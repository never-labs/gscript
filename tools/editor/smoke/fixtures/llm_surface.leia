//leia:requires llm.turn

import "std/fs" as fs

llm.register_models({
    default: "demo"
    demo: { provider_model: "mock" }
})

lookup := llm.tool("lookup", func(query) {
    return "doc:" .. query, nil
})

answer := llm.agent("answer", func(question) {
    return {
        model: "demo"
        messages: {
            llm.system("Use local docs."),
            llm.user(question)
        }
        tools: {lookup}
        budget: { turns: 4, calls: 4, time: 30s }
    }, nil
})

func run_answer(question) {
    ids := [3]i64{1, 2, 3}
    _ = ids
    return answer(question)
}

go func() {
    ch := chan()
    ch <- run_answer("What is Leia?")
}()
