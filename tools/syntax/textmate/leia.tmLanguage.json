{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Leia",
  "scopeName": "source.leia",
  "patterns": [
    {
      "include": "#directives"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#dialects"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#contextual"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.leia",
          "match": "//.*$"
        },
        {
          "name": "comment.block.leia",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.leia",
          "match": "^\\s*//leia:(?:build|test|cap|feature|requires|param)\\b.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.leia",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.leia",
              "match": "\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-9]{1,3})"
            }
          ]
        },
        {
          "name": "string.quoted.single.leia",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.leia",
              "match": "\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-9]{1,3})"
            }
          ]
        },
        {
          "name": "string.quoted.raw.fenced.leia",
          "begin": "```",
          "end": "```"
        },
        {
          "name": "string.quoted.raw.leia",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.group.leia",
          "begin": "\\b(import)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.leia"
            },
            "2": {
              "name": "punctuation.definition.import-group.begin.leia"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.import-group.end.leia"
            }
          },
          "patterns": [
            {
              "name": "meta.import.leia",
              "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s+(\"(?:\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-9]{1,3})|[^\"\\\\])*\")",
              "captures": {
                "1": {
                  "name": "entity.name.namespace.import.leia"
                },
                "2": {
                  "name": "string.quoted.double.import.path.leia"
                }
              }
            },
            {
              "name": "meta.import.leia",
              "match": "\"(?:\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-9]{1,3})|[^\"\\\\])*\"",
              "captures": {
                "0": {
                  "name": "string.quoted.double.import.path.leia"
                }
              }
            }
          ]
        },
        {
          "name": "meta.import.leia",
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(\"(?:\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-9]{1,3})|[^\"\\\\])*\")",
          "captures": {
            "1": {
              "name": "keyword.control.import.leia"
            },
            "2": {
              "name": "entity.name.namespace.import.leia"
            },
            "3": {
              "name": "string.quoted.double.import.path.leia"
            }
          }
        },
        {
          "name": "meta.import.leia",
          "match": "\\b(import)\\s+(\"(?:\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-9]{1,3})|[^\"\\\\])*\")(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.control.import.leia"
            },
            "2": {
              "name": "string.quoted.double.import.path.leia"
            },
            "3": {
              "name": "keyword.control.import.as.leia"
            },
            "4": {
              "name": "entity.name.namespace.import.leia"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.leia",
          "match": "\\b(?:[0-9][0-9_]*\\.[0-9_]*(?:[eE][+-]?[0-9_]+)?|[0-9][0-9_]*(?:[eE][+-]?[0-9_]+))\\b"
        },
        {
          "name": "constant.numeric.integer.leia",
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.leia",
          "match": "\\b(?:if|else|elseif|for|range|in|break|continue|goto|return|defer|go)\\b"
        },
        {
          "name": "storage.type.function.leia",
          "match": "\\b(?:func|var|const|chan)\\b"
        },
        {
          "name": "constant.language.leia",
          "match": "\\b(?:true|false|nil)\\b"
        },
        {
          "name": "support.type.primitive.leia",
          "match": "\\b(?:i32|i64|f32|f64|bool)\\b"
        }
      ]
    },
    "contextual": {
      "patterns": [
        {
          "name": "keyword.control.contextual.leia",
          "match": "\\b(?:import)(?=\\s*(?:\\(|[\"']))|\\b(?:select)(?=\\s*\\{)|\\b(?:case)(?=\\s+)|\\b(?:default)(?=\\s*:)|\\b(?:evaluate)(?=\\s*[\"'])"
        }
      ]
    },
    "dialects": {
      "patterns": [
        {
          "name": "meta.dialect.tagged-string.leia",
          "contentName": "string.quoted.raw.dialect.leia",
          "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)(!)?\\s*(`(?:``)?)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag.dialect.leia"
            },
            "2": {
              "name": "keyword.operator.raw.dialect.leia"
            },
            "3": {
              "name": "punctuation.definition.string.begin.leia"
            }
          },
          "end": "\\3",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.leia"
            }
          }
        },
        {
          "name": "meta.dialect.shell.tagged-string.leia",
          "contentName": "string.quoted.raw.shell.leia",
          "begin": "(\\$)(!)?\\s*(`(?:``)?)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag.shell.leia"
            },
            "2": {
              "name": "keyword.operator.raw.dialect.leia"
            },
            "3": {
              "name": "punctuation.definition.string.begin.leia"
            }
          },
          "end": "\\3",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.leia"
            }
          }
        },
        {
          "name": "meta.dialect.tagged-block.begin.leia",
          "match": "(?:^\\s*|[=(:,\\[]\\s*)([A-Za-z_][A-Za-z0-9_]*)(!)?\\s*(\\{)",
          "captures": {
            "1": {
              "name": "entity.name.tag.dialect.leia"
            },
            "2": {
              "name": "keyword.operator.raw.dialect.leia"
            },
            "3": {
              "name": "punctuation.section.block.begin.leia"
            }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.leia",
          "match": "\\b(?:assert|cap|close|collectgarbage|dofile|error|getmetatable|ipairs|len|load|loadfile|loadstring|next|pairs|pcall|print|rawequal|rawget|rawlen|rawset|require|select|setmetatable|spread|tonumber|tostring|type|unpack|xpcall)\\b(?=\\s*\\()"
        },
        {
          "name": "support.module.leia",
          "match": "\\b(?:array|base64|binary|bit32|bits|bytes|chat|color|compress|container|context|control|crypto|csv|data|db|debug|encoding|fs|hash|history|http|io|json|linalg|llm|log|loop|math|matrix|msg|net|ode|os|path|process|rand|regexp|script|serve|soa|sort|stats|string|sync|table|testkit|time|url|utf8|uuid|vec)\\b(?=\\.)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.leia",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.leia",
          "match": "\\+\\+|--|\\+=|-=|\\*=|/=|:=|==|!=|<=|>=|&&|\\|\\||&\\^|<<|>>|<-|\\.\\.\\.?|\\*\\*|[+\\-*/%#!=<>|&^.:,;]"
        }
      ]
    }
  }
}
