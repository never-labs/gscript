// Current-only q.query operator pipeline benchmark over SoA columns.

N := 4096
REPS := 520
MOD := 1000000007

func make_i64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod)
    }
    return array.i64(t)
}

func make_revenue(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = 90.0 + (i % 149) * 3.25
    }
    return array.f64(t)
}

func make_cost(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = 25.0 + (i % 67) * 1.15
    }
    return array.f64(t)
}

func make_units(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = 1.0 + (i % 19)
    }
    return array.f64(t)
}

func make_risk(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = 0.03 + (i % 41) * 0.0125
    }
    return array.f64(t)
}

func mix(sum, v) {
    return (sum * 131 + v) % MOD
}

facts := soa.zip({
    account_id: make_i64(N, 257, 1000),
    segment_id: make_i64(N, 11, 1),
    region_id: make_i64(N, 9, 20),
    revenue: make_revenue(N),
    cost: make_cost(N),
    units: make_units(N),
    risk: make_risk(N),
})

plan := {
    where: {column: "risk", op: ">=", value: 0.25},
    by: {"segment_id", "region_id"},
    select: {
        revenue: "revenue",
        cost: "cost",
        units: "units",
        margin: {"-", "revenue", "cost"},
        max_risk: "risk",
        rows: 1,
    },
    aggregate: {
        revenue: "sum",
        cost: "sum",
        units: "sum",
        margin: "sum",
        max_risk: "max",
        rows: "count",
    },
    order_by: {
        {column: "margin", desc: true},
        {column: "segment_id"},
        {column: "region_id"},
    },
    limit: 12,
}

func run_hot(cols, plan, reps) {
    checksum := 0
    for r := 1; r <= reps; r++ {
        rows := q.query(cols, plan)
        top := rows[1]
        tail := rows[#rows]
        checksum = mix(checksum, #rows + top.segment_id * 17 + top.region_id * 31 + top.rows)
        checksum = mix(checksum, math.floor(top.margin) + math.floor(tail.revenue) + math.floor(tail.max_risk * 1000))
    }
    return checksum
}

warm := run_hot(facts, plan, 2)
collectgarbage("collect")
t0 := time.now()
checksum := run_hot(facts, plan, REPS)
elapsed := time.since(t0)

print(string.format("q_operator_pipeline_hot n=%d reps=%d", N, REPS))
print(string.format("checksum: %d", mix(checksum, warm)))
print(string.format("Time: %.3fs", elapsed))
