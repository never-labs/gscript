// q market full stack hot benchmark: q.eval + mutation + asof + wj/wj1 +
// keyed lookup + xbar rollup in a single repeated analytics flow.

N := 1024
REPS := 70
MOD := 1000000007

func make_symbols(n, mod, prefix) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = string.format("%s%d", prefix, i % mod)
    }
    return data.symbols(t)
}

func make_i64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod)
    }
    return data.i64(t)
}

func make_f64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod) * 0.125
    }
    return data.f64(t)
}

func make_ts(n, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + i * 1000000000
    }
    return data.timestamp(t)
}

func make_bool(n, period) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = i % period == 0
    }
    return data.bool(t)
}

func mix(sum, v) {
    return (sum * 131 + v) % MOD
}

ids := {}
for i := 1; i <= N; i++ {
    ids[i] = i
}

base_ts := 1780738200000000000
quotes := data.frame({
    quote_id: data.i64(ids),
    sym: make_symbols(N, 128, "S"),
    ts: make_ts(N, base_ts),
    bid: make_f64(N, 251, 99.75),
    ask: make_f64(N, 251, 100.25),
    bid_sz: make_i64(N, 500, 50),
    ask_sz: make_i64(N, 500, 40),
    venue: make_symbols(N, 8, "V"),
})

orders := data.frame({
    order_id: data.i64(ids),
    parent_id: make_i64(N, 256, 1000),
    sym: make_symbols(N, 128, "S"),
    side: make_symbols(N, 2, "side"),
    ts: make_ts(N, base_ts + 20 * 1000000000),
    order_qty: make_i64(N, 97, 10),
    limit_px: make_f64(N, 251, 100.0),
    trader: make_symbols(N, 32, "trader"),
})

raw_trades := data.frame({
    trade_id: data.i64(ids),
    order_id: data.i64(ids),
    sym: make_symbols(N, 128, "S"),
    ts: make_ts(N, base_ts + 45 * 1000000000),
    price: make_f64(N, 251, 100.0),
    size: make_i64(N, 97, 1),
    venue: make_symbols(N, 8, "V"),
    cancelled: make_bool(N, 17),
})

sectors := data.frame({
    sym: make_symbols(128, 128, "S"),
    sector: make_symbols(128, 8, "sector"),
    tick_size: make_f64(128, 4, 0.01),
})

func run_hot(raw_trades, quotes, orders, sectors, reps) {
    checksum := 0
    pipeline := q.eval("px:100 101 102;sz:10 20 30;n:px*sz;+/n")
    scan := q.eval("+\\100 50 25 25")
    lambda := q.eval("{x+y}/1 2 3 4")
    for r := 1; r <= reps; r++ {
        trades := q.sql(raw_trades, "delete from trades where cancelled=true")
        trades = q.sql(trades, "update notional:price*size from trades where size>0")
        enriched := q.sql(
            "select trade_id,order_id,sym,ts,price,size,notional,bid,ask,spread:ask-bid,bid_sz,ask_sz,venue from trades asof join quotes on sym,ts",
            {trades: trades, quotes: quotes}
        )
        windowed := q.sql(
            "select trade_id,sym,ts,bid,ask,bid_sz from trades wj[-60000000000 0] quotes on sym,ts order by trade_id asc take 64",
            {trades: trades, quotes: quotes}
        )
        last_window := q.sql(
            "select trade_id,sym,ts,bid,ask,bid_sz from trades wj1[-60000000000 0] quotes on sym,ts order by trade_id asc take 64",
            {trades: trades, quotes: quotes}
        )
        fills := q.sql(
            trades,
            "select filled:sum size,traded_notional:sum notional,fills:count i by order_id,sym from trades where order_id>0 order by order_id asc take 128"
        )
        lifecycle := q.sql(
            "select order_id,parent_id,sym,order_qty,filled,traded_notional,fills,trader from orders pj fills on order_id,sym order by order_id asc take 128",
            {orders: orders, fills: fills}
        )
        joined := q.sql(
            "select trade_id,order_id,sym,sector,tick_size,price,size,notional,bid,ask,spread,venue from trades left join sectors on sym order by trade_id asc take 256",
            {trades: enriched, sectors: sectors}
        )
        keyed := q.key_by(joined, "sym")
        rows := q.lookup(keyed, joined[1].sym)
        bars := q.sql(
            enriched,
            "select notional:sum notional,shares:sum size,fills:count i,avg_spread:avg spread by sym,bucket:xbar 60000000000 ts from trades order by notional desc take 32"
        )
        checksum = mix(checksum, pipeline + scan[4] + lambda + #trades + #enriched + #windowed + #last_window + #fills + #lifecycle + #joined + #rows + #bars)
        checksum = mix(checksum, joined[1].trade_id + #windowed[1].bid + last_window[1].bid + bars[1].fills + lifecycle[1].order_id)
    }
    return checksum
}

warm := run_hot(raw_trades, quotes, orders, sectors, 2)
collectgarbage("collect")
t0 := time.now()
checksum := run_hot(raw_trades, quotes, orders, sectors, REPS)
elapsed := time.since(t0)

print(string.format("q_market_full_stack_hot rows=%d reps=%d", N, REPS))
print(string.format("checksum: %d", mix(checksum, warm)))
print(string.format("Time: %.3fs", elapsed))
