// In-memory frame qSQL rollup benchmark. This avoids SQLite setup cost and
// keeps the hot loop on frame/SoA aggregation.

N := 4096
REPS := 420
MOD := 1000000007

func make_i64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod)
    }
    return array.i64(t)
}

func make_gross(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = 720.0 + (i % 113) * 9.5
    }
    return array.f64(t)
}

func make_discount(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = 12.0 + (i % 29) * 1.75
    }
    return array.f64(t)
}

func make_units(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = 1.0 + (i % 15)
    }
    return array.f64(t)
}

func memory_frame(columns, column_names) {
    frame_soa := soa.zip(columns)
    return {
        len: soa.len(frame_soa),
        column_names: column_names,
        columns: columns,
        numeric: columns,
        numeric_columns: column_names,
        soa: frame_soa,
    }
}

func mix(sum, v) {
    return (sum * 131 + v) % MOD
}

orders := memory_frame({
    day: make_i64(N, 31, 1),
    region_id: make_i64(N, 9, 1),
    product_id: make_i64(N, 37, 100),
    channel_id: make_i64(N, 5, 10),
    gross: make_gross(N),
    discount: make_discount(N),
    units: make_units(N),
}, {"day", "region_id", "product_id", "channel_id", "gross", "discount", "units"})

qsql_rollup := "select revenue:sum gross-discount, gross:sum gross, units:sum units, orders:count i by region_id, product_id from orders where gross>900"

func run_hot(frame, qsql_rollup, reps) {
    checksum := 0
    for r := 1; r <= reps; r++ {
        rows := q.sql(frame, qsql_rollup)
        top := rows[1]
        checksum = mix(checksum, #rows + top.region_id * 17 + top.product_id * 31 + top.orders)
        checksum = mix(checksum, math.floor(top.revenue))
    }
    return checksum
}

warm := run_hot(orders, qsql_rollup, 2)
collectgarbage("collect")
t0 := time.now()
checksum := run_hot(orders, qsql_rollup, REPS)
elapsed := time.since(t0)

print(string.format("frame_qsql_rollup_hot n=%d reps=%d", N, REPS))
print(string.format("checksum: %d", mix(checksum, warm)))
print(string.format("Time: %.3fs", elapsed))
