// q portfolio risk/factor hot benchmark over in-memory frames.

N := 768
REPS := 70
MOD := 1000000007

func make_symbols(n, mod, prefix) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = string.format("%s%d", prefix, i % mod)
    }
    return data.symbols(t)
}

func make_i64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod)
    }
    return data.i64(t)
}

func make_f64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod) * 0.25
    }
    return data.f64(t)
}

func make_ts(n, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + i * 1000000000
    }
    return data.timestamp(t)
}

func make_bool(n, period) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = i % period == 0
    }
    return data.bool(t)
}

func mix(sum, v) {
    return (sum * 131 + v) % MOD
}

ids := {}
for i := 1; i <= N; i++ {
    ids[i] = i
}

base_ts := 1780738200000000000
positions_raw := data.frame({
    acct: make_symbols(N, 5, "A"),
    book: make_symbols(N, 4, "B"),
    sym: make_symbols(N, 96, "S"),
    asof_ts: make_ts(N, base_ts),
    qty: make_i64(N, 401, -200),
    avg_cost: make_f64(N, 300, 80.0),
    borrow_bps: make_i64(N, 160, 0),
    restricted: make_bool(N, 17),
})

prices := data.frame({
    sym: make_symbols(N, 96, "S"),
    ts: make_ts(N, base_ts - 90 * 1000000000),
    px: make_f64(N, 300, 81.0),
    ret: make_f64(N, 31, -0.02),
})

factor_snap := data.frame({
    sym: make_symbols(N, 96, "S"),
    ts: make_ts(N, base_ts - 120 * 1000000000),
    mkt: make_f64(N, 23, 0.80),
    value: make_f64(N, 19, -0.50),
    momentum: make_f64(N, 29, -0.20),
    quality: make_f64(N, 17, 0.10),
})

risk_ref := data.frame({
    sym: make_symbols(96, 96, "S"),
    sector: make_symbols(96, 8, "sector"),
    beta: make_f64(96, 19, 0.50),
    vol: make_f64(96, 11, 0.10),
    adv: make_i64(96, 100000, 1000000),
})

rebalance := data.frame({
    acct: make_symbols(N, 5, "A"),
    book: make_symbols(N, 4, "B"),
    sym: make_symbols(N, 96, "S"),
    ts: make_ts(N, base_ts + 30 * 1000000000),
    target_pct: make_f64(N, 21, -0.20),
})

events := data.frame({
    event_id: data.i64(ids),
    acct: make_symbols(N, 5, "A"),
    book: make_symbols(N, 4, "B"),
    sym: make_symbols(N, 96, "S"),
    ts: make_ts(N, base_ts + 45 * 1000000000),
    action: make_symbols(N, 3, "action"),
    qty: make_i64(N, 89, -40),
    px: make_f64(N, 300, 81.5),
})

func run_once() {
    factor_weight := q.eval("`mkt`value`momentum`quality!0.55 0.20 0.15 0.10")
    running_cash := q.eval("+\\100000 -25000 12000 -8000 5000")
    gaps := q.eval("-':93000 93045 93130 93200")
    gross_cut := q.eval("{x+y}/0 250000 180000 90000")

    positions := q.sql(positions_raw, "delete from trades where restricted=true")
    positions = q.sql(positions, "update signed_qty:qty from trades")
    positions = q.sql(positions, "update abs_qty:qty from trades where qty>=0")
    positions = q.sql(positions, "update abs_qty:-qty from trades where qty<0")
    positions = q.sql(positions, "update borrow_rate:borrow_bps*0.0001 from trades where borrow_bps>0")

    marked := q.sql(
        "select acct,book,sym,asof_ts,qty,signed_qty,abs_qty,avg_cost,borrow_bps,borrow_rate,px,ret from positions asof join prices on sym,asof_ts=ts order by acct asc,book asc,sym asc",
        {positions: positions, prices: prices}
    )
    marked = q.sql(marked, "update market_value:qty*px from trades")
    marked = q.sql(marked, "update gross_value:abs_qty*px from trades")
    marked = q.sql(marked, "update pnl:(px-avg_cost)*qty from trades")
    marked = q.sql(marked, "update carry_cost:gross_value*borrow_rate*reciprocal 252.0 from trades")

    risk_marked := q.sql(
        "select acct,book,sym,sector,beta,vol,adv,asof_ts,qty,signed_qty,abs_qty,px,ret,market_value,gross_value,pnl,carry_cost,borrow_rate from trades left join risk_ref on sym order by acct asc,book asc,sym asc",
        {trades: marked, risk_ref: risk_ref}
    )
    risk_marked = q.sql(risk_marked, "update beta_dollar:market_value*beta from trades")
    risk_marked = q.sql(risk_marked, "update var_1d:gross_value*vol*0.063 from trades")
    risk_marked = q.sql(risk_marked, "update liquidity_days:abs_qty*reciprocal adv from trades")
    risk_marked = q.sql(risk_marked, "update stress_loss:var_1d*exp 0.25 from trades")

    factor_marked := q.sql(
        "select acct,book,sym,sector,asof_ts,qty,market_value,gross_value,pnl,beta_dollar,var_1d,stress_loss,mkt,value,momentum,quality from trades asof join factor_snap on sym,asof_ts=ts order by acct asc,book asc,sym asc",
        {trades: risk_marked, factor_snap: factor_snap}
    )
    factor_marked = q.sql(factor_marked, "update mkt_dollar:market_value*mkt from trades")
    factor_marked = q.sql(factor_marked, "update momentum_dollar:market_value*momentum from trades")

    windowed := q.sql(
        "select acct,book,sym,asof_ts,mkt,momentum from risk_marked wj[-0D00:03:00,0D00:00:00] factor_snap on sym,asof_ts=ts order by sym asc",
        {risk_marked: risk_marked, factor_snap: factor_snap}
    )
    last_factor := q.sql(
        "select acct,book,sym,asof_ts,mkt,momentum from risk_marked wj1[-0D00:03:00,0D00:00:00] factor_snap on sym,asof_ts=ts order by sym asc",
        {risk_marked: risk_marked, factor_snap: factor_snap}
    )
    active := q.sql(risk_marked, "select sym,sector,market_value,gross_value from trades where sym in `S1`S2`S3 and sector in `sector1`sector2 order by sym asc")
    sector_rollup := q.sql(
        factor_marked,
        "select gross:sum gross_value,net:sum market_value,beta:sum beta_dollar,var:sum var_1d,stress:sum stress_loss,rows:count i by sector,bucket:xbar 60000000000 asof_ts from trades order by sector asc"
    )
    sector_rollup = q.sql(sector_rollup, "update stress_ratio:stress*reciprocal gross from trades")
    target_state := q.sql(
        "select event_id,acct,book,sym,ts,action,qty,px,target_pct from events asof join rebalance on acct,book,sym,ts order by event_id asc",
        {events: events, rebalance: rebalance}
    )
    target_state = q.sql(target_state, "update target_notional:qty*px from trades where action in `action0`action1")
    target_state = q.sql(target_state, "delete target_pct from trades")
    keyed := q.key_by(factor_marked, "acct", "book", "sym")
    hit := q.lookup(keyed, "A1", "B1", "S1")

    checksum := #positions + #marked * 3 + #risk_marked * 5 + #factor_marked * 7 + #windowed * 11 + #last_factor * 13 + #active * 17 + #sector_rollup * 19 + #target_state * 23 + #hit * 29
    checksum = checksum + math.floor(factor_weight.mkt * 100) + running_cash[5] + gaps[3] + gross_cut
    if #sector_rollup > 0 {
        checksum = checksum + math.floor(sector_rollup[1].stress_ratio * 1000000)
    }
    return checksum
}

warm := run_once()
collectgarbage("collect")
t0 := time.now()
checksum := 0
for r := 1; r <= REPS; r++ {
    checksum = mix(checksum, run_once())
}
elapsed := time.since(t0)

print(string.format("q_portfolio_risk_factor_hot rows=%d reps=%d", N, REPS))
print(string.format("checksum: %d", mix(checksum, warm)))
print(string.format("Time: %.3fs", elapsed))
