// q integrated market replay hot benchmark. This mirrors the example project
// over generated frames and exercises mutation, asof/window, left join, pj,
// xbar VWAP rollup, keyed lookup, xgroup/ungroup, adverbs, and exec dictionary
// projection.

N := 512
REPS := 64
MOD := 1000000007

func make_symbols(n, mod, prefix) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = string.format("%s%d", prefix, i % mod)
    }
    return data.symbols(t)
}

func make_i64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod)
    }
    return data.i64(t)
}

func make_f64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod) * 0.125
    }
    return data.f64(t)
}

func make_ts(n, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + i * 1000000000
    }
    return data.timestamp(t)
}

func make_bool(n, period) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = i % period == 0
    }
    return data.bool(t)
}

func mix(sum, v) {
    return (sum * 131 + v) % MOD
}

ids := {}
for i := 1; i <= N; i++ {
    ids[i] = i
}

base_ts := 1780738200000000000

quotes := data.frame({
    quote_id: data.i64(ids),
    sym: make_symbols(N, 80, "S"),
    ts: make_ts(N, base_ts),
    bid: make_f64(N, 257, 99.5),
    ask: make_f64(N, 257, 100.0),
    bid_sz: make_i64(N, 400, 50),
    ask_sz: make_i64(N, 400, 40),
    venue: make_symbols(N, 6, "V"),
})

orders_raw := data.frame({
    order_id: data.i64(ids),
    parent_id: make_i64(N, 160, 1000),
    desk: make_symbols(N, 24, "D"),
    sym: make_symbols(N, 80, "S"),
    side: make_symbols(N, 2, "side"),
    ts: make_ts(N, base_ts + 20 * 1000000000),
    order_qty: make_i64(N, 89, 10),
    limit_px: make_f64(N, 257, 100.0),
    state: make_symbols(N, 5, "state"),
})

raw_trades := data.frame({
    trade_id: data.i64(ids),
    order_id: make_i64(N, N, 0),
    parent_id: make_i64(N, 160, 1000),
    desk: make_symbols(N, 24, "D"),
    sym: make_symbols(N, 80, "S"),
    side: make_symbols(N, 2, "side"),
    ts: make_ts(N, base_ts + 30 * 1000000000),
    price: make_f64(N, 257, 100.0),
    size: make_i64(N, 89, 1),
    venue: make_symbols(N, 6, "V"),
    cancelled: make_bool(N, 17),
})

refdata := data.frame({
    sym: make_symbols(80, 80, "S"),
    sector: make_symbols(80, 8, "sector"),
    tick_size: make_f64(80, 4, 0.01),
})

func run_hot(raw_trades, orders_raw, quotes, refdata, reps) {
    checksum := 0
    stats := q.eval("q:40 25 30 45 12 10 15;p:100.1 100.5 250.2 250.7 882.2 140.1 250.9;n:p*q;(+/q;+\\q;-':q;{x+y}/q;+/n;{x+y}\\[0;q];q*\\:2)")
    for r := 1; r <= reps; r++ {
        orders := q.sql(orders_raw, "update open_qty:order_qty from trades")
        trades := q.sql(raw_trades, "delete from trades where cancelled=true")
        trades = q.sql(trades, "update notional:price*size from trades where size>0")
        trades = q.sql(trades, "update signed_qty:size from trades")
        trades = q.sql(trades, "update signed_qty:0-size from trades where side=`side1")
        trades = q.sql(trades, "update fee:notional*0.00030 from trades where venue=`V1")
        trades = q.sql(trades, "update fee:notional*0.00020 from trades where venue=`V2")
        trades = q.sql(trades, "update fee:notional*0.00025 from trades where venue=`V3")
        marked := q.sql(
            "select trade_id,order_id,parent_id,desk,sym,side,ts,price,size,signed_qty,notional,fee,bid,ask,spread:ask-bid,venue from trades asof join quotes on sym,ts order by trade_id asc take 384",
            {trades: trades, quotes: quotes}
        )
        windowed := q.sql(
            "select trade_id,sym,ts,bid,ask,bid_sz from trades wj[-120000000000 0] quotes on sym,ts order by trade_id asc take 128",
            {trades: trades, quotes: quotes}
        )
        joined := q.sql(
            "select trade_id,order_id,parent_id,desk,sym,sector,tick_size,side,ts,price,size,signed_qty,notional,fee,bid,ask,spread,venue from trades left join refdata on sym order by trade_id asc take 384",
            {trades: marked, refdata: refdata}
        )
        fills := q.sql(
            trades,
            "select filled:sum size,gross:sum notional,fees:sum fee,net_qty:sum signed_qty,fills:count i by order_id,desk,sym from trades order by order_id asc take 128"
        )
        state := q.sql(
            "select order_id,parent_id,desk,sym,side,order_qty,open_qty,filled,gross,fees,net_qty,fills from orders pj fills on order_id,desk,sym order by order_id asc take 256",
            {orders: orders, fills: fills}
        )
        bars := q.sql(
            joined,
            "select notional:sum notional,shares:sum size,net_qty:sum signed_qty,fees:sum fee,avg_spread:avg spread,fills:count i by sym,bucket:xbar 60000000000 ts from trades order by fills desc take 32"
        )
        bars = q.sql(bars, "update vwap:notional/shares from trades")
        exec_dict := q.sql(joined, "exec sym!notional from trades where notional>5000 order by notional desc take 64")
        keyed := q.key_by(joined, "sym")
        rows := q.lookup(keyed, joined[1].sym)
        keyed_bars := q.key_by(bars, "sym", "bucket")
        values := q.value(keyed_bars)
        grouped_book := q.eval("`sym`venue xgroup flip `sym`venue`trade_id`price`size!(`S1`S1`S2`S2`S3`S4`S2;`V1`V2`V3`V4`V2`V5`V4;101 102 103 104 105 107 108;100.1 100.5 250.2 250.7 882.2 140.1 250.9;40 25 30 45 12 10 15)")
        ungrouped_book := q.eval("ungroup (`sym`venue xgroup flip `sym`venue`trade_id`price`size!(`S1`S1`S2`S2`S3`S4`S2;`V1`V2`V3`V4`V2`V5`V4;101 102 103 104 105 107 108;100.1 100.5 250.2 250.7 882.2 140.1 250.9;40 25 30 45 12 10 15))")
        grouped_hit := q.lookup(grouped_book, {sym: "S2", venue: "V4"})
        checksum = mix(checksum, #trades + #marked + #windowed + #joined + #fills + #state + #bars + q.count(exec_dict) + #rows + #values + #q.value(grouped_book) + #ungrouped_book + #grouped_hit)
        checksum = mix(checksum, stats[1] + stats[2][7] + stats[6][7] + stats[7][7] + joined[1].trade_id + bars[1].fills + math.floor(bars[1].vwap))
    }
    return checksum
}

warm := run_hot(raw_trades, orders_raw, quotes, refdata, 2)
collectgarbage("collect")
t0 := time.now()
checksum := run_hot(raw_trades, orders_raw, quotes, refdata, REPS)
elapsed := time.since(t0)

print(string.format("q_integrated_market_replay_hot rows=%d reps=%d", N, REPS))
print(string.format("checksum: %d", mix(checksum, warm)))
print(string.format("Time: %.3fs", elapsed))
