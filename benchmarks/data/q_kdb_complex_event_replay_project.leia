// q complex event replay hot benchmark: keyed reference lookup + asof +
// update/delete + exec dict/adverbs/fby + enum/attribute metadata +
// temporal xbar rollup and stable repeated qSQL lowering.

N := 768
REPS := 55
MOD := 1000000007

func make_symbols(n, mod, prefix) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = string.format("%s%d", prefix, i % mod)
    }
    return data.symbols(t)
}

func make_i64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod)
    }
    return data.i64(t)
}

func make_f64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod) * 0.125
    }
    return data.f64(t)
}

func make_ts(n, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + i * 1000000000
    }
    return data.timestamp(t)
}

func make_bool(n, period) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = i % period == 0
    }
    return data.bool(t)
}

func mix(sum, v) {
    return (sum * 131 + v) % MOD
}

ids := {}
for i := 1; i <= N; i++ {
    ids[i] = i
}

base_ts := 1780738200000000000

desks := data.frame({
    desk: make_symbols(96, 24, "D"),
    sym: make_symbols(96, 96, "S"),
    risk_limit: make_i64(96, 200, 50000),
    max_participation: make_f64(96, 6, 0.05),
})

orders_raw := data.frame({
    order_id: data.i64(ids),
    parent_id: make_i64(N, 128, 1000),
    desk: make_symbols(N, 24, "D"),
    sym: make_symbols(N, 96, "S"),
    side: make_symbols(N, 2, "side"),
    ts: make_ts(N, base_ts + 10 * 1000000000),
    order_qty: make_i64(N, 91, 10),
    limit_px: make_f64(N, 251, 100.0),
    cancelled: make_bool(N, 23),
})

quotes := data.frame({
    quote_id: data.i64(ids),
    sym: make_symbols(N, 96, "S"),
    ts: make_ts(N, base_ts),
    bid: make_f64(N, 251, 99.75),
    ask: make_f64(N, 251, 100.25),
    bid_sz: make_i64(N, 500, 50),
    ask_sz: make_i64(N, 500, 40),
    venue: make_symbols(N, 6, "V"),
})

fills_raw := data.frame({
    trade_id: data.i64(ids),
    order_id: data.i64(ids),
    parent_id: make_i64(N, 128, 1000),
    desk: make_symbols(N, 24, "D"),
    sym: make_symbols(N, 96, "S"),
    side: make_symbols(N, 2, "side"),
    ts: make_ts(N, base_ts + 35 * 1000000000),
    price: make_f64(N, 251, 100.0),
    size: make_i64(N, 91, 1),
    venue: make_symbols(N, 6, "V"),
    busted: make_bool(N, 19),
    audit: make_symbols(N, 4, "A"),
})

func run_hot(orders_raw, fills_raw, quotes, desks, reps) {
    checksum := 0
    fee_dict := q.eval("`V0`V1`V2!0.00030 0.00020 0.00035")
    adverbs := q.eval("qty:25 40 35 20;(+/qty;+\\qty;-':qty;avg qty fby `S1`S1`S2`S2)")
    verbs := q.eval("(10 20 30+1 2 3;100 90 80-1 2 3;2 3 4*5 6 7)")
    path_audit := q.eval("(prev 100.1 100.5 100.3 250.6 882.4;next 100.1 100.5 100.3 250.6 882.4;deltas 100.1 100.5 100.3 250.6 882.4;fills 0Nf 100.5f 0Nf 101.0f;reverse 1 2 3 4;iasc 100.1 100.5 100.3 250.6 882.4;idesc 100.1 100.5 100.3 250.6 882.4;distinct `V0`V1`V1`V2`V0;rank 50 20 30 10 40;2 xprev 10 20 30 40;2 rotate 10 20 30 40;differ `S1`S1`S2`S2)")
    enum_codes := q.eval("codes `sym$`S1`S2`S1`S3")
    enum_meta := q.eval("meta `sym$`S1`S2`S1`S3")
    attr_meta := q.eval("meta `p#`S1`S1`S2`S3")
    for r := 1; r <= reps; r++ {
        orders := q.sql(orders_raw, "delete from trades where cancelled=true")
        orders = q.sql(orders, "update open_qty:order_qty from trades")
        orders = q.sql(orders, "update participation_cap:order_qty*0.12 from trades")

        fills := q.sql(fills_raw, "delete from trades where busted=true")
        fills = q.sql(fills, "delete audit from trades")
        fills = q.sql(fills, "update notional:price*size from trades where size>0")
        fills = q.sql(fills, "update signed_qty:size from trades")
        fills = q.sql(fills, "update signed_qty:0-size from trades where side=`side0")
        fills = q.sql(fills, "update fee:notional*0.00030 from trades where venue=`V0")
        fills = q.sql(fills, "update fee:notional*0.00020 from trades where venue=`V1")

        enriched := q.sql(
            "select trade_id,order_id,parent_id,desk,sym,side,ts,price,size,signed_qty,notional,fee,bid,ask,spread:ask-bid,venue from trades asof join quotes on sym,ts",
            {trades: fills, quotes: quotes}
        )
        joined := q.sql(
            "select trade_id,order_id,parent_id,desk,sym,side,ts,price,size,signed_qty,notional,fee,bid,ask,spread,venue,risk_limit,max_participation from trades left join desks on desk,sym order by trade_id asc take 512",
            {trades: enriched, desks: desks}
        )
        fill_rollup := q.sql(
            joined,
            "select filled:sum size,gross:sum notional,fees:sum fee,net_qty:sum signed_qty,fills:count i by order_id,desk,sym from trades order by order_id asc take 128"
        )
        lifecycle := q.sql(
            "select order_id,parent_id,desk,sym,order_qty,open_qty,participation_cap,filled,gross,fees,net_qty,fills from orders pj fills on order_id,desk,sym order by order_id asc take 128",
            {orders: orders, fills: fill_rollup}
        )
        desk_keyed := q.key_by(desks, "desk", "sym")
        desk_hit := q.lookup(desk_keyed, joined[1].desk, joined[1].sym)
        lifecycle_keyed := q.key_by(lifecycle, "desk", "sym")
        lifecycle_hit := q.lookup(lifecycle_keyed, lifecycle[1].desk, lifecycle[1].sym)
        amended := q.sql(lifecycle_keyed, "update participation_cap:participation_cap+1 from trades where order_qty>0")
        exec_risk := q.sql(joined, "exec trade_id,desk,sym,venue,notional,risk_limit from trades where notional>5000 order by notional desc take 16")
        exec_by_desk := q.sql(joined, "exec shares:sum size,gross:sum notional,fees:sum fee by desk from trades order by desk asc take 16")
        event_window := q.sql(joined, "select trade_id,sym,ts,price,size from trades where ts within 2026.06.06D09:30:00 2026.06.06D09:45:00 order by ts asc take 24")
        venue_universe := q.sql(joined, "select distinct venue from trades order by venue asc")
        symbol_venue_universe := q.sql(joined, "select distinct sym,venue from trades order by sym asc,venue asc take 24")
        select_by_sym := q.sql(joined, "select by sym from trades order by sym asc take 24")
        select_by_sym_venue := q.sql(joined, "select by sym,venue from trades order by sym asc,venue asc take 24")
        exec_by_sym := q.sql(joined, "exec by sym from trades order by sym asc take 24")
        cached_alpha := q.sql(joined, "select trade_id,sym,notional from trades where desk=`D1 order by trade_id asc take 8")
        cached_alpha_again := q.sql(joined, "select trade_id,sym,notional from trades where desk=`D1 order by trade_id asc take 8")
        bars := q.sql(
            joined,
            "select notional:sum notional,shares:sum size,net_qty:sum signed_qty,fees:sum fee,avg_spread:avg spread,first_px:first price,last_px:last price,fills:count i by desk,sym,bucket:xbar 60000000000 ts from trades order by notional desc take 32"
        )
        checksum = mix(checksum, math.floor(fee_dict.V1 * 1000000) + adverbs[1] + adverbs[2][4] + math.floor(adverbs[4][1] * 10) + verbs[1][3] + verbs[2][2] + verbs[3][3] + math.floor(path_audit[3][2] * 100) + math.floor(path_audit[4][3]) + path_audit[5][1] + path_audit[6][1] + path_audit[7][1] + #path_audit[8] + path_audit[9][1] + path_audit[10][3] + path_audit[11][1] + enum_codes[3] + enum_meta.count + attr_meta.count + #orders + #fills + #enriched + #joined + #fill_rollup + #lifecycle + #desk_hit + #lifecycle_hit + #q.value(amended) + q.count(exec_risk.notional) + #exec_by_desk.desk + #event_window + #venue_universe + #symbol_venue_universe + #select_by_sym + #select_by_sym_venue + #exec_by_sym + #cached_alpha + #cached_alpha_again + #bars)
        checksum = mix(checksum, joined[1].trade_id + lifecycle[1].order_id + bars[1].fills + math.floor(bars[1].first_px) + math.floor(bars[1].last_px))
    }
    return checksum
}

warm := run_hot(orders_raw, fills_raw, quotes, desks, 2)
collectgarbage("collect")
t0 := time.now()
checksum := run_hot(orders_raw, fills_raw, quotes, desks, REPS)
elapsed := time.since(t0)

print(string.format("q_kdb_complex_event_replay_hot rows=%d reps=%d", N, REPS))
print(string.format("checksum: %d", mix(checksum, warm)))
print(string.format("Time: %.3fs", elapsed))
