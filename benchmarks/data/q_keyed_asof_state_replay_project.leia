// q keyed/asof state replay hot benchmark. Repeats the same complex pipeline
// as the example over generated data: mutation, fill aggregation, pj, asof,
// reference left join, xbar rollup, keyed lookup, and q adverbs/dicts.

N := 768
REPS := 80
MOD := 1000000007

func make_symbols(n, mod, prefix) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = string.format("%s%d", prefix, i % mod)
    }
    return data.symbols(t)
}

func make_i64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod)
    }
    return data.i64(t)
}

func make_f64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod) * 0.125
    }
    return data.f64(t)
}

func make_ts(n, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + i * 1000000000
    }
    return data.timestamp(t)
}

func make_bool(n, period) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = i % period == 0
    }
    return data.bool(t)
}

func mix(sum, v) {
    return (sum * 131 + v) % MOD
}

ids := {}
for i := 1; i <= N; i++ {
    ids[i] = i
}

base_ts := 1780738200000000000
quotes := data.frame({
    quote_id: data.i64(ids),
    sym: make_symbols(N, 96, "S"),
    ts: make_ts(N, base_ts),
    bid: make_f64(N, 257, 99.5),
    ask: make_f64(N, 257, 100.0),
    bid_sz: make_i64(N, 400, 50),
    ask_sz: make_i64(N, 400, 40),
    venue: make_symbols(N, 6, "V"),
})

raw_events := data.frame({
    event_id: data.i64(ids),
    order_id: make_i64(N, 384, 1000),
    parent_id: make_i64(N, 128, 500),
    sym: make_symbols(N, 96, "S"),
    action: make_symbols(N, 3, "action"),
    side: make_symbols(N, 2, "side"),
    ts: make_ts(N, base_ts + 30 * 1000000000),
    qty: make_i64(N, 89, 1),
    limit_px: make_f64(N, 257, 100.0),
    venue: make_symbols(N, 6, "V"),
    trader: make_symbols(N, 24, "trader"),
    rejected: make_bool(N, 19),
})

symbols := data.frame({
    sym: make_symbols(96, 96, "S"),
    sector: make_symbols(96, 8, "sector"),
    risk_bucket: make_symbols(96, 4, "risk"),
    tick_size: make_f64(96, 4, 0.01),
})

func run_hot(raw_events, quotes, symbols, reps) {
    checksum := 0
    fees := q.eval("`XNAS`BATS`XNYS`IEX!0.00030 0.00020 0.00035 0.00010")
    scan := q.eval("+\\1200 -300 450 -150 600")
    fold := q.eval("{x+y}/100 25 10 5")
    for r := 1; r <= reps; r++ {
        events := q.sql(raw_events, "delete from trades where rejected=true")
        events = q.sql(events, "update signed_qty:qty from trades where qty>0")
        events = q.sql(events, "update fill_notional:qty*limit_px from trades where action=`action1")
        events = q.sql(events, "update notional:qty*limit_px from trades where action=`action1")
        events = q.sql(events, "update fee:fill_notional*0.00030 from trades where venue=`V1")
        events = q.sql(events, "update fee:fill_notional*0.00020 from trades where venue=`V2")
        fills := q.sql(
            events,
            "select filled:sum qty,fill_notional:sum fill_notional,fees:sum fee,events:count i by order_id,sym from trades where action=`action1 order by order_id asc take 128"
        )
        order_state := q.sql(
            "select event_id,order_id,parent_id,sym,action,side,ts,qty,size:qty,signed_qty,limit_px,filled,fill_notional,notional,fees,trader from events pj fills on order_id,sym order by event_id asc take 256",
            {events: events, fills: fills}
        )
        marked := q.sql(
            "select event_id,order_id,parent_id,sym,action,side,ts,qty,size,signed_qty,limit_px,filled,fill_notional,notional,fees,bid,ask,bid_sz,ask_sz,spread:ask-bid,trader,venue from order_state asof join quotes on sym,ts order by event_id asc take 256",
            {order_state: order_state, quotes: quotes}
        )
        marked = q.sql(marked, "update quote_mid:(bid+ask)/2 from trades")
        marked = q.sql(marked, "update quote_imbalance:(bid_sz-ask_sz)/(bid_sz+ask_sz) from trades")
        sector_marked := q.sql(
            "select event_id,order_id,parent_id,sym,sector,risk_bucket,tick_size,action,side,ts,qty,size,signed_qty,filled,fill_notional,notional,fees,bid,ask,bid_sz,ask_sz,spread,quote_mid,quote_imbalance,trader,venue from trades left join symbols on sym order by event_id asc take 256",
            {trades: marked, symbols: symbols}
        )
        keyed := q.key_by(sector_marked, "sym")
        rows := q.lookup(keyed, sector_marked[1].sym)
        rollup := q.sql(
            sector_marked,
            "select notional:sum notional,shares:sum size,fills:count i,avg_spread:avg spread by sym,bucket:xbar 60000000000 ts from trades order by fills desc take 32"
        )
        rollup = q.sql(rollup, "update vwap:notional/shares from trades")
        keyed_state := q.key_by(order_state, "order_id", "sym")
        amended_state := q.sql(keyed_state, "update filled:filled+1 from trades where sym=`S1")
        selected_state := q.sql(amended_state, "select order_id,sym,filled from trades where sym=`S1 order by event_id asc take 8")
        pruned := q.sql(sector_marked, "delete tick_size from trades")
        decoded_marked := q.decode(q.encode(sector_marked))
        decoded_keyed_state := q.decode(q.encode(keyed_state))
        decoded_rows := q.lookup(decoded_keyed_state, {order_id: order_state[1].order_id, sym: order_state[1].sym})
        checksum = mix(checksum, scan[5] + fold + #events + #fills + #order_state + #marked + #sector_marked + #rows + #rollup + #selected_state + #pruned + #decoded_marked + #decoded_rows)
        checksum = mix(checksum, fees.BATS * 1000000 + sector_marked[1].event_id + rollup[1].fills + math.floor(marked[1].quote_mid) + decoded_marked[1].event_id)
    }
    return checksum
}

warm := run_hot(raw_events, quotes, symbols, 2)
collectgarbage("collect")
t0 := time.now()
checksum := run_hot(raw_events, quotes, symbols, REPS)
elapsed := time.since(t0)

print(string.format("q_keyed_asof_state_replay_hot rows=%d reps=%d", N, REPS))
print(string.format("checksum: %d", mix(checksum, warm)))
print(string.format("Time: %.3fs", elapsed))
