// q market tape complex hot benchmark: ticks/trades/quotes, xasc/xdesc,
// group/xgroup-like projections, asof enrichment, temporal xbar VWAP rollups,
// null/vector/adverb setup, and repeated qSQL lowering.

N := 640
REPS := 50
MOD := 1000000007

func make_symbols(n, mod, prefix) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = string.format("%s%d", prefix, i % mod)
    }
    return data.symbols(t)
}

func make_i64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod)
    }
    return data.i64(t)
}

func make_f64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod) * 0.125
    }
    return data.f64(t)
}

func make_ts(n, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + i * 1000000000
    }
    return data.timestamp(t)
}

func make_bool(n, period) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = i % period == 0
    }
    return data.bool(t)
}

func mix(sum, v) {
    return (sum * 131 + v) % MOD
}

ids := {}
for i := 1; i <= N; i++ {
    ids[i] = i
}

base_ts := 1780738200000000000

ticks := data.frame({
    tick_id: data.i64(ids),
    event: make_symbols(N, 3, "event"),
    sym: make_symbols(N, 64, "S"),
    ts: make_ts(N, base_ts),
    px: make_f64(N, 251, 100.0),
    qty: make_i64(N, 91, 0),
    venue: make_symbols(N, 6, "V"),
})

quotes := data.frame({
    quote_id: data.i64(ids),
    sym: make_symbols(N, 64, "S"),
    ts: make_ts(N, base_ts),
    bid: make_f64(N, 251, 99.75),
    ask: make_f64(N, 251, 100.25),
    bid_sz: make_i64(N, 500, 50),
    ask_sz: make_i64(N, 500, 40),
    venue: make_symbols(N, 6, "V"),
})

trades_raw := data.frame({
    trade_id: data.i64(ids),
    parent_id: make_i64(N, 128, 1000),
    desk: make_symbols(N, 16, "D"),
    sym: make_symbols(N, 64, "S"),
    side: make_symbols(N, 2, "side"),
    ts: make_ts(N, base_ts + 25 * 1000000000),
    price: make_f64(N, 251, 100.0),
    size: make_i64(N, 91, 1),
    venue: make_symbols(N, 6, "V"),
    oddlot: make_bool(N, 29),
})

func run_hot(ticks, trades_raw, quotes, reps) {
    checksum := 0
    fee_by_venue := q.eval("`V0`V1`V2`V3!0.00030 0.00020 0.00035 0.00025")
    qty_path := q.eval("qty:100 50 75 40 25 10;(+/qty;+\\qty;-':qty;2 msum qty;2 mavg 100.0 100.4 100.2 250.7 881.9 205.5)")
    null_path := q.eval("(null 10 0N 20;+\\1 0N 2;fills 0Nf 100.5 0Nf;prev 2026.06.06D09:30:00 0Np 2026.06.06D09:31:00;next 2026.06.06D09:30:00 0Np 2026.06.06D09:31:00)")
    temporal_buckets := q.eval("xbar[60000000000;2026.06.06D09:30:15 2026.06.06D09:30:59 2026.06.06D09:31:01 0Np]")
    xgroup_like := q.eval("group `S1`S1`S2`S3`S2`S4")
    sorted_probe := q.eval("`sym`ts xasc flip `sym`ts`px!(`S2`S1`S1`S3;2026.06.06D09:31:00 2026.06.06D09:30:40 2026.06.06D09:30:10 2026.06.06D09:30:20;250 100.4 100.1 881.9)")
    desc_probe := q.eval("`px xdesc flip `sym`px!(`S1`S2`S3`S4;100.4 250.7 881.9 205.5)")
    enum_probe := q.eval("(domain `sym$`S1`S2`S1`S3;codes `sym$`S1`S2`S1`S3;meta `p#`S1`S1`S2`S3)")
    callable_adverbs := q.eval("((+/)[1 0N 2];(+\\)[1 0N 2];(-':)[10 15 14 20];({x+y}'[1 2 3;10 20 30]))")
    for r := 1; r <= reps; r++ {
        trades := q.sql(trades_raw, "delete from trades where oddlot=true")
        trades = q.sql(trades, "delete oddlot from trades")
        trades = q.sql(trades, "update notional:price*size from trades")
        trades = q.sql(trades, "update signed_qty:size from trades")
        trades = q.sql(trades, "update signed_qty:0-size from trades where side=`side0")
        trades = q.sql(trades, "update fee:notional*0.00030 from trades where venue=`V0")
        trades = q.sql(trades, "update fee:notional*0.00020 from trades where venue=`V1")
        trades = q.sql(trades, "update fee:notional*0.00025 from trades where venue=`V3")

        trades_xasc := q.sql(trades, "select trade_id,sym,ts,price,size,notional from trades order by sym asc,ts asc take 256")
        trades_xdesc := q.sql(trades, "select trade_id,sym,ts,price,size,notional from trades order by notional desc take 256")
        trade_groups := q.sql(trades, "select by sym from trades order by sym asc take 64")
        venue_groups := q.sql(trades, "select fills:count i,qty:sum size,notional:sum notional by venue from trades order by venue asc take 16")
        enriched := q.sql(
            "select trade_id,parent_id,desk,sym,side,ts,price,size,signed_qty,notional,fee,bid,ask,spread:ask-bid,bid_sz,ask_sz,venue from trades asof join quotes on sym,ts order by trade_id asc take 512",
            {trades: trades, quotes: quotes}
        )
        windowed := q.sql(
            "select trade_id,sym,ts,bid,ask,bid_sz from trades wj[-0D00:01:00,0D00:00:00] quotes on sym,ts order by trade_id asc take 512",
            {trades: trades, quotes: quotes}
        )
        window_stats := q.sql(
            "select trade_id,sym,ts,n:count bid,avg_bid:avg bid,last_bid:last bid from trades wj[-0D00:01:00,0D00:00:00] quotes on sym,ts order by trade_id asc take 512",
            {trades: trades, quotes: quotes}
        )
        bars := q.sql(
            enriched,
            "select notional:sum notional,shares:sum size,net_qty:sum signed_qty,fees:sum fee,fills:count i,avg_spread:avg spread,first_px:first price,last_px:last price by sym,bucket:xbar 60000000000 ts from trades order by notional desc take 32"
        )
        daily_rollup := q.sql(enriched, "select notional:sum notional,shares:sum size,net_qty:sum signed_qty,fees:sum fee,fills:count i,avg_spread:avg spread by sym from trades order by notional desc take 32")
        top_ticks := q.sql(ticks, "select tick_id,event,sym,ts,px,qty,venue from trades where event=`event1 order by px desc take 16")
        quote_counts := q.sql(ticks, "select quotes:count i by sym,bucket:xbar 60000000000 ts from trades where event=`event0 order by sym asc,bucket asc take 32")
        keyed_bars := q.key_by(bars, "sym", "bucket")
        keyed_hit := q.lookup(keyed_bars, bars[1].sym, bars[1].bucket)
        kernel_query := "select trade_id,sym,notional from trades where notional>5000 order by trade_id asc take 16"
        kernel_before := q.explain(enriched, kernel_query)
        kernel_rows := q.sql(enriched, kernel_query)
        kernel_after := q.explain(enriched, kernel_query)
        checksum = mix(checksum, math.floor(fee_by_venue.V1 * 1000000) + qty_path[1] + qty_path[2][6] + qty_path[4][3] + null_path[2][3] + q.count(temporal_buckets) + q.count(xgroup_like.S2) + sorted_probe[1].px + desc_probe[1].px + enum_probe[2][3] + callable_adverbs[3][4] + #trades + #trades_xasc + #trades_xdesc + #trade_groups + #venue_groups + #enriched + #windowed + #window_stats + #bars + #daily_rollup + #top_ticks + #quote_counts + #keyed_hit + #kernel_rows)
        if kernel_before.kernel_supported && kernel_after.kernel_cached {
            checksum = mix(checksum, 17)
        }
        checksum = mix(checksum, trades_xasc[1].trade_id + trades_xdesc[1].trade_id + bars[1].fills + daily_rollup[1].fills + window_stats[1].n)
    }
    return checksum
}

warm := run_hot(ticks, trades_raw, quotes, 2)
collectgarbage("collect")
t0 := time.now()
checksum := run_hot(ticks, trades_raw, quotes, REPS)
elapsed := time.since(t0)

print(string.format("q_kdb_market_tape_complex_hot rows=%d reps=%d", N, REPS))
print(string.format("checksum: %d", mix(checksum, warm)))
print(string.format("Time: %.3fs", elapsed))
