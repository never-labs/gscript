// qSQL columnar group/xbar benchmark over an in-memory data.frame. This
// isolates typed bucket, grouped aggregation, ordering, and limit.

N := 8192
REPS := 430
MOD := 1000000007

func make_i64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod)
    }
    return data.i64(t)
}

func make_f64(n, mod, offset) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = offset + (i % mod) * 0.25
    }
    return data.f64(t)
}

func make_symbols(n, mod, prefix) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = string.format("%s%d", prefix, i % mod)
    }
    return data.symbols(t)
}

func make_ts(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = i
    }
    return data.i64(t)
}

func mix(sum, v) {
    return (sum * 131 + v) % MOD
}

trades := data.frame({
    sym: make_symbols(N, 64, "S"),
    ts: make_ts(N),
    price: make_f64(N, 251, 90.0),
    size: make_i64(N, 100, 1),
})

query := "select notional:sum price*size,shares:sum size,fills:count i,first_px:first price,last_px:last price by sym,bucket:xbar 60 ts from trades where price>=100 order by notional desc take 24"

func run_hot(trades, query, reps) {
    checksum := 0
    for r := 1; r <= reps; r++ {
        bars := q.sql(trades, query)
        assert(#bars == 24)
        top := bars[1]
        tail := bars[#bars]
        checksum = mix(checksum, #bars + top.shares + tail.fills + top.bucket)
        checksum = mix(checksum, math.floor(top.notional) + math.floor(tail.last_px * 100))
    }
    return checksum
}

warm := run_hot(trades, query, 2)
collectgarbage("collect")
t0 := time.now()
checksum := run_hot(trades, query, REPS)
elapsed := time.since(t0)

print(string.format("q_columnar_qsql_group_xbar_hot n=%d reps=%d", N, REPS))
print(string.format("checksum: %d", mix(checksum, warm)))
print(string.format("Time: %.3fs", elapsed))
