// q.query hot smoke: grouped aggregation, ordering, and limit over SoA columns.

N := 4096
REPS := 450
MOD := 1000000007

func make_channel(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = 1 + (i % 17)
    }
    return array.i64(t)
}

func make_region(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = 1 + (i % 7)
    }
    return array.i64(t)
}

func make_revenue(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = 40.0 + (i % 97) * 1.25
    }
    return array.f64(t)
}

func make_cost(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = 15.0 + (i % 43) * 0.75
    }
    return array.f64(t)
}

func make_units(n) {
    t := {}
    for i := 1; i <= n; i++ {
        t[i] = 1.0 + (i % 11)
    }
    return array.f64(t)
}

func mix(sum, v) {
    return (sum * 131 + v) % MOD
}

campaigns := soa.zip({
    channel_id: make_channel(N),
    region_id: make_region(N),
    revenue: make_revenue(N),
    cost: make_cost(N),
    units: make_units(N),
})

active := soa.mask(campaigns, "revenue", ">=", 80.0)

func run_hot(campaigns, active, reps) {
    checksum := 0
    for r := 1; r <= reps; r++ {
        rows := q.query(campaigns, {
            where: active,
            by: {"channel_id", "region_id"},
            select: {
                revenue: "revenue",
                cost: "cost",
                units: "units",
                gross: {"-", "revenue", "cost"},
                rows: 1,
            },
            aggregate: {
                revenue: "sum",
                cost: "sum",
                units: "sum",
                gross: "sum",
                rows: "count",
            },
            order_by: {
                {column: "gross", desc: true},
                {column: "channel_id"},
            },
            limit: 8,
        })
        top := rows[1]
        checksum = mix(checksum, #rows + top.channel_id * 17 + top.region_id * 31 + top.rows)
        checksum = mix(checksum, math.floor(top.gross))
    }
    return checksum
}

warm := run_hot(campaigns, active, 2)
collectgarbage("collect")
t0 := time.now()
checksum := run_hot(campaigns, active, REPS)
elapsed := time.since(t0)

print(string.format("q_query_rollup_hot n=%d reps=%d", N, REPS))
print(string.format("checksum: %d", mix(checksum, warm)))
print(string.format("Time: %.3fs", elapsed))
