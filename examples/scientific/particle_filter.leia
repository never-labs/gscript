// Particle filter acceptance example using the general scientific stdlib APIs.
// Run:
//   go run ./cmd/leia run examples/scientific/particle_filter.leia

func near(a, b, tol) {
    return math.abs(a - b) <= tol
}

rand.seed(314159)

N := 64
particles := stats.fill(N, 0.0)
for i := 1; i <= N; i++ {
    particles[i] = rand.normal(0.0, 0.8)
}
weights := stats.fill(N, 1.0 / N)

measurements := {0.58, 1.05, 1.53, 1.95}
process_sigma := 0.04
sensor_sigma := 0.18

for t := 1; t <= #measurements; t++ {
    for i := 1; i <= N; i++ {
        particles[i] = particles[i] + 0.50 + rand.normal(0.0, process_sigma)
        residual := measurements[t] - particles[i]
        likelihood := math.exp(-0.5 * (residual / sensor_sigma) ** 2)
        weights[i] = likelihood + 1e-300
    }
    weights = stats.normalize_weights(weights)

    ess := stats.effective_sample_size(weights)
    if ess < N * 0.6 {
        idx := stats.systematic_resample(weights, 0.5)
        particles = stats.gather(particles, idx)
        weights = stats.fill(N, 1.0 / N)
    }
}

estimate := stats.mean(particles)
variance := stats["var"](particles)
spread := stats.rmse(particles, stats.fill(N, estimate))
last_measurement := measurements[#measurements]
q_checksum := q.eval("+/1 2 3")

assert(near(estimate, last_measurement, 0.15))
assert(near(spread, math.sqrt(variance), 0.000000001))
assert(spread < 0.35)
assert(q_checksum == 6)

print(string.format("ok particle n=%d estimate=%.3f measurement=%.3f spread=%.3f", N, estimate, last_measurement, spread))
