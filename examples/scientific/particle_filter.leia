// Particle filter acceptance example using the general scientific stdlib APIs.
// Run:
//   go run ./cmd/leia run examples/scientific/particle_filter.leia

rand.seed(314159)

N := 64
particles := rand.normal_vec(N, 0.0, 0.8)
weights := stats.uniform_weights(N)

measurements := {0.58, 1.05, 1.53, 1.95}
process_sigma := 0.04
sensor_sigma := 0.18

for t := 1; t <= #measurements; t++ {
    noise := rand.normal_vec(N, 0.0, process_sigma)
    particles = linalg.add(particles, noise, 0.50)
    log_weights := stats.log_normal_pdf(particles, measurements[t], sensor_sigma)
    weights = stats.normalize_log_weights(log_weights)

    ess := stats.effective_sample_size(weights)
    if ess < N * 0.6 {
        resampled, uniform_weights, resample_idx := stats.resample(particles, weights, 0.5)
        particles = resampled
        weights = uniform_weights
        assert(#resample_idx == N)
    }
}

estimate := stats.mean(particles)
variance := stats["var"](particles)
spread := stats.std(particles)
last_measurement := measurements[#measurements]
q_checksum := q.eval("+/1 2 3")

assert(math.near(estimate, last_measurement, 0.15))
assert(math.near(spread, math.sqrt(variance), 0.000000001))
assert(spread < 0.35)
assert(q_checksum == 6)

print(string.format("ok particle n=%d estimate=%.3f measurement=%.3f spread=%.3f", N, estimate, last_measurement, spread))
