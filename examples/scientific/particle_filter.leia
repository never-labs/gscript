// Particle filter acceptance example using the general scientific stdlib APIs.
// Run:
//   go run ./cmd/leia run examples/scientific/particle_filter.leia

rand.seed(314159)

N := 64
prior := stats.normal(0.0, 0.8)
process_noise := stats.normal(0.0, 0.04)
sensor_noise := stats.normal(0.0, 0.18)

ensemble := stats.samples(rand.sample(prior, N))
filter := rand.particle_filter(ensemble, {0.58, 1.05, 1.53, 1.95}, {process_noise: process_noise, sensor_noise: sensor_noise, drift: 0.50, min_ess_ratio: 0.6, offset: 0.5, trajectory: true})

ensemble = filter.samples
summary := filter.summary
estimate := summary.mean
variance := summary.variance
spread := summary.std
last_measurement := 1.95
q_value_mean := q {
avg ${ensemble.values}
}

assert(filter.ess > 0)
assert(#filter.states == 4)
assert(math.near(estimate, last_measurement, 0.15))
assert(math.near(spread, math.sqrt(variance), 0.000000001))
assert(spread < 0.35)
assert(math.near(q_value_mean, last_measurement, 0.25))

print(string.format("ok particle n=%d estimate=%.3f measurement=%.3f spread=%.3f", N, estimate, last_measurement, spread))
