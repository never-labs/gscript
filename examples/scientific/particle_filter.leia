// Particle filter acceptance example using the general scientific stdlib APIs.
// Run:
//   go run ./cmd/leia run examples/scientific/particle_filter.leia

rand.seed(314159)

N := 64
prior := stats.normal(0.0, 0.8)
process_noise := stats.normal(0.0, 0.04)
sensor_noise := stats.normal(0.0, 0.18)

particles := rand.sample(prior, N)
weights := stats.uniform_weights(N)

measurements := {0.58, 1.05, 1.53, 1.95}
did_resample := false
ess := 0.0
resample_idx := {}

for t := 1; t <= #measurements; t++ {
    noise := rand.sample(process_noise, N)
    particles = linalg.add(particles, noise, 0.50)
    residual := linalg.sub(particles, measurements[t])
    log_weights := stats.logpdf(sensor_noise, residual)
    particles, weights, did_resample, ess, resample_idx = stats.importance_update(particles, weights, log_weights, {min_ess_ratio: 0.6, offset: 0.5})
    assert(ess > 0)
    if did_resample {
        assert(#resample_idx == N)
    }
}

estimate := stats.mean(particles)
summary := stats.describe(particles)
variance := summary.variance
spread := summary.std
last_measurement := measurements[#measurements]
q_checksum := q {
+/1 2 3
}

assert(math.near(estimate, last_measurement, 0.15))
assert(math.near(spread, math.sqrt(variance), 0.000000001))
assert(spread < 0.35)
assert(q_checksum == 6)

print(string.format("ok particle n=%d estimate=%.3f measurement=%.3f spread=%.3f", N, estimate, last_measurement, spread))
