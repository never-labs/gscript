// Kalman filter acceptance example using the general scientific stdlib APIs.
// Run:
//   go run ./cmd/leia run examples/scientific/kalman_filter.leia

func near(a, b, tol) {
    return math.abs(a - b) <= tol
}

dt := 1.0
F := linalg.matrix({{1.0, dt}, {0.0, 1.0}})
H := linalg.row(1.0, 0.0)
Q := linalg.scale(linalg.eye(2), 0.01)
I := linalg.eye(2)

measurements := {0.95, 2.05, 2.95, 4.10, 5.00}
x := linalg.col(0.0, 1.0)
P := linalg.scale(linalg.eye(2), 1.0)
innovations := {}

for i := 1; i <= #measurements; i++ {
    x_pred := linalg.matmul(F, x)
    P_pred := linalg.add(linalg.matmul(linalg.matmul(F, P), linalg.transpose(F)), Q)

    z := linalg.matrix(1, 1, {measurements[i]})
    y := linalg.sub(z, linalg.matmul(H, x_pred))
    S := linalg.add(linalg.matmul(linalg.matmul(H, P_pred), linalg.transpose(H)), linalg.matrix({{0.04}}))
    K := linalg.transpose(linalg.solve(S, linalg.transpose(linalg.matmul(P_pred, linalg.transpose(H)))))

    x = linalg.add(x_pred, linalg.matmul(K, y))
    P = linalg.matmul(linalg.sub(I, linalg.matmul(K, H)), P_pred)
    innovations[i] = linalg.get(y, 1, 1)
}

innovation_rmse := stats.rms(innovations)
position := linalg.get(x, 1, 1)
velocity := linalg.get(x, 2, 1)
uncertainty_trace := linalg.trace(P)
q_checksum := q.eval("+/1 2 3")

assert(near(position, 5.0, 0.15))
assert(near(velocity, 1.0, 0.15))
assert(innovation_rmse < 0.20)
assert(q_checksum == 6)

print(string.format("ok kalman n=%d position=%.3f velocity=%.3f rmse=%.3f trace=%.4f", #measurements, position, velocity, innovation_rmse, uncertainty_trace))
