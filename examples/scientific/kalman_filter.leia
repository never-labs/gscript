// Kalman filter acceptance example using the general scientific stdlib APIs.
// Run:
//   go run ./cmd/leia run examples/scientific/kalman_filter.leia

dt := 1.0
F := linalg.matrix({{1.0, dt}, {0.0, 1.0}})
H := linalg.row(1.0, 0.0)
Q := linalg.eye(2, 0.01)

measurements := {0.95, 2.05, 2.95, 4.10, 5.00}
initial := stats.gaussian_state(linalg.vector(0.0, 1.0), linalg.eye(2))
filter := stats.linear_filter(initial, measurements, {F: F, H: H, Q: Q, R: 0.04, trajectory: true})
state := filter.state

innovation_rmse := stats.rms(filter.innovations)
position := linalg.at(state.x, 1)
velocity := linalg.at(state.x, 2)
uncertainty_trace := linalg.trace(state.P)
q_state_sum := q {
+/${state.x}
}

assert(math.near(position, 5.0, 0.15))
assert(math.near(velocity, 1.0, 0.15))
assert(innovation_rmse < 0.20)
assert(#filter.states == #measurements)
assert(math.near(q_state_sum, position + velocity, 0.000000001))

print(string.format("ok kalman n=%d position=%.3f velocity=%.3f rmse=%.3f trace=%.4f", #measurements, position, velocity, innovation_rmse, uncertainty_trace))
