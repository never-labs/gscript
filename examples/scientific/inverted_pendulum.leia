// Inverted pendulum acceptance example using the general scientific stdlib APIs.
// Run:
//   go run ./cmd/leia run examples/scientific/inverted_pendulum.leia

g := 9.81
l := 1.0
m := 1.0
dt := 0.01

A := {{0.0, 1.0}, {g / l, 0.0}}
B := {{0.0}, {1.0 / (m * l * l)}}
Q := linalg.diag(12.0, 1.5)
linalg_probe := linalg.matrix(2, 2, {0.0, 1.0, g / l, 0.0})
R := 0.18
K := control.lqr(A, B, Q, R, {iterations: 16000, step: 0.001})
stabilizer := control.policy(K, {limit: 8.0})

state := {0.22, 0.0}

func dynamics(x) {
    theta := control.wrap_angle(x.theta)
    omega := x.omega
    u := control.apply(stabilizer, {theta, omega})
    return {
        theta: omega,
        omega: (g / l) * math.sin(theta) + u / (m * l * l),
    }
}

func observe_energy(x, step, t) {
    return {
        energy: 0.5 * x.omega * x.omega + (g / l) * (1.0 - math.cos(x.theta)),
    }
}

solution := ode.solve(dynamics, state, {dt: dt, steps: 240, trajectory: true, state_names: {"theta", "omega"}, named_state: true, wrap_angles: {"theta"}, observe: observe_energy})
trajectory := solution.trajectory
observed := solution.observed
final_theta := solution.final_state.theta
final_omega := solution.final_state.omega
observed_summary := stats.describe_fields(observed)
energy_summary := observed_summary.energy
mean_energy := energy_summary.mean
peak_energy := energy_summary.max
q_checksum := q {
+/1 2 3
}

assert(math.near(final_theta, 0.0, 0.04))
assert(math.near(final_omega, 0.0, 0.08))
assert(#trajectory == 240)
assert(#observed.theta == 240)
assert(#observed.omega == 240)
assert(peak_energy < 0.25)
assert(linalg.get(linalg_probe, 2, 1) == g / l)
assert(q_checksum == 6)

print(string.format("ok pendulum steps=%d theta=%.4f omega=%.4f mean_energy=%.4f peak_energy=%.4f", 240, final_theta, final_omega, mean_energy, peak_energy))
