// Inverted pendulum acceptance example using the general scientific stdlib APIs.
// Run:
//   go run ./cmd/leia run examples/scientific/inverted_pendulum.leia

func near(a, b, tol) {
    return math.abs(a - b) <= tol
}

g := 9.81
l := 1.0
m := 1.0
dt := 0.01

A := {{0.0, 1.0}, {g / l, 0.0}}
B := {{0.0}, {1.0 / (m * l * l)}}
Q := {{12.0, 0.0}, {0.0, 1.5}}
linalg_probe := linalg.matrix(2, 2, {0.0, 1.0, g / l, 0.0})
R := 0.18
K := control.lqr2(A, B, Q, R, {iterations: 16000, step: 0.001})

state := {0.22, 0.0}
max_abs_theta := math.abs(state[1])
energy := {}

func dynamics(x) {
    theta := control.wrap_angle(x[1])
    omega := x[2]
    u := control.feedback(K, {theta, omega}, {limit: 8.0})
    theta_dot := omega
    omega_dot := (g / l) * math.sin(theta) + u / (m * l * l)
    return {theta_dot, omega_dot}
}

for step := 1; step <= 240; step++ {
    state = ode.rk4(dynamics, state, dt)
    state[1] = control.wrap_angle(state[1])
    max_abs_theta = math.max(max_abs_theta, math.abs(state[1]))
    energy[step] = 0.5 * state[2] * state[2] + (g / l) * (1.0 - math.cos(state[1]))
}

final_theta := state[1]
final_omega := state[2]
mean_energy := stats.mean(energy)
peak_energy := stats.max(energy)
q_checksum := q.eval("+/1 2 3")

assert(near(final_theta, 0.0, 0.04))
assert(near(final_omega, 0.0, 0.08))
assert(max_abs_theta < 0.23)
assert(linalg.get(linalg_probe, 2, 1) == g / l)
assert(q_checksum == 6)

print(string.format("ok pendulum steps=%d theta=%.4f omega=%.4f mean_energy=%.4f peak_energy=%.4f", 240, final_theta, final_omega, mean_energy, peak_energy))
