// Data-oriented design demo: particle integration.
//
// Current runnable path: table/AoS particles using existing Leia syntax.
// Pending backend path: typed-array/SoA columns for x/y/z/vx/vy/vz/mass.

func new_particle(i) {
    f := 1.0 * i
    return {
        x: 0.001 * f,
        y: 0.002 * ((i % 97) + 1),
        z: 0.003 * ((i % 53) + 1),
        vx: 0.01 + 0.00001 * f,
        vy: -0.02 + 0.00002 * (i % 31),
        vz: 0.015 - 0.00001 * (i % 17),
        mass: 0.5 + 0.001 * (i % 23)
    }
}

func make_particles(n) {
    particles := {}
    for i := 1; i <= n; i++ {
        particles[i] = new_particle(i)
    }
    return particles
}

func integrate_aos(particles, n, steps, dt) {
    for step := 1; step <= steps; step++ {
        for i := 1; i <= n; i++ {
            p := particles[i]
            ax := -0.125 * p.x + 0.0003 * p.mass
            ay := -0.125 * p.y + 0.0002 * p.mass
            az := -0.125 * p.z + 0.0001 * p.mass
            p.vx = p.vx + ax * dt
            p.vy = p.vy + ay * dt
            p.vz = p.vz + az * dt
            p.x = p.x + p.vx * dt
            p.y = p.y + p.vy * dt
            p.z = p.z + p.vz * dt
        }
    }
}

func checksum_aos(particles, n) {
    sum := 0.0
    for i := 1; i <= n; i++ {
        p := particles[i]
        weight := (i % 7) + 1
        sum = sum + p.x * weight + p.y * 0.5 + p.z * 0.25 + p.vx * 0.125
    }
    return sum
}

N := 8192
STEPS := 64
DT := 0.016

particles := make_particles(N)

t0 := time.now()
integrate_aos(particles, N, STEPS, DT)
elapsed := time.since(t0)
checksum := checksum_aos(particles, N)

print(string.format("data_oriented_particle_integration layout=table_aos backend=current n=%d steps=%d", N, STEPS))
print(string.format("checksum: %.9f", checksum))
print(string.format("pending_backend: typed_array_soa"))
print(string.format("Time: %.3fs", elapsed))
