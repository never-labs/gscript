// Data-oriented design demo: particle integration over structure-of-arrays.
// Run with:
//   go run ./cmd/leia run examples/data_processing/data_oriented/particle_integration.leia

func make_particles() {
    return soa.zip({
        x: []f64{0.001, 0.002, 0.003, 0.004, 0.005, 0.006, 0.007, 0.008},
        y: []f64{0.004, 0.006, 0.008, 0.010, 0.012, 0.014, 0.016, 0.018},
        z: []f64{0.006, 0.009, 0.012, 0.015, 0.018, 0.021, 0.024, 0.027},
        vx: []f64{0.01001, 0.01002, 0.01003, 0.01004, 0.01005, 0.01006, 0.01007, 0.01008},
        vy: []f64{-0.01998, -0.01996, -0.01994, -0.01992, -0.01990, -0.01988, -0.01986, -0.01984},
        vz: []f64{0.01499, 0.01498, 0.01497, 0.01496, 0.01495, 0.01494, 0.01493, 0.01492},
        mass: []f64{0.501, 0.502, 0.503, 0.504, 0.505, 0.506, 0.507, 0.508},
    })
}

func integrate_soa(particles, steps, dt) {
    n := soa.len(particles)
    for step := 1; step <= steps; step++ {
        for i := 1; i <= n; i++ {
            p := particles[i]
            ax := -0.125 * p.x + 0.0003 * p.mass
            ay := -0.125 * p.y + 0.0002 * p.mass
            az := -0.125 * p.z + 0.0001 * p.mass
            p.vx = p.vx + ax * dt
            p.vy = p.vy + ay * dt
            p.vz = p.vz + az * dt
            p.x = p.x + p.vx * dt
            p.y = p.y + p.vy * dt
            p.z = p.z + p.vz * dt
            particles[i] = p
        }
    }
}

func checksum_soa(particles) {
    sum := 0.0
    for i := 1; i <= soa.len(particles); i++ {
        weight := (i % 7) + 1
        sum = sum + particles.x[i] * weight + particles.y[i] * 0.5 + particles.z[i] * 0.25 + particles.vx[i] * 0.125
    }
    return sum
}

N := 8
STEPS := 64
DT := 0.016

particles := make_particles()
assert(soa.len(particles) == N)
assert(soa.shape(particles).columns[1].dtype == "f64")
assert(particles.mass[8] == 0.508)

t0 := time.now()
integrate_soa(particles, STEPS, DT)
elapsed := time.since(t0)
checksum := checksum_soa(particles)

print(string.format("data_oriented_particle_integration layout=soa backend=current n=%d steps=%d", N, STEPS))
print(string.format("checksum: %.9f", checksum))
print(string.format("Time: %.3fs", elapsed))
