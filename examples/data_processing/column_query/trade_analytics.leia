// Column-query project example: growth operations analytics.
// Run with:
//   go run ./cmd/leia run examples/data_processing/column_query/trade_analytics.leia

// Channel ids:
//   1 search, 2 email, 3 partner, 4 social
// Segment ids:
//   1 smb, 2 midmarket, 3 enterprise
//
// The rows model campaign-day facts exported from a warehouse. Keeping them as
// SoA columns makes the hot numeric operations explicit, while q.query provides
// the project-level analysis shape: filter, group, derive, order, and limit.
campaigns := soa.zip({
    day: []i64{1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5, 5, 6, 6, 6},
    channel_id: []i64{1, 2, 4, 1, 3, 4, 2, 3, 1, 4, 2, 3, 1, 2, 3, 4, 1, 3},
    segment_id: []i64{1, 1, 1, 2, 3, 2, 2, 2, 3, 1, 3, 1, 1, 2, 3, 3, 2, 2},
    spend: []f64{1000, 300, 700, 1200, 900, 800, 350, 750, 1500, 650, 400, 650, 1100, 380, 950, 780, 1250, 820},
    impressions: []f64{50000, 20000, 80000, 42000, 18000, 65000, 21000, 22000, 38000, 70000, 19000, 17000, 52000, 24000, 20000, 66000, 44000, 23000},
    clicks: []f64{2500, 1800, 1600, 2100, 700, 1300, 1600, 900, 1800, 1500, 1300, 650, 2400, 1700, 800, 1000, 2050, 930},
    signups: []f64{190, 220, 100, 150, 60, 90, 180, 85, 120, 115, 140, 70, 210, 170, 65, 70, 160, 90},
    trial_starts: []f64{70, 60, 20, 80, 45, 25, 55, 50, 75, 30, 70, 40, 85, 62, 52, 35, 82, 48},
    paid_conversions: []f64{18, 14, 4, 22, 16, 5, 15, 18, 24, 6, 21, 13, 20, 17, 19, 8, 23, 17},
    revenue: []f64{3600, 2100, 500, 5500, 6400, 900, 3000, 4500, 7200, 800, 6300, 2600, 4100, 3400, 7600, 1600, 5800, 4700},
    support_tickets: []f64{3, 2, 6, 4, 8, 5, 2, 3, 7, 4, 5, 2, 3, 2, 9, 8, 4, 3},
    churn_risk: []f64{0.08, 0.05, 0.18, 0.10, 0.22, 0.25, 0.07, 0.12, 0.20, 0.16, 0.11, 0.09, 0.06, 0.08, 0.27, 0.30, 0.09, 0.10},
})

channel_rollup := q.query(campaigns, {
    by: ["channel_id"],
    select: {
        spend: "spend",
        clicks: "clicks",
        signups: "signups",
        trials: "trial_starts",
        paid: "paid_conversions",
        revenue: "revenue",
        tickets: "support_tickets",
        campaign_days: 1,
    },
    aggregate: {
        spend: "sum",
        clicks: "sum",
        signups: "sum",
        trials: "sum",
        paid: "sum",
        revenue: "sum",
        tickets: "sum",
        campaign_days: "count",
    },
    order_by: {column: "revenue", desc: true},
})

top_campaigns := q.query(campaigns, {
    where: {column: "paid_conversions", op: ">=", value: 15},
    select: {
        day: "day",
        channel_id: "channel_id",
        segment_id: "segment_id",
        paid: "paid_conversions",
        revenue: "revenue",
        roas: ["/", "revenue", "spend"],
    },
    order_by: {column: "roas", desc: true},
    limit: 3,
})

risk_segments := q.query(campaigns, {
    where: soa.mask(campaigns, "churn_risk", ">=", 0.20),
    by: ["channel_id", "segment_id"],
    select: {
        revenue: "revenue",
        tickets: "support_tickets",
        avg_risk: "churn_risk",
        flagged_days: 1,
    },
    aggregate: {
        revenue: "sum",
        tickets: "sum",
        avg_risk: "mean",
        flagged_days: "count",
    },
    order_by: {column: "avg_risk", desc: true},
})

enterprise_cohort := q.query(campaigns, {
    where: {column: "segment_id", op: "==", value: 3},
    by: ["segment_id"],
    select: {
        revenue: "revenue",
        paid: "paid_conversions",
        tickets: "support_tickets",
        days: 1,
    },
    aggregate: {
        revenue: "sum",
        paid: "sum",
        tickets: "sum",
        days: "count",
    },
})

func channel_name(id) {
    if id == 1 {
        return "search"
    }
    if id == 2 {
        return "email"
    }
    if id == 3 {
        return "partner"
    }
    return "social"
}

best_channel := channel_rollup[1]
best_roas := best_channel.revenue / best_channel.spend
for i := 2; i <= #channel_rollup; i++ {
    candidate := channel_rollup[i]
    candidate_roas := candidate.revenue / candidate.spend
    if candidate_roas > best_roas {
        best_channel = candidate
        best_roas = candidate_roas
    }
}

top_campaign := top_campaigns[1]
most_sensitive_risk := risk_segments[1]
enterprise := enterprise_cohort[1]

trade_analytics_summary := string.format(
    "rows=%d channels=%d best_channel=%s roas=%.2f top_day=%d top_roas=%.2f risk_segments=%d enterprise_revenue=%.0f",
    soa.len(campaigns),
    #channel_rollup,
    channel_name(best_channel.channel_id),
    best_roas,
    top_campaign.day,
    top_campaign.roas,
    #risk_segments,
    enterprise.revenue
)

print("channel_rollup_rows", #channel_rollup)
print(string.format("best_channel %s spend=%.0f revenue=%.0f paid=%.0f roas=%.2f",
    channel_name(best_channel.channel_id),
    best_channel.spend,
    best_channel.revenue,
    best_channel.paid,
    best_roas
))
print(string.format("top_campaign day=%d channel=%s segment=%d paid=%.0f roas=%.2f",
    top_campaign.day,
    channel_name(top_campaign.channel_id),
    top_campaign.segment_id,
    top_campaign.paid,
    top_campaign.roas
))
print(string.format("risk_queue segments=%d first_channel=%s first_segment=%d avg_risk=%.2f tickets=%.0f",
    #risk_segments,
    channel_name(most_sensitive_risk.channel_id),
    most_sensitive_risk.segment_id,
    most_sensitive_risk.avg_risk,
    most_sensitive_risk.tickets
))
print(trade_analytics_summary)
