// Package-managed macOS automation example.
//leia:cap macos.automation,process.exec
//
// This file is intentionally a manifest companion, not a runnable osascript
// runtime. AppleScript and macOS automation should be supplied by a package
// adapter declared in leia.mod instead of becoming a built-in dialect or core
// stdlib module.

import macos "github.com/never-labs/leia-macos/automation"

notification := macos.applescript({
    target: "System Events",
    source: "display notification \"Release notes are ready\" with title \"Leia\"",
    timeout_ms: 1000,
    dry_run: true,
})

clipboard_probe := macos.applescript({
    target: "System Events",
    source: "return the clipboard as text",
    timeout_ms: 500,
    dry_run: true,
})

workflow := macos.plan({
    name: "release-note-notification",
    dry_run: true,
    steps: {
        notification,
        clipboard_probe,
        macos.open_url({
            url: "x-apple.systempreferences:com.apple.preference.security?Privacy_Automation",
            dry_run: true,
        }),
    },
})

return workflow
