// supply_chain_audit.leia - Offline release supply-chain audit.
// Demonstrates: JSON lockfile parsing, CSV policy tables, JSONL scanner
// findings, logfmt build metadata, hash fingerprints, and report rendering.

lockfile := dialect.eval("json", `{
  "release": "2026.06.05",
  "dependencies": [
    {"name":"leia-core","version":"0.14.0","license":"MIT","direct":true},
    {"name":"sqlite-adapter","version":"0.3.1","license":"Apache-2.0","direct":true},
    {"name":"chart-renderer","version":"1.4.0","license":"BSD-3-Clause","direct":false},
    {"name":"legacy-xml","version":"0.9.8","license":"GPL-3.0","direct":false},
    {"name":"token-cache","version":"0.8.0","license":"MIT","direct":false},
    {"name":"net-fetcher","version":"2.1.0","license":"MIT","direct":true}
  ]
}`)

license_policy := dialect.eval("csv", `license,allowed,review
MIT,true,none
Apache-2.0,true,none
BSD-3-Clause,true,none
GPL-3.0,false,legal
`, {headers: true})

vulnerabilities := jsonl`{"pkg":"sqlite-adapter","severity":"high","id":"CVE-2026-1001","fixed":"0.3.2"}
{"pkg":"chart-renderer","severity":"medium","id":"CVE-2026-1002","fixed":"1.4.1"}
{"pkg":"legacy-xml","severity":"critical","id":"CVE-2026-1003","fixed":""}
{"pkg":"token-cache","severity":"low","id":"CVE-2026-1004","fixed":"0.8.1"}
`

build_info := logfmt`release=2026.06.05 commit=8f3a2c1 builder=ci-linux-17 provenance=slsa-v1`

func truthy(value) {
    return value == true || value == "true"
}

func severity_weight(severity) {
    if severity == "critical" {
        return 10
    }
    if severity == "high" {
        return 7
    }
    if severity == "medium" {
        return 4
    }
    return 1
}

func policy_for(license) {
    for i := 1; i <= #license_policy; i++ {
        row := license_policy[i]
        if row.license == license {
            return row
        }
    }
    return {license: license, allowed: "false", review: "unknown"}
}

deps := lockfile.dependencies
findings := {}
for i := 1; i <= #deps; i++ {
    dep := deps[i]
    policy := policy_for(dep.license)
    findings[dep.name] = {
        name: dep.name,
        version: dep.version,
        license: dep.license,
        direct: dep.direct,
        allowed: truthy(policy.allowed),
        review: policy.review,
        vulnerabilities: 0,
        max_severity: "none",
        max_weight: 0,
        fix_available: false,
        blocker: !truthy(policy.allowed),
    }
}

for i := 1; i <= #vulnerabilities; i++ {
    vuln := vulnerabilities[i]
    finding := findings[vuln.pkg]
    assert(finding != nil)
    weight := severity_weight(vuln.severity)
    finding.vulnerabilities = finding.vulnerabilities + 1
    finding.fix_available = finding.fix_available || vuln.fixed != ""
    if weight > finding.max_weight {
        finding.max_weight = weight
        finding.max_severity = vuln.severity
    }
    if vuln.severity == "critical" && vuln.fixed == "" {
        finding.blocker = true
    }
    if finding.direct && weight >= severity_weight("high") {
        finding.blocker = true
    }
}

audit_rows := []
direct_count := 0
vuln_count := 0
fixable_count := 0
disallowed_count := 0
blocker_count := 0
risk_score := 0

for i := 1; i <= #deps; i++ {
    dep := deps[i]
    finding := findings[dep.name]
    if finding.direct {
        direct_count = direct_count + 1
    }
    if !finding.allowed {
        disallowed_count = disallowed_count + 1
        risk_score = risk_score + 5
    }
    if finding.vulnerabilities > 0 {
        vuln_count = vuln_count + finding.vulnerabilities
        risk_score = risk_score + finding.max_weight
    }
    if finding.fix_available {
        fixable_count = fixable_count + 1
    }
    if finding.blocker {
        blocker_count = blocker_count + 1
    }
    audit_rows[i] = {
        Package: finding.name,
        Version: finding.version,
        License: finding.license,
        Direct: finding.direct,
        MaxSeverity: finding.max_severity,
        Vulnerabilities: finding.vulnerabilities,
        FixAvailable: finding.fix_available,
        Blocker: finding.blocker,
    }
}

audit_table := dialect.eval("mdtable", audit_rows, {mode: "encode"})
artifact_manifest := dialect.eval("json", {
    release: lockfile.release,
    commit: build_info.commit,
    dependencies: #deps,
    blockers: blocker_count,
    risk_score: risk_score,
}, {mode: "encode"})
artifact_fingerprint := string.sub(dialect.eval("hash", artifact_manifest, {algo: "sha256"}), 1, 12)

release_report := template {
    text: `# Supply Chain Audit

Release: {{.release}}
Commit: {{.commit}}
Dependencies: {{.deps}}
Blockers: {{.blockers}}
Risk score: {{.risk}}
Artifact: {{.artifact}}
`,
    data: {
        release: lockfile.release,
        commit: build_info.commit,
        deps: #deps,
        blockers: blocker_count,
        risk: risk_score,
        artifact: artifact_fingerprint,
    },
}

supply_chain_audit_summary := string.format(
    "release=%s deps=%d direct=%d vulns=%d blockers=%d disallowed=%d fixable=%d risk=%d artifact=%s",
    lockfile.release,
    #deps,
    direct_count,
    vuln_count,
    blocker_count,
    disallowed_count,
    fixable_count,
    risk_score,
    artifact_fingerprint
)

print(audit_table)
print(supply_chain_audit_summary)

assert(#deps == 6)
assert(#vulnerabilities == 4)
assert(direct_count == 3)
assert(vuln_count == 4)
assert(blocker_count == 2)
assert(disallowed_count == 1)
assert(fixable_count == 3)
assert(risk_score == 27)
assert(findings["legacy-xml"].blocker == true)
assert(findings["sqlite-adapter"].blocker == true)
assert(findings["chart-renderer"].blocker == false)
assert(string.find(audit_table, "legacy-xml", 1, true) != nil)
assert(string.find(artifact_manifest, `"blockers":2`, 1, true) != nil)
assert(string.find(release_report, "# Supply Chain Audit", 1, true) != nil)
assert(string.find(supply_chain_audit_summary, "release=2026.06.05 deps=6 direct=3 vulns=4 blockers=2 disallowed=1 fixable=3 risk=27", 1, true) == 1)
