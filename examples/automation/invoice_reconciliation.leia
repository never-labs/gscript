// invoice_reconciliation.leia - Offline accounts-receivable reconciliation.
// Demonstrates: CSV exports, JSONL payment feeds, logfmt bank evidence,
// Markdown policy tables, sorting, JSON manifests, hashes, and templating.

print("=== Automation: invoice reconciliation ===")

invoices := dialect.eval("csv", `invoice,customer,owner,due_age_days,amount_cents
INV-100,Apex Labs,sales,12,120000
INV-101,Beta Health,success,0,45000
INV-102,Cedar Retail,sales,45,75000
INV-103,Delta Foods,success,-5,90000
INV-104,Echo Works,sales,20,33000
`, {headers: true})

payments := jsonl`{"payment":"PAY-1","invoice":"INV-100","amount_cents":120000,"status":"settled"}
{"payment":"PAY-2","invoice":"INV-102","amount_cents":50000,"status":"settled"}
{"payment":"PAY-3","invoice":"INV-999","amount_cents":4000,"status":"settled"}
{"payment":"PAY-4","invoice":"INV-104","amount_cents":33000,"status":"pending"}
{"payment":"PAY-5","invoice":"INV-103","amount_cents":95000,"status":"settled"}
`

bank_events := [
    logfmt`ts=2026-06-05T09:00:00Z payment=PAY-1 source=bank status=posted trace=bnk-100`,
    logfmt`ts=2026-06-05T09:01:00Z payment=PAY-2 source=bank status=posted trace=bnk-102`,
    logfmt`ts=2026-06-05T09:02:00Z payment=PAY-3 source=bank status=posted trace=bnk-999`,
    logfmt`ts=2026-06-05T09:03:00Z payment=PAY-4 source=processor status=authorized trace=bnk-104`,
    logfmt`ts=2026-06-05T09:04:00Z payment=PAY-5 source=bank status=posted trace=bnk-103`,
]

escalation_rules := mdtable`| Severity | Min Age | Action |
| --- | ---: | --- |
| critical | 30 | legal-review |
| warning | 10 | owner-followup |
| current | 0 | monitor |
`

func number_or(value, fallback) {
    parsed := tonumber(value)
    if parsed == nil {
        return fallback
    }
    return parsed
}

func money(cents) {
    return "$" .. string.format("%.2f", cents / 100)
}

func bank_trace(payment_id) {
    for i := 1; i <= #bank_events; i++ {
        event := bank_events[i]
        if event.payment == payment_id {
            return event.trace
        }
    }
    return ""
}

func invoice_by_id(id) {
    for i := 1; i <= #invoices; i++ {
        if invoices[i].invoice == id {
            return invoices[i]
        }
    }
    return nil
}

func severity_for(age, balance) {
    if balance <= 0 || age < 0 {
        return "current", "none"
    }
    for i := 1; i <= #escalation_rules; i++ {
        rule := escalation_rules[i]
        if age >= number_or(rule["Min Age"], 0) {
            return rule.Severity, rule.Action
        }
    }
    return "current", "monitor"
}

applied := {}
pending := {}
exceptions := []

for i := 1; i <= #payments; i++ {
    payment := payments[i]
    amount := number_or(payment.amount_cents, 0)
    invoice := invoice_by_id(payment.invoice)
    if invoice == nil {
        append(exceptions, {
            kind: "unknown-invoice",
            payment: payment.payment,
            invoice: payment.invoice,
            amount: amount,
            trace: bank_trace(payment.payment),
        })
    } else if payment.status == "settled" {
        if applied[payment.invoice] == nil {
            applied[payment.invoice] = 0
        }
        applied[payment.invoice] = applied[payment.invoice] + amount
    } else {
        if pending[payment.invoice] == nil {
            pending[payment.invoice] = 0
        }
        pending[payment.invoice] = pending[payment.invoice] + amount
    }
}

rows := []
owner_balances := {}
total_open := 0
overdue_open := 0
covered_by_pending := 0

for i := 1; i <= #invoices; i++ {
    invoice := invoices[i]
    amount := number_or(invoice.amount_cents, 0)
    settled := applied[invoice.invoice] || 0
    pending_amount := pending[invoice.invoice] || 0
    balance := amount - settled
    age := number_or(invoice.due_age_days, 0)
    severity, action := severity_for(age, balance)

    if balance > 0 {
        total_open = total_open + balance
    }
    if age > 0 && balance > 0 {
        overdue_open = overdue_open + balance
    }
    if pending_amount > 0 && balance > 0 {
        covered_by_pending = covered_by_pending + pending_amount
    }
    if balance < 0 {
        append(exceptions, {
            kind: "overpayment",
            payment: "",
            invoice: invoice.invoice,
            amount: 0 - balance,
            trace: "",
        })
    }
    if owner_balances[invoice.owner] == nil {
        owner_balances[invoice.owner] = 0
    }
    owner_balances[invoice.owner] = owner_balances[invoice.owner] + balance

    append(rows, {
        Invoice: invoice.invoice,
        Customer: invoice.customer,
        Owner: invoice.owner,
        Age: age,
        Amount: money(amount),
        Settled: money(settled),
        Pending: money(pending_amount),
        Balance: money(balance),
        Severity: severity,
        Action: action,
    })
}

table.sort(rows, func(a, b) {
    if a.Severity == b.Severity {
        return a.Invoice < b.Invoice
    }
    score := {critical: 3, warning: 2, current: 1}
    return score[a.Severity] > score[b.Severity]
})

owner_rows := []
for owner, balance := range pairs(owner_balances) {
    append(owner_rows, {owner: owner, balance_cents: balance, balance: money(balance)})
}
table.sort(owner_rows, func(a, b) {
    if a.balance_cents == b.balance_cents {
        return a.owner < b.owner
    }
    return a.balance_cents > b.balance_cents
})

report_table := dialect.eval("mdtable", rows, {mode: "encode"})
exception_jsonl := dialect.eval("jsonl", exceptions, {mode: "encode"})
manifest_json := dialect.eval("json", {
    source: "offline-ar-reconciliation",
    invoices: #invoices,
    payments: #payments,
    exceptions: #exceptions,
    open_cents: total_open,
    overdue_cents: overdue_open,
    pending_cents: covered_by_pending,
}, {mode: "encode"})

summary_logfmt := dialect.eval("logfmt", {
    invoices: #invoices,
    payments: #payments,
    open: total_open,
    overdue: overdue_open,
    pending: covered_by_pending,
    exceptions: #exceptions,
    top_owner: owner_rows[1].owner,
}, {mode: "encode"})

fingerprint := string.sub(dialect.eval("hash", report_table .. exception_jsonl .. manifest_json, {algo: "sha256"}), 1, 16)

invoice_reconciliation_summary := template {
    text: "invoices={{.invoices}} payments={{.payments}} open={{.open}} overdue={{.overdue}} pending={{.pending}} exceptions={{.exceptions}} top_owner={{.owner}} fp={{.fp}}",
    data: {
        invoices: #invoices,
        payments: #payments,
        open: money(total_open),
        overdue: money(overdue_open),
        pending: money(covered_by_pending),
        exceptions: #exceptions,
        owner: owner_rows[1].owner,
        fp: fingerprint,
    },
}

print(report_table)
print(summary_logfmt)
print(exception_jsonl)
print(invoice_reconciliation_summary)

assert(#invoices == 5)
assert(#payments == 5)
assert(#bank_events == 5)
assert(#escalation_rules == 3)
assert(total_open == 103000)
assert(overdue_open == 58000)
assert(covered_by_pending == 33000)
assert(#exceptions == 2)
assert(exceptions[1].kind == "unknown-invoice")
assert(exceptions[1].trace == "bnk-999")
assert(exceptions[2].kind == "overpayment")
assert(rows[1].Invoice == "INV-102")
assert(rows[1].Severity == "critical")
assert(rows[2].Invoice == "INV-104")
assert(rows[2].Severity == "warning")
assert(owner_rows[1].owner == "sales")
assert(owner_rows[1].balance_cents == 58000)
assert(string.find(report_table, "| legal-review | 45 | $750.00 | $250.00 | Cedar Retail | INV-102 | sales | $0.00 | $500.00 | critical |", 1, true) != nil)
assert(string.find(exception_jsonl, `"invoice":"INV-999"`, 1, true) != nil)
assert(string.find(manifest_json, `"open_cents":103000`, 1, true) != nil)
assert(string.find(summary_logfmt, "top_owner=sales", 1, true) != nil)
assert(invoice_reconciliation_summary == "invoices=5 payments=5 open=$1030.00 overdue=$580.00 pending=$330.00 exceptions=2 top_owner=sales fp=" .. fingerprint)

print("invoice reconciliation ok")
