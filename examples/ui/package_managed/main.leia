// Package-managed UI example.
//leia:cap ui.window,ui.input
//
// This file is intentionally a manifest companion, not a runnable UI runtime.
// UI surfaces should be supplied by a package/native adapter declared in
// leia.mod instead of becoming a built-in dialect or core stdlib module.

import ui "github.com/never-labs/leia-ui/raylib"

app := {
    title: "Package-managed UI",
    width: 800,
    height: 450,
    runtime: ui,
}

return app
