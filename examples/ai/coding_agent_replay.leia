model {
    default: "mock-fast"
}

read_file := tool {
    name: "read_file"
    fn: func(path) { return "file:" .. path, nil }
    params: ["path"]
    description: "Read a workspace file."
}

search_text := tool {
    name: "search_text"
    fn: func(query) { return "matches:" .. query, nil }
    params: ["query"]
    description: "Search workspace text."
}

apply_patch := tool {
    name: "apply_patch"
    fn: func(patch) { return "patched", nil }
    params: ["patch"]
    description: "Apply a patch."
}

run_shell := tool {
    name: "run_shell"
    fn: func(command) { return "ran:" .. command, nil }
    params: ["command"]
    description: "Run a shell command."
}

result, err := turn {
    model: "mock-fast"
    messages: [llm.user("Name the repository coding-agent tools.")]
    tools: [read_file, search_text, apply_patch, run_shell]
}

assert(err == nil)
summary := result.text
assert(summary == "Use read_file, search_text, apply_patch, and run_shell.")
