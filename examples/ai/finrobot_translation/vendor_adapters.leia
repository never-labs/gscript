// FR-GAP-013 finance vendor adapter package skeleton.
//
// This is not a provider client and never performs live network calls. It
// records the package boundary FinRobot-style finance adapters need: manifests,
// payload schemas, credential declarations, replay keys, rate-limit metadata,
// and terms metadata for deterministic fixtures.

vendor_adapter_package := {
    name: "finrobot_translation.vendor_adapters"
    version: "FR-GAP-013"
    offline_only: true
    live_network: false
    built_in_api: false
    providers: {
        yahoo: {
            provider: "yahoo"
            display_name: "Yahoo Finance"
            adapter_id: "finance.vendor.yahoo"
            capability: "finance.market_data.history"
            credential: {required: false secret_ref: nil}
            replay_key: "yahoo:chart:ACME:1mo"
            payload_schema: {
                name: "YahooChartPayload"
                required: {"chart.result[0].meta.symbol", "chart.result[0].timestamp", "chart.result[0].indicators.quote[0].close"}
                normalized_schema: "market_price_bar_v1"
            }
            rate_limit: {policy: "fixture-metadata" window_seconds: 60 limit: 120 retry_after_seconds: 1}
            terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}
        }
        finnhub: {
            provider: "finnhub"
            display_name: "Finnhub"
            adapter_id: "finance.vendor.finnhub"
            capability: "finance.company_profile"
            credential: {required: true scheme: "bearer" secret_ref: "env:FINNHUB_TOKEN" redacted: true}
            replay_key: "finnhub:profile2:ACME"
            payload_schema: {
                name: "FinnhubProfilePayload"
                required: {"ticker", "name", "exchange", "finnhubIndustry", "currency"}
                normalized_schema: "company_profile_v1"
            }
            rate_limit: {policy: "fixture-metadata" window_seconds: 60 limit: 60 retry_after_seconds: 0}
            terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}
        }
        fmp: {
            provider: "fmp"
            display_name: "Financial Modeling Prep"
            adapter_id: "finance.vendor.fmp"
            capability: "finance.fundamentals.key_metrics"
            credential: {required: true scheme: "apikey" secret_ref: "env:FMP_API_KEY" redacted: true}
            replay_key: "fmp:key_metrics:ACME:annual"
            payload_schema: {
                name: "FMPKeyMetricsPayload"
                required: {"symbol", "date", "revenuePerShare", "grossProfitMargin", "returnOnInvestedCapital"}
                normalized_schema: "fundamental_metric_row_v1"
            }
            rate_limit: {policy: "fixture-metadata" window_seconds: 86400 limit: 300 retry_after_seconds: 2}
            terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}
        }
        sec: {
            provider: "sec"
            display_name: "SEC EDGAR"
            adapter_id: "finance.vendor.sec"
            capability: "finance.filing.sections"
            credential: {required: false secret_ref: nil}
            replay_key: "sec:companyfacts:ACME:10-K:2025"
            payload_schema: {
                name: "SECFilingPayload"
                required: {"cik", "accession", "form", "filed", "sections.item_1a"}
                normalized_schema: "sec_section_v1"
            }
            rate_limit: {policy: "fixture-metadata" window_seconds: 1 limit: 10 retry_after_seconds: 1}
            terms: {usage: "offline-fixture-only" attribution: "SEC fair-access metadata retained" redistribution: "fixture-only" live_network: false user_agent_required: true}
        }
        earnings: {
            provider: "earnings"
            display_name: "Earnings Call Transcript"
            adapter_id: "finance.vendor.earnings"
            capability: "finance.earnings.transcript"
            credential: {required: false secret_ref: nil}
            replay_key: "earnings:transcript:ACME:2025:Q4"
            payload_schema: {
                name: "EarningsTranscriptPayload"
                required: {"symbol", "fiscal_year", "fiscal_quarter", "segments[0].speaker", "segments[0].text"}
                normalized_schema: "earnings_segment_v1"
            }
            rate_limit: {policy: "fixture-metadata" window_seconds: 60 limit: 30 retry_after_seconds: 0}
            terms: {usage: "offline-fixture-only" attribution: "transcript terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}
        }
        reddit: {
            provider: "reddit"
            display_name: "Reddit"
            adapter_id: "finance.vendor.reddit"
            capability: "finance.social.search"
            credential: {required: true scheme: "oauth" secret_ref: "env:REDDIT_CLIENT_SECRET" redacted: true}
            replay_key: "reddit:search:ACME:sentiment"
            payload_schema: {
                name: "RedditSearchPayload"
                required: {"data.children[0].data.id", "data.children[0].data.title", "data.children[0].data.score", "data.children[0].data.created_utc"}
                normalized_schema: "social_sentiment_record_v1"
            }
            rate_limit: {policy: "fixture-metadata" window_seconds: 600 limit: 600 retry_after_seconds: 0}
            terms: {usage: "offline-fixture-only" attribution: "platform terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}
        }
    }
}

recorded_payload_fixtures := {
    {
        provider: "yahoo"
        replay_key: "yahoo:chart:ACME:1mo"
        captured_at: "2026-06-11T00:00:00Z"
        request: {method: "GET" url: "mock://yahoo/v8/finance/chart/ACME?range=1mo" live_network: false}
        payload: {
            chart: {result: {{
                meta: {symbol: "ACME" currency: "USD" exchangeName: "NMS"}
                timestamp: {1772323200, 1772409600}
                indicators: {quote: {{open: {100.10, 101.80} high: {102.00, 103.70} low: {99.80, 101.20} close: {101.40, 103.20} volume: {1200000, 980000}}}}
            }}}
        }
    }
    {
        provider: "finnhub"
        replay_key: "finnhub:profile2:ACME"
        captured_at: "2026-06-11T00:00:00Z"
        request: {method: "GET" url: "mock://finnhub/api/v1/stock/profile2?symbol=ACME" live_network: false}
        payload: {ticker: "ACME" name: "ACME Corp" exchange: "XNAS" finnhubIndustry: "Industrial Automation" currency: "USD"}
    }
    {
        provider: "fmp"
        replay_key: "fmp:key_metrics:ACME:annual"
        captured_at: "2026-06-11T00:00:00Z"
        request: {method: "GET" url: "mock://fmp/stable/key-metrics/ACME?period=annual" live_network: false}
        payload: {{symbol: "ACME" date: "2025-12-31" revenuePerShare: 42.10 grossProfitMargin: 0.42 returnOnInvestedCapital: 0.18}}
    }
    {
        provider: "sec"
        replay_key: "sec:companyfacts:ACME:10-K:2025"
        captured_at: "2026-06-11T00:00:00Z"
        request: {method: "GET" url: "mock://sec/Archives/edgar/data/acme/10-k.html" live_network: false}
        payload: {cik: "0000000000" accession: "0000000000-26-000001" form: "10-K" filed: "2026-02-20" sections: {item_1a: "Risk factors: supply concentration."}}
    }
    {
        provider: "earnings"
        replay_key: "earnings:transcript:ACME:2025:Q4"
        captured_at: "2026-06-11T00:00:00Z"
        request: {method: "GET" url: "mock://earnings/ACME/2025/Q4/transcript" live_network: false}
        payload: {symbol: "ACME" fiscal_year: "2025" fiscal_quarter: "Q4" segments: {{speaker: "CFO" text: "Free cash flow conversion remained above ninety percent."}}}
    }
    {
        provider: "reddit"
        replay_key: "reddit:search:ACME:sentiment"
        captured_at: "2026-06-11T00:00:00Z"
        request: {method: "GET" url: "mock://reddit/r/investing/search?q=ACME" live_network: false}
        payload: {data: {children: {{data: {id: "r1" title: "ACME backlog watch" score: 42 created_utc: 1772200800}}}}}
    }
}

func vendor_manifest(name) {
    return vendor_adapter_package.providers[name]
}

func recorded_payload(key) {
    for i := 1; i <= #recorded_payload_fixtures; i++ {
        fixture := recorded_payload_fixtures[i]
        if fixture.replay_key == key {
            return fixture
        }
    }
    return nil
}

func require_adapter_metadata(provider) {
    manifest := vendor_manifest(provider)
    if manifest == nil {
        return false
    }
    if manifest.terms.live_network != false || vendor_adapter_package.live_network != false {
        return false
    }
    if manifest.payload_schema.normalized_schema == nil || manifest.rate_limit.limit == nil {
        return false
    }
    return recorded_payload(manifest.replay_key) != nil
}

provider_names := {"yahoo", "finnhub", "fmp", "sec", "earnings", "reddit"}
for i := 1; i <= #provider_names; i++ {
    assert(require_adapter_metadata(provider_names[i]))
}

assert(vendor_adapter_package.offline_only == true)
assert(vendor_adapter_package.built_in_api == false)
assert(vendor_manifest("fmp").credential.secret_ref == "env:FMP_API_KEY")
assert(vendor_manifest("sec").terms.user_agent_required == true)
assert(recorded_payload("reddit:search:ACME:sentiment").payload.data.children[1].data.score == 42)

vendor_adapters_summary := string.format(
"vendor_adapters providers=%d fixtures=%d offline=%s built_in_api=%s fmp_schema=%s reddit_terms=%s",
#provider_names,
#recorded_payload_fixtures,
tostring(vendor_adapter_package.offline_only),
tostring(vendor_adapter_package.built_in_api),
vendor_manifest("fmp").payload_schema.normalized_schema,
vendor_manifest("reddit").terms.usage
)

print(vendor_adapters_summary)
