// Generic agent loop composition.
//
// Shows a provider-free agent loop made from four explicit, reusable contracts:
// generic_agent_runner, generic_turn_runner, generic_tool_contracts, and
// generic_trace_events. All work is local and deterministic.

func check(name, ok) {
    if !ok {
        error("check failed: " .. name)
    }
}

generic_trace_events := {
    id: "generic_trace_events_v1",
    provider_free: true,
    live_network: false,
    live_model: false,
    events: {},
}

func record_generic_trace(kind, component, status, payload) {
    generic_trace_events.events[#generic_trace_events.events + 1] = {
        kind: kind,
        component: component,
        status: status,
        payload: payload,
        provider_free: true,
        live_network: false,
        live_model: false,
    }
    return generic_trace_events.events[#generic_trace_events.events]
}

lookup_context := llm.tool("lookup_context", func(topic) {
    return {
        topic: topic,
        content: "local-context:" .. topic,
        source: "local_fixture",
    }, nil
}, {
    description: "Read deterministic local context for a generic task.",
    params: {"topic"},
    requires: {"local.context.read"},
    result: {type: "object"},
    replay_key: "generic-agent-loop:lookup-context",
})

compose_response := llm.tool("compose_response", func(context, request) {
    return {
        request: request,
        context: context,
        summary: "response:" .. request .. ":" .. context,
        confidence: 1,
    }, nil
}, {
    description: "Compose a deterministic response from local context.",
    params: {"context", "request"},
    requires: {"local.response.compose"},
    result: {type: "object"},
    replay_key: "generic-agent-loop:compose-response",
})

generic_tool_contracts := {
    id: "generic_tool_contracts_v1",
    provider_free: true,
    live_network: false,
    live_model: false,
    tools: {lookup_context, compose_response},
    schemas: llm.tool_schema({lookup_context, compose_response}),
    capabilities: {"local.context.read", "local.response.compose"},
}

func run_generic_turn(turn) {
    record_generic_trace("turn.start", "generic_turn_runner", "ok", {
        step: turn.step,
        input: turn.input,
    })

    if turn.step == 1 {
        call := {
            id: "call_lookup_context_1",
            tool: "lookup_context",
            args: {topic: turn.input},
        }
        record_generic_trace("turn.tool_request", "generic_turn_runner", "ok", {
            tool: call.tool,
            call_id: call.id,
        })
        return {
            status: "tool_request",
            step: turn.step,
            messages: {msg.user(turn.input)},
            calls: {call},
            provider_free: true,
            live_network: false,
            live_model: false,
        }, nil
    }

    call := {
        id: "call_compose_response_1",
        tool: "compose_response",
        args: {
            context: turn.context.content,
            request: turn.input,
        },
    }
    record_generic_trace("turn.tool_request", "generic_turn_runner", "ok", {
        tool: call.tool,
        call_id: call.id,
    })
    return {
        status: "tool_request",
        step: turn.step,
        messages: {msg.user(turn.input), {role: "tool", tool_use_id: call.id, value: turn.context}},
        calls: {call},
        provider_free: true,
        live_network: false,
        live_model: false,
    }, nil
}

generic_turn_runner := {
    id: "generic_turn_runner_v1",
    provider_free: true,
    live_network: false,
    live_model: false,
    max_steps: 2,
    run: run_generic_turn,
}

func run_generic_agent(request) {
    record_generic_trace("agent.start", "generic_agent_runner", "ok", {request: request})

    first_turn, first_err := generic_turn_runner.run({step: 1, input: request})
    if first_err != nil {
        return nil, first_err
    }
    context_value, context_err := llm.dispatch(first_turn.calls[1], generic_tool_contracts.tools)
    if context_err != nil {
        return nil, context_err
    }
    record_generic_trace("tool.dispatch", "generic_tool_contracts", "ok", {
        tool: first_turn.calls[1].tool,
        source: context_value.source,
    })

    second_turn, second_err := generic_turn_runner.run({
        step: 2,
        input: request,
        context: context_value,
    })
    if second_err != nil {
        return nil, second_err
    }
    response_value, response_err := llm.dispatch(second_turn.calls[1], generic_tool_contracts.tools)
    if response_err != nil {
        return nil, response_err
    }
    record_generic_trace("tool.dispatch", "generic_tool_contracts", "ok", {
        tool: second_turn.calls[1].tool,
        summary: response_value.summary,
    })

    result := {
        status: "ok",
        request: request,
        output: response_value,
        turns: {first_turn, second_turn},
        tool_results: {context_value, response_value},
        trace: generic_trace_events.events,
        provider_free: true,
        live_network: false,
        live_model: false,
        live_provider_calls: 0,
    }
    record_generic_trace("agent.done", "generic_agent_runner", result.status, {
        trace_count_before_done: #generic_trace_events.events,
        output_summary: response_value.summary,
    })
    result.trace = generic_trace_events.events
    return result, nil
}

generic_agent_runner := {
    id: "generic_agent_runner_v1",
    provider_free: true,
    live_network: false,
    live_model: false,
    live_provider_calls: 0,
    turn_runner: generic_turn_runner.id,
    tool_contracts: generic_tool_contracts.id,
    trace_events: generic_trace_events.id,
    run: run_generic_agent,
}

agent_loop_result, agent_loop_err := generic_agent_runner.run("compose a launch checklist")
agent_loop_summary := agent_loop_result.output.summary

check("agent loop ok", agent_loop_err == nil && agent_loop_result.status == "ok")
check("runner composition", generic_agent_runner.turn_runner == generic_turn_runner.id && generic_agent_runner.tool_contracts == generic_tool_contracts.id)
check("tool contracts", #generic_tool_contracts.tools == 2 && generic_tool_contracts.schemas[1].name == "lookup_context")
check("turns", #agent_loop_result.turns == 2 && agent_loop_result.turns[1].step == 1 && agent_loop_result.turns[2].step == 2)
check("tool results", #agent_loop_result.tool_results == 2 && agent_loop_result.tool_results[1].source == "local_fixture")
check("trace events", #generic_trace_events.events == 8 && generic_trace_events.events[8].kind == "agent.done")
check("provider-free", agent_loop_result.provider_free == true && agent_loop_result.live_model == false && agent_loop_result.live_provider_calls == 0)
check("summary", agent_loop_summary == "response:compose a launch checklist:local-context:compose a launch checklist")

print("generic_agent_loop_composition", generic_agent_runner.id)
print("turn_runner", generic_turn_runner.id)
print("tool_contracts", generic_tool_contracts.id)
print("trace_events", generic_trace_events.id)
print("ok")

evaluate "generic agent loop provider-free composition" {
    assert(agent_loop_err == nil)
    assert(agent_loop_result.status == "ok")
    assert(generic_agent_runner.id == "generic_agent_runner_v1")
    assert(generic_agent_runner.turn_runner == generic_turn_runner.id)
    assert(generic_agent_runner.tool_contracts == generic_tool_contracts.id)
    assert(generic_agent_runner.trace_events == generic_trace_events.id)
    assert(generic_turn_runner.max_steps == 2)
    assert(#generic_tool_contracts.tools == 2)
    assert(generic_tool_contracts.schemas[1].name == "lookup_context")
    assert(generic_tool_contracts.schemas[2].name == "compose_response")
    assert(#agent_loop_result.turns == 2)
    assert(#agent_loop_result.tool_results == 2)
    assert(#generic_trace_events.events == 8)
    assert(generic_trace_events.events[1].kind == "agent.start")
    assert(generic_trace_events.events[8].kind == "agent.done")
    assert(agent_loop_result.provider_free == true)
    assert(agent_loop_result.live_network == false)
    assert(agent_loop_result.live_model == false)
    assert(agent_loop_result.live_provider_calls == 0)
    assert(agent_loop_summary == "response:compose a launch checklist:local-context:compose a launch checklist")
}
