{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leia.dev/schemas/generic-agent-state-store/trace-correlation-v1.schema.json",
  "title": "Generic Agent Trace Correlation",
  "type": "object",
  "required": [
    "trace_id",
    "event_id",
    "parent_event_id",
    "agent_run_id",
    "session_id",
    "turn_id",
    "checkpoint_key"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_event_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_run_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
