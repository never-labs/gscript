{
  "schema_version": 1,
  "id": "generic-agent-state-store-contract-v1",
  "package_boundary_id": "generic-ai-agent-state-store",
  "provider_free": true,
  "domain_specific": false,
  "live_network": false,
  "live_model": false,
  "credentials_required": false,
  "real_dependency_imports": false,
  "depends_on_q_runtime": false,
  "capabilities": [
    "generic.ai.agent_state.store",
    "generic.ai.agent_state.snapshot",
    "generic.ai.agent_state.session",
    "generic.ai.agent_state.checkpoint",
    "generic.ai.agent_state.input_ref",
    "generic.ai.agent_state.output_ref",
    "generic.ai.agent_state.trace_correlation",
    "generic.ai.agent_state.trace_replay_projection",
    "generic.ai.agent_state.cache_key",
    "generic.ai.agent_state.redaction",
    "generic.ai.agent_state.clean_skip"
  ],
  "state_contract": {
    "required_fields": [
      "agent_run_id",
      "session_id",
      "state_version",
      "resume_token",
      "input_refs",
      "output_refs",
      "trace_correlation",
      "checkpoint",
      "redaction"
    ],
    "resume_token_source": "checkpoint_key",
    "state_version_monotonic": true,
    "raw_inputs_allowed": false,
    "raw_outputs_allowed": false
  },
  "checkpoint_contract": {
    "key_algorithm": "sha256",
    "cache_key_algorithm": "sha256",
    "key_fields": [
      "agent_run_id",
      "session_id",
      "state_version",
      "input_ref_ids",
      "output_ref_ids",
      "trace_id",
      "turn_id"
    ],
    "exclude_fields": [
      "raw_input",
      "raw_output",
      "secret",
      "token",
      "authorization",
      "cookie"
    ],
    "stable_across_replay": true
  },
  "trace_correlation_contract": {
    "required_fields": [
      "trace_id",
      "event_id",
      "agent_run_id",
      "session_id",
      "turn_id",
      "parent_event_id",
      "checkpoint_key"
    ],
    "checkpoint_key_matches_state": true,
    "event_id_unique": true
  },
  "trace_replay_projection_contract": {
    "source": "state_snapshots",
    "target_event_types": [
      "agent_state_checkpoint",
      "agent_state_resume"
    ],
    "required_correlation_fields": [
      "trace_id",
      "event_id",
      "parent_event_id",
      "agent_run_id",
      "session_id",
      "turn_id",
      "checkpoint_key",
      "state_version",
      "resume_token"
    ],
    "replay_match_fields": [
      "agent_run_id",
      "session_id",
      "state_version",
      "checkpoint_key",
      "cache_key"
    ],
    "raw_payloads_allowed": false,
    "secret_values_allowed": false,
    "deterministic_order_required": true
  },
  "redaction_contract": {
    "enabled": true,
    "secret_values_present": false,
    "redacted_fields": [
      "authorization",
      "cookie",
      "api_key",
      "access_token",
      "refresh_token",
      "password"
    ],
    "placeholder": "<redacted>",
    "raw_prompt_stored": false,
    "raw_completion_stored": false
  },
  "adapter_contract": {
    "durable_provider_names_allowed": false,
    "live_dependency_imports_allowed": false,
    "credential_values_allowed": false,
    "clean_skip_required": true,
    "provider_free_replay_required": true
  },
  "acceptance_gates": [
    "manifest boundary is provider-free and has no live network, live model, credential, or core runtime dependency",
    "state snapshots are resumable from checkpoint_key and state_version",
    "input_refs and output_refs carry stable ids, digests, media types, and redacted summaries instead of raw payloads",
    "trace correlation links agent_run_id, session_id, turn_id, event_id, parent_event_id, and checkpoint_key",
    "state trace replay projection emits deterministic checkpoint/resume events without raw payloads or secrets",
    "cache_key and checkpoint_key are deterministic sha256 values and exclude raw input, raw output, and secret-bearing fields",
    "redaction metadata proves secret_values_present=false and uses placeholders for credential-shaped fields",
    "missing durable state adapters produce clean-skip envelopes instead of importing dependencies"
  ]
}
