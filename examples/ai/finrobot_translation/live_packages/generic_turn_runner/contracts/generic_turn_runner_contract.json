{
  "schema_version": 1,
  "id": "generic_turn_runner_contract_v1",
  "provider_free": true,
  "live_network": false,
  "capabilities": [
    {
      "name": "generic.ai.turn.request",
      "schema": "single_turn_request_v1",
      "turn_model": "single_turn",
      "requires_messages": true,
      "requires_response_format": true,
      "requires_replay_key": true
    },
    {
      "name": "ai.turn.execute",
      "schema": "execute_response_envelope_v1",
      "requires_usage": true,
      "requires_error_envelope": true,
      "requires_tool_request_envelope": true,
      "requires_replay_match": true
    }
  ],
  "message_contract": {
    "roles": ["system", "user", "assistant", "tool"],
    "content_types": ["text", "json"],
    "ordered": true,
    "provider_free": true
  },
  "response_format_contract": {
    "modes": ["text", "json_object", "json_schema"],
    "json_schema_required_fields": ["name", "schema", "strict"],
    "provider_free": true
  },
  "usage_contract": {
    "fields": ["input_tokens", "output_tokens", "total_tokens", "source"],
    "source": "fixture",
    "provider_free": true
  },
  "error_contract": {
    "fields": ["code", "message", "retryable", "provider_free"],
    "codes": ["replay_miss", "schema_mismatch", "tool_request_invalid", "provider_unavailable"],
    "provider_free": true
  },
  "tool_request_contract": {
    "schema": "tool_request_envelope_v1",
    "request_only": true,
    "live_execution": false,
    "required_fields": ["tool_call_id", "name", "arguments", "status", "replay"],
    "provider_free": true
  },
  "replay_record_match_contract": {
    "schema": "replay_record_match_v1",
    "match_key": "deterministic_request_hash",
    "canonicalization": ["exclude_request_id", "preserve_message_order", "sort_object_keys", "include_response_format", "include_tool_declarations"],
    "miss_behavior": "clean-skip",
    "provider_free": true,
    "live_network": false
  }
}
