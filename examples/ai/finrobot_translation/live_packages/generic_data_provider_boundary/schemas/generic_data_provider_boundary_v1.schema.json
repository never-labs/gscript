{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic data provider boundary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "live_model_calls",
    "requires_credentials",
    "provider_registry",
    "request_envelopes",
    "response_envelopes",
    "pagination",
    "rate_limits",
    "auth_redaction",
    "cache_retry_policy",
    "provenance",
    "error_envelopes",
    "adapter_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "live_model_calls": {
      "const": false
    },
    "requires_credentials": {
      "const": false
    },
    "provider_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "provider_id",
          "capability",
          "fixture_key",
          "schema_ref",
          "auth_policy",
          "live_network"
        ]
      }
    },
    "request_envelopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "request_id",
          "provider_id",
          "operation",
          "query",
          "fixture_key",
          "replay_key",
          "live_network",
          "real_dependency_imports"
        ]
      }
    },
    "response_envelopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "request_id",
          "status",
          "data",
          "metadata",
          "provenance_ref",
          "error"
        ]
      }
    },
    "pagination": {
      "type": "array"
    },
    "rate_limits": {
      "type": "array"
    },
    "auth_redaction": {
      "type": "array"
    },
    "cache_retry_policy": {
      "type": "array"
    },
    "provenance": {
      "type": "array"
    },
    "error_envelopes": {
      "type": "array"
    },
    "adapter_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "dependency_imported",
          "credential_required",
          "live_network",
          "clean_skip"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "dependency_imported": {
            "const": false
          },
          "credential_required": {
            "type": "boolean"
          },
          "live_network": {
            "const": false
          },
          "clean_skip": {
            "const": true
          }
        }
      }
    }
  }
}
