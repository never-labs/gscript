{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic data provider response envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "response_envelopes",
    "provenance",
    "error_envelopes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "response_envelopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "request_id",
          "status",
          "data",
          "metadata",
          "provenance_ref",
          "error"
        ]
      }
    },
    "provenance": {
      "type": "array"
    },
    "error_envelopes": {
      "type": "array"
    }
  }
}
