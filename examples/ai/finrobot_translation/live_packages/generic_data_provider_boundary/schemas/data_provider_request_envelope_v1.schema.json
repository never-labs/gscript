{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic data provider request envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "request_envelopes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "request_envelopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "request_id",
          "provider_id",
          "operation",
          "query",
          "fixture_key",
          "replay_key",
          "live_network",
          "real_dependency_imports"
        ]
      }
    }
  }
}
