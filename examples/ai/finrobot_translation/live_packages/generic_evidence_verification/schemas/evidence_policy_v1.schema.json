{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leia.dev/schemas/generic-evidence-verification/evidence-policy-v1.schema.json",
  "title": "Generic Evidence Verification Policy",
  "type": "object",
  "required": [
    "policy_id",
    "provider_free",
    "live_network",
    "minimum_source_refs_per_claim",
    "reject_unresolved_refs",
    "requires_source_quote_or_metric",
    "allowed_evidence_kinds",
    "freshness_policy",
    "citation_normalization"
  ],
  "properties": {
    "policy_id": {"type": "string"},
    "provider_free": {"type": "boolean", "const": true},
    "live_network": {"type": "boolean", "const": false},
    "minimum_source_refs_per_claim": {"type": "integer", "minimum": 1},
    "reject_unresolved_refs": {"type": "boolean"},
    "requires_source_quote_or_metric": {"type": "boolean"},
    "allowed_evidence_kinds": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "freshness_policy": {"type": "object"},
    "citation_normalization": {"type": "object"}
  }
}
