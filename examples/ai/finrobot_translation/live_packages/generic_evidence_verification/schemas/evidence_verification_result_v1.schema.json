{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leia.dev/schemas/generic-evidence-verification/evidence-verification-result-v1.schema.json",
  "title": "Generic Evidence Verification Result",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_key",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "live_model_calls",
    "policy",
    "requirement_matrix",
    "claim_records",
    "source_annotations",
    "normalized_citations",
    "freshness_warnings",
    "resolved_refs",
    "unresolved_refs",
    "verification_results",
    "unsupported_claims",
    "evidence_quality_summary",
    "clean_degradation_actions"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "fixture_key": {"type": "string"},
    "provider_free": {"type": "boolean", "const": true},
    "live_network": {"type": "boolean", "const": false},
    "real_dependency_imports": {"type": "boolean", "const": false},
    "live_model_calls": {"type": "boolean", "const": false},
    "policy": {"type": "object"},
    "requirement_matrix": {"type": "object"},
    "claim_records": {"type": "array", "minItems": 1},
    "source_annotations": {"type": "array", "minItems": 1},
    "normalized_citations": {"type": "array"},
    "resolved_refs": {"type": "array"},
    "freshness_warnings": {"type": "array"},
    "unresolved_refs": {"type": "array"},
    "unsupported_claims": {"type": "array"},
    "verification_results": {"type": "array", "minItems": 1},
    "evidence_quality_summary": {"type": "object"},
    "clean_degradation_actions": {"type": "array"}
  }
}
