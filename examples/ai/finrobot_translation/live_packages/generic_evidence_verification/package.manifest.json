{
  "schema_version": 1,
  "id": "generic-evidence-verification",
  "package_name": "leia-generic-ai-evidence-verification",
  "package_boundary_id": "generic-ai-evidence-verification",
  "capability_id": "generic.ai.evidence.verify",
  "version": "0.1.0-skeleton",
  "description": "Provider-free generic AI evidence verification package for claim records, source refs, citation normalization, freshness warnings, unresolved refs, quality summaries, and clean degradation actions.",
  "provider_free": true,
  "domain_specific": false,
  "live_network_default": false,
  "live_model_default": false,
  "real_dependency_import_default": false,
  "depends_on_q_runtime": false,
  "credential_required_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "contract_root": "contracts",
  "entrypoints": {
    "main": "main.leia",
    "contract": "contracts/generic_evidence_verification_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json"
  },
  "schemas": {
    "evidence_policy": "schemas/evidence_policy_v1.schema.json",
    "evidence_requirement_matrix": "schemas/evidence_requirement_matrix_v1.schema.json",
    "citation_normalization": "schemas/citation_normalization_v1.schema.json",
    "evidence_verification_result": "schemas/evidence_verification_result_v1.schema.json",
    "evidence_degradation_action": "schemas/evidence_degradation_action_v1.schema.json"
  },
  "contracts": {
    "contract": "contracts/generic_evidence_verification_contract.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json",
    "evidence_verification": "fixtures/evidence_verification_fixture.json",
    "missing_refs_clean_degradation": "fixtures/evidence_missing_refs_clean_degradation_fixture.json"
  },
  "capabilities": [
    "generic.ai.evidence.verify",
    "generic.ai.evidence.claim_record",
    "generic.ai.evidence.source_ref",
    "generic.ai.evidence.citation_ref",
    "generic.ai.evidence.requirement_matrix",
    "generic.ai.evidence.citation_normalize",
    "generic.ai.evidence.freshness_check",
    "generic.ai.evidence.unresolved_ref",
    "generic.ai.evidence.quality_summary",
    "generic.ai.evidence.clean_degradation"
  ],
  "capability_surfaces": [
    "claim_records",
    "source_annotations",
    "citation_refs",
    "evidence_policy",
    "requirement_matrix",
    "normalized_citations",
    "freshness_warnings",
    "verification_results",
    "clean_degradation_actions"
  ],
  "default_policy": {
    "mode": "fixture_replay",
    "provider_policy": "provider-free",
    "live_network": false,
    "live_model_calls": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "clean_skip_without_dependency": true,
    "fixture_hook": "recorded_generic_evidence_verification_fixture"
  },
  "test_gates": [
    "claim records, source refs, and citation refs decode without provider calls",
    "citation normalization preserves first-seen deterministic order and reports unresolved refs",
    "freshness checks emit warnings from fixture timestamps without live network access",
    "missing required evidence produces clean degradation actions instead of invented claims",
    "evidence quality summaries are deterministic provider-free fixture data"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide built-in leia-generic-ai-evidence-verification handling; this provider-free package boundary owns evidence verification, citation normalization, freshness, unresolved-ref, quality-summary, and clean-degradation contracts."
  }
}
