{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/finrobot/finance_facade/function_fixture_v1.schema.json",
  "title": "FinRobot Finance Facade Function Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "function_id",
    "source_module",
    "provider",
    "capability",
    "symbol",
    "dataset",
    "input",
    "output",
    "fallback",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "function_id": {
      "type": "string",
      "minLength": 1
    },
    "source_module": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "pattern": "^finance\\.facade\\."
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "required": [
        "symbol"
      ]
    },
    "output": {
      "type": "object",
      "required": [
        "fields",
        "source_ref"
      ]
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "selected_provider",
        "attempted",
        "clean_skip_without_dependency"
      ],
      "properties": {
        "order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "selected_provider": {
          "type": "string"
        },
        "attempted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clean_skip_without_dependency": {
          "const": true
        },
        "error_envelope_fixture": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "fixture_key",
        "captured_at",
        "source_schema",
        "source_url_redacted",
        "stale_after_days",
        "replay_ready"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "fixture_key": {
          "type": "string"
        },
        "captured_at": {
          "type": "string"
        },
        "source_schema": {
          "type": "string"
        },
        "source_url_redacted": {
          "type": "boolean"
        },
        "stale_after_days": {
          "type": "integer",
          "minimum": 0
        },
        "replay_ready": {
          "type": "boolean"
        }
      }
    }
  }
}
