{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/finrobot/finance_facade/error_envelope_v1.schema.json",
  "title": "FinRobot Finance Facade Error Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "ok",
    "error_code",
    "provider",
    "retryable",
    "retry_after_seconds",
    "fallback_attempted",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "ok": {
      "const": false
    },
    "error_code": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_after_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "fallback_attempted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "message": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    }
  }
}
