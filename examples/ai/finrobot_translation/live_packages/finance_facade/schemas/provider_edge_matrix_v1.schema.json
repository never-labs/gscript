{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/finrobot/finance_facade/provider_edge_matrix_v1.schema.json",
  "title": "FinRobot Finance Facade Provider Edge Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "dialect",
    "providers",
    "edge_rows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "dialect": {
      "const": "finance_facade.provider_edge_matrix.v1"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "edge_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
