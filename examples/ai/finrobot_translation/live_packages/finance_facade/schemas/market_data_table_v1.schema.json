{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/finrobot/finance_facade/market_data_table_v1.schema.json",
  "title": "FinRobot Finance Facade Market Data Table",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "table_id",
    "dataset",
    "symbol",
    "typed_columns",
    "rows",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "table_id": {
      "const": "market_data_table"
    },
    "dataset": {
      "const": "daily_prices"
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "typed_columns": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "as_of",
          "open",
          "high",
          "low",
          "close",
          "adjusted_close",
          "volume",
          "currency",
          "source_ref"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "as_of": {
            "type": "string"
          },
          "open": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "low": {
            "type": "number"
          },
          "close": {
            "type": "number"
          },
          "adjusted_close": {
            "type": "number"
          },
          "volume": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "fixture_key",
        "captured_at",
        "source_schema",
        "source_url_redacted",
        "stale_after_days",
        "replay_ready"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "fixture_key": {
          "type": "string"
        },
        "captured_at": {
          "type": "string"
        },
        "source_schema": {
          "type": "string"
        },
        "source_url_redacted": {
          "type": "boolean"
        },
        "stale_after_days": {
          "type": "integer",
          "minimum": 0
        },
        "replay_ready": {
          "type": "boolean"
        }
      }
    }
  }
}
