{
  "schema_version": 1,
  "id": "finrobot-finance-facade-live-package",
  "package_name": "leia-finrobot-finance-facade",
  "version": "0.1.0-skeleton",
  "description": "Provider-free live package skeleton for FinRobot finance_data.py and market_data facade contracts.",
  "source_modules": [
    "finrobot/data_source/finance_data.py",
    "finrobot/data_source/market_data.py",
    "finrobot/data_source/market_data_api.py"
  ],
  "provider_free": true,
  "live_network_default": false,
  "real_dependency_import_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "credentials": {
    "required": [],
    "optional": [],
    "secret_env_patterns": [],
    "policy": "No credentials are declared by this skeleton; yfinance, FMP, Finnhub, SEC, and OpenBB credentials belong only to future provider-specific packages."
  },
  "default_policy": {
    "mode": "fixture_replay",
    "live_network": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "clean_skip_without_dependency": true,
    "fixture_hook": "recorded_finance_facade_live_fixture"
  },
  "entrypoints": {
    "smoke": "main.leia",
    "finance_facade_contract": "contracts/finance_facade_contract.json",
    "provider_fallback_contract": "contracts/provider_fallback_contract.json",
    "provider_edge_matrix_contract": "contracts/provider_edge_matrix_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json"
  },
  "schemas": {
    "market_data_table": "schemas/market_data_table_v1.schema.json",
    "fundamental_table": "schemas/fundamental_table_v1.schema.json",
    "function_fixture": "schemas/function_fixture_v1.schema.json",
    "provider_fallback": "schemas/provider_fallback_v1.schema.json",
    "provider_edge_matrix": "schemas/provider_edge_matrix_v1.schema.json",
    "error_envelope": "schemas/error_envelope_v1.schema.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json",
    "market_data_table": "fixtures/market_data_ACME_daily_fixture.json",
    "fundamental_table": "fixtures/fundamentals_ACME_annual_fixture.json",
    "fmp_enterprise_value": "fixtures/function_fmp_enterprise_value_ACME_fixture.json",
    "fmp_ratios_key_metrics": "fixtures/function_fmp_key_metrics_ACME_fixture.json",
    "fmp_ratings": "fixtures/function_fmp_ratings_ACME_fixture.json",
    "fmp_targets": "fixtures/function_fmp_targets_ACME_fixture.json",
    "fmp_technical_indicators": "fixtures/function_fmp_technical_indicators_ACME_fixture.json",
    "fmp_company_profile": "fixtures/function_fmp_company_profile_ACME_fixture.json",
    "yfinance_company_profile": "fixtures/function_yfinance_company_profile_ACME_fixture.json",
    "yfinance_market_cap": "fixtures/function_yfinance_market_cap_ACME_fixture.json",
    "provider_fallback_order": "fixtures/function_fallback_order_ACME_fixture.json",
    "provider_edge_matrix": "fixtures/provider_edge_matrix_fixture.json",
    "error_envelope": "fixtures/error_envelope_yfinance_rate_limit_fixture.json"
  },
  "modules": [
    {
      "id": "finance_data",
      "source_module": "finrobot/data_source/finance_data.py",
      "capabilities": [
        "finance.facade.profile.fetch",
        "finance.facade.fundamentals.fetch",
        "finance.facade.financials.fetch",
        "finance.facade.provenance.attach",
        "finance.facade.error.envelope"
      ],
      "output_schemas": [
        "fundamental_table",
        "error_envelope"
      ]
    },
    {
      "id": "market_data",
      "source_module": "finrobot/data_source/market_data.py",
      "capabilities": [
        "finance.facade.market_data.fetch",
        "finance.facade.market_data.table",
        "finance.facade.provider.fallback",
        "finance.facade.cache.read_through",
        "finance.facade.rate_limit.apply",
        "finance.facade.retry.backoff"
      ],
      "output_schemas": [
        "market_data_table",
        "provider_fallback",
        "error_envelope"
      ]
    },
    {
      "id": "market_data_api",
      "source_module": "finrobot/data_source/market_data_api.py",
      "capabilities": [
        "finance.facade.fmp.enterprise_value.fetch",
        "finance.facade.fmp.ratios_key_metrics.fetch",
        "finance.facade.fmp.ratings.fetch",
        "finance.facade.fmp.targets.fetch",
        "finance.facade.fmp.technical_indicators.fetch",
        "finance.facade.fmp.company_profile.fetch",
        "finance.facade.yfinance.company_profile.fetch",
        "finance.facade.yfinance.market_cap.fetch",
        "finance.facade.provider.fallback.resolve",
        "finance.facade.error.envelope"
      ],
      "output_schemas": [
        "function_fixture",
        "provider_fallback",
        "error_envelope"
      ]
    }
  ],
