{
  "schema_version": 1,
  "id": "finrobot-chart-renderer-live-package",
  "package_name": "leia-finrobot-chart-renderer",
  "version": "0.1.0-skeleton",
  "description": "Provider-free live package skeleton for FinRobot charting, chart_generator, enhanced_chart_generator, and mplfinance-style rendering contracts.",
  "source_modules": [
    "finrobot/charting.py",
    "finrobot/chart_generator.py",
    "finrobot/enhanced_chart_generator.py",
    "mplfinance"
  ],
  "provider_free": true,
  "live_network_default": false,
  "real_dependency_import_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "credentials": {
    "required": [],
    "optional": [],
    "secret_env_patterns": [],
    "policy": "No credentials are declared by this skeleton; market data, image storage, browser rendering, matplotlib, mplfinance, and notebook display dependencies belong only to future provider-specific packages."
  },
  "default_policy": {
    "mode": "fixture_replay",
    "live_network": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "clean_skip_without_dependency": true,
    "fixture_hook": "recorded_chart_renderer_live_fixture"
  },
  "entrypoints": {
    "smoke": "main.leia",
    "chart_renderer_contract": "contracts/chart_renderer_contract.json",
    "unsupported_renderer_contract": "contracts/unsupported_renderer_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json"
  },
  "schemas": {
    "chart_spec": "schemas/chart_spec_v1.schema.json",
    "render_request": "schemas/render_request_v1.schema.json",
    "render_result": "schemas/render_result_v1.schema.json",
    "source_metadata": "schemas/source_metadata_v1.schema.json",
    "renderer_skip": "schemas/renderer_skip_v1.schema.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json",
    "chart_spec": "fixtures/chart_spec_ACME_candlestick_fixture.json",
    "render_request": "fixtures/render_request_ACME_candlestick_fixture.json",
    "render_result": "fixtures/render_result_ACME_candlestick_snapshot_fixture.json",
    "unsupported_renderer": "fixtures/unsupported_renderer_clean_skip_fixture.json"
  },
  "modules": [
    {
      "id": "charting",
      "source_module": "finrobot/charting.py",
      "capabilities": [
        "finance.chart_renderer.spec.compose",
        "finance.chart_renderer.source_metadata.attach",
        "finance.chart_renderer.stale_data.warn",
        "finance.chart_renderer.theme.apply"
      ],
      "output_schemas": [
        "chart_spec",
        "source_metadata"
      ]
    },
    {
      "id": "chart_generator",
      "source_module": "finrobot/chart_generator.py",
      "capabilities": [
        "finance.chart_renderer.request.build",
        "finance.chart_renderer.ohlcv.validate",
        "finance.chart_renderer.dimensions.normalize",
        "finance.chart_renderer.snapshot.hash"
      ],
      "output_schemas": [
        "render_request",
        "render_result"
      ]
    },
    {
      "id": "enhanced_chart_generator",
      "source_module": "finrobot/enhanced_chart_generator.py",
      "capabilities": [
        "finance.chart_renderer.indicator.overlay",
        "finance.chart_renderer.multi_panel.layout",
        "finance.chart_renderer.annotation.layer",
        "finance.chart_renderer.result.envelope"
      ],
      "output_schemas": [
        "chart_spec",
        "render_result"
      ]
    },
    {
      "id": "mplfinance_adapter",
      "source_module": "mplfinance",
      "capabilities": [
        "finance.chart_renderer.renderer.mplfinance",
        "finance.chart_renderer.renderer.unsupported_skip",
        "finance.chart_renderer.provider.clean_skip",
        "finance.chart_renderer.dependency.boundary"
      ],
      "output_schemas": [
        "render_result",
        "renderer_skip"
      ]
    }
  ],
  "renderer_boundaries": [
    {
      "id": "mplfinance",
      "capability": "finance.chart_renderer.renderer.mplfinance",
      "fixture_key": "render:ACME:candlestick:mplfinance:offline",
      "schema": "render_result",
      "live_network": false,
      "dependency_imported": false,
      "credential_required": false,
      "clean_skip": true
    },
    {
      "id": "matplotlib",
      "capability": "finance.chart_renderer.renderer.matplotlib",
      "fixture_key": "render:ACME:line:matplotlib:offline",
      "schema": "render_result",
      "live_network": false,
      "dependency_imported": false,
      "credential_required": false,
      "clean_skip": true
    },
    {
      "id": "unsupported",
      "capability": "finance.chart_renderer.renderer.unsupported_skip",
      "fixture_key": "skip:renderer:plotly:offline",
      "schema": "renderer_skip",
      "live_network": false,
      "dependency_imported": false,
      "credential_required": false,
      "clean_skip": true
    }
  ],
  "test_gates": [
    "manifest and referenced JSON files decode without external dependencies",
    "provider_free is true and live_network_default is false",
    "chart spec schema covers symbol, chart type, OHLCV series, indicators, dimensions, theme, and source metadata",
    "render request/result envelopes include renderer, dimensions, theme, snapshot hash, warnings, and source metadata",
    "stale-data warnings are explicit and deterministic in provider-free fixtures",
    "unsupported renderer requests return a clean skip envelope without importing live renderer dependencies",
    "main.leia contains no live provider SDK imports, network execution, q/runtime usage, or chart renderer dependency imports"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide FinRobot chart renderers, mplfinance adapters, image snapshots, or chart data providers as built-ins; future external packages must satisfy these provider-free contracts before enabling renderer dependencies or live network access."
  }
}
