{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leia.dev/schemas/finrobot/chart_renderer/chart_spec_v1.schema.json",
  "title": "FinRobot chart spec v1",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "chart_id",
    "symbol",
    "chart_type",
    "series",
    "dimensions",
    "theme",
    "source_metadata",
    "stale_data_warning"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "chart_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "chart_type": {
      "enum": [
        "candlestick",
        "ohlc",
        "line",
        "bar",
        "volume"
      ]
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "date",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ]
      }
    },
    "indicators": {
      "type": "array"
    },
    "dimensions": {
      "type": "object",
      "required": [
        "width",
        "height",
        "dpi"
      ]
    },
    "theme": {
      "type": "object",
      "required": [
        "name",
        "background",
        "up_color",
        "down_color"
      ]
    },
    "source_metadata": {
      "$ref": "source_metadata_v1.schema.json"
    },
    "stale_data_warning": {
      "type": "object",
      "required": [
        "required",
        "warning_code",
        "message"
      ]
    }
  }
}
