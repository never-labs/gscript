{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leia.dev/schemas/finrobot/chart_renderer/chart_recipe_matrix_v1.schema.json",
  "title": "FinRobot chart recipe semantic matrix v1",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "dialect",
    "recipes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "dialect": {
      "type": "string"
    },
    "recipes": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "recipe_id",
          "semantic_family",
          "chart_type",
          "title",
          "metrics",
          "encoding",
          "chart_spec",
          "snapshot"
        ]
      }
    }
  }
}
