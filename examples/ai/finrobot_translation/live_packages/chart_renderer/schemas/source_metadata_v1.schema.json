{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leia.dev/schemas/finrobot/chart_renderer/source_metadata_v1.schema.json",
  "title": "FinRobot chart renderer source metadata v1",
  "type": "object",
  "required": [
    "provider_free",
    "live_network",
    "provider",
    "fixture_key",
    "captured_at",
    "as_of",
    "source_schema",
    "source_url_redacted",
    "stale_after_days",
    "is_stale",
    "replay_ready"
  ],
  "properties": {
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "provider": {
      "type": "string"
    },
    "fixture_key": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "as_of": {
      "type": "string"
    },
    "source_schema": {
      "type": "string"
    },
    "source_url_redacted": {
      "type": "boolean"
    },
    "stale_after_days": {
      "type": "integer",
      "minimum": 0
    },
    "is_stale": {
      "type": "boolean"
    },
    "replay_ready": {
      "type": "boolean"
    }
  }
}
