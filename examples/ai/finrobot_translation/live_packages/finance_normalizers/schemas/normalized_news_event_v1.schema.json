{
  "schema_version": 1,
  "id": "normalized_news_event_v1",
  "domain": "news",
  "description": "Canonical market news event without live news providers.",
  "required": [
    "schema",
    "symbol",
    "headline",
    "published_at",
    "source_name",
    "url",
    "summary",
    "sentiment",
    "as_of",
    "stale_after_days",
    "stale",
    "source_id",
    "record_hash"
  ],
  "canonical_fields": [
    "schema",
    "symbol",
    "headline",
    "published_at",
    "source_name",
    "url",
    "summary",
    "sentiment",
    "as_of",
    "stale_after_days",
    "stale",
    "missing_reason",
    "source_id",
    "record_hash"
  ],
  "deterministic_order": [
    "published_at",
    "source_id",
    "headline"
  ],
  "missing_required_policy": "reject_record",
  "missing_optional_policy": "emit_null_with_missing_reason",
  "provider_free": true
}
