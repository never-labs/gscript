{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leia://generic-ai/transcript/chunk/v1",
  "title": "Generic transcript chunk",
  "type": "object",
  "required": [
    "provider_free",
    "live_network",
    "fixture_key",
    "source_id",
    "event_id",
    "chunk_id",
    "chunk_index",
    "segment_ids",
    "token_estimate",
    "text",
    "provenance"
  ],
  "properties": {
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "fixture_key": {"type": "string"},
    "source_id": {"type": "string"},
    "event_id": {"type": "string"},
    "chunk_id": {"type": "string"},
    "chunk_index": {"type": "integer"},
    "segment_ids": {"type": "array", "items": {"type": "string"}},
    "token_estimate": {"type": "integer"},
    "text": {"type": "string"},
    "overlap_from_previous": {"type": "integer"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
