generic_transcript_pipeline_live_package := {
    id: "generic-transcript-pipeline"
    package_name: "leia-generic-ai-transcript-pipeline"
    capability: "generic.ai.transcript.pipeline"
    entrypoint: "ai.transcript.pipeline"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    live_model_calls: false
    source_envelopes: 1
    speakers: 3
    segments: 4
    event_time_policies: 1
    chunks: 2
    provenance_records: 4
    clean_skip_adapters: 3
}

assert(generic_transcript_pipeline_live_package.provider_free)
assert(!generic_transcript_pipeline_live_package.live_network)
assert(!generic_transcript_pipeline_live_package.real_dependency_imports)
assert(!generic_transcript_pipeline_live_package.live_model_calls)
assert(generic_transcript_pipeline_live_package.segments == 4)
assert(generic_transcript_pipeline_live_package.chunks == 2)

generic_transcript_pipeline_live_package_summary := string.format(
"generic_transcript_pipeline_live_package capability=%s entrypoint=%s sources=%d speakers=%d segments=%d event_time_policies=%d chunks=%d provenance=%d clean_skip=%d provider_free=%s live_network=%s imports=%s model_calls=%s",
generic_transcript_pipeline_live_package.capability,
generic_transcript_pipeline_live_package.entrypoint,
generic_transcript_pipeline_live_package.source_envelopes,
generic_transcript_pipeline_live_package.speakers,
generic_transcript_pipeline_live_package.segments,
generic_transcript_pipeline_live_package.event_time_policies,
generic_transcript_pipeline_live_package.chunks,
generic_transcript_pipeline_live_package.provenance_records,
generic_transcript_pipeline_live_package.clean_skip_adapters,
tostring(generic_transcript_pipeline_live_package.provider_free),
tostring(generic_transcript_pipeline_live_package.live_network),
tostring(generic_transcript_pipeline_live_package.real_dependency_imports),
tostring(generic_transcript_pipeline_live_package.live_model_calls))

print(generic_transcript_pipeline_live_package_summary)
