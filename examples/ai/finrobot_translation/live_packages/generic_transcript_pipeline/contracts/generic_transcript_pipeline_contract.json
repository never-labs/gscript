{
  "schema_version": 1,
  "id": "generic-transcript-pipeline-contract",
  "package_id": "generic-transcript-pipeline",
  "capability_id": "generic.ai.transcript.pipeline",
  "provider_free": true,
  "domain_specific": false,
  "live_network": false,
  "real_dependency_imports": false,
  "depends_on_q_runtime": false,
  "field_contracts": {
    "source_envelope": {
      "schema": "schemas/transcript_source_envelope_v1.schema.json",
      "fixture": "fixtures/transcript_source_envelope_fixture.json",
      "required_fields": [
        "provider_free",
        "live_network",
        "fixture_key",
        "source_id",
        "source_ref",
        "source_type",
        "event_id",
        "event_time",
        "language",
        "timezone",
        "raw_turns"
      ]
    },
    "segment": {
      "schema": "schemas/transcript_segment_v1.schema.json",
      "fixture": "fixtures/transcript_segments_fixture.json",
      "required_fields": [
        "provider_free",
        "live_network",
        "fixture_key",
        "source_id",
        "event_id",
        "segment_id",
        "turn_index",
        "speaker_raw",
        "speaker_label",
        "speaker_role",
        "text",
        "provenance"
      ]
    },
    "chunk": {
      "schema": "schemas/transcript_chunk_v1.schema.json",
      "fixture": "fixtures/transcript_chunks_fixture.json",
      "required_fields": [
        "provider_free",
        "live_network",
        "fixture_key",
        "source_id",
        "event_id",
        "chunk_id",
        "chunk_index",
        "segment_ids",
        "token_estimate",
        "text",
        "provenance"
      ]
    },
    "clean_skip": {
      "schema": "schemas/transcript_clean_skip_v1.schema.json",
      "fixture": "fixtures/transcript_clean_skip_fixture.json",
      "required_fields": [
        "provider_free",
        "live_network",
        "fixture_key",
        "skip_code",
        "dependency",
        "adapter",
        "reason",
        "recoverable"
      ]
    }
  },
  "acceptance_gates": [
    "source envelope fixtures carry source_id, event_id, source_ref, source_type, language, timezone, and raw turns",
    "segment fixtures prove speaker alias normalization and stable turn order",
    "chunk fixtures prove deterministic chunk order, segment boundary preservation, and token budgets",
    "clean-skip fixtures cover unavailable speech, diarization, and remote-source adapters",
    "all fixtures remain provider-free, offline, and independent of host runtime internals"
  ]
}
