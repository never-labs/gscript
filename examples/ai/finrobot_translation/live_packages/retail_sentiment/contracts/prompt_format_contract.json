{
  "schema_version": 1,
  "id": "finrobot-retail-sentiment-prompt-format-contract",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "prompt_sections": [
    {
      "id": "source_snapshot_summary",
      "required_fields": [
        "source_id",
        "platform",
        "as_of",
        "observed_window",
        "pagination_metadata",
        "metrics",
        "normalization",
        "source_terms",
        "auth_redaction",
        "redaction",
        "stale_snapshot_warning"
      ]
    },
    {
      "id": "sentiment_aggregate_summary",
      "required_fields": [
        "aggregate_score",
        "mention_volume",
        "platform_weights",
        "source_snapshot_refs",
        "normalization",
        "redaction_summary",
        "stale_snapshot_warning"
      ]
    }
  ],
  "prompt_envelope": {
    "id": "retail_sentiment_prompt_envelope_v1",
    "required_top_level_fields": [
      "ticker",
      "as_of",
      "provider_free",
      "live_network",
      "source_snapshot_summary",
      "sentiment_aggregate_summary",
      "redaction_summary",
      "stale_snapshot_warning"
    ],
    "render_order": [
      "ticker",
      "as_of",
      "source_snapshot_summary",
      "sentiment_aggregate_summary",
      "source_terms",
      "stale_snapshot_warning"
    ],
    "provider_free_required": true,
    "live_network_required": false,
    "redacted_only": true
  },
  "forbidden_prompt_fields": [
    "raw_user_handle",
    "raw_url",
    "access_token",
    "cookie",
    "authorization_header"
  ],
  "format_rules": [
    "render only redacted display handles and redacted fixture URIs",
    "render pagination metadata only with redacted cursors and raw_cursor_removed=true",
    "render normalized sentiment labels and normalized categories, not provider-specific raw categories",
    "render auth redaction status without tokens, cookies, or authorization header values",
    "include source terms metadata next to each platform contribution",
    "include stale snapshot warning text whenever stale_snapshot_warning.is_stale is true",
    "omit provider SDK names from prompt instructions except as source metadata labels"
  ]
}
