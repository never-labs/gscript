{
  "schema_version": 1,
  "policy_id": "retail_sentiment_redaction_v1",
  "provider_free": true,
  "live_network": false,
  "raw_identifiers_allowed": false,
  "raw_urls_allowed": false,
  "secret_material_allowed": false,
  "forbidden_fields": [
    "raw_user_handle",
    "raw_url",
    "access_token",
    "cookie",
    "authorization_header"
  ],
  "replacement_fields": [
    "display_handle",
    "redacted_uri",
    "fixture_key"
  ],
  "prompt_safe": true
}
