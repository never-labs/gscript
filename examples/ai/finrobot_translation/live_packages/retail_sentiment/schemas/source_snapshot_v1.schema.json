{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/finrobot/retail_sentiment/source_snapshot_v1.schema.json",
  "title": "FinRobotRetailSentimentSourceSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_key",
    "provider_free",
    "live_network",
    "ticker",
    "as_of",
    "observed_window",
    "source_snapshots"
  ],
  "properties": {
    "fixture_key": {"type": "string"},
    "provider_free": {"type": "boolean", "const": true},
    "live_network": {"type": "boolean", "const": false},
    "ticker": {"type": "string"},
    "as_of": {"type": "string", "format": "date-time"},
    "observed_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "platform",
          "fixture_key",
          "as_of",
          "metrics",
          "redaction",
          "source_terms",
          "stale_snapshot_warning"
        ],
        "properties": {
          "source_id": {"type": "string"},
          "platform": {"type": "string", "enum": ["adanos", "reddit", "x_social", "polymarket"]},
          "fixture_key": {"type": "string"},
          "as_of": {"type": "string", "format": "date-time"},
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sentiment_score", "mention_volume", "bullish_ratio", "bearish_ratio", "confidence"],
            "properties": {
              "sentiment_score": {"type": "number", "minimum": -1, "maximum": 1},
              "mention_volume": {"type": "integer", "minimum": 0},
              "bullish_ratio": {"type": "number", "minimum": 0, "maximum": 1},
              "bearish_ratio": {"type": "number", "minimum": 0, "maximum": 1},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "redaction": {"$ref": "redaction_policy_v1.schema.json#/$defs/redaction_result"},
          "source_terms": {"$ref": "terms_metadata_v1.schema.json"},
          "stale_snapshot_warning": {
            "type": "object",
            "additionalProperties": false,
            "required": ["is_stale", "stale_after_days", "message"],
            "properties": {
              "is_stale": {"type": "boolean"},
              "stale_after_days": {"type": "integer", "minimum": 0},
              "message": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
