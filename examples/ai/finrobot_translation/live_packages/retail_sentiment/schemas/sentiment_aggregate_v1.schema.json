{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/finrobot/retail_sentiment/sentiment_aggregate_v1.schema.json",
  "title": "FinRobotRetailSentimentAggregateV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_key",
    "provider_free",
    "live_network",
    "ticker",
    "as_of",
    "aggregate_score",
    "mention_volume",
    "bullish_ratio",
    "bearish_ratio",
    "platform_weights",
    "source_snapshot_refs",
    "redaction_summary",
    "stale_snapshot_warning"
  ],
  "properties": {
    "fixture_key": {"type": "string"},
    "provider_free": {"type": "boolean", "const": true},
    "live_network": {"type": "boolean", "const": false},
    "ticker": {"type": "string"},
    "as_of": {"type": "string", "format": "date-time"},
    "aggregate_score": {"type": "number", "minimum": -1, "maximum": 1},
    "mention_volume": {"type": "integer", "minimum": 0},
    "bullish_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "bearish_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "neutral_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "platform_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adanos", "reddit", "x_social", "polymarket"],
      "properties": {
        "adanos": {"type": "number", "minimum": 0, "maximum": 1},
        "reddit": {"type": "number", "minimum": 0, "maximum": 1},
        "x_social": {"type": "number", "minimum": 0, "maximum": 1},
        "polymarket": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "source_snapshot_refs": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string"}
    },
    "redaction_summary": {"$ref": "redaction_policy_v1.schema.json#/$defs/redaction_summary"},
    "stale_snapshot_warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_stale", "stale_after_days", "message"],
      "properties": {
        "is_stale": {"type": "boolean"},
        "stale_after_days": {"type": "integer", "minimum": 0},
        "message": {"type": "string"}
      }
    },
    "normalization": {"type": "object"}
  }
}
