{
  "schema_version": 1,
  "id": "generic-chart-render-contracts",
  "package_name": "leia-generic-ai-chart-render-contracts",
  "package_boundary_id": "generic-ai-chart-render-contracts",
  "capability_id": "generic.ai.chart.render.contracts",
  "version": "0.1.0-skeleton",
  "description": "Provider-free generic AI package for chart specs, recipe semantic matrices, render request/result envelopes, source metadata, deterministic snapshot hashes, and unsupported renderer clean skips.",
  "provider_free": true,
  "domain_specific": false,
  "live_network_default": false,
  "live_model_default": false,
  "real_dependency_import_default": false,
  "depends_on_q_runtime": false,
  "credential_required_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "contract_root": "contracts",
  "entrypoints": {
    "main": "main.leia",
    "contract": "contracts/generic_chart_render_contracts_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json"
  },
  "schemas": {
    "chart_render_contracts": "schemas/generic_chart_render_contracts_v1.schema.json"
  },
  "contracts": {
    "contract": "contracts/generic_chart_render_contracts_contract.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json",
    "chart_render_contracts": "fixtures/generic_chart_render_contracts_fixture.json"
  },
  "capabilities": [
    "generic.ai.chart.render.contracts",
    "generic.ai.chart.spec",
    "generic.ai.chart.recipe.matrix",
    "generic.ai.chart.render.request",
    "generic.ai.chart.render.result",
    "generic.ai.chart.source.metadata",
    "generic.ai.chart.snapshot.hash",
    "generic.ai.chart.renderer.clean_skip",
    "generic.ai.chart.unsupported_renderer"
  ],
  "capability_surfaces": [
    "chart_spec",
    "recipe_matrix",
    "render_request",
    "render_result",
    "source_metadata",
    "snapshot_hash",
    "renderer_clean_skip"
  ],
  "default_policy": {
    "mode": "fixture_replay",
    "provider_policy": "provider-free",
    "live_network": false,
    "live_model_calls": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "renderer_dependency_default": "clean_skip",
    "clean_skip_without_dependency": true,
    "fixture_hook": "recorded_generic_chart_render_contracts_fixture"
  },
  "test_gates": [
    "chart spec and recipe matrix contract fixtures decode without renderer dependencies",
    "render request/result contract envelopes are deterministic provider-free fixture data",
    "source metadata contract is redacted and replay-ready",
    "snapshot hash contract values are deterministic fixture values",
    "unsupported renderer contract paths produce clean-skip envelopes"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide built-in leia-generic-ai-chart-render-contracts rendering, chart engines, image snapshots, or data providers; this provider-free package boundary owns chart spec, recipe, render request/result, source metadata, snapshot hash, and renderer clean-skip contracts."
  }
}
