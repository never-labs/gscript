{
  "schema_version": 1,
  "id": "generic-tool-descriptor-schema",
  "provider_free": true,
  "domain": "generic_ai_tool_registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_name",
    "description",
    "capability_ids",
    "input_schema",
    "output_schema",
    "caller_role",
    "executor_role",
    "effect",
    "approval_policy",
    "provider_wire_format",
    "live_network",
    "secret_parameters_allowed"
  ],
  "properties": {
    "tool_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "description": {
      "type": "string",
      "minLength": 8
    },
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^generic\\.tool\\."
      }
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": true
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": true
    },
    "caller_role": {
      "const": "caller"
    },
    "executor_role": {
      "const": "executor"
    },
    "effect": {
      "enum": [
        "read_only",
        "effectful"
      ]
    },
    "approval_policy": {
      "enum": [
        "not_required_for_fixture",
        "deny_without_approval"
      ]
    },
    "provider_wire_format": {
      "const": "none"
    },
    "live_network": {
      "const": false
    },
    "secret_parameters_allowed": {
      "const": false
    }
  }
}
