{
  "schema_version": 1,
  "id": "generic-tool-registry-contract",
  "provider_free": true,
  "domain_specific": false,
  "live_network": false,
  "real_dependency_imports": false,
  "local_execution": false,
  "default_mode": "fixture_replay",
  "capability_prefix": "generic.tool.",
  "required_capabilities": [
    "generic.tool.registry.declare",
    "generic.tool.registry.validate_schema",
    "generic.tool.invocation.trace",
    "generic.tool.approval.edge",
    "generic.tool.registry.replay_fixture"
  ],
  "descriptor_contract": {
    "schema_ref": "schemas/tool_descriptor.schema.json",
    "required_fields": [
      "tool_name",
      "description",
      "capability_ids",
      "input_schema",
      "output_schema",
      "caller_role",
      "executor_role",
      "effect",
      "approval_policy"
    ],
    "provider_wire_format": "none",
    "additional_properties_policy": "reject_unknown_tool_metadata",
    "secret_policy": "parameters must not contain secret, token, password, api_key, or credential fields"
  },
  "invocation_trace_contract": {
    "schema_ref": "schemas/tool_invocation_trace.schema.json",
    "fixture_ref": "fixtures/tool_registry_replay_trace_fixture.json",
    "required_events": [
      "registered",
      "schema_validated",
      "approval_checked",
      "invoked",
      "result_recorded"
    ],
    "required_fields": [
      "trace_id",
      "tool_name",
      "caller_id",
      "executor_id",
      "capability_ids",
      "schema_validation",
      "approval",
      "result",
      "provenance"
    ],
    "result_envelope_required": [
      "ok",
      "status",
      "content",
      "metadata"
    ]
  },
  "approval_edges": [
    {
      "id": "read_only_fixture",
      "effect": "read_only",
      "approval_required": false,
      "default_decision": "allow_fixture"
    },
    {
      "id": "effectful_denied_without_token",
      "effect": "effectful",
      "approval_required": true,
      "default_decision": "deny",
      "fixture_ref": "fixtures/approval_edge_fixture.json",
      "clean_skip": true
    }
  ],
  "negative_gates": {
    "forbidden_imports": [
      "autogen",
      "openai",
      "langchain",
      "requests",
      "urllib",
      "pandas",
      "q runtime package"
    ],
    "forbidden_live_behaviors": [
      "network",
      "provider_api_call",
      "local_code_execution",
      "shell_command",
      "filesystem_write_without_approval"
    ],
    "forbidden_descriptor_fields": [
      "api_key",
      "access_token",
      "secret",
      "password",
      "credential"
    ]
  }
}
