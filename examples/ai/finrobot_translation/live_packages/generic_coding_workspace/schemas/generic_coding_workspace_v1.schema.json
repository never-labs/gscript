{
  "schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic Coding Workspace Fixture",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "live_model_calls",
    "approval_gates",
    "commands",
    "channel_captures",
    "file_artifact_manifest",
    "image_artifact_manifest",
    "artifacts",
    "notebook_displays",
    "cleanup_policy",
    "adapter_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "live_model_calls": {
      "const": false
    },
    "approval_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "capability",
          "operation",
          "decision",
          "reason"
        ]
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "request_id",
          "replay_key",
          "argv",
          "cwd",
          "env_allowlist",
          "shell",
          "timeout_bucket",
          "network",
          "filesystem_write",
          "executed",
          "approval_id",
          "exit_code",
          "stdout",
          "stderr",
          "duration_bucket"
        ]
      }
    },
    "channel_captures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command_replay_key",
          "channel",
          "text",
          "bytes",
          "truncated"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "replay_key",
          "path",
          "media_type",
          "sha256",
          "bytes",
          "provenance"
        ]
      }
    },
    "notebook_displays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "display_id",
          "artifact_id",
          "media_type",
          "width",
          "height",
          "live_kernel"
        ]
      }
    },
    "cleanup_policy": {
      "type": "object",
      "required": [
        "mode",
        "delete_unapproved_outputs",
        "preserve_fixture_artifacts",
        "cleanup_replay_key",
        "paths",
        "executed"
      ]
    },
    "adapter_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "capability",
          "dependency_imported",
          "credential_required",
          "live_network",
          "clean_skip"
        ]
      }
    }
  }
}
