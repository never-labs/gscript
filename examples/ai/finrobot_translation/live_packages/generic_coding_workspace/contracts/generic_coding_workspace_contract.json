{
  "schema_version": 1,
  "package_boundary_id": "generic-ai-coding-workspace",
  "package_name": "generic.ai.coding_workspace",
  "entrypoint": "ai.coding_workspace",
  "provider_free": true,
  "domain_specific": false,
  "live_network": false,
  "live_model": false,
  "live_model_calls": false,
  "real_dependency_imports": false,
  "requires_credentials": false,
  "provider_sdks_required": false,
  "capabilities": [
    "generic.ai.coding_workspace",
    "generic.ai.code.command.request",
    "generic.ai.code.command.result",
    "generic.ai.code.approval.gate",
    "generic.ai.code.stdout.stderr",
    "generic.ai.artifact.file_manifest",
    "generic.ai.artifact.image_manifest",
    "generic.ai.notebook.display",
    "generic.ai.code.cleanup_policy",
    "generic.ai.code.replay.deterministic",
    "generic.ai.code.capability.metadata",
    "generic.ai.code.clean_skip"
  ],
  "modules": {
    "command": {
      "inputs": [
        "command_request",
        "approval_gate"
      ],
      "outputs": [
        "command_result",
        "stdout_capture",
        "stderr_capture",
        "clean_skip"
      ],
      "required_fields": [
        "request_id",
        "argv",
        "cwd",
        "env_allowlist",
        "shell",
        "timeout_bucket",
        "network",
        "filesystem_write",
        "executed"
      ]
    },
    "artifact": {
      "inputs": [
        "command_result",
        "artifact_specs"
      ],
      "outputs": [
        "file_artifact_manifest",
        "image_artifact_manifest",
        "notebook_display"
      ],
      "required_fields": [
        "artifact_id",
        "path",
        "media_type",
        "sha256",
        "bytes",
        "provenance",
        "replay_key"
      ]
    },
    "replay": {
      "inputs": [
        "fixture_seed",
        "ordered_events"
      ],
      "outputs": [
        "deterministic_summary",
        "cleanup_policy"
      ],
      "required_fields": [
        "replay_key",
        "duration_bucket",
        "stdout",
        "stderr",
        "exit_code",
        "artifact_refs"
      ]
    }
  },
  "field_contracts": {
    "sandbox_command": "command requests include argv, cwd, env allowlist, shell flag, timeout bucket, side-effect flags, and executed=false in fixture mode",
    "approval_gate": "execution and file writes require explicit approval and default to deny",
    "stdout_stderr_capture": "stdout and stderr are separate channel records with byte counts and truncation flags",
    "file_artifact_manifest": "file artifacts declare media type, hash, bytes, provenance, and replay key",
    "image_artifact_manifest": "image artifacts include dimensions, media type, content hash, and display refs",
    "notebook_display": "display metadata references artifacts without importing live notebook kernels",
    "cleanup_policy": "cleanup is fixture_noop by default and records intended paths without touching the host filesystem"
  }
}
