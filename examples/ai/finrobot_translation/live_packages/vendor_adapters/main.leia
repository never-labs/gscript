        {id: "fmp_news" provider: "fmp" capability: "finance.vendor.fmp.news" schema: "schemas/fmp_news_v1.schema.json" fixture: "fixtures/fmp_news_ACME.json" fixture_key: "fmp:news:ACME" credential: {required: false secret_ref: "env:FMP_API_KEY" redacted: true} rate_limit: {policy: "metadata-only" window_seconds: 86400 limit: 300 retry_after_seconds: 2} terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}},
        {id: "fmp_ratings" provider: "fmp" capability: "finance.vendor.fmp.ratings" schema: "schemas/fmp_ratings_v1.schema.json" fixture: "fixtures/fmp_ratings_ACME.json" fixture_key: "fmp:ratings:ACME" credential: {required: false secret_ref: "env:FMP_API_KEY" redacted: true} rate_limit: {policy: "metadata-only" window_seconds: 86400 limit: 300 retry_after_seconds: 2} terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}},
        {id: "fmp_targets" provider: "fmp" capability: "finance.vendor.fmp.targets" schema: "schemas/fmp_targets_v1.schema.json" fixture: "fixtures/fmp_targets_ACME.json" fixture_key: "fmp:targets:ACME" credential: {required: false secret_ref: "env:FMP_API_KEY" redacted: true} rate_limit: {policy: "metadata-only" window_seconds: 86400 limit: 300 retry_after_seconds: 2} terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}},
