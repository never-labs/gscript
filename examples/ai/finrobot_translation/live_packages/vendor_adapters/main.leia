// Provider-free live package skeleton for FinRobot vendor adapters.
//
// The JSON manifest is the contract of record. This executable mirror keeps the
// package discoverable by Leia smoke tests while preserving fixture-only
// defaults for CI and replay runs.

vendor_live_package := {
    id: "finrobot-live-vendor-adapters"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    default_policy: {
        mode: "fixture_replay"
        live_network: false
        provider_credentials_required: false
        clean_skip_without_credentials: true
        redact_secret_values: true
    }
    redaction: {
        enabled: true
        replacement: "<redacted>"
        secret_patterns: {
            "env:FINNHUB_TOKEN",
            "env:FMP_API_KEY",
            "env:REDDIT_CLIENT_ID",
            "env:REDDIT_CLIENT_SECRET",
            "env:SEC_USER_AGENT",
        }
    }
    capability_registry: {
        version: "vendor-adapter-capabilities-v1"
        mode: "provider-free-boundary"
        provider_free: true
        live_network: false
        registry_scope: "external-data-and-tool-adapter-dialect"
        common_capabilities: {
            "market_chart",
            "financial_statement_history",
            "company_profile",
            "dividend_history",
            "analyst_recommendations",
            "key_metrics",
            "technical_indicators",
            "company_news",
            "sec_filings",
            "social_search",
            "transcript_lookup",
        }
    }
    auth_redaction: {
        enabled: true
        fixture: "fixtures/auth_redaction_policy.json"
        fixture_key: "vendor_adapters:auth_redaction:offline"
        secret_value_policy: "never-store-secret-values"
        credential_required_for_fixture_replay: false
        secret_values_present: false
        replacement: "<redacted>"
        env_refs: {
            "env:FINNHUB_TOKEN",
            "env:FMP_API_KEY",
            "env:REDDIT_CLIENT_ID",
            "env:REDDIT_CLIENT_SECRET",
            "env:SEC_USER_AGENT",
        }
    }
    retry_cache_envelope: {
        mode: "deterministic_fixture_replay"
        provider_free: true
        live_network: false
        max_attempts: 1
        backoff: "none"
        retryable_error_kinds: {
            "rate_limited",
            "timeout",
            "transient_provider_error",
        }
        cache: {
            mode: "fixture_replay"
            namespace: "finrobot.vendor_adapters"
            key_source: "fixture_key"
            ttl_seconds: 0
            hit_state: "fixture-hit"
            miss_behavior: "clean-skip"
        }
    }
    error_taxonomy: {
        version: "vendor-error-taxonomy-v1"
        normalized_errors: {
            {kind: "rate_limited" http_status: 429 retryable: true cache_state: "stale-allowed"},
            {kind: "auth_missing" http_status: 401 retryable: false cache_state: "fixture-only"},
            {kind: "not_found" http_status: 404 retryable: false cache_state: "negative-cache"},
            {kind: "schema_mismatch" http_status: 422 retryable: false cache_state: "quarantine"},
            {kind: "transient_provider_error" http_status: 503 retryable: true cache_state: "stale-allowed"},
        }
    }
    rate_limit_fixture: {
        fixture: "fixtures/rate_limit_matrix.json"
        fixture_key: "vendor_adapters:rate_limits:offline"
        capability: "finance.vendor.adapter.rate_limits"
        live_network: false
    }
    offline_replay: {
        enabled: true
        fixture_index: "fixtures/offline_replay_index.json"
        require_fixture_key: true
        live_network: false
        provider_credentials_required: false
        miss_behavior: "clean-skip"
        secret_values_present: false
    }
    adapters: {
        {id: "yfinance_chart" provider: "yfinance" capability: "finance.vendor.yfinance.chart" schema: "schemas/yfinance_chart_v1.schema.json" fixture: "fixtures/yfinance_chart_ACME.json" fixture_key: "yfinance:chart:ACME:1mo" credential: {required: false secret_ref: nil redacted: true} rate_limit: {policy: "metadata-only" window_seconds: 60 limit: 120 retry_after_seconds: 1} terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}},
        {id: "yfinance_statements" provider: "yfinance" capability: "finance.vendor.yfinance.statements" schema: "schemas/yfinance_statements_v1.schema.json" fixture: "fixtures/yfinance_statements_ACME.json" fixture_key: "yfinance:statements:ACME:annual" credential: {required: false secret_ref: nil redacted: true} rate_limit: {policy: "metadata-only" window_seconds: 60 limit: 120 retry_after_seconds: 1} terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}},
        {id: "yfinance_info" provider: "yfinance" capability: "finance.vendor.yfinance.info" schema: "schemas/yfinance_info_v1.schema.json" fixture: "fixtures/yfinance_info_ACME.json" fixture_key: "yfinance:info:ACME" credential: {required: false secret_ref: nil redacted: true} rate_limit: {policy: "metadata-only" window_seconds: 60 limit: 120 retry_after_seconds: 1} terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}},
        {id: "yfinance_dividends" provider: "yfinance" capability: "finance.vendor.yfinance.dividends" schema: "schemas/yfinance_dividends_v1.schema.json" fixture: "fixtures/yfinance_dividends_ACME.json" fixture_key: "yfinance:dividends:ACME" credential: {required: false secret_ref: nil redacted: true} rate_limit: {policy: "metadata-only" window_seconds: 60 limit: 120 retry_after_seconds: 1} terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}},
        {id: "yfinance_cashflow" provider: "yfinance" capability: "finance.vendor.yfinance.cashflow" schema: "schemas/yfinance_cashflow_v1.schema.json" fixture: "fixtures/yfinance_cashflow_ACME.json" fixture_key: "yfinance:cashflow:ACME:annual" credential: {required: false secret_ref: nil redacted: true} rate_limit: {policy: "metadata-only" window_seconds: 60 limit: 120 retry_after_seconds: 1} terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}},
        {id: "yfinance_recommendations" provider: "yfinance" capability: "finance.vendor.yfinance.recommendations" schema: "schemas/yfinance_recommendations_v1.schema.json" fixture: "fixtures/yfinance_recommendations_ACME.json" fixture_key: "yfinance:recommendations:ACME" credential: {required: false secret_ref: nil redacted: true} rate_limit: {policy: "metadata-only" window_seconds: 60 limit: 120 retry_after_seconds: 1} terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}},
