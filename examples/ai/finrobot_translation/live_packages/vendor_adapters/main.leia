// Provider-free live package skeleton for FinRobot vendor adapters.
//
// The manifest is the contract of record. This executable mirror keeps the
// package discoverable by Leia smoke tests while preserving fixture-only
// defaults for CI and replay runs.

vendor_live_package := {
    id: "finrobot-live-vendor-adapters"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    default_policy: {
        mode: "fixture_replay"
        live_network: false
        provider_credentials_required: false
        clean_skip_without_credentials: true
        redact_secret_values: true
    }
    redaction: {
        enabled: true
        replacement: "<redacted>"
        secret_patterns: {
            "env:FINNHUB_TOKEN",
            "env:FMP_API_KEY",
            "env:REDDIT_CLIENT_ID",
            "env:REDDIT_CLIENT_SECRET",
            "env:SEC_USER_AGENT",
        }
    }
    adapters: {
        {
            id: "yfinance"
            capability: "finance.vendor.yfinance.chart"
            common_capabilities: {"market_chart", "ohlcv_history", "quote_snapshot", "currency_metadata"}
            schema: "schemas/yfinance_chart_v1.schema.json"
            fixture: "fixtures/yfinance_chart_ACME_1mo.json"
            fixture_key: "yfinance:chart:ACME:1mo"
            credential: {required: false secret_ref: nil redacted: true}
            rate_limit: {policy: "metadata-only" window_seconds: 60 limit: 120 retry_after_seconds: 1}
            terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}
        },
        {
            id: "finnhub"
            capability: "finance.vendor.finnhub.profile"
            common_capabilities: {"company_profile", "exchange_metadata", "industry_classification"}
            schema: "schemas/finnhub_profile_v1.schema.json"
            fixture: "fixtures/finnhub_profile_ACME.json"
            fixture_key: "finnhub:profile:ACME"
            credential: {required: false secret_ref: "env:FINNHUB_TOKEN" redacted: true}
            rate_limit: {policy: "metadata-only" window_seconds: 60 limit: 60 retry_after_seconds: 0}
            terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}
        },
        {
            id: "fmp"
            capability: "finance.vendor.fmp.key_metrics"
            common_capabilities: {"key_metrics", "financial_ratios", "periodic_fundamentals"}
            schema: "schemas/fmp_key_metrics_v1.schema.json"
            fixture: "fixtures/fmp_key_metrics_ACME_annual.json"
            fixture_key: "fmp:key_metrics:ACME:annual"
            credential: {required: false secret_ref: "env:FMP_API_KEY" redacted: true}
            rate_limit: {policy: "metadata-only" window_seconds: 86400 limit: 300 retry_after_seconds: 2}
            terms: {usage: "offline-fixture-only" attribution: "provider terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}
        },
        {
            id: "sec"
            capability: "finance.vendor.sec.filing"
            common_capabilities: {"filing_lookup", "company_facts", "risk_factor_sections", "accession_metadata"}
            schema: "schemas/sec_filing_v1.schema.json"
            fixture: "fixtures/sec_filing_ACME_10K_2025.json"
            fixture_key: "sec:filing:ACME:10-K:2025"
            credential: {required: false secret_ref: "env:SEC_USER_AGENT" redacted: true}
            rate_limit: {policy: "metadata-only" window_seconds: 1 limit: 10 retry_after_seconds: 1}
            terms: {usage: "offline-fixture-only" attribution: "SEC fair-access metadata retained" redistribution: "fixture-only" live_network: false user_agent_required_for_live: true}
        },
        {
            id: "reddit"
            capability: "finance.vendor.reddit.search"
            common_capabilities: {"subreddit_search", "post_metadata", "sentiment_source"}
            schema: "schemas/reddit_search_v1.schema.json"
            fixture: "fixtures/reddit_search_ACME_sentiment.json"
            fixture_key: "reddit:search:ACME:sentiment"
            credential: {required: false secret_ref: "env:REDDIT_CLIENT_SECRET" redacted: true}
            rate_limit: {policy: "metadata-only" window_seconds: 600 limit: 600 retry_after_seconds: 0}
            terms: {usage: "offline-fixture-only" attribution: "platform terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}
        },
        {
            id: "earnings"
            capability: "finance.vendor.earnings.transcript"
            common_capabilities: {"transcript_lookup", "speaker_segments", "fiscal_period_metadata"}
            schema: "schemas/earnings_transcript_v1.schema.json"
            fixture: "fixtures/earnings_transcript_ACME_2025_Q4.json"
            fixture_key: "earnings:transcript:ACME:2025:Q4"
            credential: {required: false secret_ref: nil redacted: true}
            rate_limit: {policy: "metadata-only" window_seconds: 60 limit: 30 retry_after_seconds: 0}
            terms: {usage: "offline-fixture-only" attribution: "transcript terms metadata retained" redistribution: "do-not-redistribute-live-payloads" live_network: false}
        },
    }
}

func vendor_live_adapter(id) {
    for i := 1; i <= #vendor_live_package.adapters; i++ {
        adapter := vendor_live_package.adapters[i]
        if adapter.id == id {
            return adapter
        }
    }
    return nil
}

func vendor_live_adapter_ok(adapter) {
    if adapter == nil {
        return false
    }
    if vendor_live_package.provider_free != true || vendor_live_package.live_network != false || vendor_live_package.real_dependency_imports != false {
        return false
    }
    if adapter.credential.required != false || adapter.credential.redacted != true {
        return false
    }
    if adapter.terms.live_network != false || adapter.rate_limit.policy != "metadata-only" {
        return false
    }
    return adapter.capability != nil && adapter.schema != nil && adapter.fixture != nil && adapter.fixture_key != nil
}

vendor_live_adapter_ids := {"yfinance", "finnhub", "fmp", "sec", "reddit", "earnings"}
vendor_live_ok_count := 0
for i := 1; i <= #vendor_live_adapter_ids; i++ {
    adapter := vendor_live_adapter(vendor_live_adapter_ids[i])
    assert(vendor_live_adapter_ok(adapter))
    vendor_live_ok_count = vendor_live_ok_count + 1
}

assert(vendor_live_package.default_policy.live_network == false)
assert(vendor_live_package.default_policy.provider_credentials_required == false)
assert(#vendor_live_package.redaction.secret_patterns == 5)
assert(vendor_live_adapter("sec").terms.user_agent_required_for_live == true)

vendor_live_package_summary := string.format(
"vendor_live_package adapters=%d provider_free=%s live_network=%s imports=%s redaction=%s",
vendor_live_ok_count,
tostring(vendor_live_package.provider_free),
tostring(vendor_live_package.live_network),
tostring(vendor_live_package.real_dependency_imports),
tostring(vendor_live_package.redaction.enabled)
)

print(vendor_live_package_summary)
