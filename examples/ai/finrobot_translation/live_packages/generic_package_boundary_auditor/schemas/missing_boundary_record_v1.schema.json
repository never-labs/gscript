{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generic.missing_boundary_record.v1",
  "type": "object",
  "required": [
    "record_id",
    "package_id",
    "missing_boundary_type",
    "required_artifact",
    "blocking",
    "remediation"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "missing_boundary_type": {
      "type": "string",
      "enum": [
        "package_manifest",
        "fixture_index",
        "example_registry",
        "capability_policy",
        "audit_findings",
        "missing_boundary_records"
      ]
    },
    "required_artifact": {
      "type": "string",
      "minLength": 1
    },
    "owner_hint": {
      "type": "string"
    },
    "blocking": {
      "type": "boolean"
    },
    "remediation": {
      "type": "string",
      "minLength": 1
    }
  }
}
