// Provider-free smoke skeleton for generic AI package boundary audits.
//
// This file summarizes static audit metadata only. It does not import provider
// packages, open network connections, or load external registries.

generic_package_boundary_audit := {
    id: "generic-ai-package-boundary-audit-live-package"
    package_name: "generic.ai.package.boundary.audit"
    aliases: {"ai.package.audit"}
    provider_free: true
    live_network: false
    real_dependency_imports: false
    default_policy: {
        mode: "fixture_replay"
        provider_credentials_required: false
        clean_skip_without_dependency: true
    }
    targets: {
        {id: "package_manifest_audit" capability: "generic.ai.package.boundary.audit.manifest" fixture_key: "generic-package-boundary:manifest:offline"},
        {id: "fixture_index_audit" capability: "generic.ai.package.boundary.audit.fixture_index" fixture_key: "generic-package-boundary:fixture-index:offline"},
        {id: "example_registry_audit" capability: "generic.ai.package.boundary.audit.example_registry" fixture_key: "generic-package-boundary:example-registry:offline"},
        {id: "capability_policy" capability: "generic.ai.package.boundary.audit.capability_policy" fixture_key: "generic-package-boundary:capability-policy:offline"},
        {id: "audit_findings" capability: "generic.ai.package.boundary.audit.findings" fixture_key: "generic-package-boundary:findings:offline"},
        {id: "missing_boundary_records" capability: "generic.ai.package.boundary.audit.missing_boundary_records" fixture_key: "generic-package-boundary:missing-boundary-records:offline"},
    }
}

func generic_boundary_target_ok(target) {
    if target == nil {
        return false
    }
    if generic_package_boundary_audit.provider_free != true || generic_package_boundary_audit.live_network != false || generic_package_boundary_audit.real_dependency_imports != false {
        return false
    }
    return target.id != nil && target.capability != nil && target.fixture_key != nil
}

generic_boundary_target_count := 0
for i := 1; i <= #generic_package_boundary_audit.targets; i++ {
    target := generic_package_boundary_audit.targets[i]
    assert(generic_boundary_target_ok(target))
    generic_boundary_target_count = generic_boundary_target_count + 1
}

assert(generic_boundary_target_count == 6)

generic_package_boundary_audit_summary := string.format(
"generic_package_boundary_audit targets=%d aliases=%d provider_free=%s live_network=%s imports=%s",
generic_boundary_target_count,
#generic_package_boundary_audit.aliases,
tostring(generic_package_boundary_audit.provider_free),
tostring(generic_package_boundary_audit.live_network),
tostring(generic_package_boundary_audit.real_dependency_imports)
)

print(generic_package_boundary_audit_summary)
