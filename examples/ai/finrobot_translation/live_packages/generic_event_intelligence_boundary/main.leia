generic_event_intelligence_boundary_live_package := {
    id: "generic-event-intelligence-boundary"
    package_name: "leia-generic-ai-event-intelligence-boundary"
    capability: "generic.ai.event_intelligence.boundary"
    entrypoint: "ai.event_intelligence.boundary"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    live_model_calls: false
    sources: 2
    events: 2
    taxonomies: 1
    freshness_policies: 1
    dedupe_groups: 2
    relevance_scores: 2
    sentiment_impact: 2
    prompt_contracts: 1
    clean_skip_adapters: 2
}

assert(generic_event_intelligence_boundary_live_package.provider_free)
assert(!generic_event_intelligence_boundary_live_package.live_network)
assert(!generic_event_intelligence_boundary_live_package.real_dependency_imports)
assert(!generic_event_intelligence_boundary_live_package.live_model_calls)
assert(generic_event_intelligence_boundary_live_package.sources == 2)
assert(generic_event_intelligence_boundary_live_package.events == 2)

generic_event_intelligence_boundary_live_package_summary := string.format(
"generic_event_intelligence_boundary_live_package capability=%s entrypoint=%s sources=%d events=%d taxonomies=%d freshness=%d dedupe=%d relevance=%d sentiment_impact=%d prompts=%d clean_skip=%d provider_free=%s live_network=%s imports=%s model_calls=%s",
generic_event_intelligence_boundary_live_package.capability,
generic_event_intelligence_boundary_live_package.entrypoint,
generic_event_intelligence_boundary_live_package.sources,
generic_event_intelligence_boundary_live_package.events,
generic_event_intelligence_boundary_live_package.taxonomies,
generic_event_intelligence_boundary_live_package.freshness_policies,
generic_event_intelligence_boundary_live_package.dedupe_groups,
generic_event_intelligence_boundary_live_package.relevance_scores,
generic_event_intelligence_boundary_live_package.sentiment_impact,
generic_event_intelligence_boundary_live_package.prompt_contracts,
generic_event_intelligence_boundary_live_package.clean_skip_adapters,
tostring(generic_event_intelligence_boundary_live_package.provider_free),
tostring(generic_event_intelligence_boundary_live_package.live_network),
tostring(generic_event_intelligence_boundary_live_package.real_dependency_imports),
tostring(generic_event_intelligence_boundary_live_package.live_model_calls))

