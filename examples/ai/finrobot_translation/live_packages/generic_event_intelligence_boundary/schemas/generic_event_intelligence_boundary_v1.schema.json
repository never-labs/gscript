{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic event intelligence boundary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "live_model_calls",
    "source_snapshots",
    "event_taxonomy",
    "event_records",
    "freshness_policy",
    "dedupe_confidence",
    "relevance_scores",
    "sentiment_impact",
    "prompt_contracts",
    "adapter_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "live_model_calls": {
      "const": false
    },
    "source_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "source_id",
          "source_type",
          "fixture_key",
          "captured_at",
          "redaction_policy",
          "live_network",
          "terms_metadata"
        ]
      }
    },
    "event_taxonomy": {
      "type": "object"
    },
    "event_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "event_id",
          "source_refs",
          "category",
          "summary",
          "confidence",
          "freshness",
          "dedupe_group"
        ]
      }
    },
    "freshness_policy": {
      "type": "array"
    },
    "dedupe_confidence": {
      "type": "array"
    },
    "relevance_scores": {
      "type": "array"
    },
    "sentiment_impact": {
      "type": "array"
    },
    "prompt_contracts": {
      "type": "array"
    },
    "adapter_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "dependency_imported",
          "credential_required",
          "live_network",
          "clean_skip"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "dependency_imported": {
            "const": false
          },
          "credential_required": {
            "type": "boolean"
          },
          "live_network": {
            "const": false
          },
          "clean_skip": {
            "const": true
          }
        }
      }
    }
  }
}
