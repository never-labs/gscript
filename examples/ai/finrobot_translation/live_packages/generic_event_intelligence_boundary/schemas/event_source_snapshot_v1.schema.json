{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic event source snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "source_snapshots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "source_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "source_id",
          "source_type",
          "fixture_key",
          "captured_at",
          "redaction_policy",
          "live_network",
          "terms_metadata"
        ]
      }
    }
  }
}
