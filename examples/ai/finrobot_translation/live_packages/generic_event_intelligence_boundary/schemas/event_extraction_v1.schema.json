{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic event extraction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "event_records",
    "event_taxonomy",
    "dedupe_confidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "event_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "event_id",
          "source_refs",
          "category",
          "summary",
          "confidence",
          "freshness",
          "dedupe_group"
        ]
      }
    },
    "event_taxonomy": {
      "type": "object"
    },
    "dedupe_confidence": {
      "type": "array"
    }
  }
}
