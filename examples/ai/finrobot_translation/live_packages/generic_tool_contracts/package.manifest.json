      "status": "active"
    },
    {
      "alias": "approval",
      "target_capability_id": "ai.tool.invoke",
      "alias_kind": "backend_capability_slug",
      "scope": "backend_shape",
      "status": "active"
    },
    {
      "alias": "capability",
      "target_capability_id": "ai.tool.invoke",
      "alias_kind": "backend_capability_slug",
      "scope": "backend_shape",
      "status": "active"
    },
    {
      "alias": "generic.ai.tool.contract",
      "target_capability_id": "ai.tool.invoke",
      "alias_kind": "dialect_capability_id",
