{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/leia/ai/artifact_ref_v1.schema.json",
  "title": "AI Tool Artifact Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "uri",
    "media_type",
    "sha256",
    "bytes",
    "provenance",
    "replay_key"
  ],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "uri": {"type": "string", "pattern": "^artifact://"},
    "media_type": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bytes": {"type": "integer", "minimum": 0},
    "provenance": {
      "type": "object",
      "required": ["source", "tool_name", "provider_free", "live_network"],
      "properties": {
        "source": {"type": "string"},
        "tool_name": {"type": "string"},
        "provider_free": {"const": true},
        "live_network": {"const": false}
      }
    },
    "replay_key": {"type": "string", "minLength": 1}
  }
}
