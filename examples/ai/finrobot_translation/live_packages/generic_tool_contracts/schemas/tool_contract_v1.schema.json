{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/leia/ai/tool_contract_v1.schema.json",
  "title": "Generic AI Tool Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "declarative_schema",
    "capability_tags",
    "approval",
    "result_schema_ref",
    "error_schema_ref",
    "artifact_schema_ref"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "declarative_schema": {
      "type": "object",
      "required": ["type", "properties", "required"],
      "properties": {
        "type": {"const": "object"},
        "additionalProperties": {"type": "boolean"},
        "required": {"type": "array", "items": {"type": "string"}},
        "properties": {"type": "object"}
      }
    },
    "capability_tags": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
      "uniqueItems": true
    },
    "approval": {
      "type": "object",
      "required": ["required", "state", "policy"],
      "properties": {
        "required": {"type": "boolean"},
        "state": {"enum": ["not_required", "required", "approved", "denied", "expired", "fixture_only"]},
        "policy": {"type": "string"}
      }
    },
    "result_schema_ref": {"type": "string"},
    "error_schema_ref": {"type": "string"},
    "artifact_schema_ref": {"type": "string"},
    "fixture_keys": {"type": "array", "items": {"type": "string"}}
  }
}
