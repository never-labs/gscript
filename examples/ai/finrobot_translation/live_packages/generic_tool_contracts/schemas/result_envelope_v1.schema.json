{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/leia/ai/result_envelope_v1.schema.json",
  "title": "AI Tool Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "tool_name",
    "capability_tags",
    "approval",
    "value",
    "error",
    "artifact_refs",
    "replay"
  ],
  "properties": {
    "ok": {"type": "boolean"},
    "tool_name": {"type": "string"},
    "capability_tags": {"type": "array", "items": {"type": "string"}},
    "approval": {
      "type": "object",
      "required": ["state", "required"],
      "properties": {
        "state": {"enum": ["not_required", "required", "approved", "denied", "expired", "fixture_only"]},
        "approval_id": {"type": "string"},
        "required": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    },
    "value": {"type": ["object", "array", "string", "number", "boolean", "null"]},
    "error": {
      "anyOf": [
        {"$ref": "normalized_error_v1.schema.json"},
        {"type": "null"}
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {"$ref": "artifact_ref_v1.schema.json"}
    },
    "replay": {
      "type": "object",
      "required": ["mode", "replay_key", "deterministic", "provider_free", "live_network"],
      "properties": {
        "mode": {"const": "fixture_replay"},
        "replay_key": {"type": "string"},
        "deterministic": {"type": "boolean"},
        "provider_free": {"const": true},
        "live_network": {"const": false}
      }
    }
  }
}
