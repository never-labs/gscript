{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/leia/ai/invoke_request_v1.schema.json",
  "title": "AI Tool Invoke Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_name",
    "arguments",
    "capability_tags",
    "approval",
    "replay_key",
    "provider_free",
    "live_network"
  ],
  "properties": {
    "tool_name": {"type": "string", "minLength": 1},
    "arguments": {"type": "object"},
    "capability_tags": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "approval": {
      "type": "object",
      "required": ["state", "required"],
      "properties": {
        "state": {"enum": ["not_required", "required", "approved", "denied", "expired", "fixture_only"]},
        "approval_id": {"type": "string"},
        "required": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    },
    "replay_key": {"type": "string", "minLength": 1},
    "provider_free": {"const": true},
    "live_network": {"const": false}
  }
}
