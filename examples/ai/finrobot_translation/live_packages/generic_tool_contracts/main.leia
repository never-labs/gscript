// Provider-free generic AI tool contract live package smoke.
//
// This file mirrors the checked-in generic.ai.tool.contract and ai.tool.invoke
// schemas. It records only fixture replay metadata and does not execute a
// provider, host tool, network call, or external dependency.

generic_tool_contracts_live_package := {
    id: "finrobot-generic-tool-contracts-live-package"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    dialect_exports: {"generic.ai.tool.contract", "ai.tool.invoke"}
    projection_exports: {"generic.ai.tool.contract.project_registry_descriptor"}
    default_policy: {
        mode: "fixture_replay"
        tool_execution_default: "fixture_only"
        approval_default: "deny_without_explicit_fixture"
        argument_validation_default: "schema_required"
        artifact_storage_default: "artifact_ref_only"
    }
    tool_contract: {
        name: "fixture.lookup"
        declarative_schema: {
            type: "object"
            required: {"ticker", "horizon"}
            additional_properties: false
        }
        capability_tags: {
            "generic.ai.tool.contract",
            "ai.tool.invoke",
            "ai.tool.schema.declarative",
            "ai.tool.arguments.validate",
            "ai.tool.result.envelope",
            "ai.tool.artifact.refs"
        }
        approval: {
            required: false
            state: "fixture_only"
        }
    }
    invoke_success: {
        ok: true
        tool_name: "fixture.lookup"
        approval: {state: "fixture_only" required: false}
        value: {ticker: "ACME" horizon: "1d" summary: "provider-free fixture lookup completed"}
        error: nil
        artifact_refs: {
            {
                artifact_id: "artifact_generic_tool_lookup_ACME_1d"
                uri: "artifact://generic_tool_contracts/lookup/ACME/1d.json"
                media_type: "application/json"
                sha256: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                bytes: 192
                replay_key: "generic_tool:artifact:fixture.lookup:ACME:1d"
            },
        }
        replay: {
            mode: "fixture_replay"
            replay_key: "generic_tool:invoke:fixture.lookup:ACME:1d:success"
            deterministic: true
            provider_free: true
            live_network: false
        }
    }
    invoke_validation_error: {
        ok: false
        tool_name: "fixture.lookup"
        approval: {state: "fixture_only" required: false}
        value: nil
        error: {
            kind: "validation"
            message: "argument horizon must be one of 1d, 1w, or 1m"
            field: "arguments.horizon"
            retryable: false
            provider_free: true
        }
        artifact_refs: {}
        replay: {
            mode: "fixture_replay"
            replay_key: "generic_tool:invoke:fixture.lookup:bad-args:validation"
            deterministic: true
            provider_free: true
            live_network: false
        }
    }
    registry_descriptor_projection: {
        projection_kind: "registry_descriptor_to_tool_contract"
        source_fixtures: {
            "generic_tool:invocation:trace:v1",
            "generic_tool:approval:denied:v1"
        }
        projected_tools: {
            {
                name: "summarize_rows"
                source_effect: "read_only"
                declarative_schema: {required: {"rows"} additional_properties: false}
                capability_tags: {
                    "generic.ai.tool.contract",
                    "generic.ai.tool.contract.project_registry_descriptor",
                    "ai.tool.schema.declarative",
                    "ai.tool.replay.fixture"
                }
                approval: {required: false state: "fixture_only"}
                replay_key: "generic_tool:invocation:trace:v1"
            },
            {
                name: "publish_artifact"
                source_effect: "effectful"
                declarative_schema: {required: {"artifact_id"} additional_properties: false}
                capability_tags: {
                    "generic.ai.tool.contract",
                    "generic.ai.tool.contract.project_registry_descriptor",
                    "ai.tool.approval.state",
                    "ai.tool.error.normalized",
                    "ai.tool.replay.fixture"
                }
                approval: {required: true state: "denied"}
                replay_key: "generic_tool:approval:denied:v1"
                error_kind: "approval_denied"
            },
        }
        provider_free: true
        live_network: false
    }
}

func generic_tool_contracts_provider_free_ok(pkg) {
    if pkg == nil {
        return false
    }
    return pkg.provider_free == true &&
        pkg.live_network == false &&
        pkg.real_dependency_imports == false &&
        pkg.default_policy.mode == "fixture_replay" &&
        pkg.default_policy.tool_execution_default == "fixture_only" &&
        pkg.default_policy.argument_validation_default == "schema_required" &&
        pkg.default_policy.artifact_storage_default == "artifact_ref_only"
}

func generic_tool_contracts_success_ok(result) {
    if result == nil {
        return false
    }
    return result.ok == true &&
        result.tool_name == "fixture.lookup" &&
        result.approval.state == "fixture_only" &&
        result.error == nil &&
        #result.artifact_refs == 1 &&
        result.artifact_refs[1].uri == "artifact://generic_tool_contracts/lookup/ACME/1d.json" &&
        result.replay.provider_free == true &&
        result.replay.live_network == false
}

func generic_tool_contracts_validation_error_ok(result) {
    if result == nil {
        return false
    }
    return result.ok == false &&
        result.value == nil &&
        result.error.kind == "validation" &&
        result.error.field == "arguments.horizon" &&
        result.error.retryable == false &&
        result.error.provider_free == true &&
        #result.artifact_refs == 0 &&
        result.replay.provider_free == true
}

func generic_tool_contracts_projection_ok(projection) {
    if projection == nil {
        return false
    }
    return projection.provider_free == true &&
        projection.live_network == false &&
        projection.projection_kind == "registry_descriptor_to_tool_contract" &&
        #projection.projected_tools == 2 &&
        projection.projected_tools[1].name == "summarize_rows" &&
        projection.projected_tools[1].approval.required == false &&
        projection.projected_tools[2].name == "publish_artifact" &&
        projection.projected_tools[2].approval.state == "denied" &&
        projection.projected_tools[2].error_kind == "approval_denied"
}

assert(generic_tool_contracts_provider_free_ok(generic_tool_contracts_live_package))
assert(generic_tool_contracts_success_ok(generic_tool_contracts_live_package.invoke_success))
assert(generic_tool_contracts_validation_error_ok(generic_tool_contracts_live_package.invoke_validation_error))
assert(generic_tool_contracts_projection_ok(generic_tool_contracts_live_package.registry_descriptor_projection))

generic_tool_contracts_live_package_summary := string.format(
"generic_tool_contracts dialect_exports=%d projection_exports=%d provider_free=%s live_network=%s success_artifacts=%d validation_error=%s projected_tools=%d",
#generic_tool_contracts_live_package.dialect_exports,
#generic_tool_contracts_live_package.projection_exports,
tostring(generic_tool_contracts_live_package.provider_free),
tostring(generic_tool_contracts_live_package.live_network),
#generic_tool_contracts_live_package.invoke_success.artifact_refs,
generic_tool_contracts_live_package.invoke_validation_error.error.kind,
#generic_tool_contracts_live_package.registry_descriptor_projection.projected_tools
)

print(generic_tool_contracts_live_package_summary)
