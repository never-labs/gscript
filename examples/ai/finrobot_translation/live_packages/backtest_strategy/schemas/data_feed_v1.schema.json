{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/backtest_strategy/data_feed_v1.schema.json",
  "title": "FinRobot Backtest Data Feed Fixture",
  "type": "object",
  "required": [
    "provider_free",
    "live_network",
    "fixture_key",
    "symbol",
    "timeframe",
    "timezone",
    "calendar",
    "currency",
    "source_ref",
    "deterministic_seed",
    "rows"
  ],
  "properties": {
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "real_dependency_imports": {"const": false},
    "fixture_key": {"type": "string"},
    "symbol": {"type": "string"},
    "timeframe": {"type": "string"},
    "timezone": {"type": "string"},
    "calendar": {"type": "string"},
    "currency": {"type": "string"},
    "source_ref": {"type": "string"},
    "deterministic_seed": {"type": "string"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timestamp", "open", "high", "low", "close", "volume"],
        "properties": {
          "timestamp": {"type": "string"},
          "open": {"type": "number"},
          "high": {"type": "number"},
          "low": {"type": "number"},
          "close": {"type": "number"},
          "volume": {"type": "integer"},
          "provider_free": {"const": true},
          "live_network": {"const": false}
        }
      }
    }
  }
}
