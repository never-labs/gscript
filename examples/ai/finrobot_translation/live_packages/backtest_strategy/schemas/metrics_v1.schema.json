{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/backtest_strategy/metrics_v1.schema.json",
  "title": "FinRobot Backtest Metrics",
  "type": "object",
  "required": [
    "provider_free",
    "live_network",
    "fixture_key",
    "strategy_id",
    "symbol",
    "deterministic_seed",
    "metrics",
    "risk_limits"
  ],
  "properties": {
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "real_dependency_imports": {"const": false},
    "fixture_key": {"type": "string"},
    "strategy_id": {"type": "string"},
    "symbol": {"type": "string"},
    "deterministic_seed": {"type": "string"},
    "metrics": {
      "type": "object",
      "required": [
        "start_cash",
        "end_value",
        "total_return",
        "annualized_return",
        "volatility",
        "sharpe",
        "max_drawdown",
        "win_rate",
        "trade_count",
        "turnover",
        "average_exposure",
        "max_exposure"
      ]
    },
    "risk_limits": {
      "type": "array",
      "items": {"$ref": "risk_limits_v1.schema.json"},
      "minItems": 1
    }
  }
}

