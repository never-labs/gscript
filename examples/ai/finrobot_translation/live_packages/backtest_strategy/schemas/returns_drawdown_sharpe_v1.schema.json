{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/backtest_strategy/returns_drawdown_sharpe_v1.schema.json",
  "title": "FinRobot Backtest Returns Drawdown Sharpe Series",
  "type": "object",
  "required": [
    "provider_free",
    "live_network",
    "fixture_key",
    "strategy_id",
    "symbol",
    "deterministic_seed",
    "source_ref",
    "summary",
    "rows"
  ],
  "properties": {
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "fixture_key": {
      "type": "string"
    },
    "strategy_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "deterministic_seed": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "start_value",
        "end_value",
        "total_return",
        "max_drawdown",
        "annualization_factor",
        "full_period_sharpe"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "portfolio_value",
          "daily_return",
          "cumulative_return",
          "drawdown",
          "rolling_sharpe"
        ]
      }
    }
  }
}
