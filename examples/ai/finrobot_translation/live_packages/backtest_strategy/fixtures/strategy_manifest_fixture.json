{
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "fixture_key": "strategy_manifest:sma_cross:offline:v1",
  "strategy_id": "sma_cross_strategy",
  "strategy_class": "SmaCrossStrategy",
  "source_module": "backtrader.Strategy",
  "deterministic_seed": "finrobot-backtest-strategy-offline-v1",
  "parameters": {
    "fast_window": 3,
    "slow_window": 5,
    "signal_field": "close",
    "order_on_close": true
  },
  "indicator_bindings": [
    {
      "indicator_id": "fast_sma",
      "source_module": "backtrader.Indicator",
      "lookback": 3,
      "warmup_bars": 3,
      "input_field": "close",
      "output_field": "sma_fast"
    },
    {
      "indicator_id": "slow_sma",
      "source_module": "backtrader.Indicator",
      "lookback": 5,
      "warmup_bars": 5,
      "input_field": "close",
      "output_field": "sma_slow"
    }
  ],
  "sizer_binding": {
    "sizer_id": "fixed_fractional_sizer",
    "source_module": "backtrader.Sizer",
    "cash_buffer_pct": 0.05,
    "max_position_pct": 0.35,
    "lot_size": 1,
    "risk_budget_pct": 0.02
  },
  "analyzer_bindings": [
    {
      "analyzer_id": "trade_ledger_analyzer",
      "source_module": "backtrader.Analyzer",
      "metric_keys": [
        "trade_count",
        "win_rate",
        "realized_pnl"
      ],
      "output_schema": "trade_ledger"
    },
    {
      "analyzer_id": "performance_metrics_analyzer",
      "source_module": "backtrader.Analyzer",
      "metric_keys": [
        "total_return",
        "sharpe",
        "max_drawdown",
        "turnover"
      ],
      "output_schema": "metrics"
    }
  ]
}

