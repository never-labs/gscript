{
  "id": "finrobot-backtest-strategy-contract",
  "version": "1.0.0",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "clean_skip_without_dependency": true,
  "source_module": "FinRobot.BackTraderUtils.back_test",
  "deterministic_seed": "finrobot-backtest-strategy-offline-v1",
  "modules": [
    {
      "id": "back_test",
      "source_module": "FinRobot.BackTraderUtils.back_test",
      "required_fields": [
        "strategy_manifest",
        "data_feed",
        "trade_ledger",
        "metrics",
        "risk_limits"
      ]
    },
    {
      "id": "strategy",
      "source_module": "backtrader.Strategy",
      "required_fields": [
        "strategy_id",
        "parameters",
        "signals",
        "order_intents"
      ]
    },
    {
      "id": "sizer",
      "source_module": "backtrader.Sizer",
      "required_fields": [
        "sizer_id",
        "cash_buffer_pct",
        "max_position_pct",
        "lot_size"
      ]
    },
    {
      "id": "indicator",
      "source_module": "backtrader.Indicator",
      "required_fields": [
        "indicator_id",
        "lookback",
        "warmup_bars",
        "output_field"
      ]
    },
    {
      "id": "analyzer",
      "source_module": "backtrader.Analyzer",
      "required_fields": [
        "analyzer_id",
        "metric_keys",
        "trade_ledger_schema",
        "metrics_schema"
      ]
    }
  ],
  "field_contracts": {
    "strategy_manifest": {
      "schema": "schemas/strategy_manifest_v1.schema.json",
      "fixture": "fixtures/strategy_manifest_fixture.json",
      "required_fields": [
        "strategy_id",
        "strategy_class",
        "parameters",
        "indicator_bindings",
        "sizer_binding",
        "analyzer_bindings",
        "deterministic_seed"
      ]
    },
    "data_feed": {
      "schema": "schemas/data_feed_v1.schema.json",
      "fixture": "fixtures/data_feed_ACME_daily_fixture.json",
      "required_fields": [
        "fixture_key",
        "symbol",
        "timeframe",
        "timezone",
        "calendar",
        "rows"
      ]
    },
    "trade_ledger": {
      "schema": "schemas/trade_ledger_v1.schema.json",
      "fixture": "fixtures/trade_ledger_ACME_fixture.json",
      "required_fields": [
        "trade_id",
        "order_id",
        "side",
        "quantity",
        "price",
        "commission",
        "slippage",
        "cash_after",
        "position_after",
        "realized_pnl"
      ]
    },
    "metrics": {
      "schema": "schemas/metrics_v1.schema.json",
      "fixture": "fixtures/metrics_ACME_fixture.json",
      "required_fields": [
        "total_return",
        "annualized_return",
        "volatility",
        "sharpe",
        "max_drawdown",
        "win_rate",
        "turnover",
        "risk_limits"
      ]
    },
    "risk_limits": {
      "schema": "schemas/risk_limits_v1.schema.json",
      "fixture": "fixtures/metrics_ACME_fixture.json",
      "required_fields": [
        "id",
        "metric",
        "limit",
        "observed",
        "status"
      ]
    }
  },
  "acceptance_gates": [
    "BackTraderUtils.back_test can be replayed from provider-free fixtures without importing Backtrader",
    "strategy, sizer, indicator, and analyzer output contracts are explicit and schema-backed",
    "data feed, trade ledger, metrics, deterministic seed, and risk limits are fixture-backed",
    "optional dependencies clean-skip when Backtrader or pandas are unavailable"
  ]
}

