{
  "schema_version": 1,
  "id": "generic-optional-adapter-boundary",
  "package_name": "leia-generic-ai-optional-adapter-boundary",
  "package_boundary_id": "generic-ai-optional-adapter-boundary",
  "capability_id": "generic.ai.optional_adapter.boundary",
  "version": "0.1.0-skeleton",
  "description": "Provider-free generic AI package for optional adapter registries, dependency gates, result envelopes, version and terms metadata, credential redaction, no-live-import defaults, and clean skips.",
  "provider_free": true,
  "domain_specific": false,
  "live_network_default": false,
  "live_model_default": false,
  "real_dependency_import_default": false,
  "depends_on_q_runtime": false,
  "credential_required_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "contract_root": "contracts",
  "entrypoints": {
    "main": "main.leia",
    "contract": "contracts/generic_optional_adapter_boundary_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json"
  },
  "schemas": {
    "registry": "schemas/optional_adapter_registry_v1.schema.json",
    "gate": "schemas/optional_adapter_gate_v1.schema.json",
    "result_envelope": "schemas/optional_adapter_result_envelope_v1.schema.json"
  },
  "contracts": {
    "contract": "contracts/generic_optional_adapter_boundary_contract.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json",
    "optional_adapter_boundary": "fixtures/optional_adapter_boundary_fixture.json"
  },
  "capabilities": [
    "generic.ai.optional_adapter.boundary",
    "generic.ai.optional_adapter.registry",
    "generic.ai.optional_dependency.gate",
    "generic.ai.optional_adapter.result_envelope",
    "generic.ai.optional_adapter.version_metadata",
    "generic.ai.optional_adapter.terms_metadata",
    "generic.ai.optional_adapter.credential_redaction",
    "generic.ai.optional_adapter.clean_skip",
    "generic.ai.optional_adapter.no_live_import_default"
  ],
  "capability_surfaces": [
    "adapter_registry",
    "dependency_gate",
    "result_envelope",
    "version_metadata",
    "terms_metadata",
    "credential_redaction",
    "clean_skip",
    "no_live_import_default"
  ],
  "default_policy": {
    "mode": "fixture_replay",
    "provider_policy": "provider-free",
    "live_network": false,
    "live_model_calls": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "no_live_import_default": true,
    "clean_skip_without_dependency": true,
    "fixture_hook": "recorded_generic_optional_adapter_boundary_fixture"
  },
  "test_gates": [
    "optional adapter registry contract fixtures decode without importing optional dependencies",
    "dependency gate contract fixtures clean-skip when packages, credentials, or live network are absent",
    "adapter result envelope contract fixtures expose status, capability, fixture_key, data, and metadata",
    "version and terms metadata contract fixtures are metadata-only and provider-free",
    "credential redaction contract fixtures never expose secret values"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide built-in leia-generic-ai-optional-adapter-boundary adapters, optional dependency imports, credentials, or network clients; this provider-free package boundary owns optional adapter registry, dependency gate, result envelope, version metadata, terms metadata, credential redaction, and clean-skip contracts."
  }
}
