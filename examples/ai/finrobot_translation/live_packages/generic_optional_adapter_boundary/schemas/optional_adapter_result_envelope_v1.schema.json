{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic optional adapter result envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "live_model_calls",
    "no_live_import_default",
    "adapter_registry",
    "dependency_gates",
    "result_envelopes",
    "version_metadata",
    "terms_metadata",
    "credential_redaction",
    "adapter_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "live_model_calls": {
      "const": false
    },
    "no_live_import_default": {
      "const": true
    },
    "adapter_registry": {
      "type": "array"
    },
    "dependency_gates": {
      "type": "array"
    },
    "result_envelopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "status",
          "capability",
          "fixture_key",
          "data",
          "metadata"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok",
              "skipped"
            ]
          },
          "capability": {
            "type": "string"
          },
          "fixture_key": {
            "type": "string"
          },
          "data": {},
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "version_metadata": {
      "type": "array"
    },
    "terms_metadata": {
      "type": "array"
    },
    "credential_redaction": {
      "type": "array"
    },
    "adapter_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "dependency_imported",
          "credential_required",
          "live_network",
          "clean_skip"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "dependency_imported": {
            "const": false
          },
          "credential_required": {
            "type": "boolean"
          },
          "live_network": {
            "const": false
          },
          "clean_skip": {
            "const": true
          }
        }
      }
    }
  }
}
