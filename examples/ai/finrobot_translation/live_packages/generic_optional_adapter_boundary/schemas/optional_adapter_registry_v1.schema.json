{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic optional adapter registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "adapter_registry"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "adapter_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapter_id",
          "capability",
          "package_name",
          "import_name",
          "fixture_key",
          "output_schema",
          "no_live_import_default"
        ],
        "properties": {
          "adapter_id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "package_name": {
            "type": "string"
          },
          "import_name": {
            "type": "string"
          },
          "fixture_key": {
            "type": "string"
          },
          "output_schema": {
            "type": "string"
          },
          "no_live_import_default": {
            "const": true
          }
        }
      }
    }
  }
}
