{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt_catalog_v1",
  "type": "object",
  "required": ["id", "version", "capability", "source_path", "entries"],
  "properties": {
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "id": {"type": "string"},
    "version": {"type": "string"},
    "capability": {"const": "finance.analyzer.prompt.catalog"},
    "source_path": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "section_id", "requires_evidence", "requires_citations"],
        "properties": {
          "id": {"type": "string"},
          "section_id": {"enum": ["risk", "thesis", "valuation", "news"]},
          "requires_evidence": {"const": true},
          "requires_citations": {"const": true}
        }
      }
    }
  }
}
