// Provider-free live package skeleton for FinRobot analyzer report contracts.
//
// The JSON manifest and fixtures are the contract of record. This executable
// mirror keeps the skeleton discoverable without importing analyzer.py,
// finance provider SDKs, or live model clients.

analyzer_report_live_package := {
    id: "finrobot-analyzer-report-live-package"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    live_model_calls: false
    prompt_catalogs: {
        {id: "finance_analysis_prompt_library" capability: "finance.analyzer.prompt.catalog" fixture_key: "prompt_catalog:finance_analysis:v1"},
        {id: "analyzer_report_orchestrator" capability: "finance.analyzer.report.orchestrate" fixture_key: "prompt_catalog:analyzer_report:v1"},
    }
    sections: {
        {id: "risk" envelope: "risk_output_v1" min_source_refs: 2},
        {id: "thesis" envelope: "thesis_output_v1" min_source_refs: 2},
        {id: "valuation" envelope: "valuation_output_v1" min_source_refs: 2},
        {id: "news" envelope: "news_output_v1" min_source_refs: 2},
    }
    evidence_rules: {
        rejects_unresolved_refs: true
        requires_source_quote_or_metric: true
        requires_fixture_key: true
        requires_provider_free: true
    }
    section_schema_registry: {
        capability: "finance.analyzer.section.schema.registry"
        deterministic_order: {"risk", "thesis", "valuation", "news"}
        registry_version: "2026-06-11.offline"
    }
    evidence_requirement_matrix: {
        capability: "finance.analyzer.evidence.matrix"
        rows: {
            {section_id: "risk" required_evidence_kinds: {"filing", "fundamental_metric"} clean_degradation_mode: "omit_claim_and_warn"},
            {section_id: "thesis" required_evidence_kinds: {"earnings_transcript", "fundamental_metric"} clean_degradation_mode: "balanced_view_with_warnings"},
            {section_id: "valuation" required_evidence_kinds: {"fundamental_metric", "earnings_transcript"} clean_degradation_mode: "suppress_target_until_supported"},
            {section_id: "news" required_evidence_kinds: {"news_event", "earnings_transcript"} clean_degradation_mode: "downgrade_to_no_current_catalyst"},
        }
    }
    citation_normalization: {
        capability: "finance.analyzer.citation.normalize"
        source_id_case: "lower_snake"
        dedupe_repeated_refs: true
        preserve_first_seen_order: true
    }
    source_freshness_policy: {
        capability: "finance.analyzer.source.freshness.warn"
        warning_level_for_stale_sources: "section_warning"
        block_on_stale_source: false
    }
    analyst_role_prompt_envelope: {
        capability: "finance.analyzer.prompt.analyst_role.envelope"
        role: "equity_research_analyst"
        fallback_instruction: "omit unsupported claims"
    }
    missing_evidence_degradation: {
        capability: "finance.analyzer.evidence.degrade_clean"
        fixture_key: "analyzer_report:ACME:missing-evidence:offline:v1"
        expected_validated: false
    }
    replay: {
        fixture_key: "analyzer_report:ACME:offline:v1"
        deterministic_order: true
        expected_section_ids: {"risk", "thesis", "valuation", "news"}
    }
}

func analyzer_section_ok(section) {
    if section == nil {
        return false
    }
    return section.id != nil && section.envelope != nil && section.min_source_refs >= 2
}

analyzer_report_section_count := 0
for i := 1; i <= #analyzer_report_live_package.sections; i++ {
    section := analyzer_report_live_package.sections[i]
    assert(analyzer_section_ok(section))
    analyzer_report_section_count = analyzer_report_section_count + 1
}

assert(analyzer_report_live_package.provider_free == true)
assert(analyzer_report_live_package.live_network == false)
assert(analyzer_report_live_package.real_dependency_imports == false)
assert(analyzer_report_live_package.live_model_calls == false)
assert(#analyzer_report_live_package.prompt_catalogs == 2)
assert(analyzer_report_section_count == 4)
assert(analyzer_report_live_package.evidence_rules.rejects_unresolved_refs == true)
assert(analyzer_report_live_package.evidence_rules.requires_source_quote_or_metric == true)
assert(#analyzer_report_live_package.section_schema_registry.deterministic_order == 4)
assert(#analyzer_report_live_package.evidence_requirement_matrix.rows == 4)
assert(analyzer_report_live_package.citation_normalization.dedupe_repeated_refs == true)
assert(analyzer_report_live_package.source_freshness_policy.block_on_stale_source == false)
assert(analyzer_report_live_package.analyst_role_prompt_envelope.role == "equity_research_analyst")
assert(analyzer_report_live_package.missing_evidence_degradation.expected_validated == false)
assert(analyzer_report_live_package.replay.deterministic_order == true)
assert(#analyzer_report_live_package.replay.expected_section_ids == 4)

analyzer_report_live_package_summary := string.format(
"analyzer_report_live_package catalogs=%d sections=%d provider_free=%s live_network=%s model_calls=%s replay=%s",
#analyzer_report_live_package.prompt_catalogs,
analyzer_report_section_count,
tostring(analyzer_report_live_package.provider_free),
tostring(analyzer_report_live_package.live_network),
tostring(analyzer_report_live_package.live_model_calls),
analyzer_report_live_package.replay.fixture_key
)

print(analyzer_report_live_package_summary)
