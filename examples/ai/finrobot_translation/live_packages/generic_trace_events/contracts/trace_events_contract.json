{
  "schema_version": 1,
  "id": "generic-ai-trace-events-contract",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "capability": "generic.ai.trace.events",
  "emit_shape": "ai.trace.emit",
  "required_event_types": [
    "turn_start",
    "stream",
    "tool",
    "artifact",
    "approval",
    "replay",
    "turn_end",
    "tool_call",
    "tool_result",
    "approval_replay_trace",
    "workflow_step",
    "replay_record_matched",
    "agent_start",
    "agent_turn_tool_dispatch",
    "agent_done"
  ],
  "required_event_fields": [
    "schema_version",
    "fixture_key",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "trace_id",
    "run_id",
    "turn_id",
    "event_id",
    "event_type",
    "capability",
    "sequence",
    "sequence_marker",
    "timestamp_ms",
    "correlation",
    "redaction",
    "payload",
    "replay"
  ],
  "correlation_id_fields": [
    "trace_id",
    "run_id",
    "turn_id",
    "event_id",
    "parent_event_id",
    "tool_call_id",
    "artifact_id",
    "approval_id",
    "replay_id",
    "workflow_run_id",
    "workflow_step_id",
    "agent_run_id",
    "replay_session_id"
  ],
  "sequence_marker": {
    "name": "fixture_sequence",
    "clock": "fixture_monotonic_ms",
    "strictly_increasing": true,
    "start_sequence": 1
  },
  "redaction_contract": {
    "policy_ref": "fixtures/redaction_policy_fixture.json",
    "default_action": "hash_or_drop",
    "hash_algorithm": "sha256",
    "provider_request_id_policy": "drop",
    "raw_prompt_policy": "hash",
    "raw_completion_policy": "hash"
  },
  "replay_contract": {
    "mode": "deterministic_fixture_replay",
    "fixture": "fixtures/trace_sequence_ACME_fixture.json",
    "match_keys": [
      "trace_id",
      "event_id",
      "sequence",
      "event_type"
    ],
    "mismatch_policy": "fail_closed",
    "allow_live_sink": false
  },
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Trace storage, hosted telemetry export, and provider SDK trace streams are external package responsibilities."
  },
  "trace_envelope_contract": {
    "schema": "schemas/trace_envelope_v1.schema.json",
    "fixture": "fixtures/trace_envelope_fixture.json",
    "required_fields": [
      "trace_id",
      "event_id",
      "event_type",
      "timestamp_ms",
      "sequence",
      "correlation"
    ],
    "required_correlation_id_fields": [
      "turn_id",
      "tool_call_id",
      "approval_id",
      "workflow_run_id",
      "workflow_step_id",
      "agent_run_id",
      "replay_session_id",
      "parent_event_id"
    ],
    "covered_surfaces": [
      "turn",
      "tool",
      "approval",
      "workflow",
      "replay",
      "agent"
    ],
    "provider_free": true,
    "live_network": false,
    "live_model": false,
    "credentials_required": false
  },
  "external_envelope_projections": [
    {
      "id": "generic-approval-trace-to-ai-trace-approval",
      "source_package": "generic-ai-approval-policy",
      "source_schema": "../generic_approval_policy/schemas/approval_trace_envelope_v1.schema.json",
      "source_fixture": "../generic_approval_policy/fixtures/approval_trace_envelope_fixture.json",
      "source_kind": "generic_ai_approval_trace",
      "target_schema": "schemas/trace_event_v1.schema.json",
      "target_fixture": "fixtures/approval_trace_projection_fixture.json",
      "target_event_type": "approval",
      "target_capability": "ai.trace.approval",
      "required_source_paths": [
        "trace_id",
        "fixture_key",
        "request.request_id",
        "request.tool",
        "request.capability",
        "request.risk_level",
        "decision.status",
        "decision.approval_id",
        "result.status",
        "result.secret_values_present",
        "replay.deterministic"
      ],
      "required_target_paths": [
        "trace_id",
        "event_id",
        "event_type",
        "capability",
        "correlation.tool_call_id",
        "correlation.approval_id",
        "payload.operation",
        "payload.decision",
        "payload.policy_id",
        "payload.capability",
        "payload.risk_level",
        "payload.result_status",
        "redaction.secret_values_present",
        "replay.deterministic"
      ],
      "null_policy": "preserve_source_nulls_in_payload_and_use_stable_trace_correlation_fallbacks",
      "provider_free": true,
      "live_network": false,
      "live_model": false,
      "credentials_required": false,
      "real_dependency_imports": false
    },
    {
      "id": "generic-tool-invocation-to-ai-trace-tool",
      "source_package": "generic-tool-registry-live-package",
      "source_schema": "../generic_tool_registry/schemas/tool_invocation_trace.schema.json",
      "source_fixture": "../generic_tool_registry/fixtures/tool_registry_replay_trace_fixture.json",
      "source_kind": "generic_tool_invocation_trace",
      "target_schema": "schemas/trace_event_v1.schema.json",
      "target_fixture": "fixtures/tool_invocation_projection_fixture.json",
      "target_event_type": "tool",
      "target_capability": "ai.trace.tool",
      "required_source_paths": [
        "trace.trace_id",
        "trace.tool_name",
        "trace.caller_id",
        "trace.executor_id",
        "trace.capability_ids",
        "trace.events",
        "trace.schema_validation",
        "trace.approval.decision",
        "trace.result.status",
        "trace.result.content",
        "trace.provenance.fixture_key"
      ],
      "required_target_paths": [
        "trace_id",
        "event_id",
        "event_type",
        "capability",
        "correlation.tool_call_id",
        "payload.tool_call_id",
        "payload.tool_name",
        "payload.caller_id",
        "payload.executor_id",
        "payload.capability_ids",
        "payload.schema_validation",
        "payload.approval_decision",
        "payload.status",
        "payload.input_digest",
        "payload.output_digest",
        "payload.source_fixture_key",
        "redaction.secret_values_present",
        "replay.deterministic"
      ],
      "null_policy": "stable_trace_correlation_fallbacks_for_missing_external_ids",
      "provider_free": true,
      "live_network": false,
      "live_model": false,
      "credentials_required": false,
      "real_dependency_imports": false
    },
    {
      "id": "generic-model-turn-replay-to-trace-envelope",
      "source_packages": [
        "generic-model-io-envelope",
        "generic-turn-runner",
        "generic-record-replay"
      ],
      "source_fixtures": [
        "../generic_model_io_envelope/fixtures/provider_free_replay_fixture.json",
        "../generic_turn_runner/fixtures/ai_turn_execute_fixture.json",
        "../generic_turn_runner/fixtures/replay_record_match_fixture.json",
        "../generic_record_replay/fixtures/ordered_records_fixture.json"
      ],
      "target_schema": "schemas/model_turn_replay_trace_projection_v1.schema.json",
      "target_fixture": "fixtures/model_turn_replay_trace_projection_fixture.json",
      "target_event_types": [
        "turn_start",
        "turn_end",
        "replay_record_matched"
      ],
      "target_capability": "ai.trace.model_turn_replay_projection",
      "required_source_paths": [
        "model_io.records[0].request.turn_id",
        "model_io.records[0].request.metadata.trace_id",
        "model_io.replay.replay_session_id",
        "model_io.records[0].response.status",
        "turn_execution.replay.request_hash",
        "turn_execution.replay.record_id",
        "turn_replay_match.record_id",
        "record_replay.records[0].record_id",
        "record_replay.records[0].request_hash",
        "record_replay.records[0].response_hash"
      ],
      "required_target_paths": [
        "projected_events[0].event_type",
        "projected_events[0].correlation.turn_id",
        "projected_events[0].correlation.replay_session_id",
        "projected_events[1].event_type",
        "projected_events[1].payload.turn_record_id",
        "projected_events[2].event_type",
        "projected_events[2].payload.record_replay_record_id",
        "projected_events[2].payload.request_hash",
        "projected_events[2].payload.response_hash"
      ],
      "identity_policy": "explicit_mapping_only_no_cross_package_id_equality_assumption",
      "provider_free": true,
      "live_network": false,
      "live_model": false,
      "credentials_required": false,
      "real_dependency_imports": false
    },
    {
      "id": "generic-tool-approval-result-composition",
      "source_packages": [
        "generic-tool-registry-live-package",
        "generic-ai-approval-policy",
        "generic-tool-contracts-live-package"
      ],
      "source_fixtures": [
        "../generic_tool_registry/fixtures/approval_edge_fixture.json",
        "../generic_approval_policy/fixtures/approval_trace_envelope_fixture.json",
        "../generic_tool_contracts/fixtures/invoke_validation_error_fixture.json"
      ],
      "target_schema": "schemas/tool_approval_result_composition_v1.schema.json",
      "target_fixture": "fixtures/tool_approval_result_composition_fixture.json",
      "target_event_types": [
        "tool_call",
        "approval_replay_trace",
        "tool_result"
      ],
      "target_capability": "ai.trace.tool_approval_result_composition",
      "required_source_paths": [
        "tool_registry.trace.tool_name",
        "tool_registry.trace.approval.decision",
        "tool_registry.trace.result.status",
        "approval_policy.request.tool",
        "approval_policy.request.capability",
        "approval_policy.decision.status",
        "approval_policy.result.executed",
        "tool_contracts.request.tool_name",
        "tool_contracts.result.ok",
        "tool_contracts.result.error.kind",
        "tool_contracts.result.replay.replay_key"
      ],
      "required_target_paths": [
        "identity_policy.canonical_tool_call_id",
        "projected_events[0].event_type",
        "projected_events[0].correlation.tool_call_id",
        "projected_events[1].event_type",
        "projected_events[1].payload.decision",
        "projected_events[2].event_type",
        "projected_events[2].payload.result_replay_key"
      ],
      "identity_policy": "explicit_canonical_keys_with_source_provenance_no_source_id_equality_assumption",
      "provider_free": true,
      "live_network": false,
      "live_model": false,
      "credentials_required": false,
      "real_dependency_imports": false
    }
  ]
}
