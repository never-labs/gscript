{
  "schema_version": 1,
  "id": "generic-ai-trace-events-live-package",
  "package_name": "leia-generic-ai-trace-events",
  "version": "0.1.0-skeleton",
  "description": "Provider-free live package skeleton for generic.ai.trace.events and ai.trace.emit turn, stream, tool, artifact, approval, replay, workflow, and agent trace event envelopes.",
  "source_modules": [
    "examples/ai/finrobot_translation/ai_dialect_index/index.json",
    "examples/ai/finrobot_translation/ai_dialect_index/backend_plan.json",
    "examples/ai/finrobot_translation/ai_dialect_index/fixtures/generic_trace_envelope_fixture.json"
  ],
  "provider_free": true,
  "live_network_default": false,
  "real_dependency_import_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "dialect_symbols": [
    "generic.ai.trace.events",
    "ai.trace.emit"
  ],
  "credentials": {
    "required": [],
    "optional": [],
    "secret_env_patterns": [],
    "policy": "No credentials are declared by this skeleton; provider SDK traces, hosted telemetry, storage sinks, and model-specific event adapters belong only to future provider-specific packages."
  },
  "default_policy": {
    "mode": "fixture_replay",
    "live_network": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "telemetry_sink_required": false,
    "clean_skip_without_sink": true,
    "fixture_hook": "recorded_generic_trace_events_fixture"
  },
  "entrypoints": {
    "smoke": "main.leia",
    "trace_events_contract": "contracts/trace_events_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json",
    "trace_sequence_fixture": "fixtures/trace_sequence_ACME_fixture.json",
    "redaction_policy_fixture": "fixtures/redaction_policy_fixture.json",
    "trace_envelope_fixture": "fixtures/trace_envelope_fixture.json"
  },
  "schemas": {
    "trace_event": "schemas/trace_event_v1.schema.json",
    "trace_sequence": "schemas/trace_sequence_v1.schema.json",
    "redaction_policy": "schemas/redaction_policy_v1.schema.json",
    "correlation_ids": "schemas/correlation_ids_v1.schema.json",
    "trace_envelope": "schemas/trace_envelope_v1.schema.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json",
    "trace_sequence": "fixtures/trace_sequence_ACME_fixture.json",
    "redaction_policy": "fixtures/redaction_policy_fixture.json",
    "trace_envelope": "fixtures/trace_envelope_fixture.json"
  },
  "capabilities": [
    "generic.ai.trace.events",
    "ai.trace.emit",
    "ai.trace.turn_start",
    "ai.trace.stream",
    "ai.trace.tool",
    "ai.trace.artifact",
    "ai.trace.approval",
    "ai.trace.replay",
    "ai.trace.redaction_policy",
    "ai.trace.correlation_ids",
    "ai.trace.sequence_marker",
    "ai.trace.fixture_replay",
    "ai.trace.envelope",
    "ai.trace.turn_end",
    "ai.trace.tool_call",
    "ai.trace.tool_result",
    "ai.trace.workflow_step",
    "ai.trace.replay_record_matched",
    "ai.trace.agent_start",
    "ai.trace.agent_turn_tool_dispatch",
    "ai.trace.agent_done",
    "ai.trace.workflow_correlation",
    "ai.trace.agent_correlation"
  ],
  "event_contracts": [
    {
      "event_type": "turn_start",
      "capability": "ai.trace.turn_start",
      "required_payload_fields": [
        "model_alias",
        "message_count",
        "tools_declared",
        "provider_name"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "stream",
      "capability": "ai.trace.stream",
      "required_payload_fields": [
        "chunk_index",
        "delta_kind",
        "text_preview",
        "token_count"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "tool",
      "capability": "ai.trace.tool",
      "required_payload_fields": [
        "tool_call_id",
        "tool_name",
        "status",
        "input_digest",
        "output_digest"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "artifact",
      "capability": "ai.trace.artifact",
      "required_payload_fields": [
        "artifact_id",
        "artifact_kind",
        "media_type",
        "content_hash"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "approval",
      "capability": "ai.trace.approval",
      "required_payload_fields": [
        "approval_id",
        "operation",
        "decision",
        "policy_id"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "replay",
      "capability": "ai.trace.replay",
      "required_payload_fields": [
        "replay_fixture_key",
        "matched_event_count",
        "mismatch_count",
        "deterministic"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "turn_end",
      "capability": "ai.trace.turn_end",
      "required_payload_fields": [
        "status",
        "message_count",
        "output_digest"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "tool_call",
      "capability": "ai.trace.tool_call",
      "required_payload_fields": [
        "tool_call_id",
        "tool_name",
        "status",
        "input_digest"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "tool_result",
      "capability": "ai.trace.tool_result",
      "required_payload_fields": [
        "tool_call_id",
        "tool_name",
        "status",
        "output_digest"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "approval_replay_trace",
      "capability": "ai.trace.approval",
      "required_payload_fields": [
        "approval_id",
        "tool_call_id",
        "decision",
        "policy_id"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "workflow_step",
      "capability": "ai.trace.workflow_step",
      "required_payload_fields": [
        "workflow_run_id",
        "workflow_step_id",
        "status"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "replay_record_matched",
      "capability": "ai.trace.replay_record_matched",
      "required_payload_fields": [
        "replay_session_id",
        "matched_event_id",
        "deterministic"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "agent_start",
      "capability": "ai.trace.agent_start",
      "required_payload_fields": [
        "agent_run_id",
        "status"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "agent_turn_tool_dispatch",
      "capability": "ai.trace.agent_turn_tool_dispatch",
      "required_payload_fields": [
        "agent_run_id",
        "turn_id",
        "tool_call_id",
        "status"
      ],
      "provider_name_policy": "generic_or_redacted"
    },
    {
      "event_type": "agent_done",
      "capability": "ai.trace.agent_done",
      "required_payload_fields": [
        "agent_run_id",
        "status"
      ],
      "provider_name_policy": "generic_or_redacted"
    }
  ],
  "sequence_policy": {
    "marker": "fixture_sequence",
    "clock": "fixture_monotonic_ms",
    "start_sequence": 1,
    "strictly_increasing": true,
    "dedupe_key_fields": [
      "trace_id",
      "event_id",
      "sequence"
    ],
    "terminal_event_types": [
      "replay"
    ]
  },
  "correlation_policy": {
    "required_ids": [
      "trace_id",
      "run_id",
      "turn_id",
      "event_id"
    ],
    "optional_ids": [
      "parent_event_id",
      "tool_call_id",
      "artifact_id",
      "approval_id",
      "replay_id",
      "workflow_run_id",
      "workflow_step_id",
      "agent_run_id",
      "replay_session_id"
    ],
    "format": "stable-provider-free-strings",
    "provider_request_id_policy": "omitted_or_redacted"
  },
  "redaction_policy": {
    "fixture": "fixtures/redaction_policy_fixture.json",
    "default_action": "hash_or_drop",
    "secret_fields": [
      "api_key",
      "authorization",
      "cookie",
      "provider_request_id",
      "raw_prompt",
      "raw_completion"
    ],
    "allowed_preview_fields": [
      "text_preview",
      "status",
      "artifact_kind",
      "decision"
    ],
    "hash_algorithm": "sha256"
  },
  "replay_contract": {
    "mode": "deterministic_fixture_replay",
    "fixture": "fixtures/trace_sequence_ACME_fixture.json",
    "matching_keys": [
      "trace_id",
      "event_id",
      "sequence",
      "event_type"
    ],
    "mismatch_policy": "fail_closed",
    "allow_live_sink": false
  },
  "test_gates": [
    "manifest and referenced JSON files decode without external dependencies",
    "provider_free is true and live_network_default is false",
    "generic.ai.trace.events and ai.trace.emit capabilities are provider-free and fixture-replay only",
    "turn_start, stream, tool, artifact, approval, and replay event schemas require correlation IDs and a sequence marker",
    "trace fixture records strictly increasing sequence values using fixture_monotonic_ms",
    "redaction policy hashes or drops secrets and permits only explicit previews",
    "provider request IDs and provider names are omitted, generic, or redacted",
    "fixture replay matches trace_id, event_id, sequence, and event_type without live telemetry sinks",
    "trace envelope fixture covers turn, tool, approval, workflow, replay, and agent correlation IDs under the generic trace events package boundary",
    "workflow and agent trace envelope event types remain provider-free and live-network disabled"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide built-in generic AI trace emission, hosted telemetry, or trace storage sinks; leia-generic-ai-trace-events defines the provider-free package boundary."
  }
}
