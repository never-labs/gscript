{
  "schema_version": 1,
  "policy_id": "generic-trace-redaction-v1",
  "provider_free": true,
  "live_network": false,
  "default_action": "hash_or_drop",
  "hash_algorithm": "sha256",
  "secret_fields": [
    "api_key",
    "authorization",
    "cookie",
    "provider_request_id",
    "raw_prompt",
    "raw_completion",
    "tool_input_raw",
    "tool_output_raw"
  ],
  "drop_fields": [
    "api_key",
    "authorization",
    "cookie",
    "provider_request_id"
  ],
  "hash_fields": [
    "raw_prompt",
    "raw_completion",
    "tool_input_raw",
    "tool_output_raw"
  ],
  "allowed_preview_fields": [
    "text_preview",
    "status",
    "artifact_kind",
    "decision",
    "model_alias",
    "tool_name"
  ],
  "provider_identity_policy": {
    "provider_name": "generic_or_redacted",
    "provider_request_id": "drop",
    "provider_endpoint": "drop"
  },
  "examples": [
    {
      "field": "raw_prompt",
      "action": "hash",
      "replacement": "sha256:prompt-fixture-digest"
    },
    {
      "field": "provider_request_id",
      "action": "drop",
      "replacement": null
    }
  ]
}
