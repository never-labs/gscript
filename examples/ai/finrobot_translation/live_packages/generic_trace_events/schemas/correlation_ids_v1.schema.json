{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/generic-ai/generic_trace_events/correlation_ids_v1.schema.json",
  "title": "Generic AI Trace Correlation IDs",
  "type": "object",
  "required": [
    "trace_id",
    "run_id",
    "turn_id",
    "event_id"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_event_id": {
      "type": "string"
    },
    "tool_call_id": {
      "type": "string"
    },
    "artifact_id": {
      "type": "string"
    },
    "approval_id": {
      "type": "string"
    },
    "replay_id": {
      "type": "string"
    }
  }
}
