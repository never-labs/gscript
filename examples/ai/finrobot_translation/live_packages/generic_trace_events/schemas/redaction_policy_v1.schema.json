{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/generic-ai/generic_trace_events/redaction_policy_v1.schema.json",
  "title": "Generic AI Trace Redaction Policy",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "provider_free",
    "live_network",
    "default_action",
    "hash_algorithm",
    "secret_fields",
    "drop_fields",
    "allowed_preview_fields",
    "provider_identity_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "default_action": {
      "enum": [
        "hash_or_drop",
        "drop"
      ]
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "secret_fields": {
      "type": "array",
      "minItems": 1
    },
    "drop_fields": {
      "type": "array"
    },
    "allowed_preview_fields": {
      "type": "array"
    },
    "provider_identity_policy": {
      "type": "object",
      "required": [
        "provider_name",
        "provider_request_id"
      ]
    }
  }
}
