    "chart_render_artifact_projection",
    "snapshot_metadata",
    "accessibility_checklist",
    "stale_data_policy",
    "renderer_clean_skip"
  ],
  "default_policy": {
    "mode": "fixture_replay",
    "provider_policy": "provider-free",
    "live_network": false,
    "live_model_calls": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "clean_skip_without_dependency": true,
    "clean_skip_without_renderer": true,
    "fixture_hook": "recorded_generic_evidence_report_artifacts_fixture"
  },
  "test_gates": [
    "evidence source annotations and citation envelopes resolve without provider calls",
    "report outline and section dependency DAG remain domain-neutral and provider-free",
    "artifact and render manifests declare planned outputs without invoking renderers",
    "verification-to-render projection preserves explicit source, citation, warning, artifact, and render request mappings",
    "chart render artifact projection preserves chart artifacts, warnings, source metadata, and snapshot hashes without invoking renderers",
    "snapshot metadata, stale warnings, and accessibility checks are deterministic fixtures",
    "renderer absence produces clean-skip metadata instead of failure"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide built-in leia-generic-ai-evidence-report-artifacts handling; this provider-free package boundary owns evidence, report, artifact, render, snapshot, stale-warning, accessibility, and clean-skip contracts."
  },
  "credentials": {
