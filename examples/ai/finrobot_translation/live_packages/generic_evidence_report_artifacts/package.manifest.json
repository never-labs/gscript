  "version": "0.1.0-skeleton",
  "description": "Provider-free generic AI package for evidence source annotations, citation envelopes, report outlines, section DAGs, artifact manifests, render manifests, chart artifact projection, snapshot metadata, stale-data warnings, accessibility checks, and renderer clean skips.",
  "provider_free": true,
  "domain_specific": false,
  "live_network_default": false,
  "live_model_default": false,
  "real_dependency_import_default": false,
  "depends_on_q_runtime": false,
  "credential_required_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "contract_root": "contracts",
  "entrypoints": {
    "main": "main.leia",
    "contract": "contracts/generic_evidence_report_artifacts_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json"
  },
  "schemas": {
    "evidence_report_artifacts": "schemas/generic_evidence_report_artifacts_v1.schema.json",
    "verification_render_projection": "schemas/verification_render_projection_v1.schema.json",
    "chart_render_artifact_projection": "schemas/chart_render_artifact_projection_v1.schema.json"
  },
  "contracts": {
