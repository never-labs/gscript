    "optional_env": [],
    "secret_env_patterns": [],
    "secret_refs": [],
    "provider_credentials_required": false,
    "policy": "No credentials are declared by leia-generic-ai-evidence-report-artifacts; provider credentials belong only to provider-specific adapter packages behind explicit capability gates."
