      "type": "string"
    },
    "identity_policy": {
      "type": "object"
    },
    "source_mappings": {
      "type": "array",
      "minItems": 1
    },
    "citation_mappings": {
      "type": "array",
      "minItems": 1
    },
    "warning_mappings": {
      "type": "array",
      "minItems": 1
    },
    "artifact_mappings": {
      "type": "array",
      "minItems": 1
    },
    "render_request_mappings": {
      "type": "array",
      "minItems": 1
