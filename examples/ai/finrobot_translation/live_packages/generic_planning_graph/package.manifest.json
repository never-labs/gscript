    "smoke": "main.leia",
    "main": "main.leia",
    "planning_graph_contract": "contracts/planning_graph_contract.json",
    "trace_fixture": "fixtures/planning_graph_trace_fixture.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json"
  },
  "schemas": {
    "planning_graph": "schemas/planning_graph.schema.json",
    "planning_trace": "schemas/planning_trace.schema.json"
