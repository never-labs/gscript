    "generic.planning.dependency.validate",
    "generic.planning.retry.replay",
    "generic.planning.branch.merge",
    "generic.planning.trace.evidence"
  ],
  "default_policy": {
    "mode": "fixture_replay",
    "provider_free": true,
    "live_network": false,
    "live_model": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "clean_skip_without_dependency": true,
    "fixture_hook": "recorded_generic_planning_graph_fixture"
  },
  "test_gates": [
    "plan nodes declare generic node_type and do not encode provider or domain-specific semantics",
    "dependencies form an acyclic graph with explicit branch and merge edges",
    "retry metadata is deterministic fixture evidence, not provider behavior",
    "trace evidence references every plan node, edge, retry, branch, and merge event"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide leia-generic-ai-planning-graph as a built-in; this provider-free package boundary owns planning graph semantics."
  },
