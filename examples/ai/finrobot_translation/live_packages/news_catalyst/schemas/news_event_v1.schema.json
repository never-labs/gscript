{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/finrobot/news_event_v1.schema.json",
  "title": "FinRobotNewsEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "headline",
    "source_name",
    "published_at",
    "category",
    "sentiment",
    "relevance_score",
    "impact_score",
    "source_rank"
  ],
  "properties": {
    "event_id": {"type": "string"},
    "headline": {"type": "string"},
    "source_name": {"type": "string"},
    "published_at": {"type": "string", "format": "date-time"},
    "url": {"type": "string"},
    "category": {
      "type": "string",
      "enum": ["earnings", "guidance", "product", "regulatory", "macro", "mna", "litigation", "analyst", "retail_sentiment"]
    },
    "sentiment": {
      "type": "string",
      "enum": ["positive", "neutral", "negative", "mixed"]
    },
    "relevance_score": {"type": "number", "minimum": 0, "maximum": 1},
    "impact_score": {"type": "number", "minimum": -1, "maximum": 1},
    "source_rank": {"type": "integer", "minimum": 1},
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
