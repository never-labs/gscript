{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/finrobot/retail_sentiment_snapshot_v1.schema.json",
  "title": "FinRobotRetailSentimentSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_key",
    "provider_free",
    "live_network",
    "ticker",
    "as_of",
    "aggregate_score",
    "mention_volume",
    "bullish_ratio",
    "bearish_ratio",
    "platform_snapshots"
  ],
  "properties": {
    "fixture_key": {"type": "string"},
    "provider_free": {"type": "boolean", "const": true},
    "live_network": {"type": "boolean", "const": false},
    "ticker": {"type": "string"},
    "as_of": {"type": "string", "format": "date-time"},
    "aggregate_score": {"type": "number", "minimum": -1, "maximum": 1},
    "mention_volume": {"type": "integer", "minimum": 0},
    "bullish_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "bearish_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "neutral_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "platform_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "fixture_key", "sentiment_score", "mention_volume", "bullish_ratio", "bearish_ratio", "confidence"],
        "properties": {
          "platform": {"type": "string", "enum": ["polymarket", "x_social", "reddit"]},
          "fixture_key": {"type": "string"},
          "sentiment_score": {"type": "number", "minimum": -1, "maximum": 1},
          "mention_volume": {"type": "integer", "minimum": 0},
          "bullish_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "bearish_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "normalization": {"type": "object"}
  }
}
