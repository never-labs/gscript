{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/finrobot/source_ranking_v1.schema.json",
  "title": "FinRobotSourceRankingV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_name",
    "rank",
    "trust_score",
    "recency_score",
    "directness_score",
    "rationale"
  ],
  "properties": {
    "source_name": {"type": "string"},
    "rank": {"type": "integer", "minimum": 1},
    "trust_score": {"type": "number", "minimum": 0, "maximum": 1},
    "recency_score": {"type": "number", "minimum": 0, "maximum": 1},
    "directness_score": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string"}
  }
}
