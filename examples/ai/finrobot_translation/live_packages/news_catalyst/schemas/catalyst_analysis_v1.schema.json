{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/finrobot/catalyst_analysis_v1.schema.json",
  "title": "FinRobotCatalystAnalysisV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_key",
    "provider_free",
    "live_network",
    "ticker",
    "as_of",
    "news_events",
    "source_rankings",
    "catalysts",
    "impact_summary"
  ],
  "properties": {
    "fixture_key": {"type": "string"},
    "provider_free": {"type": "boolean", "const": true},
    "live_network": {"type": "boolean", "const": false},
    "ticker": {"type": "string"},
    "as_of": {"type": "string", "format": "date-time"},
    "news_events": {
      "type": "array",
      "items": {"$ref": "news_event_v1.schema.json"}
    },
    "source_rankings": {
      "type": "array",
      "items": {"$ref": "source_ranking_v1.schema.json"}
    },
    "catalysts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalyst_id", "catalyst_type", "direction", "impact_score", "time_horizon", "confidence", "evidence_event_ids"],
        "properties": {
          "catalyst_id": {"type": "string"},
          "catalyst_type": {"type": "string"},
          "direction": {"type": "string", "enum": ["positive", "neutral", "negative", "mixed"]},
          "impact_score": {"type": "number", "minimum": -1, "maximum": 1},
          "time_horizon": {"type": "string", "enum": ["near_term", "medium_term", "long_term"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_event_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "impact_summary": {"type": "object"},
    "calibration_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "scenario",
          "input_event_ids",
          "expected_primary_event_id",
          "expected_category",
          "expected_direction",
          "expected_ranked_event_ids",
          "score_components",
          "explanation"
        ],
        "properties": {
          "case_id": {"type": "string"},
          "scenario": {
            "type": "string",
            "enum": [
              "conflicting_news",
              "recency_decay",
              "source_trust",
              "category_conflict",
              "retail_sentiment_conflict"
            ]
          },
          "input_event_ids": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string"}
          },
          "expected_primary_event_id": {"type": "string"},
          "expected_category": {
            "type": "string",
            "enum": ["earnings", "guidance", "product", "regulatory", "macro", "mna", "litigation", "analyst", "retail_sentiment"]
          },
          "expected_direction": {
            "type": "string",
            "enum": ["positive", "neutral", "negative", "mixed"]
          },
          "expected_ranked_event_ids": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string"}
          },
          "score_components": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trust",
              "recency",
              "relevance",
              "impact",
              "conflict_penalty",
              "retail_sentiment_adjustment",
              "final_score"
            ],
            "properties": {
              "trust": {"type": "number", "minimum": 0, "maximum": 1},
              "recency": {"type": "number", "minimum": 0, "maximum": 1},
              "relevance": {"type": "number", "minimum": 0, "maximum": 1},
              "impact": {"type": "number", "minimum": -1, "maximum": 1},
              "conflict_penalty": {"type": "number", "minimum": -1, "maximum": 0},
              "retail_sentiment_adjustment": {"type": "number", "minimum": -1, "maximum": 1},
              "final_score": {"type": "number", "minimum": -1, "maximum": 1}
            }
          },
          "explanation": {"type": "string"}
        }
      }
    }
  }
}
