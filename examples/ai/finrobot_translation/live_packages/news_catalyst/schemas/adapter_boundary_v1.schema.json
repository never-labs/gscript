{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/finrobot/adapter_boundary_v1.schema.json",
  "title": "FinRobotRetailSentimentAdapterBoundaryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "capability",
    "adapter_kind",
    "fixture_key",
    "live_network",
    "dependency_imported",
    "credential_required",
    "clean_skip"
  ],
  "properties": {
    "id": {"type": "string", "enum": ["polymarket", "x_social", "reddit"]},
    "display_name": {"type": "string"},
    "capability": {"type": "string"},
    "adapter_kind": {"type": "string", "enum": ["prediction_market", "social_stream", "community_thread"]},
    "fixture_key": {"type": "string"},
    "live_network": {"type": "boolean", "const": false},
    "dependency_imported": {"type": "boolean", "const": false},
    "credential_required": {"type": "boolean", "const": false},
    "clean_skip": {"type": "boolean", "const": true},
    "terms": {"type": "object"}
  }
}
