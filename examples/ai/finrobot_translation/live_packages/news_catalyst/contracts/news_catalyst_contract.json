{
  "schema_version": 1,
  "id": "finrobot-news-catalyst-contract",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "fixture_hook": "recorded_news_catalyst_live_fixture",
  "modules": [
    {
      "id": "news_integrator",
      "source_module": "news_integrator.py",
      "inputs": [
        "ticker",
        "as_of",
        "news_window"
      ],
      "outputs": [
        "news_events",
        "source_rankings"
      ],
      "required_fields": [
        "relevance_score",
        "category",
        "sentiment",
        "impact_score",
        "source_rank"
      ]
    },
    {
      "id": "catalyst_analyzer",
      "source_module": "catalyst_analyzer.py",
      "inputs": [
        "news_events",
        "retail_sentiment_snapshot",
        "financial_context"
      ],
      "outputs": [
        "catalysts",
        "impact_summary"
      ],
      "required_fields": [
        "catalyst_type",
        "direction",
        "impact_score",
        "time_horizon",
        "evidence_event_ids"
      ]
    },
    {
      "id": "retail_sentiment_client",
      "source_module": "retail_sentiment_client.py",
      "inputs": [
        "ticker",
        "as_of",
        "platform_boundaries"
      ],
      "outputs": [
        "retail_sentiment_snapshot",
        "platform_snapshots"
      ],
      "required_fields": [
        "aggregate_score",
        "mention_volume",
        "bullish_ratio",
        "bearish_ratio",
        "platform"
      ]
    }
  ],
  "field_contracts": {
    "relevance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "category": {
      "type": "enum",
      "values": [
        "earnings",
        "guidance",
        "product",
        "regulatory",
        "macro",
        "mna",
        "litigation",
        "analyst",
        "retail_sentiment"
      ]
    },
    "sentiment": {
      "type": "enum",
      "values": [
        "positive",
        "neutral",
        "negative",
        "mixed"
      ]
    },
    "impact_score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "source_ranking": {
      "type": "ordered_list",
      "sort": [
        "trust_score desc",
        "recency desc",
        "source_name asc"
      ]
    },
    "retail_sentiment_snapshot": {
      "type": "snapshot",
      "platforms": [
        "polymarket",
        "x_social",
        "reddit"
      ]
    }
  },
  "fixtures": [
    {
      "fixture_key": "news_catalyst:ACME:2026-06-11",
      "path": "fixtures/news_catalyst_ACME_fixture.json",
      "schema": "schemas/catalyst_analysis_v1.schema.json",
      "replay_ready": true
    },
    {
      "fixture_key": "retail_sentiment:ACME:2026-06-11",
      "path": "fixtures/retail_sentiment_ACME_snapshot.json",
      "schema": "schemas/retail_sentiment_snapshot_v1.schema.json",
      "replay_ready": true
    }
  ],
  "acceptance_gates": [
    "news events include relevance, category, sentiment, impact, source rank, and source provenance",
    "source rankings are deterministic and explain trust, recency, and directness components",
    "catalyst output links impact scores back to evidence event ids",
    "retail sentiment snapshots aggregate Polymarket, X, and Reddit fixture boundaries",
    "fixture replay succeeds without credentials, live network, or provider SDK imports"
  ]
}
