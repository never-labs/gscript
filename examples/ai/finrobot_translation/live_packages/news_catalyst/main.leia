// Provider-free live package skeleton for FinRobot news and catalyst analysis.
//
// The manifest and contracts are the contract of record. This executable
// mirror keeps the package discoverable by smoke tests without importing or
// calling live news, Polymarket, X, or Reddit clients.

news_catalyst_live_package := {
    id: "finrobot-news-catalyst-live-package"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    default_policy: {
        mode: "fixture_replay"
        live_network: false
        provider_credentials_required: false
        real_dependency_imports: false
        clean_skip_without_dependency: true
        fixture_hook: "recorded_news_catalyst_live_fixture"
    }
    modules: {
        {
            id: "news_integrator"
            source_module: "news_integrator.py"
            capabilities: {"ai.news.source.ingest.schema", "ai.news.event.extract", "ai.news.freshness.evaluate", "ai.news.dedupe.confidence.envelope", "finance.news.fetch.fixture", "finance.news.relevance.score", "finance.news.category.classify", "finance.news.sentiment.score", "finance.news.source.rank"}
            required_fields: {"relevance_score", "category", "sentiment", "impact_score", "source_rank"}
        },
        {
            id: "catalyst_analyzer"
            source_module: "catalyst_analyzer.py"
            capabilities: {"ai.catalyst.classification.taxonomy", "ai.prompt.contract.news_event_catalyst", "finance.catalyst.detect", "finance.catalyst.impact.score", "finance.catalyst.time_horizon.classify", "finance.catalyst.evidence.link"}
            required_fields: {"catalyst_type", "direction", "impact_score", "time_horizon", "evidence_event_ids"}
        },
        {
            id: "retail_sentiment_client"
            source_module: "retail_sentiment_client.py"
            capabilities: {"finance.retail_sentiment.snapshot", "finance.retail_sentiment.platform.aggregate", "finance.retail_sentiment.volume.normalize", "finance.retail_sentiment.adapter.boundary"}
            required_fields: {"aggregate_score", "mention_volume", "bullish_ratio", "bearish_ratio", "platform"}
        },
    }
    adapter_boundaries: {
        {id: "polymarket" capability: "finance.retail_sentiment.polymarket.market_snapshot" fixture_key: "polymarket:market_snapshot:ACME:offline" live_network: false dependency_imported: false credential_required: false clean_skip: true},
        {id: "x_social" capability: "finance.retail_sentiment.x.mention_snapshot" fixture_key: "x:mention_snapshot:ACME:offline" live_network: false dependency_imported: false credential_required: false clean_skip: true},
        {id: "reddit" capability: "finance.retail_sentiment.reddit.thread_snapshot" fixture_key: "reddit:thread_snapshot:ACME:offline" live_network: false dependency_imported: false credential_required: false clean_skip: true},
    }
    fixture_keys: {
        "event_extraction:ACME:2026-06-11",
        "news_catalyst:ACME:2026-06-11",
        "retail_sentiment:ACME:2026-06-11",
        "adapter_boundary:ACME:offline",
    }
    dialect_capabilities: {
        "ai.news.source.ingest.schema",
        "ai.news.event.extract",
        "ai.catalyst.classification.taxonomy",
        "ai.news.freshness.evaluate",
        "ai.news.dedupe.confidence.envelope",
        "ai.prompt.contract.news_event_catalyst",
    }
}

func news_catalyst_module_ok(module) {
    if module == nil {
        return false
    }
    if news_catalyst_live_package.provider_free != true || news_catalyst_live_package.live_network != false || news_catalyst_live_package.real_dependency_imports != false {
        return false
    }
    return module.id != nil && module.source_module != nil && #module.capabilities >= 4 && #module.required_fields >= 5
}

func news_catalyst_boundary_ok(boundary) {
    if boundary == nil {
        return false
    }
    return boundary.live_network == false && boundary.dependency_imported == false && boundary.credential_required == false && boundary.clean_skip == true && boundary.capability != nil && boundary.fixture_key != nil
}

news_catalyst_module_count := 0
for i := 1; i <= #news_catalyst_live_package.modules; i++ {
    module := news_catalyst_live_package.modules[i]
    assert(news_catalyst_module_ok(module))
    news_catalyst_module_count = news_catalyst_module_count + 1
}

news_catalyst_boundary_count := 0
for i := 1; i <= #news_catalyst_live_package.adapter_boundaries; i++ {
    boundary := news_catalyst_live_package.adapter_boundaries[i]
    assert(news_catalyst_boundary_ok(boundary))
    news_catalyst_boundary_count = news_catalyst_boundary_count + 1
}

assert(news_catalyst_module_count == 3)
assert(news_catalyst_boundary_count == 3)
assert(#news_catalyst_live_package.fixture_keys == 4)
assert(#news_catalyst_live_package.dialect_capabilities == 6)
assert(news_catalyst_live_package.default_policy.mode == "fixture_replay")
assert(news_catalyst_live_package.default_policy.clean_skip_without_dependency == true)

news_catalyst_live_package_summary := string.format(
"news_catalyst_live_package modules=%d adapters=%d provider_free=%s live_network=%s imports=%s fixtures=%d dialect_capabilities=%d",
news_catalyst_module_count,
news_catalyst_boundary_count,
tostring(news_catalyst_live_package.provider_free),
tostring(news_catalyst_live_package.live_network),
tostring(news_catalyst_live_package.real_dependency_imports),
#news_catalyst_live_package.fixture_keys,
#news_catalyst_live_package.dialect_capabilities
)

print(news_catalyst_live_package_summary)
