{
  "schema_version": 1,
  "id": "finrobot-optional-integrations-live-package",
  "package_name": "leia-finrobot-optional-integrations",
  "version": "0.1.0-skeleton",
  "description": "Provider-free live package skeleton for FinRobot optional integrations with capability gates and clean fixture-only skips.",
  "source_examples": [
    "examples/ai/finrobot_translation/optional_integrations.leia",
    "examples/ai/finrobot_translation/optional_integrations_manifest.json"
  ],
  "provider_free": true,
  "live_network_default": false,
  "real_dependency_import_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "credentials": {
    "required": [],
    "optional": [],
    "secret_env_patterns": [],
    "policy": "No credentials are declared by this skeleton; optional provider keys and local endpoints belong only to future provider-specific packages."
  },
  "default_policy": {
    "mode": "fixture_replay",
    "live_network": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "clean_skip_without_dependency": true,
    "fixture_hook": "recorded_optional_live_fixture"
  },
  "entrypoints": {
    "capability_gates": "contracts/optional_integration_capability_gates.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json",
    "smoke": "main.leia"
  },
  "schemas": {
    "capability_gate": "schemas/optional_integration_gate.schema.json",
    "fixture_index": "schemas/optional_fixture_index.schema.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json"
  },
  "integrations": [
    {
      "id": "fingpt",
      "display_name": "FinGPT",
      "package_name": "fingpt",
      "import_name": "fingpt",
      "capability": "optional.ai.fingpt.forecast",
      "fixture_key": "fingpt:forecast:ACME:2026-06-11",
      "output_schema": "fingpt_forecast_v1",
      "clean_skip": true,
      "skip_reason": "optional dependency fingpt is not installed"
    },
    {
      "id": "finrl",
      "display_name": "FinRL",
      "package_name": "finrl",
      "import_name": "finrl",
      "capability": "optional.quant.finrl.strategy",
      "fixture_key": "finrl:strategy:ACME:offline",
      "output_schema": "finrl_strategy_v1",
      "clean_skip": true,
      "skip_reason": "optional dependency finrl is not installed"
    },
    {
      "id": "finml",
      "display_name": "FinML",
      "package_name": "finml",
      "import_name": "finml",
      "capability": "optional.quant.finml.factor_model",
      "fixture_key": "finml:factors:ACME:offline",
      "output_schema": "finml_factor_model_v1",
      "clean_skip": true,
      "skip_reason": "optional dependency finml is not installed"
    },
    {
      "id": "backtrader",
      "display_name": "Backtrader",
      "package_name": "backtrader",
      "import_name": "backtrader",
      "capability": "optional.quant.backtrader.backtest",
      "fixture_key": "backtrader:sma_cross:ACME:offline",
      "output_schema": "backtrader_backtest_v1",
      "clean_skip": true,
      "skip_reason": "optional dependency backtrader is not installed"
    },
    {
      "id": "mplfinance",
      "display_name": "mplfinance",
      "package_name": "mplfinance",
      "import_name": "mplfinance",
      "capability": "optional.chart.mplfinance.render",
      "fixture_key": "mplfinance:candles:ACME:offline",
      "output_schema": "mplfinance_chart_artifact_v1",
      "clean_skip": true,
      "skip_reason": "optional dependency mplfinance is not installed"
    },
    {
      "id": "openbb",
      "display_name": "OpenBB",
      "package_name": "openbb",
      "import_name": "openbb",
      "capability": "optional.data.openbb.market_data",
      "fixture_key": "openbb:market_data:ACME:offline",
      "output_schema": "openbb_market_data_v1",
      "clean_skip": true,
      "skip_reason": "optional dependency openbb is not installed"
    },
    {
      "id": "ollama",
      "display_name": "Ollama",
      "package_name": "ollama",
      "import_name": "ollama",
      "capability": "optional.llm.ollama.local",
      "fixture_key": "ollama:function_call:ACME:offline",
      "output_schema": "ollama_function_call_v1",
      "clean_skip": true,
      "skip_reason": "optional dependency ollama is not installed"
    }
  ],
  "test_gates": [
    "manifest and referenced schemas decode without external dependencies",
    "provider_free is true and live_network_default is false",
    "required and optional credentials are empty",
    "all optional integrations declare unique capability and fixture gates",
    "clean skip is true for every optional dependency",
    "main.leia contains no live import statements or provider SDK execution"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide these optional FinRobot integrations as built-ins; future external packages must satisfy these gates explicitly."
  }
}
