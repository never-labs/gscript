// Provider-free live package skeleton for FinRobot optional integrations.
//
// This file mirrors the manifest for smoke tests only. It does not import,
// load, or execute any optional provider package.

optional_live_package := {
    id: "finrobot-optional-integrations-live-package"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    default_policy: {
        mode: "fixture_replay"
        live_network: false
        provider_credentials_required: false
        real_dependency_imports: false
        clean_skip_without_dependency: true
        fixture_hook: "recorded_optional_live_fixture"
    }
    integrations: {
        {id: "fingpt" package_name: "fingpt" import_name: "fingpt" capability: "optional.ai.fingpt.forecast" fixture_key: "fingpt:forecast:ACME:2026-06-11" clean_skip: true dependency_imported: false live_network: false},
        {id: "finrl" package_name: "finrl" import_name: "finrl" capability: "optional.quant.finrl.strategy" fixture_key: "finrl:strategy:ACME:offline" clean_skip: true dependency_imported: false live_network: false},
        {id: "finml" package_name: "finml" import_name: "finml" capability: "optional.quant.finml.factor_model" fixture_key: "finml:factors:ACME:offline" clean_skip: true dependency_imported: false live_network: false},
        {id: "backtrader" package_name: "backtrader" import_name: "backtrader" capability: "optional.quant.backtrader.backtest" fixture_key: "backtrader:sma_cross:ACME:offline" clean_skip: true dependency_imported: false live_network: false},
        {id: "mplfinance" package_name: "mplfinance" import_name: "mplfinance" capability: "optional.chart.mplfinance.render" fixture_key: "mplfinance:candles:ACME:offline" clean_skip: true dependency_imported: false live_network: false},
        {id: "openbb" package_name: "openbb" import_name: "openbb" capability: "optional.data.openbb.market_data" fixture_key: "openbb:market_data:ACME:offline" clean_skip: true dependency_imported: false live_network: false},
        {id: "ollama" package_name: "ollama" import_name: "ollama" capability: "optional.llm.ollama.local" fixture_key: "ollama:function_call:ACME:offline" clean_skip: true dependency_imported: false live_network: false},
    }
}

func optional_live_gate_ok(gate) {
    if gate == nil {
        return false
    }
    if optional_live_package.provider_free != true || optional_live_package.live_network != false || optional_live_package.real_dependency_imports != false {
        return false
    }
    if optional_live_package.default_policy.mode != "fixture_replay" || optional_live_package.default_policy.clean_skip_without_dependency != true {
        return false
    }
    return gate.clean_skip == true && gate.dependency_imported == false && gate.live_network == false && gate.capability != nil && gate.fixture_key != nil
}

optional_live_clean_skip_count := 0
optional_live_imported_count := 0
for i := 1; i <= #optional_live_package.integrations; i++ {
    gate := optional_live_package.integrations[i]
    assert(optional_live_gate_ok(gate))
    if gate.clean_skip {
        optional_live_clean_skip_count = optional_live_clean_skip_count + 1
    }
    if gate.dependency_imported {
        optional_live_imported_count = optional_live_imported_count + 1
    }
}

assert(optional_live_clean_skip_count == 7)
assert(optional_live_imported_count == 0)

optional_live_package_summary := string.format(
"optional_integrations_live_package integrations=%d provider_free=%s live_network=%s imports=%s clean_skip=%d",
#optional_live_package.integrations,
tostring(optional_live_package.provider_free),
tostring(optional_live_package.live_network),
tostring(optional_live_package.real_dependency_imports),
optional_live_clean_skip_count
)

print(optional_live_package_summary)
