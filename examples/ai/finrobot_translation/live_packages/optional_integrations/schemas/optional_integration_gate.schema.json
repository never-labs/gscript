{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/finrobot/optional_integration_gate.schema.json",
  "title": "FinRobot optional integration capability gate",
  "type": "object",
  "required": [
    "id",
    "capability",
    "package_name",
    "import_name",
    "fixture_key",
    "clean_skip",
    "live_network",
    "dependency_imported",
    "version_metadata",
    "tool_adapter_result_envelope",
    "absence_gates",
    "terms_metadata",
    "credential_redaction"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "pattern": "^optional\\."
    },
    "package_name": {
      "type": "string"
    },
    "import_name": {
      "type": "string"
    },
    "fixture_key": {
      "type": "string"
    },
    "clean_skip": {
      "const": true
    },
    "requires_credentials": {
      "const": false
    },
    "live_network": {
      "const": false
    },
    "dependency_imported": {
      "const": false
    },
    "no_live_import_default": {
      "const": true
    },
    "provider_credentials_required": {
      "const": false
    },
    "credential_absent_safe": {
      "const": true
    },
    "status_without_dependency": {
      "const": "skipped"
    },
    "request_schema": {
      "type": "object"
    },
    "version_metadata": {
      "type": "object",
      "required": [
        "package",
        "version_source",
        "dependency_absent_status"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "version_source": {
          "const": "fixture_metadata"
        },
        "minimum_supported": {
          "type": "string"
        },
        "dependency_absent_status": {
          "const": "skipped"
        }
      },
      "additionalProperties": true
    },
    "tool_adapter_result_envelope": {
      "type": "object"
    },
    "absence_gates": {
      "type": "object"
    },
    "terms_metadata": {
      "type": "object"
    },
    "credential_redaction": {
      "type": "object",
      "required": [
        "status",
        "secret_values_present"
      ],
      "properties": {
        "status": {
          "const": "redacted"
        },
        "secret_values_present": {
          "const": false
        },
        "redacted_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
