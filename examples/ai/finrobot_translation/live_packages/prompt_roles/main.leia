// Provider-free live package skeleton for FinRobot prompt and role contracts.
//
// This smoke fixture is static metadata only. It does not import SDKs, load
// provider clients, or execute live model calls.

prompt_role_live_package := {
    id: "finrobot-prompt-roles-live-package"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    live_model_calls: false
    termination: "TERMINATE"
    catalogs: {
        {id: "agent_library" capability: "prompt.role.catalog.agent_library" fixture_key: "prompt_catalog:agent_library:v1"},
        {id: "prompts" capability: "prompt.role.catalog.prompts" fixture_key: "prompt_catalog:prompts:v1"},
        {id: "utils" capability: "prompt.role.catalog.utils" fixture_key: "prompt_catalog:utils:v1"},
        {id: "text_generator_agents" capability: "prompt.role.catalog.text_generator_agents" fixture_key: "prompt_catalog:text_generator_agents:v1"},
        {id: "equity_agents" capability: "prompt.role.catalog.equity_agents" fixture_key: "prompt_catalog:equity_agents:v1"},
    }
    roles: {
        {id: "Market_Analyst" version: "1.0.0" output_schema: "role_handoff_v1" termination: "TERMINATE"},
        {id: "Expert_Investor" version: "1.0.0" output_schema: "role_handoff_v1" termination: "TERMINATE"},
        {id: "Data_Analyst" version: "1.0.0" output_schema: "role_handoff_v1" termination: "TERMINATE"},
        {id: "Report_Section_Writer" version: "1.0.0" output_schema: "section_agent_output_v1" termination: "TERMINATE"},
    }
    section_output_schema: "section_agent_output_v1"
    evidence_validation_schema: "source_evidence_validation_v1"
}

func prompt_role_gate_ok() {
    return prompt_role_live_package.provider_free == true &&
        prompt_role_live_package.live_network == false &&
        prompt_role_live_package.real_dependency_imports == false &&
        prompt_role_live_package.live_model_calls == false &&
        prompt_role_live_package.termination == "TERMINATE"
}

prompt_role_catalog_count := 0
prompt_role_versioned_count := 0
for i := 1; i <= #prompt_role_live_package.catalogs; i++ {
    catalog := prompt_role_live_package.catalogs[i]
    assert(catalog.capability != nil && catalog.fixture_key != nil)
    prompt_role_catalog_count = prompt_role_catalog_count + 1
}
for i := 1; i <= #prompt_role_live_package.roles; i++ {
    role := prompt_role_live_package.roles[i]
    assert(role.version == "1.0.0" && role.termination == "TERMINATE")
    prompt_role_versioned_count = prompt_role_versioned_count + 1
}

assert(prompt_role_gate_ok())
assert(prompt_role_catalog_count == 5)
assert(prompt_role_versioned_count == 4)

prompt_role_live_package_summary := string.format(
"prompt_roles_live_package catalogs=%d roles=%d provider_free=%s live_network=%s model_calls=%s termination=%s",
prompt_role_catalog_count,
prompt_role_versioned_count,
tostring(prompt_role_live_package.provider_free),
tostring(prompt_role_live_package.live_network),
tostring(prompt_role_live_package.live_model_calls),
prompt_role_live_package.termination
)

print(prompt_role_live_package_summary)
