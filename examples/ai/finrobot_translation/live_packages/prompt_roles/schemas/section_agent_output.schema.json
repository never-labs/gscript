{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/prompt_roles/section_agent_output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["section_id", "title", "summary", "body", "key_points", "source_refs", "evidence_validation", "termination"],
  "properties": {
    "section_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "body": {"type": "string", "minLength": 1},
    "key_points": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_validation": {"$ref": "source_evidence_validation.schema.json"},
    "termination": {"const": "TERMINATE"}
  }
}
