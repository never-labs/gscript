{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/prompt_roles/source_evidence_validation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_free", "live_network", "validated", "unresolved_source_refs", "fixture_keys"],
  "properties": {
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "validated": {"type": "boolean"},
    "unresolved_source_refs": {"type": "array", "items": {"type": "string"}},
    "fixture_keys": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
