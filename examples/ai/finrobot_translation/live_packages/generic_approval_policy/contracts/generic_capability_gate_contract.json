{
  "schema_version": 1,
  "id": "generic-ai-capability-gate-contract",
  "package_name": "generic.ai.capability.gate",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "no_live_import_default": true,
  "clean_skip_without_dependency": true,
  "vocabulary_schema": "schemas/capability_vocabulary_v1.schema.json",
  "gate_schema": "schemas/capability_gate_v1.schema.json",
  "capability_vocabulary": [
    {
      "id": "local_read",
      "capability": "generic.ai.capability.local.read",
      "risk_level": "low",
      "default_decision": "allow_fixture",
      "requires_approval": false,
      "clean_skip": false,
      "provider_binding": "none"
    },
    {
      "id": "network_http",
      "capability": "generic.ai.capability.network.http",
      "risk_level": "medium",
      "default_decision": "deny",
      "requires_approval": true,
      "clean_skip": true,
      "provider_binding": "external"
    },
    {
      "id": "credential_read",
      "capability": "generic.ai.capability.credential.read",
      "risk_level": "critical",
      "default_decision": "deny",
      "requires_approval": true,
      "clean_skip": true,
      "provider_binding": "external"
    },
    {
      "id": "generated_code_execute",
      "capability": "generic.ai.capability.generated_code.execute",
      "risk_level": "high",
      "default_decision": "deny",
      "requires_approval": true,
      "clean_skip": true,
      "provider_binding": "external"
    },
    {
      "id": "trading_order_submit",
      "capability": "generic.ai.capability.trading.order_submit",
      "risk_level": "critical",
      "default_decision": "deny",
      "requires_approval": true,
      "clean_skip": true,
      "provider_binding": "external"
    },
    {
      "id": "portfolio_rebalance",
      "capability": "generic.ai.capability.portfolio.rebalance",
      "risk_level": "high",
      "default_decision": "deny",
      "requires_approval": true,
      "clean_skip": true,
      "provider_binding": "external"
    },
    {
      "id": "publish_web",
      "capability": "generic.ai.capability.publish.web",
      "risk_level": "medium",
      "default_decision": "deny",
      "requires_approval": true,
      "clean_skip": true,
      "provider_binding": "external"
    }
  ],
  "gate_defaults": {
    "exact_capability_match_required": true,
    "unknown_capability": "deny",
    "missing_dependency": "skipped",
    "missing_credential": "skipped",
    "missing_live_network": "skipped",
    "secret_values_present": false
  }
}
