{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/generic_ai_approval_policy/clean_skip_v1.schema.json",
  "title": "Generic AI clean skip envelope",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_key",
    "provider_free",
    "requested_capability",
    "risk_level",
    "status",
    "clean_skip",
    "skip_reason",
    "dependency_imported",
    "secret_values_present",
    "result_envelope"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "fixture_key": {"type": "string"},
    "provider_free": {"type": "boolean", "const": true},
    "live_network": {"type": "boolean", "const": false},
    "real_dependency_imports": {"type": "boolean", "const": false},
    "requested_capability": {"type": "string", "pattern": "^generic\\.ai\\.capability\\."},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "status": {"const": "skipped"},
    "clean_skip": {"type": "boolean", "const": true},
    "skip_reason": {"type": "string"},
    "dependency_imported": {"type": "boolean", "const": false},
    "credentials_required": {"type": "boolean"},
    "secret_values_present": {"type": "boolean", "const": false},
    "result_envelope": {"type": "object"}
  }
}
