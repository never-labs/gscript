{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/generic_ai_approval_policy/capability_gate_v1.schema.json",
  "title": "Generic AI capability gate",
  "type": "object",
  "required": [
    "capability",
    "risk_level",
    "default_decision",
    "requires_approval",
    "exact_capability_match_required",
    "provider_free"
  ],
  "properties": {
    "capability": {"type": "string", "pattern": "^generic\\.ai\\.capability\\."},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "default_decision": {"enum": ["allow_fixture", "deny"]},
    "requires_approval": {"type": "boolean"},
    "exact_capability_match_required": {"type": "boolean", "const": true},
    "provider_free": {"type": "boolean", "const": true},
    "live_network": {"type": "boolean", "const": false},
    "real_dependency_imports": {"type": "boolean", "const": false},
    "clean_skip": {"type": "boolean"}
  }
}
