{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/generic_ai_approval_policy/policy_outcome_v1.schema.json",
  "title": "Generic AI policy outcome",
  "type": "object",
  "required": ["id", "capability", "risk_level", "requires_approval", "decision", "result_status", "reason"],
  "properties": {
    "id": {"type": "string"},
    "capability": {"type": "string", "pattern": "^generic\\.ai\\.capability\\."},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "requires_approval": {"type": "boolean"},
    "grant": {"enum": ["fixture", "missing", "missing_dependency"]},
    "decision": {"enum": ["allowed", "denied", "skipped"]},
    "result_status": {"enum": ["ok", "denied", "skipped"]},
    "reason": {"type": "string"},
    "clean_skip": {"type": "boolean"}
  }
}
