{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/document_pipeline/section_extraction_v1.schema.json",
  "title": "FinRobot document pipeline section extraction",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "document_id",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "provider_free": {
      "type": "boolean",
      "const": true
    },
    "live_network": {
      "type": "boolean",
      "const": false
    },
    "document_id": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "section_title",
          "start_offset",
          "end_offset",
          "page_start",
          "page_end"
        ]
      }
    }
  }
}
