{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/document_pipeline/adapter_boundary_v1.schema.json",
  "title": "FinRobot document pipeline adapter boundary fixture",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "provider_free": {
      "type": "boolean",
      "const": true
    },
    "live_network": {
      "type": "boolean",
      "const": false
    },
    "real_dependency_imports": {
      "type": "boolean",
      "const": false
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "capability",
          "fixture_key",
          "live_network",
          "dependency_imported",
          "credential_required",
          "clean_skip",
          "clean_skip_reason",
          "policy",
          "gap"
        ]
      }
    }
  }
}
