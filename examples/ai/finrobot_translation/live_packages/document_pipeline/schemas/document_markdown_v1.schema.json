{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/document_pipeline/document_markdown_v1.schema.json",
  "title": "FinRobot document pipeline markdown conversion fixture",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "document_id",
    "accession_number",
    "source_url",
    "conversion",
    "markdown",
    "page_spans",
    "sections",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "provider_free": {
      "type": "boolean",
      "const": true
    },
    "live_network": {
      "type": "boolean",
      "const": false
    },
    "document_id": {
      "type": "string"
    },
    "accession_number": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "conversion": {
      "type": "object",
      "required": [
        "conversion_source",
        "converter",
        "html_supported",
        "pdf_supported",
        "warnings"
      ]
    },
    "markdown": {
      "type": "string",
      "minLength": 1
    },
    "page_spans": {
      "type": "array",
      "minItems": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "section_title",
          "start_offset",
          "end_offset",
          "page_start",
          "page_end"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "fixture_key",
        "accession_number",
        "captured_at",
        "live_network"
      ]
    }
  }
}
