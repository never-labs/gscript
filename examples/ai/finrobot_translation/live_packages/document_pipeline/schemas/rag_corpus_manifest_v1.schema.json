{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/document_pipeline/rag_corpus_manifest_v1.schema.json",
  "title": "FinRobot document pipeline RAG corpus manifest fixture",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "corpus_id",
    "document_id",
    "fixture_key",
    "source_fixture_keys",
    "chunk_fixture_key",
    "retriever_fixture_key",
    "chunk_ids",
    "citation_consistency",
    "vector_store_capabilities",
    "retriever_boundaries",
    "optional_dependencies"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "provider_free": {
      "type": "boolean",
      "const": true
    },
    "live_network": {
      "type": "boolean",
      "const": false
    },
    "corpus_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "fixture_key": {
      "type": "string"
    },
    "source_fixture_keys": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "chunk_fixture_key": {
      "type": "string"
    },
    "retriever_fixture_key": {
      "type": "string"
    },
    "chunk_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "citation_consistency": {
      "type": "object",
      "required": [
        "required_for_all_chunks",
        "required_for_answer_citations",
        "source_url",
        "accession_number",
        "section_ids",
        "offsets_required"
      ]
    },
    "vector_store_capabilities": {
      "type": "object",
      "required": [
        "adapter",
        "capability_gates",
        "dependency_imported",
        "credential_required",
        "live_network",
        "clean_skip",
        "skip_reason"
      ]
    },
    "retriever_boundaries": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "adapter",
          "input",
          "output",
          "fixture_key",
          "dependency_imported",
          "credential_required",
          "live_network",
          "clean_skip"
        ]
      }
    },
    "optional_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "purpose",
          "dependency_imported",
          "credential_required",
          "clean_skip",
          "skip_reason"
        ]
      }
    }
  }
}
