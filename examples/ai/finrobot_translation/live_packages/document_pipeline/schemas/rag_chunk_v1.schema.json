{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/document_pipeline/rag_chunk_v1.schema.json",
  "title": "FinRobot document pipeline RAG chunk fixture",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "document_id",
    "chunk_policy",
    "chunks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "provider_free": {
      "type": "boolean",
      "const": true
    },
    "live_network": {
      "type": "boolean",
      "const": false
    },
    "document_id": {
      "type": "string"
    },
    "chunk_policy": {
      "type": "object",
      "required": [
        "max_tokens",
        "overlap_tokens",
        "section_aware"
      ]
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "chunk_id",
          "section_id",
          "text",
          "token_count",
          "citation",
          "provenance",
          "embedding_ref"
        ],
        "properties": {
          "citation": {
            "type": "object",
            "required": [
              "source_url",
              "page",
              "section_title",
              "start_offset",
              "end_offset"
            ]
          },
          "provenance": {
            "type": "object",
            "required": [
              "accession_number",
              "fixture_key",
              "converter_fixture_key"
            ]
          },
          "embedding_ref": {
            "type": "object",
            "required": [
              "adapter",
              "embedding_id",
              "model"
            ]
          }
        }
      }
    }
  }
}
