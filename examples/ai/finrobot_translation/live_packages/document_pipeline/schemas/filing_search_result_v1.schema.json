{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/document_pipeline/filing_search_result_v1.schema.json",
  "title": "FinRobot document pipeline filing search result fixture",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "ticker",
    "query",
    "results"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "provider_free": {
      "type": "boolean",
      "const": true
    },
    "live_network": {
      "type": "boolean",
      "const": false
    },
    "ticker": {
      "type": "string"
    },
    "query": {
      "type": "object",
      "required": [
        "form_type",
        "user_agent_policy",
        "rate_limit_policy"
      ]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "accession_number",
          "cik",
          "company_name",
          "ticker",
          "form_type",
          "filing_date",
          "source_url",
          "document_url",
          "redirect_chain",
          "cache",
          "provenance"
        ],
        "properties": {
          "accession_number": {
            "type": "string"
          },
          "cik": {
            "type": "string"
          },
          "company_name": {
            "type": "string"
          },
          "ticker": {
            "type": "string"
          },
          "form_type": {
            "type": "string"
          },
          "filing_date": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "document_url": {
            "type": "string"
          },
          "redirect_chain": {
            "type": "array",
            "minItems": 1
          },
          "cache": {
            "type": "object",
            "required": [
              "key",
              "mode",
              "hit",
              "ttl_seconds"
            ]
          },
          "provenance": {
            "type": "object",
            "required": [
              "provider",
              "fixture_key",
              "captured_at",
              "live_network"
            ]
          }
        }
      }
    }
  }
}
