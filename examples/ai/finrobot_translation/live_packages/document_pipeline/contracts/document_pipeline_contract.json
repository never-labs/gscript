{
  "schema_version": 1,
  "id": "finrobot-document-pipeline-contract",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "fixture_hook": "recorded_document_pipeline_live_fixture",
  "modules": [
    {
      "id": "filings_src",
      "source_module": "filings_src/sec_api.py",
      "inputs": [
        "ticker",
        "form_type",
        "date_range"
      ],
      "outputs": [
        "filing_search_results",
        "filing_fetch_manifest"
      ],
      "required_fields": [
        "accession_number",
        "cik",
        "form_type",
        "filing_date",
        "source_url",
        "provenance"
      ]
    },
    {
      "id": "marker_sec_src",
      "source_module": "marker_sec_src/sec_filings_to_markdown.py",
      "inputs": [
        "filing_fetch_manifest",
        "html_or_pdf_bytes",
        "conversion_policy"
      ],
      "outputs": [
        "document_markdown",
        "section_extractions"
      ],
      "required_fields": [
        "markdown",
        "conversion_source",
        "page_spans",
        "section_id",
        "section_title",
        "source_offsets"
      ]
    },
    {
      "id": "rag",
      "source_module": "functional/rag.py",
      "inputs": [
        "document_markdown",
        "section_extractions",
        "chunk_policy"
      ],
      "outputs": [
        "rag_chunks",
        "rag_corpus_manifest",
        "citation_map",
        "vector_adapter_payload"
      ],
      "required_fields": [
        "chunk_id",
        "corpus_id",
        "text",
        "section_id",
        "citation",
        "provenance",
        "embedding_ref",
        "vector_store_capabilities"
      ]
    },
    {
      "id": "ragquery",
      "source_module": "functional/ragquery.py",
      "inputs": [
        "query",
        "retriever_policy",
        "retriever_boundaries",
        "rag_chunks"
      ],
      "outputs": [
        "retriever_query_result",
        "answer_citations"
      ],
      "required_fields": [
        "query",
        "answer",
        "retrieved_chunks",
        "rank",
        "score",
        "citation"
      ]
    }
  ],
  "field_contracts": {
    "filing_search": {
      "type": "list",
      "required": [
        "ticker",
        "cik",
        "accession_number",
        "form_type",
        "filing_date",
        "source_url"
      ]
    },
    "sec_access_policy": {
      "type": "metadata_only_boundary",
      "user_agent_required_for_live": true,
      "live_user_agent_declared": false,
      "rate_limit_policy": {
        "source": "SEC fair access policy",
        "max_requests_per_second": 10,
        "enforced_in_skeleton": false
      },
      "clean_skip_without_policy": true
    },
    "redirect_cache_metadata": {
      "type": "fetch_metadata",
      "required": [
        "redirect_chain",
        "cache.key",
        "cache.mode",
        "cache.hit",
        "cache.ttl_seconds"
      ],
      "live_network": false
    },
    "html_pdf_to_markdown": {
      "type": "conversion_boundary",
      "accepted_inputs": [
        "sec_html",
        "sec_pdf"
      ],
      "required_outputs": [
        "markdown",
        "page_spans",
        "conversion_warnings",
        "provenance"
      ]
    },
    "html_parser_boundary": {
      "type": "parser_boundary",
      "accepted_inputs": [
        "sec_html"
      ],
      "dependency_imports": false,
      "clean_skip": true,
      "required_outputs": [
        "normalized_dom_ref",
        "section_anchor_map",
        "table_policy"
      ]
    },
    "pdf_to_markdown_converter_boundary": {
      "type": "converter_boundary",
      "accepted_inputs": [
        "sec_pdf"
      ],
      "dependency_imports": false,
      "clean_skip": true,
      "required_outputs": [
        "page_spans",
        "layout_warnings",
        "markdown"
      ]
    },
    "section_extraction": {
      "type": "ordered_sections",
      "required_sections": [
        "business",
        "risk_factors",
        "mda"
      ]
    },
    "chunk_citation_provenance": {
      "type": "chunk_list",
      "required": [
        "chunk_id",
        "section_id",
        "citation.source_url",
        "citation.page",
        "citation.start_offset",
        "citation.end_offset",
        "provenance.accession_number",
        "provenance.source_fixture_key",
        "provenance.corpus_id"
      ]
    },
    "rag_corpus_manifest": {
      "type": "corpus_manifest",
      "required": [
        "corpus_id",
        "document_id",
        "source_fixture_keys",
        "chunk_fixture_key",
        "retriever_fixture_key",
        "chunk_ids",
        "citation_consistency",
        "vector_store_capabilities",
        "retriever_boundaries",
        "optional_dependencies"
      ],
      "live_network": false,
      "dependency_imports": false
    },
    "chunk_citation_vector_adapter_matrix": {
      "type": "adapter_matrix",
      "required_columns": [
        "stage",
        "input",
        "output",
        "adapter",
        "fixture_key",
        "clean_skip"
      ],
      "stages": [
        "chunk",
        "citation",
        "vector_payload"
      ],
      "live_network": false,
      "dependency_imports": false
    },
    "vector_retriever_adapter": {
      "type": "adapter_boundary",
      "dependency_imports": false,
      "live_network": false,
      "credential_required": false
    },
    "vector_store_capability_gates": {
      "type": "capability_gate_list",
      "required_capabilities": [
        "similarity_search",
        "metadata_filter"
      ],
      "optional_capabilities": [
        "persistent_index"
      ],
      "dependency_imports": false,
      "live_network": false,
      "clean_skip_without_dependency": true
    },
    "citation_consistency": {
      "type": "cross_fixture_consistency",
      "required": [
        "chunk ids in corpus manifest match chunk fixture",
        "retrieved chunk ids exist in chunk fixture",
        "answer citation chunk ids exist in retrieved chunks",
        "citation source URLs and pages match chunk fixture"
      ]
    },
    "embedding_retriever_clean_skip": {
      "type": "clean_skip_boundary",
      "embedding_dependency_imported": false,
      "retriever_dependency_imported": false,
      "langchain_dependency_imported": false,
      "vector_dependency_imported": false,
      "fallback_adapter": "fixture_vector_index",
      "skip_reason_required": true
    }
  },
  "fixtures": [
    {
      "fixture_key": "sec:filing_search:ACME:10-K:offline",
      "path": "fixtures/sec_filing_search_ACME_fixture.json",
      "schema": "schemas/filing_search_result_v1.schema.json",
      "replay_ready": true
    },
    {
      "fixture_key": "converter:sec_markdown:ACME:10-K:offline",
      "path": "fixtures/sec_markdown_ACME_10k_fixture.json",
      "schema": "schemas/document_markdown_v1.schema.json",
      "replay_ready": true
    },
    {
      "fixture_key": "rag:chunks:ACME:10-K:offline",
      "path": "fixtures/rag_chunks_ACME_10k_fixture.json",
      "schema": "schemas/rag_chunk_v1.schema.json",
      "replay_ready": true
    },
    {
      "fixture_key": "rag:corpus_manifest:ACME:10-K:offline",
      "path": "fixtures/rag_corpus_manifest_ACME_fixture.json",
      "schema": "schemas/rag_corpus_manifest_v1.schema.json",
      "replay_ready": true
    },
    {
      "fixture_key": "retriever:ragquery:ACME:offline",
      "path": "fixtures/retriever_query_ACME_fixture.json",
      "schema": "schemas/retriever_query_result_v1.schema.json",
      "replay_ready": true
    }
  ],
  "acceptance_gates": [
    "SEC filing search and fetch metadata includes accession number, CIK, filing date, source URL, user-agent policy, rate-limit policy, redirect chain, cache metadata, and replay provenance",
    "HTML parser and PDF-to-markdown converter boundaries return markdown with page spans, source offsets, and conversion warnings without invoking Marker or network clients",
    "section extraction preserves ordered business, risk factor, and MD&A section identifiers",
    "RAG chunks include stable chunk ids, corpus manifest linkage, citations, source offsets, accession provenance, and a chunk/citation/vector adapter matrix without embedding model calls",
    "RAG corpus manifest records chunk ids, source fixture keys, citation consistency, retriever adapter boundaries, vector store capability gates, and optional LangChain/vector dependency clean-skip metadata",
    "retriever query fixtures include ranked chunks, scores, answer citations, vector adapter metadata, retriever boundary references, and embedding/retriever clean-skip metadata",
    "fixture replay succeeds without credentials, live network, SEC clients, Marker, embedding models, LangChain, or vector database imports"
  ]
}
