{
  "schema_version": 1,
  "id": "finrobot-coding-notebook-live-package",
  "package_name": "leia-finrobot-coding-notebook",
  "version": "0.1.0-skeleton",
  "description": "Provider-free live package skeleton for FinRobot coding.py notebook, image display, and generated-code tooling contracts.",
  "source_modules": [
    "finrobot/functional/coding.py",
    "examples/ai/finrobot_translation/generated_code_tooling.leia"
  ],
  "provider_free": true,
  "live_network_default": false,
  "real_dependency_import_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "credentials": {
    "required": [],
    "optional": [],
    "secret_env_patterns": [],
    "policy": "No credentials are declared by this skeleton; live notebook kernels, file systems, and execution sandboxes must be supplied by future external packages behind capability gates."
  },
  "default_policy": {
    "mode": "fixture_replay",
    "live_network": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "sandbox_execution_default": "deny",
    "file_write_default": "deny",
    "image_display_default": "fixture_only",
    "clean_skip_without_dependency": true,
    "fixture_hook": "recorded_coding_notebook_fixture"
  },
  "entrypoints": {
    "smoke": "main.leia",
    "coding_notebook_contract": "contracts/coding_notebook_contract.json",
    "sandbox_policy_gates": "contracts/sandbox_policy_gates.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json",
    "denied_command_fixture": "fixtures/denied_command_fixture.json",
    "deterministic_replay_fixture": "fixtures/deterministic_replay_fixture.json"
  },
  "schemas": {
    "sandbox_command": "schemas/sandbox_command.schema.json",
    "file_image_artifact": "schemas/file_image_artifact.schema.json",
    "notebook_display": "schemas/notebook_display.schema.json",
    "capability_metadata": "schemas/capability_metadata.schema.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json",
    "denied_command": "fixtures/denied_command_fixture.json",
    "deterministic_replay": "fixtures/deterministic_replay_fixture.json"
  },
  "capabilities": [
    "coding.notebook.file.read",
    "coding.notebook.file.write",
    "coding.notebook.command.execute",
    "coding.notebook.command.deny",
    "coding.notebook.stdout.capture",
    "coding.notebook.stderr.capture",
    "coding.notebook.image.display",
    "coding.notebook.artifact.publish",
    "coding.notebook.replay.deterministic",
    "coding.notebook.metadata.capability"
  ],
  "capability_metadata": [
    {
      "id": "file_read",
      "capability": "coding.notebook.file.read",
      "default": "fixture",
      "schema": "file_image_artifact",
      "approval_required": false
    },
    {
      "id": "file_write",
      "capability": "coding.notebook.file.write",
      "default": "deny_without_approval",
      "schema": "file_image_artifact",
      "approval_required": true
    },
    {
      "id": "command_execute",
      "capability": "coding.notebook.command.execute",
      "default": "deny_without_approval",
      "schema": "sandbox_command",
      "approval_required": true
    },
    {
      "id": "display_image",
      "capability": "coding.notebook.image.display",
      "default": "fixture",
      "schema": "notebook_display",
      "approval_required": false
    },
    {
      "id": "deterministic_replay",
      "capability": "coding.notebook.replay.deterministic",
      "default": "fixture",
      "schema": "sandbox_command",
      "approval_required": false
    }
  ],
  "test_gates": [
    "manifest and referenced JSON files decode without external dependencies",
    "provider_free is true and live_network_default is false",
    "sandbox command execution, file writes, and notebook kernels deny by default unless an approval fixture grants the exact capability",
    "file and image artifact contracts require artifact_id, path, media_type, sha256, bytes, provenance, and replay_key",
    "denied command fixture captures command, reason, stdout, stderr, exit_code, and approval decision",
    "deterministic replay fixture pins stdout, stderr, duration bucket, artifact hashes, and display-image metadata",
    "capability metadata declares file, command, stdout, stderr, image display, artifact publish, and replay boundaries"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide FinRobot coding.py execution, notebook kernels, image display, or sandboxed command runners as built-ins; future external packages must satisfy these contracts and approval gates."
  }
}
