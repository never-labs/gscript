{
  "schema_version": 1,
  "id": "finrobot-coding-notebook-sandbox-policy-gates",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "default_decision": "deny",
  "approval_gates": [
    {
      "id": "deny_live_notebook_kernel",
      "capability": "coding.notebook.command.execute",
      "operation": "execute_command",
      "decision": "deny",
      "reason": "notebook kernel execution is disabled in replay mode",
      "fixture": "fixtures/denied_command_fixture.json"
    },
    {
      "id": "deny_unapproved_file_write",
      "capability": "coding.notebook.file.write",
      "operation": "write_file",
      "decision": "deny",
      "reason": "file writes require an explicit artifact approval fixture"
    },
    {
      "id": "allow_fixture_image_display",
      "capability": "coding.notebook.image.display",
      "operation": "display_image",
      "decision": "allow_fixture",
      "reason": "image display is metadata-only in provider-free replay"
    }
  ],
  "capture_contract": {
    "stdout_required": true,
    "stderr_required": true,
    "exit_code_required": true,
    "approval_decision_required": true,
    "denied_commands_must_have_reason": true,
    "command_envelope_required": true,
    "executed_flag_required": true,
    "stdout_stderr_channel_records_required": true
  },
  "cleanup_policy": {
    "mode": "fixture_noop",
    "delete_unapproved_outputs": true,
    "preserve_fixture_artifacts": true,
    "cleanup_replay_key": "cleanup:coding-notebook:fixture-noop"
  }
}
