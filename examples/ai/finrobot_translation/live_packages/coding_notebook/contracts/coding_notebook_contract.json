{
  "schema_version": 1,
  "id": "finrobot-coding-notebook-contract",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "source_module": "finrobot/functional/coding.py",
  "fixture_hook": "recorded_coding_notebook_fixture",
  "operations": [
    {
      "id": "read_file",
      "capability": "coding.notebook.file.read",
      "approval": "not_required_for_fixture",
      "input_schema": "file_image_artifact",
      "output_schema": "file_image_artifact",
      "captures": ["artifact_id", "path", "media_type", "sha256", "bytes", "provenance", "replay_key"]
    },
    {
      "id": "write_file",
      "capability": "coding.notebook.file.write",
      "approval": "required",
      "input_schema": "file_image_artifact",
      "output_schema": "file_image_artifact",
      "captures": ["approval_id", "artifact_id", "sha256", "bytes"]
    },
    {
      "id": "execute_command",
      "capability": "coding.notebook.command.execute",
      "approval": "required",
      "input_schema": "sandbox_command",
      "output_schema": "sandbox_command",
      "captures": ["command", "exit_code", "stdout", "stderr", "duration_ms", "approval_decision"]
    },
    {
      "id": "display_image",
      "capability": "coding.notebook.image.display",
      "approval": "not_required_for_fixture",
      "input_schema": "notebook_display",
      "output_schema": "notebook_display",
      "captures": ["artifact_id", "path", "media_type", "width", "height", "sha256"]
    }
  ],
  "artifact_contract": {
    "schema": "schemas/file_image_artifact.schema.json",
    "required": ["artifact_id", "path", "media_type", "sha256", "bytes", "provenance", "replay_key"],
    "allowed_media_types": ["text/plain", "text/x-python", "application/json", "application/vnd.jupyter", "image/png", "image/jpeg", "image/svg+xml"],
    "local_paths_only": true
  },
  "deterministic_replay": {
    "fixture": "fixtures/deterministic_replay_fixture.json",
    "sort_keys": ["replay_key", "artifact_id"],
    "pinned_fields": ["stdout", "stderr", "exit_code", "sha256", "media_type"]
  },
  "acceptance_gates": [
    "coding.py operations stay fixture-backed in this skeleton",
    "sandbox execution and file writes require explicit approval gates",
    "denied command fixtures preserve stdout and stderr capture",
    "image display returns artifact metadata and never opens a live notebook kernel",
    "deterministic replay can compare command output and artifact hashes without network or provider SDK imports"
  ]
}
