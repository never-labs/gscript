{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/finrobot/coding_notebook/capability_metadata.schema.json",
  "title": "FinRobot coding notebook capability metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "capability", "default", "schema", "approval_required"],
  "properties": {
    "id": {"type": "string"},
    "capability": {"type": "string", "pattern": "^coding\\.notebook\\."},
    "default": {"enum": ["fixture", "deny_without_approval"]},
    "schema": {"enum": ["sandbox_command", "file_image_artifact", "notebook_display"]},
    "approval_required": {"type": "boolean"}
  }
}
