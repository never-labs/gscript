{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/finrobot/coding_notebook/sandbox_command.schema.json",
  "title": "FinRobot coding notebook sandbox command",
  "type": "object",
  "additionalProperties": false,
  "required": ["replay_key", "operation", "capability", "command", "command_envelope", "approval", "result", "captures", "executed", "deterministic"],
  "properties": {
    "replay_key": {"type": "string"},
    "operation": {"const": "execute_command"},
    "capability": {"type": "string", "pattern": "^coding\\.notebook\\.command\\."},
    "command": {"type": "string"},
    "command_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "env_allowlist", "shell", "timeout_bucket", "network", "filesystem_write", "executed"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "cwd": {"type": "string"},
        "env_allowlist": {
          "type": "array",
          "items": {"type": "string"}
        },
        "shell": {"const": false},
        "timeout_bucket": {"enum": ["denied", "short", "medium", "long"]},
        "network": {"const": false},
        "filesystem_write": {"const": false},
        "executed": {"const": false}
      }
    },
    "cwd": {"type": "string"},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "decision", "gate", "reason"],
      "properties": {
        "approval_id": {"type": "string"},
        "decision": {"enum": ["allow_fixture", "deny"]},
        "gate": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "stdout", "stderr", "duration_ms", "duration_bucket"],
      "properties": {
        "exit_code": {"type": "integer"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "duration_bucket": {"enum": ["denied", "short", "medium", "long"]}
      }
    },
    "captures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "text", "bytes", "truncated"],
        "properties": {
          "channel": {"enum": ["stdout", "stderr"]},
          "text": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "truncated": {"type": "boolean"}
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "executed": {"const": false},
    "deterministic": {"const": true}
  }
}
