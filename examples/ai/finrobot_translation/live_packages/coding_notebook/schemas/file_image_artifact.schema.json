{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/finrobot/coding_notebook/file_image_artifact.schema.json",
  "title": "FinRobot coding notebook file and image artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "replay_key", "path", "media_type", "sha256", "bytes", "provenance"],
  "properties": {
    "artifact_id": {"type": "string"},
    "replay_key": {"type": "string"},
    "path": {"type": "string"},
    "media_type": {
      "enum": ["text/plain", "text/x-python", "application/json", "application/vnd.jupyter", "image/png", "image/jpeg", "image/svg+xml"]
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bytes": {"type": "integer", "minimum": 0},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_module", "operation", "fixture"],
      "properties": {
        "source_module": {"const": "finrobot/functional/coding.py"},
        "operation": {"enum": ["read_file", "write_file", "display_image"]},
        "fixture": {"const": true}
      }
    }
  }
}
