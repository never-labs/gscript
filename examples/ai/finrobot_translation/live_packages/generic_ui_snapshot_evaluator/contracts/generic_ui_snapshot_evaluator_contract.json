{
  "schema_version": 1,
  "package_boundary_id": "generic-ai-ui-snapshot-evaluator",
  "package_name": "generic.ai.ui.snapshot.evaluator",
  "entrypoint": "ai.ui.snapshot_evaluator",
  "provider_free": true,
  "domain_specific": false,
  "live_network": false,
  "live_model": false,
  "live_model_calls": false,
  "real_dependency_imports": false,
  "requires_browser": false,
  "requires_credentials": false,
  "provider_sdks_required": false,
  "capabilities": [
    "generic.ai.ui.snapshot.evaluator",
    "generic.ai.ui.snapshot.evidence_report_projection",
    "generic.ai.ui.route_dom_schema",
    "generic.ai.ui.viewport_matrix",
    "generic.ai.ui.visual_diff_budget",
    "generic.ai.ui.accessibility_summary",
    "generic.ai.ui.artifact_uri_manifest",
    "generic.ai.ui.redaction_policy",
    "generic.ai.ui.static_asset_policy",
    "generic.ai.ui.browser_clean_skip"
  ],
  "modules": {
    "snapshot": {
      "inputs": [
        "route_dom_snapshots",
        "viewport_matrix"
      ],
      "outputs": [
        "snapshot_refs",
        "artifact_refs",
        "stable_dom_schema"
      ],
      "required_fields": [
        "route_id",
        "route",
        "method",
        "fixture_url",
        "dom_schema",
        "snapshot_refs",
        "artifact_refs"
      ]
    },
    "evaluation": {
      "inputs": [
        "visual_diff_budgets",
        "accessibility_summaries"
      ],
      "outputs": [
        "diff_budget_results",
        "accessibility_summary_results"
      ],
      "required_fields": [
        "route_id",
        "viewport_id",
        "max_changed_pixels_ratio",
        "max_layout_shift_px",
        "text_overflow_allowed",
        "missing_region_allowed"
      ]
    },
    "artifact": {
      "inputs": [
        "artifact_uri_manifest",
        "redaction_policy",
        "static_asset_policy"
      ],
      "outputs": [
        "redacted_artifact_manifest",
        "clean_skip"
      ],
      "required_fields": [
        "uri_policy",
        "allowed_schemes",
        "artifacts",
        "forbidden_output_patterns"
      ]
    }
  },
  "evidence_report_projection_contract": {
    "source_package": "generic_evidence_report_artifacts",
    "source_fixture": "../generic_evidence_report_artifacts/fixtures/generic_evidence_report_artifacts_fixture.json",
    "target_fixture": "fixtures/generic_ui_snapshot_evaluator_fixture.json",
    "target_capability": "generic.ai.ui.snapshot.evidence_report_projection",
    "required_source_fields": [
      "artifact_manifest.artifacts.artifact_id",
      "artifact_manifest.artifacts.uri",
      "snapshot_metadata.snapshot_id",
      "snapshot_metadata.content_hash",
      "warnings.id",
      "accessibility_checklist.checks.id"
    ],
    "required_target_fields": [
      "route_id",
      "snapshot_ref",
      "artifact_ref",
      "viewport_id",
      "accessibility_check"
    ],
    "raw_render_payloads_allowed": false,
    "remote_fetch_allowed": false,
    "browser_required": false,
    "provider_free": true
  },
  "field_contracts": {
    "route_dom_snapshots": "routes declare stable DOM selectors, required landmarks/regions, forbidden remote selectors, snapshot refs, and artifact refs",
    "evidence_report_projection": "evidence report projection maps report artifact, snapshot, warning, and accessibility refs into UI snapshot evaluator refs without fetching remote resources",
    "viewport_matrix": "viewport rows include dimensions, device scale factor, color scheme, and reduced motion policy",
    "visual_diff_budgets": "diff budgets are deterministic thresholds keyed by route and viewport",
    "accessibility_summaries": "static accessibility summaries name standards, checks, violation budget, and manual review policy",
    "artifact_uri_manifest": "artifact URI manifest forbids external fetches and restricts schemes to fixture/artifact",
    "redaction_policy": "redaction runs before hashing and blocks credential/session output patterns",
    "static_asset_policy": "static assets must be inline or local-only with no remote fonts",
    "browser_clean_skip": "browser dependencies are optional and clean-skip in fixture mode"
  }
}
