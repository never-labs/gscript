{
  "schema_version": 1,
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "live_model_calls": false,
  "requires_browser": false,
  "requires_credentials": false,
  "dialect_scope": "generic_ui_snapshot_evaluator",
  "route_dom_snapshots": [
    {
      "route_id": "overview",
      "route": "/items/{id}",
      "method": "GET",
      "fixture_url": "fixture://ui/routes/overview/item-001",
      "dom_schema": {
        "root_selector": "main[data-route='overview']",
        "required_landmarks": [
          "main",
          "navigation",
          "contentinfo"
        ],
        "required_regions": [
          "summary",
          "details",
          "sources"
        ],
        "forbidden_selectors": [
          "script[src^='http']",
          "link[href^='http']"
        ],
        "stable_attributes": [
          "data-route",
          "data-section-id",
          "data-source-id"
        ]
      },
      "snapshot_refs": [
        "snapshot:overview:desktop"
      ],
      "artifact_refs": [
        "artifact:overview:dom",
        "artifact:overview:png"
      ]
    },
    {
      "route_id": "task_detail",
      "route": "/tasks/{task_id}",
      "method": "GET",
      "fixture_url": "fixture://ui/routes/task-detail/offline",
      "dom_schema": {
        "root_selector": "main[data-route='task-detail']",
        "required_landmarks": [
          "main",
          "navigation"
        ],
        "required_regions": [
          "artifact_links",
          "task_timeline",
          "source_summary"
        ],
        "forbidden_selectors": [
          "script[src^='http']",
          "iframe[src^='http']"
        ],
        "stable_attributes": [
          "data-route",
          "data-artifact-uri",
          "data-source-id"
        ]
      },
      "snapshot_refs": [
        "snapshot:task:tablet"
      ],
      "artifact_refs": [
        "artifact:task:dom"
      ]
    }
  ],
  "viewport_matrix": [
    {
      "id": "mobile_portrait",
      "width": 390,
      "height": 844,
      "device_scale_factor": 2,
      "color_scheme": "light",
      "reduced_motion": true
    },
    {
      "id": "tablet_landscape",
      "width": 1024,
      "height": 768,
      "device_scale_factor": 1,
      "color_scheme": "light",
      "reduced_motion": true
    },
    {
      "id": "desktop_wide",
      "width": 1440,
      "height": 960,
      "device_scale_factor": 1,
      "color_scheme": "light",
      "reduced_motion": true
    }
  ],
  "visual_diff_budgets": [
    {
      "route_id": "overview",
      "viewport_id": "mobile_portrait",
      "max_changed_pixels_ratio": 0.005,
      "max_layout_shift_px": 2,
      "text_overflow_allowed": false,
      "missing_region_allowed": false
    },
    {
      "route_id": "overview",
      "viewport_id": "desktop_wide",
      "max_changed_pixels_ratio": 0.003,
      "max_layout_shift_px": 1,
      "text_overflow_allowed": false,
      "missing_region_allowed": false
    },
    {
      "route_id": "task_detail",
      "viewport_id": "tablet_landscape",
      "max_changed_pixels_ratio": 0.004,
      "max_layout_shift_px": 2,
      "text_overflow_allowed": false,
      "missing_region_allowed": false
    }
  ],
  "accessibility_summaries": [
    {
      "route_id": "overview",
      "mode": "static_dom_summary",
      "standards": [
        "WCAG_2_2_AA_static_subset",
        "ARIA_landmark_names"
      ],
      "required_checks": [
        "main_landmark",
        "single_h1",
        "heading_order",
        "source_links_visible"
      ],
      "violations_allowed": 0,
      "manual_review_required": false
    },
    {
      "route_id": "task_detail",
      "mode": "static_dom_summary",
      "standards": [
        "WCAG_2_2_AA_static_subset"
      ],
      "required_checks": [
        "main_landmark",
        "heading_order",
        "artifact_links_named"
      ],
      "violations_allowed": 0,
      "manual_review_required": false
    }
  ],
  "artifact_uri_manifest": {
    "uri_policy": "fixture_uri_only",
    "external_fetch": false,
    "allowed_schemes": [
      "fixture",
      "artifact"
    ],
    "artifacts": [
      {
        "id": "artifact:overview:dom",
        "uri": "artifact://ui/overview/dom.json",
        "media_type": "application/json",
        "hash_algorithm": "sha256",
        "hash": "sha256:overview-dom"
      },
      {
        "id": "artifact:overview:png",
        "uri": "artifact://ui/overview/desktop.png",
        "media_type": "image/png",
        "hash_algorithm": "sha256",
        "hash": "sha256:overview-png"
      },
      {
        "id": "artifact:task:dom",
        "uri": "artifact://ui/task/dom.json",
        "media_type": "application/json",
        "hash_algorithm": "sha256",
        "hash": "sha256:task-dom"
      }
    ]
  },
  "static_asset_policy": {
    "external_fetch": false,
    "remote_fonts": false,
    "inline_or_local_only": true,
    "hash_algorithm": "sha256",
    "network_required": false
  },
  "redaction_policy": {
    "mode": "deterministic_static_redaction",
    "applies_before_hashing": true,
    "secret_env_patterns_allowed": false,
    "rules": [
      {
        "id": "api_keys",
        "pattern_class": "credential_token",
        "replacement": "[REDACTED:CREDENTIAL]"
      },
      {
        "id": "emails",
        "pattern_class": "email_address",
        "replacement": "[REDACTED:EMAIL]"
      },
      {
        "id": "session_ids",
        "pattern_class": "session_identifier",
        "replacement": "[REDACTED:SESSION]"
      }
    ],
    "forbidden_output_patterns": [
      "api_key=",
      "Authorization:",
      "Set-Cookie:",
      "sk-"
    ]
  },
  "adapter_boundaries": [
    {
      "id": "browser",
      "capability": "generic.ai.ui.browser_clean_skip",
      "dependency_imported": false,
      "credential_required": false,
      "live_network": false,
      "clean_skip": true
    },
    {
      "id": "visual_diff_engine",
      "capability": "generic.ai.ui.visual_diff_budget",
      "dependency_imported": false,
      "credential_required": false,
      "live_network": false,
      "clean_skip": true
    }
  ]
}
