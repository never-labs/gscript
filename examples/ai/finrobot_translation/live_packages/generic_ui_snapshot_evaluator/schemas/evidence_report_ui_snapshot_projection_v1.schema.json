{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leia://generic-ai/ui-snapshot-evaluator/evidence-report-ui-snapshot-projection-v1",
  "title": "Generic Evidence Report To UI Snapshot Projection",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "projection_kind",
    "package_boundary_id",
    "provider_free",
    "domain_specific",
    "live_network",
    "live_model_calls",
    "real_dependency_imports",
    "source_fixture_refs",
    "snapshot_mappings",
    "artifact_uri_mappings",
    "warning_mappings",
    "accessibility_mappings",
    "viewport_budget_mappings",
    "projection_assertions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "generic-ui-evidence-report-projection-fixture"
    },
    "projection_kind": {
      "const": "evidence_report_artifacts_to_ui_snapshot_evaluator_projection"
    },
    "package_boundary_id": {
      "const": "generic-ai-ui-snapshot-evaluator"
    },
    "provider_free": {
      "const": true
    },
    "domain_specific": {
      "const": false
    },
    "live_network": {
      "const": false
    },
    "live_model_calls": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "source_fixture_refs": {
      "type": "object"
    },
    "snapshot_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_snapshot_id",
          "source_content_hash",
          "source_dimensions",
          "target_route_id",
          "target_snapshot_ref",
          "target_viewport_id",
          "mapping_policy"
        ]
      }
    },
    "artifact_uri_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_artifact_id",
          "source_uri",
          "source_content_hash",
          "target_artifact_id",
          "target_uri",
          "remote_fetch"
        ]
      }
    },
    "warning_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_warning_id",
          "source_severity",
          "target_route_id",
          "target_review_marker",
          "manual_review_required"
        ]
      }
    },
    "accessibility_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_check_id",
          "source_status",
          "target_route_id",
          "target_required_check"
        ]
      }
    },
    "viewport_budget_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_snapshot_id",
          "target_route_id",
          "target_viewport_id",
          "target_budget_ratio",
          "text_overflow_allowed",
          "missing_region_allowed"
        ]
      }
    },
    "projection_assertions": {
      "type": "object"
    }
  }
}
