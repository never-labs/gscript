// Provider-free smoke contract for the tutorial/demo parity live package.
//
// This file intentionally does not import AutoGen, Backtrader, notebook
// runtimes, provider SDKs, chart renderers, PDF renderers, or network clients.

tutorial_demo_parity_package := {
    id: "finrobot-tutorial-demo-parity-live-package"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    tutorial_entries: 13
    demo_entries: 5
    replay_record_links: 4
    conversion_checklist_items: 6
    gates: {
        {id: "tutorial-notebook-live-data" default_enabled: false live_network: false clean_skip_without_credentials: true dependency_imported: false fixture_key: "tutorials:provider_free:ledger:2026-06-12"},
        {id: "agent-builder-demo-live-autogen" default_enabled: false live_network: false clean_skip_without_credentials: true dependency_imported: false fixture_key: "demo:agent_builder:provider_free:2026-06-12"},
        {id: "backtrader-test-module-live" default_enabled: false live_network: false clean_skip_without_credentials: true dependency_imported: false fixture_key: "demo:backtrader_test_module:provider_free:2026-06-12"},
    }
}

func tutorial_demo_gate_ok(gate) {
    if gate == nil {
        return false
    }
    if tutorial_demo_parity_package.provider_free != true || tutorial_demo_parity_package.live_network != false || tutorial_demo_parity_package.real_dependency_imports != false {
        return false
    }
    return gate.default_enabled == false && gate.live_network == false && gate.clean_skip_without_credentials == true && gate.dependency_imported == false && gate.fixture_key != nil
}

tutorial_demo_clean_skip_count := 0
tutorial_demo_enabled_count := 0
for i := 1; i <= #tutorial_demo_parity_package.gates; i++ {
    gate := tutorial_demo_parity_package.gates[i]
    assert(tutorial_demo_gate_ok(gate))
    if gate.clean_skip_without_credentials {
        tutorial_demo_clean_skip_count = tutorial_demo_clean_skip_count + 1
    }
    if gate.default_enabled {
        tutorial_demo_enabled_count = tutorial_demo_enabled_count + 1
    }
}

assert(tutorial_demo_parity_package.tutorial_entries == 13)
assert(tutorial_demo_parity_package.demo_entries == 5)
assert(tutorial_demo_parity_package.replay_record_links == 4)
assert(tutorial_demo_parity_package.conversion_checklist_items == 6)
assert(tutorial_demo_enabled_count == 0)

tutorial_demo_parity_summary := string.format(
"tutorial_demo_parity_live_package tutorials=%d demos=%d records=%d gates=%d clean_skip=%d live_network=%s imports=%s",
tutorial_demo_parity_package.tutorial_entries,
tutorial_demo_parity_package.demo_entries,
tutorial_demo_parity_package.replay_record_links,
#tutorial_demo_parity_package.gates,
tutorial_demo_clean_skip_count,
tostring(tutorial_demo_parity_package.live_network),
tostring(tutorial_demo_parity_package.real_dependency_imports)
)

print(tutorial_demo_parity_summary)
