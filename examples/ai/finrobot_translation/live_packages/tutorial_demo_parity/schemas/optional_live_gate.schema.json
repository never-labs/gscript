{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "clean_skip_without_dependency",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "clean_skip_without_dependency": {
      "const": true
    },
    "gates": {
      "type": "array",
      "minItems": 1
    }
  }
}
