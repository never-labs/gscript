{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/generic_ai/strategy_backtest_contracts/performance_series_v1.schema.json",
  "title": "Strategy Backtest Performance Series",
  "type": "object",
  "required": [
    "provider_free",
    "live_network",
    "fixture_key",
    "strategy_id",
    "subject_id",
    "deterministic_seed",
    "source_ref",
    "summary",
    "rows"
  ],
  "properties": {
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "fixture_key": {
      "type": "string"
    },
    "strategy_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "deterministic_seed": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "start_state_value",
        "end_state_value",
        "total_delta",
        "max_regret",
        "normalization_factor",
        "full_period_stability_score"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "state_value",
          "step_delta",
          "cumulative_delta",
          "regret",
          "rolling_stability_score"
        ]
      }
    }
  }
}
