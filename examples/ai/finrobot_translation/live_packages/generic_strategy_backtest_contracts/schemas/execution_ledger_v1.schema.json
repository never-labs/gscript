{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/generic_ai/strategy_backtest_contracts/execution_ledger_v1.schema.json",
  "title": "Strategy Backtest Execution Ledger",
  "type": "object",
  "required": [
    "provider_free",
    "live_network",
    "fixture_key",
    "strategy_id",
    "subject_id",
    "deterministic_seed",
    "schema_fields",
    "executions"
  ],
  "properties": {
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "real_dependency_imports": {"const": false},
    "fixture_key": {"type": "string"},
    "strategy_id": {"type": "string"},
    "subject_id": {"type": "string"},
    "deterministic_seed": {"type": "string"},
    "schema_fields": {"type": "array", "items": {"type": "string"}},
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "execution_id",
          "action_id",
          "timestamp",
          "side",
          "amount",
          "value",
          "gross_value",
          "cost",
          "adjustment",
          "resource_after",
          "state_after",
          "realized_delta",
          "source_ref"
        ],
        "properties": {
          "execution_id": {"type": "string"},
          "action_id": {"type": "string"},
          "timestamp": {"type": "string"},
          "side": {"enum": ["increase", "decrease"]},
          "amount": {"type": "number"},
          "value": {"type": "number"},
          "gross_value": {"type": "number"},
          "cost": {"type": "number"},
          "adjustment": {"type": "number"},
          "resource_after": {"type": "number"},
          "state_after": {"type": "number"},
          "realized_delta": {"type": "number"},
          "source_ref": {"type": "string"}
        }
      }
    }
  }
}
