{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/generic_ai/strategy_backtest_contracts/observation_feed_v1.schema.json",
  "title": "Strategy Backtest Observation Feed Fixture",
  "type": "object",
  "required": [
    "provider_free",
    "live_network",
    "fixture_key",
    "subject_id",
    "granularity",
    "timezone",
    "schedule",
    "unit",
    "source_ref",
    "deterministic_seed",
    "rows"
  ],
  "properties": {
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "real_dependency_imports": {"const": false},
    "fixture_key": {"type": "string"},
    "subject_id": {"type": "string"},
    "granularity": {"type": "string"},
    "timezone": {"type": "string"},
    "schedule": {"type": "string"},
    "unit": {"type": "string"},
    "source_ref": {"type": "string"},
    "deterministic_seed": {"type": "string"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timestamp", "observed_a", "observed_b", "observed_c", "observed_d", "activity"],
        "properties": {
          "timestamp": {"type": "string"},
          "observed_a": {"type": "number"},
          "observed_b": {"type": "number"},
          "observed_c": {"type": "number"},
          "observed_d": {"type": "number"},
          "activity": {"type": "integer"},
          "provider_free": {"const": true},
          "live_network": {"const": false}
        }
      }
    }
  }
}

