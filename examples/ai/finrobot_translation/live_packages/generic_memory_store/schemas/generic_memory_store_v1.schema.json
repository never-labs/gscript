{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/generic/memory_store_v1.schema.json",
  "title": "Generic provider-free memory store fixture",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "memory_store",
    "namespace_policy",
    "memory_items",
    "retrieval_policy",
    "retrieval_results",
    "context_window",
    "adapter_boundaries",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "provider_free": {
      "type": "boolean",
      "const": true
    },
    "live_network": {
      "type": "boolean",
      "const": false
    },
    "memory_store": {
      "type": "object",
      "required": [
        "store_id",
        "store_type",
        "persistent",
        "dependency_imported",
        "credential_required",
        "live_network",
        "clean_skip"
      ]
    },
    "namespace_policy": {
      "type": "object",
      "required": [
        "namespace",
        "tenant_scope",
        "allowed_tags",
        "pii_policy",
        "secret_policy"
      ]
    },
    "memory_items": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "memory_id",
          "text",
          "tags",
          "source_ref",
          "chunk_id",
          "provenance"
        ]
      }
    },
    "retrieval_policy": {
      "type": "object",
      "required": [
        "query",
        "top_k",
        "ranking",
        "metadata_filters",
        "embedding_dependency_imported",
        "vector_dependency_imported",
        "provider_credentials_required"
      ]
    },
    "retrieval_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "memory_id",
          "rank",
          "score",
          "reason",
          "context_ref"
        ]
      }
    },
    "context_window": {
      "type": "object",
      "required": [
        "strategy",
        "max_context_items",
        "token_budget",
        "included_memory_ids",
        "excluded_memory_ids",
        "deterministic_order"
      ]
    },
    "adapter_boundaries": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "adapter",
          "capability",
          "fixture_key",
          "dependency_imported",
          "credential_required",
          "live_network",
          "clean_skip"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "fixture_key",
        "linked_chunk_fixture_key",
        "linked_retriever_fixture_key"
      ]
    }
  }
}
