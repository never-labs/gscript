{
  "schema_version": 1,
  "id": "generic-memory-store",
  "package_name": "leia-generic-ai-memory-store",
  "package_boundary_id": "generic-ai-memory-store",
  "capability_id": "generic.ai.memory.store",
  "version": "0.1.0-skeleton",
  "description": "Provider-free generic AI memory store package for namespace policy, memory item provenance, retrieval ranking, context windows, and clean-skip adapter boundaries.",
  "provider_free": true,
  "domain_specific": false,
  "live_network_default": false,
  "live_model_default": false,
  "real_dependency_import_default": false,
  "depends_on_q_runtime": false,
  "credential_required_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "contract_root": "contracts",
  "entrypoints": {
    "main": "main.leia",
    "contract": "contracts/generic_memory_store_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json"
  },
  "schemas": {
    "generic_memory_store": "schemas/generic_memory_store_v1.schema.json"
  },
  "contracts": {
    "contract": "contracts/generic_memory_store_contract.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json",
    "generic_memory_store": "fixtures/generic_memory_store_fixture.json"
  },
  "capabilities": [
    "generic.ai.memory.store",
    "generic.ai.memory.namespace",
    "generic.ai.memory.retrieve",
    "generic.ai.memory.context_window",
    "generic.ai.memory.retrieval_policy",
    "generic.ai.memory.provenance",
    "generic.ai.memory.clean_skip"
  ],
  "capability_surfaces": [
    "memory_store",
    "namespace_policy",
    "retrieval_policy",
    "retrieval_results",
    "context_window",
    "adapter_boundaries",
    "provenance"
  ],
  "default_policy": {
    "mode": "fixture_replay",
    "provider_policy": "provider-free",
    "live_network": false,
    "live_model_calls": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "clean_skip_without_descriptor": true,
    "fixture_hook": "recorded_generic_memory_store_fixture"
  },
  "test_gates": [
    "memory store contract fixture decodes without Redis, Postgres, vector databases, embedding models, or managed memory providers",
    "namespace policy and retrieval policy are provider-free and credential-free",
    "retrieval ranking and context window order are deterministic fixture data",
    "adapter boundaries prove dependency imports, live network, and credentials stay disabled"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide built-in leia-generic-ai-memory-store handling; this provider-free package boundary owns memory store, retrieval, context window, and provenance contracts."
  }
}
