generic_memory_store_live_package := {
    id: "generic-memory-store",
    package_name: "leia-generic-ai-memory-store",
    capability: "generic.ai.memory.store",
    fixture_key: "generic:memory_store:offline",
    provider_free: true,
    live_network: false,
    real_dependency_imports: false,
    durable_provider: false,
    context_window_budget: 2048,
    ranked_items: 2
}

assert(generic_memory_store_live_package.provider_free)
assert(!generic_memory_store_live_package.live_network)
assert(!generic_memory_store_live_package.real_dependency_imports)
assert(!generic_memory_store_live_package.durable_provider)

generic_memory_store_live_package_summary := string.format(
"generic_memory_store_live_package capability=%s fixture=%s ranked_items=%d provider_free=%s live_network=%s imports=%s",
generic_memory_store_live_package.capability,
generic_memory_store_live_package.fixture_key,
generic_memory_store_live_package.ranked_items,
tostring(generic_memory_store_live_package.provider_free),
tostring(generic_memory_store_live_package.live_network),
tostring(generic_memory_store_live_package.real_dependency_imports))

print(generic_memory_store_live_package_summary)
