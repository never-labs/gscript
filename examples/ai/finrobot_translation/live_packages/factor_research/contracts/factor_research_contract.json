{
  "schema_version": 1,
  "id": "finrobot-factor-research-contract",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "source_module": "experiments/multi_factor_agents.py",
  "modules": [
    {
      "id": "multi_factor_agents",
      "source_module": "experiments/multi_factor_agents.py",
      "required_fields": [
        "request_id",
        "universe_id",
        "factor_panel",
        "ranked_candidates",
        "portfolio_factor_exposure",
        "agent_handoff_boundary"
      ]
    },
    {
      "id": "factor_transforms",
      "source_module": "factor_transforms.py",
      "required_fields": [
        "transform_id",
        "input_schema",
        "output_schema",
        "parameters",
        "provenance"
      ]
    },
    {
      "id": "portfolio_factor_exposure",
      "source_module": "portfolio_factor_exposure.py",
      "required_fields": [
        "portfolio_id",
        "factor_exposures",
        "sector_exposures",
        "risk_limits",
        "source_refs"
      ]
    }
  ],
  "field_contracts": {
    "market_data": {
      "required": [
        "symbol",
        "as_of",
        "close",
        "volume",
        "currency",
        "source_ref"
      ],
      "stale_data_warning_required": true
    },
    "factor_data": {
      "required_factors": [
        "value",
        "growth",
        "momentum",
        "quality",
        "volatility",
        "liquidity",
        "sentiment",
        "macro"
      ],
      "transform_ids": [
        "winsorize",
        "zscore",
        "sector_neutralize",
        "composite_score"
      ]
    },
    "portfolio_factor_exposure": {
      "required": [
        "portfolio_id",
        "as_of",
        "factor_exposures",
        "sector_exposures",
        "risk_limits",
        "source_refs"
      ],
      "all_source_refs_must_resolve": true
    },
    "agent_handoff_boundary": {
      "required": [
        "handoff_id",
        "from_agent",
        "to_agent",
        "capability",
        "fixture_key",
        "schema",
        "clean_skip"
      ],
      "provider_free_required": true
    }
  },
  "transform_registry_contract": {
    "registry_id": "factor_transform_registry_v1",
    "ordered": true,
    "required_entry_fields": [
      "id",
      "deterministic",
      "input_fields",
      "output_fields",
      "provenance_tag",
      "failure_mode"
    ],
    "required_ids": [
      "winsorize",
      "zscore",
      "sector_neutralize",
      "composite_score"
    ]
  },
  "fixture_provenance_contract": {
    "provider": "fixture",
    "required_fields": [
      "id",
      "provider",
      "replay_key",
      "captured_at",
      "source_schema",
      "license",
      "stale_after_days",
      "row_count"
    ],
    "row_source_refs_must_resolve": true,
    "source_url_required": false
  },
  "exposure_summary_contract": {
    "required_fields": [
      "gross_exposure",
      "net_exposure",
      "top_factor",
      "top_factor_exposure",
      "dominant_sector",
      "risk_status"
    ],
    "risk_status_values": [
      "pass",
      "warn",
      "fail"
    ]
  },
  "risk_envelope_contract": {
    "required_fields": [
      "max_single_name_weight",
      "max_weighted_volatility",
      "min_weighted_liquidity",
      "max_sector_weight",
      "status"
    ],
    "default_status": "pass"
  },
  "optional_optimizer_gate": {
    "id": "portfolio_optimizer_optional_gate",
    "required": false,
    "default_enabled": false,
    "clean_skip_without_dependency": true,
    "skip_status": "clean_skipped_without_optimizer",
    "fixture_fallback": "portfolio_exposure:ACME_UNIVERSE:offline"
  },
  "acceptance_gates": [
    "multi-factor agent orchestration remains fixture replay only",
    "factor transforms are deterministic and declare parameters",
    "market data and factor data carry as_of, stale_after, provider, replay_key, and source_ref provenance",
    "portfolio exposure results include factor vectors, exposure summaries, sector rollups, risk envelopes, and resolvable source refs",
    "agent handoff boundaries clean-skip when live providers, credentials, or optimizer dependencies are absent",
    "optional optimizer gate stays disabled by default and resolves to a provider-free fixture fallback"
  ]
}
