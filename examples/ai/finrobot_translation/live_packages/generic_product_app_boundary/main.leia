assert(generic_product_app_boundary_live_package.crud_ops == 3)

generic_product_app_boundary_live_package_summary := string.format(
"generic_product_app_boundary_live_package capability=%s entrypoint=%s routes=%d sessions=%d tasks=%d downloads=%d crud=%d migrations=%d deployments=%d approvals=%d clean_skip=%d workflow_projections=%d provider_free=%s live_network=%s imports=%s model_calls=%s",
