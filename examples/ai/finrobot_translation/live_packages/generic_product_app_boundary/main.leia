generic_product_app_boundary_live_package := {
    id: "generic-product-app-boundary"
    package_name: "leia-generic-ai-product-app-boundary"
    capability: "generic.ai.product_app.boundary"
    entrypoint: "ai.product_app.boundary"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    live_model_calls: false
    routes: 3
    sessions: 2
    tasks: 2
    downloads: 2
    crud_ops: 3
    migrations: 1
    deployments: 2
    approvals: 2
    clean_skip_adapters: 3
    workflow_projections: 1
}

assert(generic_product_app_boundary_live_package.provider_free)
assert(!generic_product_app_boundary_live_package.live_network)
assert(!generic_product_app_boundary_live_package.real_dependency_imports)
assert(!generic_product_app_boundary_live_package.live_model_calls)
