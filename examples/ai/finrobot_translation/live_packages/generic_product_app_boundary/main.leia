generic_product_app_boundary_live_package.entrypoint,
generic_product_app_boundary_live_package.routes,
generic_product_app_boundary_live_package.sessions,
generic_product_app_boundary_live_package.tasks,
generic_product_app_boundary_live_package.downloads,
generic_product_app_boundary_live_package.crud_ops,
generic_product_app_boundary_live_package.migrations,
generic_product_app_boundary_live_package.deployments,
generic_product_app_boundary_live_package.approvals,
generic_product_app_boundary_live_package.clean_skip_adapters,
generic_product_app_boundary_live_package.workflow_projections,
tostring(generic_product_app_boundary_live_package.provider_free),
tostring(generic_product_app_boundary_live_package.live_network),
tostring(generic_product_app_boundary_live_package.real_dependency_imports),
