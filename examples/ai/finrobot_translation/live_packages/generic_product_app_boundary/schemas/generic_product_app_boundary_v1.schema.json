{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic product app boundary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "live_model_calls",
    "requires_credentials",
    "route_contracts",
    "session_contracts",
    "task_logs",
    "artifact_downloads",
    "crud_fixture_state",
    "db_migration_plans",
    "deployment_targets",
    "approval_boundaries",
    "adapter_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "live_model_calls": {
      "const": false
    },
    "requires_credentials": {
      "const": false
    },
    "route_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "method",
          "path",
          "handler_ref",
          "auth_required",
          "capability"
        ],
        "properties": {
          "route_id": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "handler_ref": {
            "type": "string"
          },
          "auth_required": {
            "type": "boolean"
          },
          "capability": {
            "type": "string"
          }
        }
      }
    },
    "session_contracts": {
      "type": "array"
    },
    "task_logs": {
      "type": "array"
    },
    "artifact_downloads": {
      "type": "array"
    },
    "crud_fixture_state": {
      "type": "array"
    },
    "db_migration_plans": {
      "type": "array"
    },
    "deployment_targets": {
      "type": "array"
    },
    "approval_boundaries": {
      "type": "array"
    },
    "adapter_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "dependency_imported",
          "credential_required",
          "live_network",
          "clean_skip"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "dependency_imported": {
            "const": false
          },
          "credential_required": {
            "type": "boolean"
          },
          "live_network": {
            "const": false
          },
          "clean_skip": {
            "const": true
          }
        }
      }
    }
  }
}
