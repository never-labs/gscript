{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic product app route contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "route_contracts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "route_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "method",
          "path",
          "handler_ref",
          "auth_required",
          "capability"
        ],
        "properties": {
          "route_id": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "handler_ref": {
            "type": "string"
          },
          "auth_required": {
            "type": "boolean"
          },
          "capability": {
            "type": "string"
          }
        }
      }
    }
  }
}
