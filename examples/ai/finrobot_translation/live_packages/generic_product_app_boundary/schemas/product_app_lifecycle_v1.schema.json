{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic product app lifecycle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "session_contracts",
    "task_logs",
    "crud_fixture_state",
    "db_migration_plans",
    "deployment_targets",
    "approval_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "session_contracts": {
      "type": "array"
    },
    "task_logs": {
      "type": "array"
    },
    "crud_fixture_state": {
      "type": "array"
    },
    "db_migration_plans": {
      "type": "array"
    },
    "deployment_targets": {
      "type": "array"
    },
    "approval_boundaries": {
      "type": "array"
    }
  }
}
