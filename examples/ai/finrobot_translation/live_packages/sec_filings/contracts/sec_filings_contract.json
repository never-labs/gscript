{
  "schema_version": 1,
  "id": "finrobot-sec-filings-contract",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "fixture_hook": "recorded_sec_filings_live_fixture",
  "modules": [
    {
      "id": "sec_search",
      "source_module": "filings_src/sec_api.py",
      "inputs": [
        "ticker",
        "form_types",
        "date_range"
      ],
      "outputs": [
        "filing_search_results"
      ],
      "required_fields": [
        "ticker",
        "cik",
        "accession_number",
        "form_type",
        "filing_date",
        "document_url",
        "redirect_chain",
        "cache",
        "terms"
      ]
    },
    {
      "id": "sec_fetch",
      "source_module": "filings_src/sec_api.py",
      "inputs": [
        "accession_number",
        "document_url",
        "artifact_policy"
      ],
      "outputs": [
        "sec_filing_document",
        "artifact_provenance"
      ],
      "required_fields": [
        "document_id",
        "form_type",
        "primary_artifact",
        "artifacts",
        "redirect_chain",
        "cache",
        "user_agent_policy",
        "terms"
      ]
    },
    {
      "id": "section_extraction",
      "source_module": "marker_sec_src/sec_filings_to_markdown.py",
      "inputs": [
        "sec_filing_document",
        "section_policy"
      ],
      "outputs": [
        "section_extraction"
      ],
      "required_fields": [
        "document_id",
        "form_type",
        "section_id",
        "section_title",
        "source_offsets",
        "artifact_ref",
        "provenance"
      ]
    }
  ],
  "field_contracts": {
    "filing_search": {
      "type": "list",
      "required_forms": [
        "10-K",
        "10-Q"
      ],
      "required": [
        "ticker",
        "cik",
        "accession_number",
        "form_type",
        "filing_date",
        "document_url",
        "redirect_chain",
        "cache",
        "provenance"
      ]
    },
    "filing_fetch": {
      "type": "document_fetch",
      "required_forms": [
        "10-K",
        "10-Q"
      ],
      "required_artifact_types": [
        "sec_html",
        "sec_pdf"
      ],
      "live_network": false
    },
    "artifact_provenance": {
      "type": "artifact_list",
      "required": [
        "artifact_id",
        "artifact_type",
        "source_url",
        "content_sha256",
        "mime_type",
        "provenance.fixture_key",
        "terms"
      ]
    },
    "sec_access_policy": {
      "type": "metadata_only_boundary",
      "user_agent_required_for_live": true,
      "live_user_agent_declared": false,
      "rate_limit_policy": {
        "source": "SEC fair access policy",
        "max_requests_per_second": 10,
        "enforced_in_skeleton": false
      },
      "clean_skip_without_policy": true
    },
    "redirect_cache_metadata": {
      "type": "fetch_metadata",
      "required": [
        "redirect_chain",
        "cache.key",
        "cache.mode",
        "cache.hit",
        "cache.ttl_seconds"
      ],
      "live_network": false
    },
    "section_extraction": {
      "type": "ordered_sections",
      "required_forms": [
        "10-K",
        "10-Q"
      ],
      "required_sections": [
        "business",
        "risk_factors",
        "mda",
        "financial_statements"
      ]
    },
    "live_gate": {
      "type": "explicit_capability_env",
      "default_enabled": false,
      "capability": "finance.document.sec.live_network",
      "env": "LEIA_FINROBOT_SEC_FILINGS_LIVE",
      "requires_user_agent_env": "LEIA_SEC_USER_AGENT",
      "terms_ack_env": "LEIA_SEC_TERMS_ACK"
    }
  },
  "acceptance_gates": [
    "offline SEC filing search returns both 10-K and 10-Q entries with accession, CIK, redirect/cache, user-agent, rate-limit, terms, and provenance metadata",
    "offline fetch fixtures cover 10-K HTML and 10-Q PDF artifact provenance without live network",
    "section extraction fixtures include ordered sections, source offsets, artifact references, and citation provenance for both 10-K and 10-Q documents",
    "live network remains disabled by default and exists only as explicit capability/env metadata",
    "fixture replay validates SEC fair-access user-agent and rate-limit policy metadata without enforcing live provider calls"
  ]
}
