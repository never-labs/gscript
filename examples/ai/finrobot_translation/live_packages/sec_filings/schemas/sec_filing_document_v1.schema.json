{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SECFilingDocumentV1",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "document_id",
    "ticker",
    "cik",
    "accession_number",
    "form_type",
    "filing_date",
    "primary_artifact",
    "user_agent_policy",
    "redirect_chain",
    "cache",
    "terms",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "artifact_type",
          "source_url",
          "mime_type",
          "content_sha256",
          "byte_length",
          "parser_boundary",
          "provenance",
          "terms"
        ]
      }
    }
  }
}
