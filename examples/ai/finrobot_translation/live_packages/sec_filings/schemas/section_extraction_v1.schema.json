{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SECSectionExtractionV1",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "form_type",
          "artifact_ref",
          "artifact_type",
          "sections"
        ],
        "properties": {
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "section_id",
                "section_title",
                "text",
                "source_offsets",
                "citation",
                "provenance"
              ]
            }
          }
        }
      }
    }
  }
}
