{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SECFilingSearchResultV1",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "query",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "query": {
      "type": "object",
      "required": [
        "ticker",
        "cik",
        "form_types",
        "date_range",
        "user_agent_policy",
        "rate_limit_policy",
        "terms"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "ticker",
          "cik",
          "accession_number",
          "form_type",
          "filing_date",
          "source_url",
          "document_url",
          "artifact_hint",
          "redirect_chain",
          "cache",
          "terms",
          "provenance"
        ]
      }
    }
  }
}
