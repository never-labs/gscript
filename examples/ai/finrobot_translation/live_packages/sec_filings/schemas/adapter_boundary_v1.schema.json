{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SECAdapterBoundaryV1",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "capability",
          "fixture_key",
          "schema",
          "live_network",
          "dependency_imported",
          "credential_required",
          "clean_skip",
          "clean_skip_reason"
        ]
      }
    }
  }
}
