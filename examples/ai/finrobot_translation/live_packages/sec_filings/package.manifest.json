{
  "schema_version": 1,
  "id": "finrobot-sec-filings-live-package",
  "package_name": "leia-finrobot-sec-filings",
  "version": "0.1.0-skeleton",
  "description": "Provider-free live package skeleton for SEC filing search, fetch, HTML/PDF artifact provenance, section extraction, redirect/cache metadata, user-agent policy, terms metadata, and explicit live capability gates.",
  "source_modules": [
    "FinRobot/filings_src/sec_api.py",
    "FinRobot/marker_sec_src/sec_filings_to_markdown.py",
    "FinRobot/functional/rag.py"
  ],
  "provider_free": true,
  "live_network_default": false,
  "real_dependency_import_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "credentials": {
    "required": [],
    "optional": [],
    "secret_env_patterns": [],
    "policy": "No credentials are declared by this skeleton. SEC live access requires an explicit capability, a compliant user-agent contact, rate-limit policy, cache policy, and terms metadata in a future provider package."
  },
  "default_policy": {
    "mode": "fixture_replay",
    "live_network": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "clean_skip_without_dependency": true,
    "fixture_hook": "recorded_sec_filings_live_fixture"
  },
  "live_gate": {
    "default_enabled": false,
    "capability": "finance.document.sec.live_network",
    "env": "LEIA_FINROBOT_SEC_FILINGS_LIVE",
    "requires_user_agent_env": "LEIA_SEC_USER_AGENT",
    "terms_ack_env": "LEIA_SEC_TERMS_ACK",
    "clean_skip_without_capability": true
  },
  "entrypoints": {
    "smoke": "main.leia",
    "sec_filings_contract": "contracts/sec_filings_contract.json",
    "adapter_boundary_contract": "contracts/adapter_boundary_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json"
  },
  "schemas": {
    "sec_search_result": "schemas/sec_search_result_v1.schema.json",
    "sec_filing_document": "schemas/sec_filing_document_v1.schema.json",
    "section_extraction": "schemas/section_extraction_v1.schema.json",
    "artifact_provenance": "schemas/artifact_provenance_v1.schema.json",
    "adapter_boundary": "schemas/adapter_boundary_v1.schema.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json",
    "search": "fixtures/sec_search_ACME_fixture.json",
    "fetch_10k": "fixtures/sec_fetch_ACME_10k_fixture.json",
    "fetch_10q": "fixtures/sec_fetch_ACME_10q_fixture.json",
    "section_extraction": "fixtures/section_extraction_ACME_fixture.json",
    "adapter_boundary": "fixtures/adapter_boundary_fixture.json"
  },
  "modules": [
    {
      "id": "sec_search",
      "source_module": "filings_src/sec_api.py",
      "capabilities": [
        "finance.document.sec.search",
        "finance.document.sec.form_filter",
        "finance.document.sec.redirect.trace",
        "finance.document.sec.cache.metadata",
        "finance.document.sec.terms.metadata"
      ],
      "output_schemas": [
        "sec_search_result",
        "adapter_boundary"
      ]
    },
    {
      "id": "sec_fetch",
      "source_module": "filings_src/sec_api.py",
      "capabilities": [
        "finance.document.sec.fetch",
        "finance.document.sec.artifact.provenance",
        "finance.document.sec.html.artifact",
        "finance.document.sec.pdf.artifact",
        "finance.document.sec.user_agent.policy"
      ],
      "output_schemas": [
        "sec_filing_document",
        "artifact_provenance"
      ]
    },
    {
      "id": "section_extraction",
      "source_module": "marker_sec_src/sec_filings_to_markdown.py",
      "capabilities": [
        "finance.document.sec.section.extract",
        "finance.document.sec.section.normalize",
        "finance.document.sec.source_offsets",
        "finance.document.sec.citation.provenance",
        "finance.document.sec.html_pdf.boundary"
      ],
      "output_schemas": [
        "section_extraction",
        "artifact_provenance"
      ]
    }
  ],
  "adapter_boundaries": [
    {
      "id": "sec_company_submissions",
      "display_name": "SEC company submissions search",
      "capability": "finance.document.sec.search",
      "fixture_key": "sec:search:ACME:10K10Q:offline",
      "schema": "adapter_boundary",
      "live_network": false,
      "dependency_imported": false,
      "credential_required": false,
      "clean_skip": true
    },
    {
      "id": "sec_archive_fetch",
      "display_name": "SEC archive document fetch",
      "capability": "finance.document.sec.fetch",
      "fixture_key": "sec:fetch:ACME:10K10Q:offline",
      "schema": "adapter_boundary",
      "live_network": false,
      "dependency_imported": false,
      "credential_required": false,
      "clean_skip": true
    },
    {
      "id": "html_document_parser",
      "display_name": "SEC HTML filing parser",
      "capability": "finance.document.sec.html.parse",
      "fixture_key": "sec:section_extract:ACME:offline",
      "schema": "adapter_boundary",
      "live_network": false,
      "dependency_imported": false,
      "credential_required": false,
      "clean_skip": true
    },
    {
      "id": "pdf_artifact_reader",
      "display_name": "SEC PDF artifact reader",
      "capability": "finance.document.sec.pdf.read",
      "fixture_key": "sec:fetch:ACME:10Q:offline",
      "schema": "adapter_boundary",
      "live_network": false,
      "dependency_imported": false,
      "credential_required": false,
      "clean_skip": true
    }
  ],
  "test_gates": [
    "manifest and referenced JSON files decode without external dependencies",
    "provider_free is true and live_network_default is false",
    "required and optional credentials are empty",
    "offline 10-K and 10-Q fixtures cover SEC search, fetch, section extraction, HTML/PDF artifact provenance, redirect/cache metadata, user-agent policy, terms metadata, and explicit live gate metadata",
    "SEC search, archive fetch, HTML parser, and PDF reader boundaries are metadata-only, fixture-backed, and clean-skip safe",
    "main.leia contains no live provider SDK imports or network execution"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide SEC filing clients, SEC fair-access policy enforcement, HTML/PDF parsing, cache stores, or section extraction as built-ins; future external packages must satisfy these provider-free contracts first."
  }
}
