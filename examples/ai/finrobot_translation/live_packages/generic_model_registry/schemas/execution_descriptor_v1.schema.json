{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/leia/generic-model-registry/execution_descriptor_v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "provider_free",
    "live_network",
    "descriptors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "descriptors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "descriptor_ref",
          "model_alias",
          "provider",
          "provider_model",
          "mode",
          "fixture_key",
          "replay_safe",
          "live_network",
          "provider_credentials_required",
          "secret_values_present",
          "temperature",
          "capability_flags",
          "redaction_policy_ref"
        ],
        "properties": {
          "descriptor_ref": {
            "type": "string"
          },
          "model_alias": {
            "type": "string"
          },
          "provider": {
            "const": "fixture-replay"
          },
          "provider_model": {
            "type": "string"
          },
          "mode": {
            "const": "deterministic_fixture_replay"
          },
          "fixture_key": {
            "type": "string"
          },
          "replay_safe": {
            "const": true
          },
          "live_network": {
            "const": false
          },
          "provider_credentials_required": {
            "const": false
          },
          "secret_values_present": {
            "const": false
          },
          "temperature": {
            "const": 0
          },
          "capability_flags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "redaction_policy_ref": {
            "type": "string"
          }
        }
      }
    }
  }
}
