{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/leia/generic-model-registry/model_alias_registry_v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "provider_free",
    "aliases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "capability_id": {
      "const": "generic.ai.model.registry"
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "alias",
          "kind"
        ],
        "properties": {
          "alias": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "alias",
              "descriptor"
            ]
          },
          "descriptor_ref": {
            "type": "string"
          }
        }
      }
    },
    "resolution_examples": {
      "type": "array"
    }
  }
}

