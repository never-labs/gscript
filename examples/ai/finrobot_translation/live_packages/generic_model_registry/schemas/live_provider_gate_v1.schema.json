{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic AI Model Registry Live Provider Gate",
  "type": "object",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "secret_values_present": false,
  "required": [
    "schema_version",
    "id",
    "capability",
    "provider_free",
    "live_network",
    "live_model_calls",
    "enabled_by_default",
    "requires_explicit_integration_env",
    "integration_env",
    "allowed_provider_env_refs",
    "secret_values_present",
    "credential_values_allowed",
    "redaction_policy_ref",
    "clean_skip_without_credentials",
    "default_skip_reason",
    "provider_protocols",
    "live_smoke_contract"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string"},
    "capability": {"type": "string"},
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "live_model_calls": {"const": false},
    "enabled_by_default": {"const": false},
    "requires_explicit_integration_env": {"const": true},
    "integration_env": {"type": "string"},
    "allowed_provider_env_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "secret_values_present": {"const": false},
    "credential_values_allowed": {"const": false},
    "redaction_policy_ref": {"type": "string"},
    "clean_skip_without_credentials": {"const": true},
    "default_skip_reason": {"type": "string"},
    "provider_protocols": {
      "type": "array",
      "items": {"type": "string"}
    },
    "live_smoke_contract": {
      "type": "object",
      "required": [
        "prompt",
        "expected_text",
        "max_tokens",
        "temperature",
        "timeout_seconds",
        "record_replay_required_for_ci"
      ],
      "properties": {
        "prompt": {"type": "string"},
        "expected_text": {"type": "string"},
        "max_tokens": {"type": "integer"},
        "temperature": {"const": 0},
        "timeout_seconds": {"type": "integer"},
        "record_replay_required_for_ci": {"const": true}
      }
    }
  }
}
