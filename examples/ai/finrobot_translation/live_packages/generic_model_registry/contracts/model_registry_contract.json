{
  "schema_version": 1,
  "id": "generic-ai-model-registry-contract",
  "capability_id": "generic.ai.model.registry",
  "provider_free": true,
  "domain_specific": false,
  "live_network": false,
  "real_dependency_imports": false,
  "live_model_calls": false,
  "boundary": "model alias registry with provider-free replay defaults",
  "inputs": [
    "model_alias",
    "provider_policy",
    "replay_mode"
  ],
  "outputs": [
    "model_descriptor",
    "capability_flags",
    "redaction_policy"
  ],
  "provider_policy": {
    "allow_named_providers": false,
    "allow_live_provider_gate": true,
    "descriptor_provider": "fixture-replay",
    "credential_material": "forbidden",
    "network": "disabled",
    "live_provider_default": "clean-skip"
  },
  "live_provider_gate": {
    "required": true,
    "enabled_by_default": false,
    "requires_explicit_integration_env": true,
    "integration_env": "LEIA_LLM_INTEGRATION",
    "credential_values_allowed": false,
    "credential_env_refs_allowed": true,
    "clean_skip_without_credentials": true,
    "redaction_policy_required": true
  },
  "routing_guard": {
    "request_provider_override": "ignored-when-replay-descriptor-present",
    "replay_descriptor_source": "model_alias_registry",
    "live_provider_behavior": "deny-or-redirect-to-fixture-replay",
    "decision_replay_stable": true
  },
  "resolution_rules": [
    {
      "rule": "alias-chain",
      "description": "aliases may point at other aliases until a descriptor_ref is reached",
      "cycle_behavior": "config-error"
    },
    {
      "rule": "replay-first",
      "description": "resolved descriptors must be deterministic fixture replay descriptors",
      "miss_behavior": "clean-skip"
    },
    {
      "rule": "provider-free",
      "description": "descriptors must not require credentials, live network, or provider SDK imports",
      "violation_behavior": "deny"
    }
  ]
}
