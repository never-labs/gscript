{
  "schema_version": 1,
  "id": "generic-ai-model-registry",
  "package_name": "leia-generic-ai-model-registry",
  "package": "example.com/leia/examples/ai/finrobot-translation/live-packages/generic-model-registry",
  "version": "0.1.0-provider-free-skeleton",
  "dialect_capability_id": "generic.ai.model.registry",
  "provider_free": true,
  "domain_specific": false,
  "live_network": false,
  "live_network_default": false,
  "real_dependency_imports": false,
  "real_dependency_import_default": false,
  "live_model_calls": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "contract_root": "contracts",
  "source_index_entry": {
    "index": "examples/ai/finrobot_translation/ai_dialect_index/index.json",
    "dialect_capability_id": "generic.ai.model.registry",
    "missing_boundary_package_id": "generic-ai-model-registry",
    "resolved_boundary": "provider-free live package skeleton"
  },
  "entrypoints": {
    "main": "main.leia",
    "contract": "contracts/model_registry_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json",
    "alias_registry": "fixtures/model_alias_registry_fixture.json"
  },
  "schemas": {
    "alias_registry": "schemas/model_alias_registry_v1.schema.json",
    "execution_descriptor": "schemas/execution_descriptor_v1.schema.json",
    "redaction_policy": "schemas/redaction_policy_v1.schema.json"
  },
  "capabilities": [
    "generic.ai.model.registry",
    "generic.ai.model.alias.resolve",
    "generic.ai.model.descriptor.replay",
    "generic.ai.model.redaction.policy",
    "generic.ai.model.routing.guard"
  ],
  "default_policy": {
    "mode": "fixture_replay",
    "provider_policy": "provider-free",
    "live_network": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "live_model_calls": false,
    "clean_skip_without_descriptor": true,
    "redact_secret_values": true,
    "replay_miss_behavior": "clean-skip",
    "fixture_hook": "recorded_generic_model_registry_fixture"
  },
  "provider_policy": {
    "id": "provider-free-model-policy-v1",
    "allow_named_providers": false,
    "provider_credentials_required": false,
    "live_network": false,
    "live_model_calls": false,
    "descriptor_provider": "fixture-replay",
    "fallback_provider": "fixture-replay",
    "deny_reasons": [
      "live_provider_disabled",
      "credential_material_forbidden",
      "network_disabled"
    ]
  },
  "routing_guard": {
    "id": "provider-free-routing-guard-v1",
    "provider_free": true,
    "live_network": false,
    "secret_values_present": false,
    "request_provider_override": "ignored-when-replay-descriptor-present",
    "replay_descriptor_source": "model_alias_registry",
    "live_provider_behavior": "deny-or-redirect-to-fixture-replay",
    "fallback_provider": "fixture-replay",
    "decision_replay_stable": true,
    "denied_provider_kinds": [
      "future-live-provider",
      "request-scoped-live-provider",
      "provider-sdk-import"
    ],
    "redirect_evidence": [
      {
        "requested_alias": "live_candidate",
        "denied_provider": "future-live-provider",
        "redirect_alias": "default",
        "descriptor_ref": "model_registry:descriptor:fixture_analyst:v1",
        "provider": "fixture-replay",
        "reason": "replay"
      }
    ]
  },
  "redaction_policy": {
    "id": "generic-model-registry-redaction-v1",
    "enabled": true,
    "replacement": "<redacted>",
    "secret_value_policy": "never-store-secret-values",
    "secret_values_present": false,
    "redact_fields": [
      "api_key",
      "authorization",
      "credential",
      "secret",
      "token"
    ],
    "env_ref_patterns": [
      "env:*_API_KEY",
      "env:*_TOKEN",
      "env:OPENAI_API_KEY",
      "env:ANTHROPIC_API_KEY"
    ]
  },
  "capability_flags": {
    "model_alias_registry": true,
    "provider_policy": true,
    "replay_safe_execution_descriptor": true,
    "redaction_policy": true,
    "structured_output": true,
    "tool_calling": true,
    "streaming": false,
    "vision": false,
    "live_network": false,
    "provider_credentials": false
  },
  "alias_registry": [
    {
      "alias": "default",
      "target": "analyst",
      "kind": "alias"
    },
    {
      "alias": "analyst",
      "target": "fixture_analyst",
      "kind": "alias"
    },
    {
      "alias": "reviewer",
      "target": "fixture_reviewer",
      "kind": "alias"
    },
    {
      "alias": "fixture_analyst",
      "kind": "descriptor",
      "descriptor_ref": "model_registry:descriptor:fixture_analyst:v1"
    },
    {
      "alias": "fixture_reviewer",
      "kind": "descriptor",
      "descriptor_ref": "model_registry:descriptor:fixture_reviewer:v1"
    }
  ],
  "execution_descriptors": [
    {
      "descriptor_ref": "model_registry:descriptor:fixture_analyst:v1",
      "model_alias": "fixture_analyst",
      "provider": "fixture-replay",
      "provider_model": "generic-fixture-analyst-v1",
      "mode": "deterministic_fixture_replay",
      "fixture_key": "model_registry:turn:analyst:ACME:v1",
      "replay_safe": true,
      "live_network": false,
      "provider_credentials_required": false,
      "secret_values_present": false,
      "temperature": 0,
      "capability_flags": [
        "model_alias_registry",
        "provider_policy",
        "replay_safe_execution_descriptor",
        "redaction_policy",
        "structured_output",
        "tool_calling"
      ],
      "redaction_policy_ref": "generic-model-registry-redaction-v1"
    },
    {
      "descriptor_ref": "model_registry:descriptor:fixture_reviewer:v1",
      "model_alias": "fixture_reviewer",
      "provider": "fixture-replay",
      "provider_model": "generic-fixture-reviewer-v1",
      "mode": "deterministic_fixture_replay",
      "fixture_key": "model_registry:turn:reviewer:ACME:v1",
      "replay_safe": true,
      "live_network": false,
      "provider_credentials_required": false,
      "secret_values_present": false,
      "temperature": 0,
      "capability_flags": [
        "model_alias_registry",
        "provider_policy",
        "replay_safe_execution_descriptor",
        "redaction_policy",
        "structured_output"
      ],
      "redaction_policy_ref": "generic-model-registry-redaction-v1"
    }
  ],
  "test_gates": [
    "provider_free",
    "no live network",
    "no provider credentials",
    "routing guard redirects live provider candidates to replay descriptors",
    "alias registry resolves to replay-safe descriptors",
    "redaction policy forbids stored secret values",
    "capability flags expose registry and replay boundaries"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide built-in generic AI model registry execution; leia-generic-ai-model-registry defines the provider-free package boundary."
  }
}
