generic_agent_runner_live_package := {
    provider_free: true
    live_network: false
    real_dependency_imports: false
    backend_shape: "ai.agent.run"
    contracts: {
        tools: 2
        max_steps: 4
        trace_events: 6
        output_required_fields: 3
        capabilities: 7
        tool_contract_projections: 1
    }
}

func generic_agent_runner_provider_free_ok(pkg) {
    if pkg == nil {
        return false
    }
    return pkg.provider_free == true && pkg.live_network == false && pkg.real_dependency_imports == false && pkg.backend_shape == "ai.agent.run"
}

assert(generic_agent_runner_provider_free_ok(generic_agent_runner_live_package))

generic_agent_runner_live_package_summary := string.format(
