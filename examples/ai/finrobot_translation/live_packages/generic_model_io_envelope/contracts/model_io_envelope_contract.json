{
  "schema_version": 1,
  "id": "generic-model-io-envelope-contract",
  "package_boundary_id": "generic-ai-model-io-envelope",
  "provider_free": true,
  "domain_specific": false,
  "live_network": false,
  "live_model": false,
  "credentials_required": false,
  "adapter_contract": {
    "adapter_identity": "generic-model-io-envelope-adapter",
    "concrete_provider_names_allowed": false,
    "request_response_envelope_required": true,
    "provider_free_replay_required": true
  },
  "request_envelope": {
    "name": "model_request_envelope_v1",
    "required_fields": [
      "envelope_version",
      "turn_id",
      "model",
      "messages",
      "tools",
      "response_format",
      "metadata",
      "redaction"
    ],
    "metadata_fields": [
      "trace_id",
      "replay_session_id",
      "adapter_identity",
      "provider_free"
    ]
  },
  "stream_chunk_envelope": {
    "name": "model_stream_chunk_v1",
    "required_fields": [
      "chunk_id",
      "turn_id",
      "sequence",
      "event_type",
      "delta",
      "status",
      "usage_delta"
    ],
    "event_types": [
      "response.delta",
      "response.completed"
    ],
    "sequence_stable": true,
    "chunk_text_reconstructs_response": true
  },
  "response_envelope": {
    "name": "model_response_envelope_v1",
    "required_fields": [
      "envelope_version",
      "turn_id",
      "status",
      "text",
      "tool_calls",
      "finish_reason",
      "usage",
      "metadata",
      "redaction"
    ],
    "usage_fields": [
      "input_tokens",
      "output_tokens",
      "total_tokens",
      "cost",
      "currency",
      "latency_ms"
    ],
    "cost_metadata_required": true
  },
  "redaction": {
    "required": true,
    "secret_values_present": false,
    "redacted_fields": [
      "api_key",
      "authorization",
      "provider_credentials"
    ],
    "replacement": "<redacted>"
  },
  "registry_turn_projection": {
    "source_packages": [
      "generic-model-registry",
      "generic-model-io-envelope",
      "generic-turn-runner"
    ],
    "inputs": [
      "model_alias_registry",
      "replay_execution_descriptor",
      "redaction_policy",
      "provider_free_replay_record",
      "single_turn_request"
    ],
    "outputs": [
      "resolved_descriptor_ref",
      "model_request_envelope",
      "turn_request_projection",
      "redaction_mapping",
      "replay_match_mapping"
    ],
    "required_fields": [
      "projection_id",
      "requested_alias",
      "resolved_descriptor_ref",
      "model_request_turn_id",
      "turn_request_id",
      "request_hash",
      "redaction_policy_ref",
      "provider_free"
    ],
    "source_ids_are_not_assumed_equal": true,
    "raw_prompt_stored": false,
    "secret_values_allowed": false,
    "deterministic_replay_required": true
  }
}
