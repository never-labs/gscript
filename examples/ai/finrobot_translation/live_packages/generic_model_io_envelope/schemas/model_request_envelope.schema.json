{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/generic_ai/model_request_envelope.schema.json",
  "title": "generic model request envelope",
  "type": "object",
  "required": ["envelope_version", "turn_id", "model", "messages", "tools", "response_format", "metadata", "redaction"],
  "properties": {
    "envelope_version": {"type": "string", "const": "model_request_envelope_v1"},
    "turn_id": {"type": "string"},
    "model": {"type": "string"},
    "messages": {"type": "array", "items": {"type": "object"}},
    "tools": {"type": "array", "items": {"type": "object"}},
    "response_format": {"type": "object"},
    "metadata": {"type": "object"},
    "redaction": {"type": "object"}
  },
  "additionalProperties": true
}
