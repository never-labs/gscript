source_annotation_requirements := {
    required_fields: {"id", "title", "kind", "locator", "as_of", "stale_after", "stale", "license", "retrieved_at", "evidence_hash"},
    all_report_source_refs_must_resolve: true,
    all_snapshot_source_refs_must_resolve: true,
}

func source_annotation_by_id(id) {
    for i := 1; i <= #source_annotations; i++ {
        if source_annotations[i].id == id {
            return source_annotations[i]
        }
    }
    return nil
}

func source_ref_resolves(id) {
    return source_annotation_by_id(id) != nil
}

func validate_source_annotation_requirements(source) {
    for i := 1; i <= #source_annotation_requirements.required_fields; i++ {
        field := source_annotation_requirements.required_fields[i]
        if source[field] == nil {
            return false, field
        }
    }
    return true, nil
}

source_requirements_ok := true
source_requirements_error := nil
for i := 1; i <= #source_annotations; i++ {
    source_req_ok, source_req_error := validate_source_annotation_requirements(source_annotations[i])
    if !source_req_ok {
        source_requirements_ok = false
        source_requirements_error = source_req_error
    }
}

