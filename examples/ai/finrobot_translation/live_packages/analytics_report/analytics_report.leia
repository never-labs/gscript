    retryable: true,
    renderable: true,
    warning_refs: {"warning_optional_macro_section_skipped"},
    failure_reason: "optional section skipped because no provider dependency is available in provider-free mode",
}

func outline_section_by_id(id) {
    for i := 1; i <= #report_outline.sections; i++ {
        if report_outline.sections[i].id == id {
            return report_outline.sections[i]
        }
    }
    return nil
}

func dag_node_exists(id) {
    for i := 1; i <= #section_dependency_dag.nodes; i++ {
        if section_dependency_dag.nodes[i] == id {
            return true
        }
    }
    return false
}

func validate_report_outline(outline) {
    if outline.style_profile_id != style_profile_policy.id || outline.render_manifest_id != render_artifact_manifest.id || #outline.sections != #report_sections {
        return false
    }
    for i := 1; i <= #outline.sections; i++ {
        section := outline.sections[i]
        if section.id != report_sections[i].id || section.order != report_sections[i].order || #section.render_targets != 2 {
            return false
        }
        for j := 1; j <= #section.depends_on; j++ {
            if outline_section_by_id(section.depends_on[j]) == nil {
                return false
            }
        }
    }
    return true
}

func validate_section_dependency_dag(dag) {
    if dag.acyclic != true || dag.missing_dependency_policy != "block_required_section_and_emit_partial_fixture" {
        return false
    }
    for i := 1; i <= #dag.edges; i++ {
        edge := dag.edges[i]
        if !dag_node_exists(edge.from) || !dag_node_exists(edge.to) || edge.from == edge.to {
            return false
        }
    }
    return true
}

func validate_evidence_envelope(envelope) {
    if envelope.provider_free != true || #envelope.unresolved_refs != 0 || #envelope.source_refs == 0 || #envelope.citation_refs == 0 {
        return false
    }
    for i := 1; i <= #envelope.source_refs; i++ {
        if !source_ref_resolves(envelope.source_refs[i]) {
            return false
        }
    }
    for i := 1; i <= #envelope.citation_refs; i++ {
        citation := envelope.citation_refs[i]
        if citation.source_id == nil || !source_ref_resolves(citation.source_id) || citation.quote_policy == nil {
            return false
        }
    }
    return true
}

func snapshot_ref_exists(id) {
    for i := 1; i <= #snapshot_metadata; i++ {
        if snapshot_metadata[i].id == id {
            return true
        }
    }
    return false
}

func validate_render_artifact_manifest(manifest) {
    if manifest.dependency_required != false || manifest.status != "planned_not_rendered" || #manifest.outputs != #snapshot_metadata {
        return false
    }
    for i := 1; i <= #manifest.outputs; i++ {
        output := manifest.outputs[i]
        if output.artifact_id == nil || output.path == nil || output.status == nil || !snapshot_ref_exists(output.snapshot_ref) {
            return false
        }
    }
    return true
}

func validate_style_profile_policy(policy) {
    return policy.provider_free == true && policy.disclosure_policy == "ai_disclosure_required" && policy.currency == valuation_assumptions.currency && #policy.forbidden_content == 2
}

func validate_partial_report_fixture(fixture) {
    return fixture.status == "partial" && fixture.retryable == true && fixture.renderable == true && #fixture.completed_sections == #report_sections && #fixture.failed_sections == 1 && fixture.failed_sections[1].required == false
}

outline_ok := validate_report_outline(report_outline)
section_dag_ok := validate_section_dependency_dag(section_dependency_dag)
