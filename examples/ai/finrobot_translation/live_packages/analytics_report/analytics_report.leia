    snapshots: {"snapshot_html_report", "snapshot_pdf_report", "snapshot_chart_target_price", "snapshot_chart_sensitivity"},
}

partial_report_fixture := {
    id: "partial_report_fixture_optional_macro_section_v1",
    status: "partial",
    completed_sections: {"valuation", "sensitivity"},
    failed_sections: {
        {
            id: "macro_context",
