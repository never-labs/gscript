{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/finrobot/equity_analysis_pipeline/forecast_result_v1.schema.json",
  "title": "FinRobot Equity Analysis Forecast Result",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_key",
    "provider_free",
    "live_network",
    "ticker",
    "forecast_periods",
    "assumptions",
    "forecast_rows",
    "valuation_summary",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "forecast_periods": {
      "type": "array",
      "minItems": 1
    },
    "assumptions": {
      "type": "object"
    },
    "forecast_rows": {
      "type": "array",
      "minItems": 1
    },
    "valuation_summary": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  }
}
