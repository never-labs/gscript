{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/finrobot/equity_analysis_pipeline/provider_free_trace_v1.schema.json",
  "title": "FinRobot Equity Analysis Provider Free Trace",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_key",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "run_id",
    "stage_events",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "run_id": {
      "type": "string"
    },
    "stage_events": {
      "type": "array",
      "minItems": 1
    },
    "artifact_refs": {
      "type": "array"
    }
  }
}
