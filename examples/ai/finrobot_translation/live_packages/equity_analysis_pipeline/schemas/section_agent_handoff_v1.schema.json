{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/finrobot/equity_analysis_pipeline/section_agent_handoff_v1.schema.json",
  "title": "FinRobot Equity Analysis Section Agent Handoff",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_key",
    "provider_free",
    "live_network",
    "run_id",
    "agent_roles",
    "ordered_sections",
    "handoff_payloads",
    "evidence_refs",
    "terminate_convention"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "agent_roles": {
      "type": "array",
      "minItems": 1
    },
    "ordered_sections": {
      "type": "array",
      "minItems": 1
    },
    "handoff_payloads": {
      "type": "array",
      "minItems": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1
    },
    "terminate_convention": {
      "type": "object"
    }
  }
}
