{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/finrobot/equity_analysis_pipeline/artifact_manifest_v1.schema.json",
  "title": "FinRobot Equity Analysis Artifact Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_key",
    "provider_free",
    "live_network",
    "report_id",
    "artifacts",
    "trace_refs",
    "disclosures"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "report_id": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1
    },
    "trace_refs": {
      "type": "array"
    },
    "disclosures": {
      "type": "array"
    }
  }
}
