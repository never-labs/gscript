{
  "schema_version": 1,
  "id": "generic-ai-record-replay-contract",
  "package_name": "generic.ai.record.replay",
  "provider_free": true,
  "domain_specific": false,
  "live_network": false,
  "real_dependency_imports": false,
  "record_schema": "schemas/record_v1.schema.json",
  "index_schema": "schemas/replay_index_v1.schema.json",
  "finding_schema": "schemas/match_finding_v1.schema.json",
  "summary_schema": "schemas/matching_summary_v1.schema.json",
  "record_required_fields": [
    "record_id",
    "sequence",
    "replay_key",
    "operation",
    "capability",
    "request_hash",
    "response_hash",
    "request",
    "response",
    "provider_free",
    "recorded_at"
  ],
  "forbidden_record_fields": [
    "provider",
    "provider_sdk",
    "api_key",
    "credential",
    "network_client",
    "live_endpoint"
  ],
  "matching_contract": {
    "strategy": "strict_ordered",
    "cursor_origin": 0,
    "scan_ahead": false,
    "consume_on_match": true,
    "consume_on_mismatch": false,
    "request_identity_fields": ["operation", "capability", "replay_key", "request_hash"],
    "mismatch_finding_kind": "generic.ai.replay.mismatch",
    "unconsumed_finding_kind": "generic.ai.replay.unconsumed_record",
    "exhausted_finding_kind": "generic.ai.replay.exhausted"
  },
  "deterministic_summary": {
    "field_order": [
      "fixture_id",
      "strategy",
      "loaded_records",
      "requests",
      "matched",
      "mismatches",
      "unconsumed",
      "exhausted",
      "next_index",
      "finding_kinds",
      "matched_record_ids"
    ],
    "sort_findings_by": ["cursor", "kind", "record_id"],
    "hash_algorithm": "sha256",
    "stable_json": true
  }
}
