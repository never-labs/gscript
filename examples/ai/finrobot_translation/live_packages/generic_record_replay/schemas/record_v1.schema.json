{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generic.ai.record.replay.record.v1",
  "title": "Generic AI replay record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "sequence",
    "replay_key",
    "operation",
    "capability",
    "request_hash",
    "response_hash",
    "request",
    "response",
    "provider_free",
    "recorded_at"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "replay_key": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "pattern": "^generic\\.ai\\."},
    "request_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "response_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": ["canonical_json", "redactions"],
      "properties": {
        "canonical_json": {"type": "object", "additionalProperties": true},
        "redactions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": true,
      "required": ["canonical_json", "status"],
      "properties": {
        "canonical_json": {"type": "object", "additionalProperties": true},
        "status": {"type": "string", "enum": ["ok", "error", "clean_skip"]}
      }
    },
    "provider_free": {"type": "boolean", "const": true},
    "recorded_at": {"type": "string", "format": "date-time"},
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fixture": {"type": "boolean"},
        "deterministic": {"type": "boolean"},
        "live_network": {"type": "boolean", "const": false},
        "real_dependency_imports": {"type": "boolean", "const": false}
      }
    }
  }
}
