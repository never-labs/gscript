{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generic.ai.record.replay.index.v1",
  "title": "Generic AI replay fixture index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "provider_free",
    "domain_specific",
    "strategy",
    "record_schema",
    "records_path",
    "request_fixtures",
    "expected_summaries"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "fixture_id": {"type": "string"},
    "provider_free": {"type": "boolean", "const": true},
    "domain_specific": {"type": "boolean", "const": false},
    "strategy": {"type": "string", "const": "strict_ordered"},
    "record_schema": {"type": "string"},
    "records_path": {"type": "string"},
    "request_fixtures": {"type": "object", "additionalProperties": {"type": "string"}},
    "expected_summaries": {"type": "object", "additionalProperties": true}
  }
}
