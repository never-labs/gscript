{
  "schema_version": 1,
  "id": "finrobot-product-workflow-live-package",
  "package_name": "leia-finrobot-product-workflow",
  "version": "0.1.0-skeleton",
  "description": "Provider-free live package skeleton for FinRobot equity CLI and web product workflow contracts.",
  "source_examples": [
    "examples/ai/finrobot_translation/equity_cli_workflow.leia",
    "examples/ai/finrobot_translation/web_product.leia"
  ],
  "provider_free": true,
  "live_network_default": false,
  "real_dependency_import_default": false,
  "credentials": {
    "required": [],
    "optional": [],
    "secret_env_patterns": [],
    "policy": "No credentials are declared by this skeleton; live provider keys belong only to future provider-specific packages."
  },
  "entrypoints": {
    "equity_cli_workflow": "contracts/product_workflow_contract.json#/workflows/equity_cli",
    "web_product": "contracts/product_workflow_contract.json#/workflows/web_product",
    "db_migrations": "contracts/db_migration_contract.json",
    "deployment_capability_gates": "contracts/deployment_capability_gates.json"
  },
  "schemas": {
    "workflow_run": "schemas/workflow_run.schema.json",
    "web_product": "schemas/web_product.schema.json",
    "db_migration": "schemas/db_migration.schema.json",
    "deployment_gate": "schemas/deployment_gate.schema.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json"
  },
  "capabilities": [
    "product.workflow.equity_cli.run",
    "product.workflow.equity_cli.artifact_plan",
    "product.workflow.web.route",
    "product.workflow.auth.session",
    "product.workflow.history.read",
    "product.workflow.task_log.read",
    "product.workflow.download.artifact",
    "product.workflow.crud.report_request",
    "product.workflow.db.migration.plan",
    "product.workflow.deploy.local",
    "product.workflow.deploy.container",
    "product.workflow.deploy.cloud"
  ],
  "deployment_capability_gates": [
    {
      "id": "local_fixture_service",
      "capability": "product.workflow.deploy.local",
      "default": "fixture",
      "live_network": false,
      "requires_credentials": false,
      "checks": [
        "manifest present",
        "schemas valid",
        "fixtures resolvable"
      ]
    },
    {
      "id": "container_image",
      "capability": "product.workflow.deploy.container",
      "default": "contract_only",
      "live_network": false,
      "requires_credentials": false,
      "checks": [
        "Dockerfile owned by future package",
        "no provider SDK import in skeleton",
        "health route fixture-backed"
      ]
    },
    {
      "id": "cloud_runtime",
      "capability": "product.workflow.deploy.cloud",
      "default": "disabled",
      "live_network": false,
      "requires_credentials": false,
      "checks": [
        "cloud deployment denied until capability granted",
        "database and object storage gates explicit",
        "observability export disabled in fixture mode"
      ]
    }
  ],
  "test_gates": [
    "manifest and referenced schemas decode without external dependencies",
    "provider_free is true and live_network_default is false",
    "required and optional credentials are empty",
    "equity CLI, web product, auth/session/history/task log/download/CRUD/db migration contracts are present",
    "deployment capability gates declare capabilities and deny credentials by default"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide this product workflow as a built-in; a future external package must satisfy these contracts and capability gates."
  }
}
