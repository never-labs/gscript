  "accessibility_snapshot_requirements": {
    "mode": "static_dom_contract",
    "requires_browser": false,
    "requires_live_network": false,
    "requires_credentials": false,
    "standards": ["WCAG_2_2_AA_static_subset", "ARIA_landmark_names"],
    "checks": [
      "one_main_landmark",
      "one_h1_per_route",
      "nav_landmark_labelled_when_present",
      "form_controls_have_labels",
      "buttons_have_accessible_names",
      "tables_have_captions_or_aria_labels",
      "status_regions_use_role_status_or_alert",
      "focus_order_follows_dom_order",
      "decorative_assets_hidden_from_accessibility_tree"
    ],
    "snapshot_fixture_path": "fixtures/provider_free_fixture_index.json#/fixtures/web_product/ui_snapshots/accessibility"
  },
  "visual_regression_metadata": {
    "mode": "static_template_asset_contract",
    "requires_browser": false,
    "requires_live_network": false,
    "requires_credentials": false,
    "snapshot_source": "template_hash_plus_static_asset_manifest",
    "viewports": [
      {"id": "mobile", "width": 390, "height": 844, "device_scale_factor": 2},
      {"id": "desktop", "width": 1440, "height": 1024, "device_scale_factor": 1}
    ],
    "metadata_fields": [
      "route",
      "template_id",
      "snapshot_id",
      "viewport_id",
      "fixture_dataset_id",
      "template_sha256",
      "asset_manifest_sha256"
    ],
    "diff_policy": {
      "baseline": "provider_free_fixture",
      "pixel_threshold": 0,
      "layout_shift_threshold": 0,
      "font_source": "system_ui_only"
    },
    "snapshot_fixture_path": "fixtures/provider_free_fixture_index.json#/fixtures/web_product/ui_snapshots/visual"
  }
}
