{
  "schema_version": 1,
  "id": "finrobot-product-workflow-ui-template-snapshot-contract",
  "capability": "product.workflow.web.template_snapshot",
  "provider_free": true,
  "live_network": false,
  "requires_credentials": false,
  "requires_browser": false,
  "static_asset_manifest": "templates/static_asset_manifest.json",
  "route_to_template_mapping": [
    {
      "route": "home",
      "path": "/",
      "template_id": "tmpl_home",
      "template_path": "templates/home.html",
      "required_slots": ["page_title", "primary_nav", "recent_reports", "new_request_action"],
      "snapshot_id": "snap_home_fixture"
    },
    {
      "route": "login",
      "path": "/login",
      "template_id": "tmpl_login",
      "template_path": "templates/login.html",
      "required_slots": ["page_title", "oauth_state_notice", "login_action"],
      "snapshot_id": "snap_login_fixture"
    },
    {
      "route": "oauth_callback",
      "path": "/auth/callback",
