{
  "schema_version": 1,
  "id": "finrobot-product-workflow-contract",
  "provider_free": true,
  "live_network": false,
  "workflows": {
    "equity_cli": {
      "capability": "product.workflow.equity_cli.run",
      "source_example": "examples/ai/finrobot_translation/equity_cli_workflow.leia",
      "stages": [
        "load_cli_config",
        "load_recorded_inputs",
        "normalize_financial_tables",
        "generate_section_text",
        "plan_report_artifacts",
        "validate_stale_sections",
        "finalize_report_output"
      ],
      "contracts": [
        "retry_policy",
        "stale_section_failure_hook",
        "artifact_manifest",
        "source_annotations",
        "deterministic_task_history"
      ],
      "outputs": [
        "html_report_path",
        "pdf_report_path",
        "artifact_manifest_path",
        "task_history"
      ]
    },
    "web_product": {
      "capability": "product.workflow.web.route",
      "source_example": "examples/ai/finrobot_translation/web_product.leia",
      "routes": [
        "home",
        "login",
        "oauth_callback",
        "logout",
        "reports_index",
        "report_detail",
        "report_download",
        "submit_equity_request",
        "task_status",
        "admin_dashboard",
        "admin_users",
        "admin_task_log"
      ],
      "contracts": [
        "auth_session",
        "report_history",
        "task_log",
        "download_manifest",
        "crud_fixture",
        "db_migration"
      ]
    }
  },
  "route_session_state_contract": {
    "capability": "product.workflow.web.route",
    "mode": "fixture_session_state",
    "requires_browser": false,
    "requires_live_network": false,
    "requires_credentials": false,
    "state_source": "fixtures/provider_free_fixture_index.json#/fixtures/web_product/auth_sessions",
    "routes": [
      {"route": "home", "method": "GET", "allowed_session_states": ["anonymous", "authenticated", "session_refreshed"], "required_role": "none", "side_effects": []},
      {"route": "login", "method": "GET", "allowed_session_states": ["anonymous"], "required_role": "none", "side_effects": ["oauth_state_fixture_issued"]},
      {"route": "oauth_callback", "method": "GET", "allowed_session_states": ["oauth_state_issued"], "required_role": "none", "side_effects": ["session_fixture_created", "audit_event_recorded"]},
      {"route": "logout", "method": "POST", "allowed_session_states": ["authenticated", "session_refreshed"], "required_role": "analyst", "side_effects": ["session_revoked", "audit_event_recorded"]},
      {"route": "reports_index", "method": "GET", "allowed_session_states": ["authenticated", "session_refreshed"], "required_role": "analyst", "side_effects": []},
      {"route": "report_detail", "method": "GET", "allowed_session_states": ["authenticated", "session_refreshed"], "required_role": "analyst", "side_effects": []},
      {"route": "report_download", "method": "GET", "allowed_session_states": ["authenticated", "session_refreshed"], "required_role": "analyst", "side_effects": ["artifact_download_audit_event"]},
      {"route": "submit_equity_request", "method": "POST", "allowed_session_states": ["authenticated", "session_refreshed"], "required_role": "analyst", "side_effects": ["report_request_command_enqueued"]},
      {"route": "task_status", "method": "GET", "allowed_session_states": ["authenticated", "session_refreshed"], "required_role": "analyst", "side_effects": []},
      {"route": "admin_dashboard", "method": "GET", "allowed_session_states": ["authenticated", "session_refreshed"], "required_role": "admin", "side_effects": []},
      {"route": "admin_users", "method": "GET", "allowed_session_states": ["authenticated", "session_refreshed"], "required_role": "admin", "side_effects": []},
      {"route": "admin_task_log", "method": "GET", "allowed_session_states": ["authenticated", "session_refreshed"], "required_role": "admin", "side_effects": []}
    ],
    "denied_cases": [
      "anonymous_on_protected_route",
      "expired_session",
      "revoked_session",
      "csrf_missing_for_post",
      "role_mismatch"
    ],
    "invariants": {
      "protected_routes_require_authenticated_state": true,
      "post_routes_require_csrf": true,
      "admin_routes_require_admin_role": true,
      "denied_cases_fixture_covered": true,
      "session_state_changes_emit_audit_event": true
    }
  },
  "auth_session": {
    "capability": "product.workflow.auth.session",
    "mode": "fixture",
    "session_cookie": "finrobot_session",
    "csrf_required": true,
    "lifecycle": {
      "states": [
        "anonymous",
        "oauth_state_issued",
        "authenticated",
        "session_refreshed",
        "expired",
        "revoked"
      ],
      "initial_state": "anonymous",
      "terminal_states": [
        "expired",
        "revoked"
      ],
      "transitions": [
        {
          "from": "anonymous",
          "event": "login_started",
          "to": "oauth_state_issued",
          "writes": ["audit_events"]
        },
        {
          "from": "oauth_state_issued",
          "event": "oauth_callback_validated",
          "to": "authenticated",
          "writes": ["sessions", "audit_events"]
        },
        {
          "from": "authenticated",
          "event": "csrf_validated",
          "to": "session_refreshed",
          "writes": ["sessions"]
        },
        {
          "from": "session_refreshed",
          "event": "ttl_elapsed",
          "to": "expired",
          "writes": ["sessions", "audit_events"]
        },
        {
          "from": "authenticated",
          "event": "logout_requested",
          "to": "revoked",
          "writes": ["sessions", "audit_events"]
        }
      ],
      "fixture_path": "fixtures/provider_free_fixture_index.json#/fixtures/web_product/auth_sessions"
    },
    "roles": [
      "analyst",
      "admin"
    ],
    "denied_cases": [
      "missing_session",
      "disabled_user",
      "expired_oauth_state",
      "requires_admin"
    ]
  },
  "report_request_state_machine": {
    "capability": "product.workflow.crud.report_request",
    "table": "report_requests",
    "states": [
      "draft",
      "queued",
      "running",
      "artifact_ready",
      "completed",
      "failed",
      "cancelled",
      "deleted"
    ],
    "initial_state": "draft",
    "terminal_states": [
      "completed",
      "failed",
      "cancelled",
      "deleted"
    ],
    "transitions": [
      {
        "from": "draft",
        "event": "submit",
        "to": "queued",
        "requires_role": "analyst",
        "writes": ["report_requests", "task_events", "audit_events"]
      },
      {
        "from": "queued",
        "event": "worker_started",
        "to": "running",
        "requires_role": "system_fixture",
        "writes": ["report_requests", "task_events"]
      },
      {
        "from": "running",
        "event": "artifact_manifest_written",
        "to": "artifact_ready",
        "requires_role": "system_fixture",
        "writes": ["reports", "artifacts", "task_events"]
      },
      {
        "from": "artifact_ready",
        "event": "finalize",
        "to": "completed",
        "requires_role": "system_fixture",
        "writes": ["report_requests", "reports", "task_events", "audit_events"]
      },
      {
        "from": "running",
        "event": "fail",
        "to": "failed",
        "requires_role": "system_fixture",
        "writes": ["report_requests", "task_events", "audit_events"]
      },
      {
        "from": "queued",
        "event": "cancel",
        "to": "cancelled",
        "requires_role": "analyst",
        "writes": ["report_requests", "task_events", "audit_events"]
      },
      {
        "from": "draft",
        "event": "delete",
        "to": "deleted",
        "requires_role": "analyst",
        "writes": ["report_requests", "audit_events"]
      }
    ],
    "fixture_path": "fixtures/provider_free_fixture_index.json#/fixtures/web_product/report_request_lifecycle"
  },
  "history": {
    "capability": "product.workflow.history.read",
    "entities": [
      "report_requests",
      "reports",
      "artifacts",
      "audit_events"
    ],
    "deterministic_order": "created_at,id"
  },
  "task_log": {
    "capability": "product.workflow.task_log.read",
    "format": "jsonl",
    "ordering": {
      "key": ["task_id", "sequence"],
      "sequence_column": "sequence",
      "monotonic_per_task": true,
      "tie_breaker": "id",
      "clock": "fixture_logical_clock",
      "fixture_path": "fixtures/provider_free_fixture_index.json#/fixtures/web_product/task_events"
    },
    "events": [
      "queued",
      "started",
      "artifact_planned",
      "completed",
      "failed"
    ],
    "redaction": "no secrets exist in fixture mode"
  },
  "download": {
    "capability": "product.workflow.download.artifact",
    "artifacts": [
      "html",
      "pdf",
      "artifact_manifest",
      "task_log"
    ],
    "authorization": {
      "mode": "owner_or_admin",
      "requires_session_state": "authenticated",
      "requires_artifact_state": "completed",
      "denied_cases": [
        "missing_session",
        "expired_session",
        "wrong_owner",
        "disabled_user",
        "artifact_not_ready",
        "artifact_sha_mismatch"
      ],
      "audit_event": "artifact_download_authorized",
      "fixture_path": "fixtures/provider_free_fixture_index.json#/fixtures/web_product/download_authorization"
    },
    "remote_object_fetch": false
  },
  "artifact_manifest_contract": {
    "capability": "product.workflow.download.artifact_manifest",
    "provider_free": true,
    "live_network": false,
    "requires_credentials": false,
    "manifest_path": "fixtures/provider_free_fixture_index.json#/fixtures/web_product/artifact_manifest",
    "required_fields": [
      "manifest_version",
      "request_id",
      "owner_user_id",
      "artifacts",
      "created_at"
    ],
    "artifact_fields": [
      "artifact_id",
      "kind",
      "media_type",
      "local_path",
      "sha256",
      "byte_size",
      "download_capability"
    ],
    "path_policy": {
      "local_fixture_prefix": "output/fixture/",
      "remote_uri_allowed": false,
      "signed_url_allowed": false,
      "checksum_algorithm": "sha256"
    }
  },
  "crud": {
    "capability": "product.workflow.crud.report_request",
    "operations": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "tables": [
      "users",
      "sessions",
      "report_requests",
      "reports",
      "artifacts",
      "task_events",
      "audit_events"
    ],
    "command_envelope": {
      "mode": "deterministic_fixture_command",
      "requires_live_network": false,
      "requires_credentials": false,
      "required_fields": [
        "command_id",
        "operation",
        "actor_user_id",
        "actor_role",
        "idempotency_key",
        "expected_state",
        "payload",
        "fixture_result_id"
      ],
      "operations": [
        {"operation": "create", "allowed_from": ["none"], "allowed_to": "draft", "requires_role": "analyst"},
        {"operation": "read", "allowed_from": ["draft", "queued", "running", "artifact_ready", "completed", "failed", "cancelled"], "allowed_to": "same", "requires_role": "analyst"},
        {"operation": "update", "allowed_from": ["draft"], "allowed_to": "draft", "requires_role": "analyst"},
        {"operation": "delete", "allowed_from": ["draft"], "allowed_to": "deleted", "requires_role": "analyst"}
      ],
      "fixture_path": "fixtures/provider_free_fixture_index.json#/fixtures/web_product/crud_command_envelopes"
    }
  },
  "approval_boundary": {
    "capability": "product.workflow.approval.boundary",
    "provider_free": true,
    "default_decision": "deny",
    "fixture_path": "fixtures/provider_free_fixture_index.json#/fixtures/web_product/approval_decisions",
    "requires_explicit_capability_grant": true,
    "denied_by_default": [
      "live_provider_call",
      "live_network_fetch",
      "credential_read",
      "provider_sdk_import",
      "database_write_outside_fixture",
      "object_storage_write",
      "external_deploy"
    ],
    "allowed_without_approval": [
      "read_checked_in_fixture",
      "render_static_template_snapshot",
      "replay_recorded_workflow",
      "validate_json_contract"
    ]
  },
  "workflow_replay": {
    "capability": "product.workflow.replay.fixture",
    "provider_free": true,
    "live_network": false,
    "requires_credentials": false,
    "requires_provider_callbacks": false,
    "fixture_path": "fixtures/provider_free_fixture_index.json#/fixtures/workflow_replay",
    "inputs": [
      "ticker",
      "sections",
      "session_fixture_id",
      "crud_command_ids"
    ],
    "ordered_event_sources": [
      "report_request_lifecycle",
      "task_events",
      "download_authorization"
    ],
    "outputs": [
      "artifact_manifest",
      "task_history",
      "ui_snapshot_metadata"
    ],
    "determinism": {
      "clock": "fixture_logical_clock",
      "random_seed": "not_used",
      "external_callbacks": false
    }
  }
}
