{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leia.dev/schemas/finrobot/ui_template_snapshot.schema.json",
  "title": "FinRobot UI Template Snapshot Contract",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "capability",
    "provider_free",
    "live_network",
    "requires_credentials",
    "requires_browser",
    "static_asset_manifest",
    "route_to_template_mapping",
    "accessibility_snapshot_requirements",
    "visual_regression_metadata"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string"},
    "capability": {"type": "string"},
    "provider_free": {"type": "boolean", "const": true},
    "live_network": {"type": "boolean", "const": false},
    "requires_credentials": {"type": "boolean", "const": false},
    "requires_browser": {"type": "boolean", "const": false},
    "static_asset_manifest": {"type": "string"},
    "route_to_template_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route", "path", "template_id", "template_path", "required_slots", "snapshot_id"],
        "properties": {
          "route": {"type": "string"},
          "path": {"type": "string"},
          "template_id": {"type": "string"},
          "template_path": {"type": "string"},
          "required_slots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "snapshot_id": {"type": "string"}
        }
      }
    },
    "accessibility_snapshot_requirements": {"type": "object"},
    "visual_regression_metadata": {"type": "object"}
  }
}
