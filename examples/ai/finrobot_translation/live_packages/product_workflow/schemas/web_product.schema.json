{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/product_workflow/web_product.schema.json",
  "title": "FinRobot Web Product Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_free", "live_network", "routes", "auth_session", "report_request_state_machine", "history", "task_log", "download", "crud"],
  "properties": {
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "routes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "auth_session": {
      "type": "object",
      "required": ["capability", "lifecycle"],
      "properties": {
        "capability": {"const": "product.workflow.auth.session"},
        "lifecycle": {
          "type": "object",
          "required": ["states", "initial_state", "terminal_states", "transitions"],
          "properties": {
            "states": {"type": "array", "items": {"type": "string"}},
            "initial_state": {"const": "anonymous"},
            "terminal_states": {"type": "array", "items": {"type": "string"}},
            "transitions": {"type": "array", "minItems": 1}
          }
        }
      }
    },
    "report_request_state_machine": {
      "type": "object",
      "required": ["capability", "states", "initial_state", "terminal_states", "transitions"],
      "properties": {
        "capability": {"const": "product.workflow.crud.report_request"},
        "states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "initial_state": {"const": "draft"},
        "terminal_states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "transitions": {"type": "array", "minItems": 1}
      }
    },
    "history": {"type": "object"},
    "task_log": {
      "type": "object",
      "required": ["capability", "ordering"],
      "properties": {
        "capability": {"const": "product.workflow.task_log.read"},
        "ordering": {
          "type": "object",
          "required": ["key", "sequence_column", "monotonic_per_task"],
          "properties": {
            "key": {"type": "array", "items": {"type": "string"}},
            "sequence_column": {"const": "sequence"},
            "monotonic_per_task": {"const": true}
          }
        }
      }
    },
    "download": {
      "type": "object",
      "required": ["capability", "authorization", "remote_object_fetch"],
      "properties": {
        "capability": {"const": "product.workflow.download.artifact"},
        "authorization": {
          "type": "object",
          "required": ["mode", "requires_session_state", "requires_artifact_state", "denied_cases"],
          "properties": {
            "mode": {"const": "owner_or_admin"},
            "requires_session_state": {"const": "authenticated"},
            "requires_artifact_state": {"const": "completed"},
            "denied_cases": {"type": "array", "items": {"type": "string"}}
          }
        },
        "remote_object_fetch": {"const": false}
      }
    },
    "crud": {"type": "object"}
  }
}
