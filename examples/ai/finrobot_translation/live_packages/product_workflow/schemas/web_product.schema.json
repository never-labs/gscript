{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/product_workflow/web_product.schema.json",
  "title": "FinRobot Web Product Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_free", "live_network", "routes", "auth_session", "history", "task_log", "download", "crud"],
  "properties": {
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "routes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "auth_session": {"type": "object"},
    "history": {"type": "object"},
    "task_log": {"type": "object"},
    "download": {"type": "object"},
    "crud": {"type": "object"}
  }
}

