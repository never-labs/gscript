{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/finrobot/product_workflow/workflow_run.schema.json",
  "title": "FinRobot Product Workflow Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "provider_free", "live_network", "stages", "outputs"],
  "properties": {
    "workflow_id": {"type": "string"},
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
