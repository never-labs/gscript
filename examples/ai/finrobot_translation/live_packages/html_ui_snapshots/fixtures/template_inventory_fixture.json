{
  "schema_version": 1,
  "id": "finrobot-html-ui-template-inventory-fixture",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "requires_browser": false,
  "templates": [
    {"id": "tpl_base", "source_path": "finrobot_equity/web_app/templates/base.html", "route": "layout", "required_slots": ["document_title", "main_landmark", "flash_messages", "content_block"]},
    {"id": "tpl_index", "source_path": "finrobot_equity/web_app/templates/index.html", "route": "/", "required_slots": ["hero_summary", "ticker_form", "recent_reports"]},
    {"id": "tpl_login", "source_path": "finrobot_equity/web_app/templates/login.html", "route": "/login", "required_slots": ["login_action", "oauth_state_notice"]},
    {"id": "tpl_reports", "source_path": "finrobot_equity/web_app/templates/reports.html", "route": "/reports", "required_slots": ["filter_controls", "report_table", "empty_state"]},
    {"id": "tpl_report_detail", "source_path": "finrobot_equity/web_app/templates/report_detail.html", "route": "/reports/{report_id}", "required_slots": ["report_header", "artifact_links", "task_timeline", "source_summary"]},
    {"id": "tpl_admin_dashboard", "source_path": "finrobot_equity/web_app/templates/admin/dashboard.html", "route": "/admin", "required_slots": ["queue_health", "capability_gates", "audit_summary"]},
    {"id": "tpl_admin_users", "source_path": "finrobot_equity/web_app/templates/admin/users.html", "route": "/admin/users", "required_slots": ["user_table", "role_filter", "session_status"]},
    {"id": "tpl_admin_tasks", "source_path": "finrobot_equity/web_app/templates/admin/tasks.html", "route": "/admin/tasks", "required_slots": ["task_log_table", "redaction_notice", "sequence_sort"]}
  ],
  "professional_template": {
    "id": "html_template_professional",
    "source_path": "finrobot_equity/core/src/modules/html_template_professional.py",
    "required_sections": ["executive_summary", "company_overview", "financial_analysis", "valuation", "risk_assessment", "investment_recommendation", "sources", "disclosures"],
    "section_markup": {"anchor_attribute": "data-section-id", "heading_order": "h1_then_h2", "main_landmark_required": true},
    "table_placeholders": [
      {"id": "financial_metrics_table", "required": true, "markup": "table[data-table-id]", "fallback": "static_table_placeholder", "accessibility": ["caption", "scope=col"]},
      {"id": "valuation_summary_table", "required": true, "markup": "table[data-table-id]", "fallback": "static_table_placeholder", "accessibility": ["caption", "scope=col"]}
    ],
    "chart_placeholders": [
      {"id": "price_performance_chart", "required": true, "markup": "figure[data-chart-id]", "fallback": "static_chart_placeholder", "accessibility": ["figcaption", "aria-label", "text_equivalent"]},
      {"id": "valuation_sensitivity_chart", "required": true, "markup": "figure[data-chart-id]", "fallback": "static_chart_placeholder", "accessibility": ["figcaption", "aria-label", "text_equivalent"]}
    ],
    "provenance_markup": {
      "required": true,
      "attributes": ["data-source-id", "data-source-kind", "data-as-of", "data-evidence-hash"],
      "visible_source_list_required": true
    },
    "disclosure_markup": {
      "required": true,
      "attributes": ["data-disclosure-id", "data-disclosure-kind"],
      "required_disclosures": ["ai_generated_notice", "investment_risk_notice"]
    }
  }
}
