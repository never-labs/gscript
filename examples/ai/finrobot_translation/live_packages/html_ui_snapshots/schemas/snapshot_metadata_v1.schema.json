{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leia.dev/schemas/finrobot/html_ui/snapshot_metadata_v1.schema.json",
  "title": "FinRobot HTML/UI Snapshot Metadata",
  "type": "object",
  "required": ["schema_version", "provider_free", "live_network", "requires_browser", "deterministic_hash_seed", "deterministic_snapshot_hash", "snapshots"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "provider_free": {"type": "boolean", "const": true},
    "live_network": {"type": "boolean", "const": false},
    "requires_browser": {"type": "boolean", "const": false},
    "deterministic_hash_seed": {"type": "string"},
    "deterministic_snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshots": {"type": "array", "minItems": 1}
  }
}
