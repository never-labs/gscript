{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leia.dev/schemas/finrobot/html_ui/static_asset_manifest_v1.schema.json",
  "title": "FinRobot HTML/UI Static Asset Manifest",
  "type": "object",
  "required": ["schema_version", "provider_free", "live_network", "requires_browser", "asset_policy", "assets", "template_asset_refs"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "provider_free": {"type": "boolean", "const": true},
    "live_network": {"type": "boolean", "const": false},
    "requires_browser": {"type": "boolean", "const": false},
    "asset_policy": {"type": "object"},
    "assets": {"type": "array", "minItems": 1},
    "template_asset_refs": {"type": "array", "minItems": 1}
  }
}
