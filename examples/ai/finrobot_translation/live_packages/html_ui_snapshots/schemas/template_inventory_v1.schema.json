{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leia.dev/schemas/finrobot/html_ui/template_inventory_v1.schema.json",
  "title": "FinRobot HTML/UI Template Inventory",
  "type": "object",
  "required": ["schema_version", "provider_free", "live_network", "requires_browser", "templates", "professional_template"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "provider_free": {"type": "boolean", "const": true},
    "live_network": {"type": "boolean", "const": false},
    "requires_browser": {"type": "boolean", "const": false},
    "templates": {"type": "array", "minItems": 1},
    "professional_template": {"type": "object"}
  }
}
