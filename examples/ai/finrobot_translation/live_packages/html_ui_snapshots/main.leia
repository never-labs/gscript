// Provider-free HTML/UI snapshot contract for FinRobot templates and static assets.
//
// The JSON manifest and fixtures are the contract of record. This smoke file
// avoids browser, network, provider, and runtime substrate dependencies.

html_ui_snapshots_live_package := {
    id: "finrobot-html-ui-snapshots-live-package"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    requires_browser: false
    clean_skip_without_browser: true
    template_sources: {
        "finrobot_equity/web_app/templates/*",
        "finrobot_equity/web_app/static/*",
        "finrobot_equity/core/src/modules/html_template_professional.py"
    }
    required_sections: {
        "executive_summary",
        "company_overview",
        "financial_analysis",
        "valuation",
        "risk_assessment",
        "investment_recommendation",
        "sources",
        "disclosures"
    }
    table_placeholders: {"financial_metrics_table", "valuation_summary_table"}
    chart_placeholders: {"price_performance_chart", "valuation_sensitivity_chart"}
    markup_hooks: {"data-source-id", "data-evidence-hash", "data-disclosure-id"}
    accessibility_checks: {
        "main_landmark",
        "single_h1",
        "heading_order",
        "table_captions",
        "chart_text_equivalent",
        "source_links_visible",
        "disclosures_rendered",
        "focus_order_static"
    }
    static_assets: {"asset_app_css", "asset_report_css", "asset_app_js", "asset_status_icons"}
    deterministic_snapshot_hash: "fc0779b037111b16133371e271f272d08c2ceb4cae6c61329d49d9dfef2e91f6"
}

func html_ui_snapshot_contract_ok(pkg) {
    if pkg == nil {
        return false
    }
    return pkg.provider_free == true &&
        pkg.live_network == false &&
        pkg.real_dependency_imports == false &&
        pkg.requires_browser == false &&
        pkg.clean_skip_without_browser == true &&
        #pkg.template_sources == 3 &&
        #pkg.required_sections == 8 &&
        #pkg.table_placeholders == 2 &&
        #pkg.chart_placeholders == 2 &&
        #pkg.markup_hooks == 3 &&
        #pkg.accessibility_checks == 8 &&
        #pkg.static_assets == 4
}

html_ui_snapshot_contract_valid := html_ui_snapshot_contract_ok(html_ui_snapshots_live_package)
assert(html_ui_snapshot_contract_valid)

html_ui_snapshots_live_package_summary := string.format(
"html_ui_snapshots_live_package templates=%d sections=%d tables=%d charts=%d a11y=%d assets=%d provider_free=%s browser=%s",
#html_ui_snapshots_live_package.template_sources,
#html_ui_snapshots_live_package.required_sections,
#html_ui_snapshots_live_package.table_placeholders,
#html_ui_snapshots_live_package.chart_placeholders,
#html_ui_snapshots_live_package.accessibility_checks,
#html_ui_snapshots_live_package.static_assets,
tostring(html_ui_snapshots_live_package.provider_free),
tostring(html_ui_snapshots_live_package.requires_browser)
)

print(html_ui_snapshots_live_package_summary)
