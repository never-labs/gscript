{
  "schema_version": 1,
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "live_model_calls": false,
  "catalog": {
    "catalog_id": "generic-prompt-role-catalog",
    "fixture_key": "generic:prompt_role_catalog:offline",
    "default_termination": "COMPLETE",
    "domain_identifiers": {}
  },
  "role_profiles": [
    {
      "role_id": "Researcher",
      "version": "1.0.0",
      "status": "fixture_locked",
      "instructions": ["Use only supplied evidence.", "Return unresolved refs instead of inventing facts."],
      "tool_policy": "read_only_fixture_tools",
      "output_schema": "role_handoff_v1",
      "termination": "COMPLETE"
    },
    {
      "role_id": "Data_Checker",
      "version": "1.0.0",
      "status": "fixture_locked",
      "instructions": ["Validate source refs.", "Report missing evidence before narrative writing."],
      "tool_policy": "validation_fixture_tools",
      "output_schema": "evidence_validation_v1",
      "termination": "COMPLETE"
    },
    {
      "role_id": "Writer",
      "version": "1.0.0",
      "status": "fixture_locked",
      "instructions": ["Draft only from validated evidence.", "Preserve unresolved warnings."],
      "tool_policy": "no_side_effect_tools",
      "output_schema": "section_output_v1",
      "termination": "COMPLETE"
    }
  ],
  "prompt_templates": [
    {
      "entry_id": "researcher_system",
      "role_id": "Researcher",
      "kind": "system",
      "template": "Research the request using {{source_refs}} and return unresolved refs with COMPLETE.",
      "required_placeholders": ["{{source_refs}}"],
      "constraints": ["provider_free", "no_live_network", "cite_supplied_refs"],
      "expected_sections": ["summary", "source_refs", "unresolved_source_refs", "COMPLETE"]
    },
    {
      "entry_id": "data_checker_guardrail",
      "role_id": "Data_Checker",
      "kind": "guardrail",
      "template": "Validate at least {{minimum_source_refs}} source refs and reject unresolved refs before COMPLETE.",
      "required_placeholders": ["{{minimum_source_refs}}"],
      "constraints": ["validate_source_refs", "no_generated_sources"],
      "expected_sections": ["validated", "rules", "failure_reason", "COMPLETE"]
    },
    {
      "entry_id": "writer_section",
      "role_id": "Writer",
      "kind": "instruction",
      "template": "Draft {{section_id}} from validated evidence, keep source refs, and finish with COMPLETE.",
      "required_placeholders": ["{{section_id}}"],
      "constraints": ["source_bound_claims", "preserve_warnings"],
      "expected_sections": ["title", "body", "key_points", "source_refs", "COMPLETE"]
    }
  ],
  "delegation_triggers": [
    {
      "entry_id": "researcher_system",
      "pattern": "(?i)\\b(validate|check sources|missing evidence)\\b",
      "input": "validate source refs before drafting",
      "matched": true,
      "delegate_role_id": "Data_Checker",
      "reason": "source validation belongs to the checker role"
    },
    {
      "entry_id": "researcher_system",
      "pattern": "(?i)\\b(write|draft|section)\\b",
      "input": "summarize supplied evidence",
      "matched": false,
      "delegate_role_id": "",
      "reason": "research summary can stay in the current role"
    },
    {
      "entry_id": "writer_section",
      "pattern": "(?i)\\b(unresolved|missing source)\\b",
      "input": "missing source ref in section draft",
      "matched": true,
      "delegate_role_id": "Data_Checker",
      "reason": "unresolved evidence must be checked before writing"
    },
    {
      "entry_id": "writer_section",
      "pattern": "(?i)\\b(validate|check sources)\\b",
      "input": "draft from already validated refs",
      "matched": false,
      "delegate_role_id": "",
      "reason": "no additional validation trigger matched"
    }
  ],
  "output_schema": {
    "schema_id": "section_output_v1",
    "required_fields": ["section_id", "title", "body", "key_points", "source_refs", "evidence_validation", "termination"]
  },
  "evidence_validation_cases": [
    {
      "case_id": "valid_sources",
      "validated": true,
      "minimum_source_refs": 1,
      "source_refs": ["source:fixture:001"],
      "unresolved_source_refs": [],
      "fixture_keys": ["generic:prompt_role_catalog:offline"],
      "rules": [
        {"rule_id": "minimum_source_refs", "passes": true},
        {"rule_id": "no_unresolved_source_refs", "passes": true}
      ]
    },
    {
      "case_id": "missing_sources",
      "validated": false,
      "minimum_source_refs": 1,
      "source_refs": [],
      "unresolved_source_refs": [],
      "fixture_keys": ["generic:prompt_role_catalog:offline"],
      "rules": [
        {"rule_id": "minimum_source_refs", "passes": false},
        {"rule_id": "no_unresolved_source_refs", "passes": true}
      ]
    },
    {
      "case_id": "unresolved_sources",
      "validated": false,
      "minimum_source_refs": 1,
      "source_refs": ["source:fixture:001"],
      "unresolved_source_refs": ["source:missing:999"],
      "fixture_keys": ["generic:prompt_role_catalog:offline"],
      "rules": [
        {"rule_id": "minimum_source_refs", "passes": true},
        {"rule_id": "no_unresolved_source_refs", "passes": false}
      ]
    }
  ],
  "termination_convention": {
    "literal": "COMPLETE",
    "required_for_final": true,
    "drift_cases": [
      {"case_id": "exact_literal", "text": "All evidence checked. COMPLETE", "valid": true},
      {"case_id": "missing_literal", "text": "All evidence checked.", "valid": false},
      {"case_id": "wrong_literal", "text": "All evidence checked. DONE", "valid": false}
    ]
  },
  "adapter_boundaries": [
    {"id": "template_loader", "capability": "generic.ai.prompt.template.snapshot", "dependency_imported": false, "credential_required": false, "live_network": false, "clean_skip": true},
    {"id": "trigger_parser", "capability": "generic.ai.role.delegation.trigger", "dependency_imported": false, "credential_required": false, "live_network": false, "clean_skip": true},
    {"id": "evidence_validator", "capability": "generic.ai.role.evidence.validation", "dependency_imported": false, "credential_required": false, "live_network": false, "clean_skip": true}
  ]
}
