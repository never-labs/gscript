generic_prompt_role_catalog_live_package := {
    id: "generic-prompt-role-catalog",
    package_name: "leia-generic-ai-prompt-role-catalog",
    capability: "generic.ai.prompt.role.catalog",
    entrypoint: "ai.prompt.role_catalog",
    fixture_key: "generic:prompt_role_catalog:offline",
    provider_free: true,
    live_network: false,
    real_dependency_imports: false,
    live_model_calls: false,
    roles: 3,
    templates: 3,
    delegation_cases: 4,
    evidence_cases: 3,
    termination: "COMPLETE"
}

assert(generic_prompt_role_catalog_live_package.provider_free)
assert(!generic_prompt_role_catalog_live_package.live_network)
assert(!generic_prompt_role_catalog_live_package.real_dependency_imports)
assert(!generic_prompt_role_catalog_live_package.live_model_calls)
assert(generic_prompt_role_catalog_live_package.roles == 3)
assert(generic_prompt_role_catalog_live_package.templates == 3)
assert(generic_prompt_role_catalog_live_package.delegation_cases == 4)

generic_prompt_role_catalog_live_package_summary := string.format(
"generic_prompt_role_catalog_live_package capability=%s entrypoint=%s roles=%d templates=%d delegation=%d evidence=%d termination=%s provider_free=%s live_network=%s imports=%s model_calls=%s",
generic_prompt_role_catalog_live_package.capability,
generic_prompt_role_catalog_live_package.entrypoint,
generic_prompt_role_catalog_live_package.roles,
generic_prompt_role_catalog_live_package.templates,
generic_prompt_role_catalog_live_package.delegation_cases,
generic_prompt_role_catalog_live_package.evidence_cases,
generic_prompt_role_catalog_live_package.termination,
tostring(generic_prompt_role_catalog_live_package.provider_free),
tostring(generic_prompt_role_catalog_live_package.live_network),
tostring(generic_prompt_role_catalog_live_package.real_dependency_imports),
tostring(generic_prompt_role_catalog_live_package.live_model_calls))

print(generic_prompt_role_catalog_live_package_summary)
