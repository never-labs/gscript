{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/generic_ai/workflow_orchestrator/planning_graph_stage_projection_v1.schema.json",
  "title": "GenericWorkflowPlanningGraphStageProjectionV1",
  "type": "object",
  "required": [
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "source_package",
    "target_package",
    "source_refs",
    "workflow_id",
    "run_id",
    "stage_mappings",
    "edge_mappings",
    "evidence_mappings",
    "projection_assertions"
  ],
  "properties": {
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "source_package": {
      "const": "generic_planning_graph"
    },
    "target_package": {
      "const": "generic_workflow_orchestrator"
    },
    "source_refs": {
      "type": "object"
    },
    "workflow_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "stage_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "source_node_ids",
          "source_node_types",
          "input_ref",
          "output_ref",
          "trace_event_refs"
        ]
      }
    },
    "edge_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_edge_type",
          "source_edges",
          "workflow_edge",
          "handoff_ref"
        ]
      }
    },
    "evidence_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_kind",
          "source_event_refs",
          "workflow_trace_refs"
        ]
      }
    },
    "projection_assertions": {
      "type": "object"
    }
  }
}
