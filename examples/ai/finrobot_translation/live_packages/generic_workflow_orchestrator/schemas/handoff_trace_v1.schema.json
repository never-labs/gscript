{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenericWorkflowHandoffTraceV1",
  "type": "object",
  "required": [
    "provider_free",
    "live_network",
    "workflow_id",
    "run_id",
    "handoffs"
  ],
  "properties": {
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_stage",
          "to_stage",
          "payload_ref",
          "payload_schema",
          "status",
          "trace_event_id"
        ]
      }
    }
  }
}
