{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenericWorkflowGraphV1",
  "type": "object",
  "required": [
    "workflow_id",
    "entrypoint",
    "provider_free",
    "live_network",
    "stages",
    "edges"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "entrypoint": {
      "const": "ai.workflow.orchestrate"
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "stages": {
      "type": "array"
    },
    "edges": {
      "type": "array"
    }
  }
}

