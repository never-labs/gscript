{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenericWorkflowGraphV1",
  "type": "object",
  "required": [
    "workflow_id",
    "entrypoint",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "package_name",
    "stages",
    "edges"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "entrypoint": {
      "const": "ai.workflow.orchestrate"
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "package_name": {
      "const": "generic.ai.workflow.orchestration"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "depends_on",
          "input_ref",
          "output_ref",
          "input_schema",
          "output_schema"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
