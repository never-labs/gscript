{
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "package_name": "generic.ai.workflow.orchestration",
  "entrypoint": "ai.workflow.orchestrate",
  "workflow_graph_fixture": "fixtures/workflow_graph_fixture.json",
  "stage_io_fixture": "fixtures/stage_io_fixture.json",
  "handoff_trace_fixture": "fixtures/handoff_trace_fixture.json",
  "workflow_result_fixture": "fixtures/workflow_result_fixture.json",
  "stages": [
    {
      "id": "plan",
      "depends_on": [],
      "input_schema": "schemas/workflow_graph_v1.schema.json",
      "output_schema": "schemas/stage_io_v1.schema.json",
      "required_fields": [
        "stage_id",
        "input_ref",
        "output_ref",
        "status",
        "trace_event_id"
      ]
    },
    {
      "id": "execute",
      "depends_on": [
        "plan"
      ],
      "input_schema": "schemas/stage_io_v1.schema.json",
      "output_schema": "schemas/stage_io_v1.schema.json",
      "required_fields": [
        "stage_id",
        "input_ref",
        "output_ref",
        "status",
        "trace_event_id"
      ]
    },
    {
      "id": "handoff",
      "depends_on": [
        "execute"
      ],
      "input_schema": "schemas/stage_io_v1.schema.json",
      "output_schema": "schemas/handoff_trace_v1.schema.json",
      "required_fields": [
        "from_stage",
        "to_stage",
        "payload_ref",
        "status",
        "trace_event_id"
      ]
    },
    {
      "id": "finalize",
      "depends_on": [
        "handoff"
      ],
      "input_schema": "schemas/handoff_trace_v1.schema.json",
      "output_schema": "schemas/workflow_result_v1.schema.json",
      "required_fields": [
        "workflow_id",
        "run_id",
        "status",
        "stage_results",
        "trace_refs"
      ]
    }
  ],
  "dag_edges": [
    [
      "plan",
      "execute"
    ],
    [
      "execute",
      "handoff"
    ],
    [
      "handoff",
      "finalize"
    ]
  ],
  "retry_cache_contract": {
    "provider_free": true,
    "live_network": false,
    "schema": "schemas/retry_cache_policy_v1.schema.json",
    "max_attempts": 1,
    "cache_states": [
      "hit",
      "miss",
      "bypass"
    ],
    "required_event_fields": [
      "attempt",
      "max_attempts",
      "cache_key",
      "cache_state",
      "fixture_key"
    ]
  },
  "acceptance_gates": [
    "workflow graph is acyclic and ordered plan, execute, handoff, finalize",
    "each stage has explicit input and output schema refs",
    "retry/cache policy stays deterministic fixture metadata",
    "workflow result and handoff trace decode without provider imports"
  ]
}
