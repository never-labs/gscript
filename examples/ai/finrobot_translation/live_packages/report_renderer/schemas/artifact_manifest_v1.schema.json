{
  "schema_version": 1,
  "id": "artifact_manifest_v1",
  "type": "object",
  "required": [
    "manifest_id",
    "report_id",
    "request_id",
    "hash_algorithm",
    "manifest_hash_seed",
    "manifest_hash",
    "artifacts"
  ],
  "artifact_required": [
    "artifact_id",
    "kind",
    "format",
    "uri",
    "status",
    "content_hash",
    "hash_algorithm"
  ],
  "artifact_kinds": [
    "html_report",
    "pdf_report",
    "page_snapshot",
    "render_manifest"
  ],
  "statuses": [
    "specified_not_rendered",
    "planned_not_rendered",
    "clean_skipped_without_renderer"
  ],
  "hash_algorithm": "sha256"
}
