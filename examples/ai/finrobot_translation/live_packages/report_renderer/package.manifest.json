{
  "schema_version": 1,
  "id": "finrobot-report-renderer-live-package",
  "package_name": "leia-finrobot-report-renderer",
  "version": "0.1.0-skeleton",
  "description": "Provider-free live package skeleton for FinRobot HTML/PDF report rendering contracts, visual snapshots, warnings, and annotations.",
  "source_modules": [
    "FinRobot/report/render.py",
    "FinRobot/report/html.py",
    "FinRobot/report/pdf.py"
  ],
  "provider_free": true,
  "live_network_default": false,
  "real_dependency_import_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "credentials": {
    "required": [],
    "optional": [],
    "secret_env_patterns": [],
    "policy": "No renderer credentials are declared by this skeleton; browser, PDF, chart export, and storage integrations belong only to future provider-specific packages."
  },
  "default_policy": {
    "mode": "fixture_replay",
    "live_network": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "renderer_dependency_required": false,
    "clean_skip_without_renderer": true,
    "fixture_hook": "recorded_report_renderer_live_fixture"
  },
  "entrypoints": {
    "smoke": "main.leia",
    "report_renderer_contract": "contracts/report_renderer_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json"
  },
  "schemas": {
    "render_request": "schemas/render_request_v1.schema.json",
    "output_manifest": "schemas/output_manifest_v1.schema.json",
    "artifact_manifest": "schemas/artifact_manifest_v1.schema.json",
    "page_snapshot_metadata": "schemas/page_snapshot_metadata_v1.schema.json",
    "render_warning": "schemas/render_warning_v1.schema.json",
    "source_annotation": "schemas/source_annotation_v1.schema.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json",
    "render_request": "fixtures/render_request_ACME_report_fixture.json"
  },
  "capabilities": [
    "finance.report.render.request",
    "finance.report.render.request_envelope",
    "finance.report.render.html.contract",
    "finance.report.render.pdf.contract",
    "finance.report.render.output_manifest",
    "finance.report.render.artifact_manifest",
    "finance.report.render.page_snapshot_metadata",
    "finance.report.render.page_snapshot_hash",
    "finance.report.render.table_warning",
    "finance.report.render.markdown_warning",
    "finance.report.render.disclosure_annotation",
    "finance.report.render.source_annotation",
    "finance.report.render.missing_chart_handling",
    "finance.report.render.fixture_hash",
    "finance.report.render.clean_skip"
  ],
  "render_contracts": [
    {
      "id": "html_renderer_contract",
      "format": "text/html",
      "capability": "finance.report.render.html.contract",
      "required_request_fields": [
        "report_id",
        "request_id",
        "render_mode",
        "sections",
        "tables",
        "charts",
        "source_annotations",
        "disclosures",
        "output_formats"
      ],
      "required_output_fields": [
        "artifact_id",
        "format",
        "uri",
        "content_hash",
        "artifact_manifest_id",
        "page_snapshots",
        "warnings",
        "source_annotation_checks",
        "disclosure_checks"
      ],
      "renderer_dependency_required": false,
      "clean_skip": true
    },
    {
      "id": "pdf_renderer_contract",
      "format": "application/pdf",
      "capability": "finance.report.render.pdf.contract",
      "required_request_fields": [
        "report_id",
        "request_id",
        "render_mode",
        "sections",
        "tables",
        "charts",
        "source_annotations",
        "disclosures",
        "output_formats"
      ],
      "required_output_fields": [
        "artifact_id",
        "format",
        "uri",
        "content_hash",
        "artifact_manifest_id",
        "page_snapshots",
        "warnings",
        "source_annotation_checks",
        "disclosure_checks"
      ],
      "renderer_dependency_required": false,
      "clean_skip": true
    }
  ],
  "visual_contract": {
    "output_formats": [
      "text/html",
      "application/pdf"
    ],
    "snapshot_formats": [
      "text/html",
      "application/pdf",
      "image/png"
    ],
    "snapshot_statuses": [
      "specified_not_rendered",
      "planned_not_rendered",
      "clean_skipped_without_renderer"
    ],
    "required_snapshot_fields": [
      "page_number",
      "format",
      "viewport",
      "dimensions",
      "status",
      "content_hash",
      "hash_algorithm",
      "hash_seed",
      "source_refs",
      "warning_refs",
      "disclosure_refs"
    ],
    "warning_kinds": [
      "table_render_warning",
      "markdown_render_warning",
      "missing_chart_warning"
    ],
    "annotation_checks": {
      "all_source_refs_must_resolve": true,
      "all_disclosures_must_render": true,
      "unresolved_refs_allowed": false
    }
  },
  "test_gates": [
    "manifest and referenced JSON files decode without external dependencies",
    "provider_free is true and live_network_default is false",
    "HTML and PDF render contracts declare request, output manifest, page snapshots, warning, annotation, and clean-skip fields",
    "request envelope carries deterministic request id, render mode, and optional renderer dependency gate",
    "artifact manifest records HTML, PDF, and page snapshot artifacts without writing rendered files",
    "page snapshot hashes are deterministic sha256 values derived from provider-free fixture seeds",
    "fixture declares table and markdown render warnings plus missing chart handling",
    "source annotations and AI/risk disclosures are resolved in fixture output checks",
    "deterministic fixture hash is stable without invoking a renderer"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide FinRobot HTML renderers, PDF renderers, browser engines, chart exporters, or visual diff engines as built-ins; this package declares those surfaces as external capabilities behind provider-free contracts."
  }
}
