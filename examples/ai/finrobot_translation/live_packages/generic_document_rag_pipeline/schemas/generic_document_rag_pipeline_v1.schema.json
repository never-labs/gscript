{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.example/schemas/generic/ai/document_rag_pipeline_v1.schema.json",
  "title": "generic_document_rag_pipeline_v1",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "document_source",
    "document_markdown",
    "sections",
    "chunk_policy",
    "corpus_manifest",
    "chunks",
    "retriever_query",
    "retrieved_chunks",
    "answer_citations",
    "adapter_boundaries",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "real_dependency_imports": {"const": false},
    "document_source": {
      "type": "object",
      "required": ["document_id", "source_ref", "source_type", "media_type"],
      "properties": {
        "document_id": {"type": "string"},
        "source_ref": {"type": "string"},
        "source_type": {"type": "string"},
        "media_type": {"type": "string"},
        "domain_identifiers": {"type": "object"}
      }
    },
    "document_markdown": {
      "type": "object",
      "required": ["document_id", "markdown", "source_offsets"],
      "properties": {
        "document_id": {"type": "string"},
        "markdown": {"type": "string"},
        "source_offsets": {"type": "array"}
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "section_title", "start_offset", "end_offset"],
        "properties": {
          "section_id": {"type": "string"},
          "section_title": {"type": "string"},
          "start_offset": {"type": "integer"},
          "end_offset": {"type": "integer"}
        }
      }
    },
    "chunk_policy": {
      "type": "object",
      "required": ["max_tokens", "overlap_tokens", "section_aware"]
    },
    "corpus_manifest": {
      "type": "object",
      "required": ["corpus_id", "fixture_key", "document_count", "chunk_count", "citation_consistency_required"]
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "section_id", "text", "token_count", "citation", "provenance", "embedding_ref"],
        "properties": {
          "chunk_id": {"type": "string"},
          "section_id": {"type": "string"},
          "text": {"type": "string"},
          "token_count": {"type": "integer"},
          "citation": {
            "type": "object",
            "required": ["source_ref", "page", "section_title", "start_offset", "end_offset"]
          },
          "provenance": {
            "type": "object",
            "required": ["corpus_id", "source_document_ref", "source_fixture_key", "fixture_key", "converter_fixture_key", "source_offsets"]
          },
          "embedding_ref": {
            "type": "object",
            "required": ["adapter", "embedding_id", "model", "dependency_imported", "credential_required", "clean_skip"]
          }
        }
      }
    },
    "retriever_query": {
      "type": "object",
      "required": ["query", "answer", "top_k"]
    },
    "retrieved_chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "rank", "score", "section_id", "citation"]
      }
    },
    "answer_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "claim", "source_ref", "page"]
      }
    },
    "adapter_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "adapter", "capability", "fixture_key", "dependency_imported", "credential_required", "live_network", "clean_skip"]
      }
    },
    "provenance": {
      "type": "object",
      "required": ["fixture_key", "source_document_ref", "chunk_fixture_key", "retriever_fixture_key"]
    }
  }
}
