{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/finrobot/valuation_engine/assumption_audit_v1.schema.json",
  "title": "FinRobot Valuation Assumption Audit",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "symbol",
    "currency",
    "period",
    "assumptions",
    "audit_results",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "symbol": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "minItems": 1
    },
    "audit_results": {
      "type": "array",
      "minItems": 1
    },
    "provenance": {
      "type": "object"
    }
  }
}
