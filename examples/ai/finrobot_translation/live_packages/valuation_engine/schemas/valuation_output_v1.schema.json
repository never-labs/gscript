{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/finrobot/valuation_engine/valuation_output_v1.schema.json",
  "title": "FinRobot Valuation Output",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "symbol",
    "currency",
    "as_of",
    "methods",
    "target_price_synthesis",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "symbol": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "methods": {
      "type": "array",
      "minItems": 3
    },
    "target_price_synthesis": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  }
}
