{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-labs.dev/schemas/finrobot/valuation_engine/scenario_book_v1.schema.json",
  "title": "FinRobot Valuation Scenario Book",
  "type": "object",
  "required": [
    "schema_version",
    "provider_free",
    "live_network",
    "real_dependency_imports",
    "symbol",
    "currency",
    "as_of",
    "scenario_dimensions",
    "scenarios",
    "scenario_weighted_target",
    "tolerance_metadata",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_free": {
      "const": true
    },
    "live_network": {
      "const": false
    },
    "real_dependency_imports": {
      "const": false
    },
    "symbol": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "scenario_dimensions": {
      "type": "array",
      "minItems": 6
    },
    "scenarios": {
      "type": "array",
      "minItems": 3
    },
    "scenario_weighted_target": {
      "type": "object"
    },
    "tolerance_metadata": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  }
}
