{
  "schema_version": 1,
  "id": "finrobot-valuation-engine-contract",
  "provider_free": true,
  "live_network": false,
  "real_dependency_imports": false,
  "clean_skip_without_dependency": true,
  "source_modules": [
    "finrobot/valuation/dcf.py",
    "finrobot/valuation/multiples.py",
    "finrobot/valuation/target_price.py"
  ],
  "modules": [
    {
      "id": "dcf",
      "source_module": "finrobot/valuation/dcf.py",
      "required_fields": [
        "symbol",
        "method",
        "currency",
        "period",
        "inputs",
        "outputs",
        "math_metadata",
        "provenance"
      ]
    },
    {
      "id": "multiples",
      "source_module": "finrobot/valuation/multiples.py",
      "required_fields": [
        "symbol",
        "method",
        "currency",
        "period",
        "peer_set",
        "inputs",
        "outputs",
        "provenance"
      ]
    },
    {
      "id": "target_price_synthesis",
      "source_module": "finrobot/valuation/target_price.py",
      "required_fields": [
        "symbol",
        "weights",
        "target_price",
        "football_field",
        "assumption_audit",
        "tolerance_gates",
        "provenance"
      ]
    }
  ],
  "method_outputs": [
    {
      "id": "dcf",
      "schema": "schemas/valuation_output_v1.schema.json",
      "fixture": "fixtures/valuation_output_ACME_fixture.json",
      "primary_key": [
        "symbol",
        "method",
        "period"
      ],
      "required_metrics": [
        "enterprise_value",
        "equity_value",
        "price_per_share"
      ]
    },
    {
      "id": "football_field",
      "schema": "schemas/football_field_v1.schema.json",
      "fixture": "fixtures/football_field_ACME_fixture.json",
      "primary_key": [
        "symbol",
        "as_of"
      ],
      "required_metrics": [
        "low",
        "base",
        "high"
      ]
    }
  ],
  "provenance_contract": {
    "required_fields": [
      "provider",
      "fixture_key",
      "captured_at",
      "source_schema",
      "source_url_redacted",
      "stale_after_days",
      "replay_ready"
    ],
    "redact_source_url": true,
    "live_network": false
  },
  "acceptance_gates": [
    "valuation methods return typed envelopes, not provider-native payloads",
    "DCF math metadata records projected FCFs, discount rate, terminal growth, terminal value, and share count",
    "EV/EBITDA and P/E multiples carry peer_set, period, currency, and provenance",
    "target price synthesis uses explicit weights and produces football-field data",
    "assumption audit and tolerance gates are fixture-backed and provider-free",
    "hidden live data fetches are forbidden while live_network=false"
  ]
}
