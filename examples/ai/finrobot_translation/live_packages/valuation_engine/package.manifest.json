{
  "schema_version": 1,
  "id": "finrobot-valuation-engine-live-package",
  "package_name": "leia-finrobot-valuation-engine",
  "version": "0.1.0-skeleton",
  "description": "Provider-free live package skeleton for FinRobot valuation contracts covering DCF, EV/EBITDA, P/E, target price synthesis, football-field data, assumption audit, and tolerance gates.",
  "source_modules": [
    "finrobot/valuation/dcf.py",
    "finrobot/valuation/multiples.py",
    "finrobot/valuation/target_price.py"
  ],
  "provider_free": true,
  "live_network_default": false,
  "real_dependency_import_default": false,
  "fixture_root": "fixtures",
  "schema_root": "schemas",
  "credentials": {
    "required": [],
    "optional": [],
    "secret_env_patterns": [],
    "policy": "No credentials are declared by this skeleton; market data, consensus estimate, filing, and peer multiple providers belong only to future provider-specific packages."
  },
  "default_policy": {
    "mode": "fixture_replay",
    "live_network": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "clean_skip_without_dependency": true,
    "fixture_hook": "recorded_valuation_engine_live_fixture"
  },
  "entrypoints": {
    "smoke": "main.leia",
    "valuation_engine_contract": "contracts/valuation_engine_contract.json",
    "assumption_audit_contract": "contracts/assumption_audit_contract.json",
    "scenario_contract": "contracts/valuation_scenario_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json"
  },
  "schemas": {
    "valuation_output": "schemas/valuation_output_v1.schema.json",
    "football_field": "schemas/football_field_v1.schema.json",
    "assumption_audit": "schemas/assumption_audit_v1.schema.json",
    "tolerance_gate": "schemas/tolerance_gate_v1.schema.json",
    "valuation_scenario": "contracts/valuation_scenario_contract.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json",
    "valuation_output": "fixtures/valuation_output_ACME_fixture.json",
    "football_field": "fixtures/football_field_ACME_fixture.json",
    "assumption_audit": "fixtures/assumption_audit_ACME_fixture.json",
    "tolerance_gates": "fixtures/tolerance_gates_ACME_fixture.json",
    "scenario_coverage": "fixtures/scenario_coverage_fixture.json"
  },
  "modules": [
    {
      "id": "dcf",
      "source_module": "finrobot/valuation/dcf.py",
      "capabilities": [
        "finance.valuation.dcf.project_fcf",
        "finance.valuation.dcf.discount_cash_flows",
        "finance.valuation.dcf.terminal_value",
        "finance.valuation.dcf.equity_value",
        "finance.valuation.provenance.attach"
      ],
      "output_schemas": [
        "valuation_output",
        "football_field",
        "tolerance_gate"
      ]
    },
    {
      "id": "multiples",
      "source_module": "finrobot/valuation/multiples.py",
      "capabilities": [
        "finance.valuation.multiple.ev_ebitda",
        "finance.valuation.multiple.pe",
        "finance.valuation.peer_set.validate",
        "finance.valuation.currency_period.normalize",
        "finance.valuation.provenance.attach"
      ],
      "output_schemas": [
        "valuation_output",
        "football_field",
        "tolerance_gate"
      ]
    },
    {
      "id": "target_price_synthesis",
      "source_module": "finrobot/valuation/target_price.py",
      "capabilities": [
        "finance.valuation.target_price.synthesize",
        "finance.valuation.football_field.build",
        "finance.valuation.assumption_audit",
        "finance.valuation.tolerance_gate.evaluate",
        "finance.valuation.offline_data_boundary.enforce"
      ],
      "output_schemas": [
        "valuation_output",
        "football_field",
        "assumption_audit",
        "tolerance_gate"
      ]
    }
  ],
  "valuation_methods": [
    {
      "id": "dcf",
      "capability": "finance.valuation.dcf.discount_cash_flows",
      "schema": "valuation_output",
      "fixture_key": "valuation:ACME:dcf:offline",
      "currency": "USD",
      "period": "FY2026-FY2030",
      "provider_free": true
    },
    {
      "id": "ev_ebitda",
      "capability": "finance.valuation.multiple.ev_ebitda",
      "schema": "valuation_output",
      "fixture_key": "valuation:ACME:ev_ebitda:offline",
      "currency": "USD",
      "period": "FY2026E",
      "provider_free": true
    },
    {
      "id": "pe",
      "capability": "finance.valuation.multiple.pe",
      "schema": "valuation_output",
      "fixture_key": "valuation:ACME:pe:offline",
      "currency": "USD",
      "period": "FY2026E",
      "provider_free": true
    }
  ],
  "tolerance_gates": [
    {
      "id": "dcf_enterprise_value",
      "metric": "enterprise_value",
      "expected": 2310.802011,
      "actual": 2310.802011,
      "absolute_tolerance": 0.000001,
      "status": "pass"
    },
    {
      "id": "dcf_price_per_share",
      "metric": "price_per_share",
      "expected": 43.61604,
      "actual": 43.61604,
      "absolute_tolerance": 0.000001,
      "status": "pass"
    },
    {
      "id": "ev_ebitda_price_per_share",
      "metric": "price_per_share",
      "expected": 50.2,
      "actual": 50.2,
      "absolute_tolerance": 0.000001,
      "status": "pass"
    },
    {
      "id": "pe_price_per_share",
      "metric": "price_per_share",
      "expected": 53.2,
      "actual": 53.2,
      "absolute_tolerance": 0.000001,
      "status": "pass"
    },
    {
      "id": "synthesis_target_price",
      "metric": "target_price",
      "expected": 47.50802,
      "actual": 47.50802,
      "absolute_tolerance": 0.000001,
      "status": "pass"
    }
  ],
  "test_gates": [
    "manifest and referenced JSON files decode without external dependencies",
    "DCF, EV/EBITDA, P/E, target price synthesis, football-field data, assumption audit, and tolerance gates are represented as provider-free contracts",
    "deterministic fixture math metadata records formulas, currency, period, provenance, and replay-ready status",
    "bear/base/bull sensitivity, WACC terminal-growth grids, peer outlier rejection, analyst target conflicts, and scenario audit trails are fixture-backed",
    "tolerance gates compare expected and actual fixture values within explicit absolute tolerances",
    "main.leia contains no live provider SDK imports, network execution, q/runtime valuation optimization, or hidden data fetch"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide FinRobot valuation engines, peer multiple providers, consensus estimate feeds, or target price synthesis as built-ins; future external packages must satisfy these provider-free contracts before enabling live network access."
  }
}
