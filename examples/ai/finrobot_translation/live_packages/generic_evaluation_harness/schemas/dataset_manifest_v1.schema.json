{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset_manifest_v1.schema.json",
  "type": "object",
  "required": ["schema_version", "dataset_id", "provider_free", "live_network", "format", "id_field", "case_count", "required_fields"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string"},
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "format": {"type": "string"},
    "id_field": {"type": "string"},
    "case_count": {"type": "integer", "minimum": 1},
    "required_fields": {"type": "array", "items": {"type": "string"}}
  }
}
