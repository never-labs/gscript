{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "findings_v1.schema.json",
  "type": "object",
  "required": ["schema_version", "provider_free", "live_network", "finding_kinds", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "finding_kinds": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array"}
  }
}
