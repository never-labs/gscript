{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case_inputs_v1.schema.json",
  "type": "object",
  "required": ["schema_version", "provider_free", "live_network", "dataset_id", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "dataset_id": {"type": "string"},
    "cases": {"type": "array", "minItems": 1}
  }
}
