{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judge_replay_records_v1.schema.json",
  "type": "object",
  "required": ["schema_version", "provider_free", "live_network", "mode", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "provider_free": {"const": true},
    "live_network": {"const": false},
    "mode": {"const": "replay"},
    "records": {"type": "array", "minItems": 1}
  }
}
