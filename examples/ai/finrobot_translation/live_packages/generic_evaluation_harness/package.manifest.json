{
  "schema_version": 1,
  "id": "generic-ai-evaluation-harness-live-package",
  "package_name": "leia-generic-ai-evaluation-harness",
  "version": "0.1.0-skeleton",
  "description": "Provider-free live package skeleton for generic.ai.evaluation.harness and ai.eval.run with manifest-driven datasets, case inputs, metrics, judge replay records, findings, golden gates, and case result summaries.",
  "provider_free": true,
  "live_network_default": false,
  "real_dependency_import_default": false,
  "source_modules": [
    "main.leia"
  ],
  "credentials": {
    "required": [],
    "optional": [],
    "secret_env_patterns": [],
    "policy": "No provider credentials are declared by this skeleton; judge models are represented by checked-in replay records or deterministic mock stubs only."
  },
  "default_policy": {
    "mode": "fixture_replay",
    "live_network": false,
    "provider_credentials_required": false,
    "real_dependency_imports": false,
    "clean_skip_without_dependency": true,
    "fixture_hook": "recorded_generic_evaluation_harness_fixture"
  },
  "entrypoints": {
    "smoke": "main.leia",
    "evaluation_harness_contract": "contracts/evaluation_harness_contract.json",
    "fixture_index": "fixtures/provider_free_fixture_index.json"
  },
  "schemas": {
    "dataset_manifest": "schemas/dataset_manifest_v1.schema.json",
    "case_inputs": "schemas/case_inputs_v1.schema.json",
    "metric_specs": "schemas/metric_specs_v1.schema.json",
    "judge_replay_records": "schemas/judge_replay_records_v1.schema.json",
    "findings": "schemas/findings_v1.schema.json",
    "golden_gates": "schemas/golden_gates_v1.schema.json",
    "case_result_summary": "schemas/case_result_summary_v1.schema.json"
  },
  "fixtures": {
    "index": "fixtures/provider_free_fixture_index.json",
    "dataset_manifest": "fixtures/dataset_manifest_fixture.json",
    "case_inputs": "fixtures/case_inputs_fixture.json",
    "metric_specs": "fixtures/metric_specs_fixture.json",
    "judge_replay_records": "fixtures/judge_replay_records_fixture.json",
    "findings": "fixtures/findings_fixture.json",
    "golden_gates": "fixtures/golden_gates_fixture.json",
    "case_result_summary": "fixtures/case_result_summary_fixture.json"
  },
  "capabilities": [
    "generic.ai.evaluation.harness.dataset_manifest",
    "generic.ai.evaluation.harness.case_inputs",
    "generic.ai.evaluation.harness.metric_specs",
    "generic.ai.evaluation.harness.judge_replay_records",
    "generic.ai.evaluation.harness.findings",
    "generic.ai.evaluation.harness.golden_gates",
    "generic.ai.evaluation.harness.case_result_summary",
    "ai.eval.run.provider_free",
    "ai.eval.run.fixture_replay",
    "ai.eval.run.golden_gate"
  ],
  "dialect_surface": [
    "generic.ai.evaluation.harness",
    "ai.eval.run",
    "eval.load_jsonl",
    "eval.case",
    "eval.metric",
    "eval.judge",
    "eval.finding",
    "eval.golden_gate",
    "llm.replay"
  ],
  "artifact_boundaries": [
    {
      "id": "dataset_manifest",
      "capability": "generic.ai.evaluation.harness.dataset_manifest",
      "schema": "dataset_manifest",
      "fixture": "dataset_manifest",
      "provider_free": true,
      "live_network": false
    },
    {
      "id": "case_inputs",
      "capability": "generic.ai.evaluation.harness.case_inputs",
      "schema": "case_inputs",
      "fixture": "case_inputs",
      "provider_free": true,
      "live_network": false
    },
    {
      "id": "metric_specs",
      "capability": "generic.ai.evaluation.harness.metric_specs",
      "schema": "metric_specs",
      "fixture": "metric_specs",
      "provider_free": true,
      "live_network": false
    },
    {
      "id": "judge_replay_records",
      "capability": "generic.ai.evaluation.harness.judge_replay_records",
      "schema": "judge_replay_records",
      "fixture": "judge_replay_records",
      "provider_free": true,
      "live_network": false
    },
    {
      "id": "findings",
      "capability": "generic.ai.evaluation.harness.findings",
      "schema": "findings",
      "fixture": "findings",
      "provider_free": true,
      "live_network": false
    },
    {
      "id": "golden_gates",
      "capability": "generic.ai.evaluation.harness.golden_gates",
      "schema": "golden_gates",
      "fixture": "golden_gates",
      "provider_free": true,
      "live_network": false
    },
    {
      "id": "case_result_summary",
      "capability": "generic.ai.evaluation.harness.case_result_summary",
      "schema": "case_result_summary",
      "fixture": "case_result_summary",
      "provider_free": true,
      "live_network": false
    }
  ],
  "golden_gate": {
    "fixture": "fixtures/golden_gates_fixture.json",
    "gate": true,
    "summary_pass_rate_min": 1,
    "cases_failed_max": 0,
    "findings_max": 0,
    "judge_replay_errors_max": 0
  },
  "test_gates": [
    "generic.ai.evaluation.harness and ai.eval.run surfaces are declared as provider-free live package skeleton capabilities",
    "dataset manifest, case inputs, metric specs, judge replay records, findings, golden gates, and case result summary fixtures are all checked in",
    "fixture index is manifest-driven and does not require live network, credentials, provider SDKs, or real dependency imports",
    "judge replay records use deterministic mock model ids and forbid live provider calls",
    "golden gate requires pass_rate=1, cases_failed=0, findings=0, and judge replay errors=0",
    "case result summary records per-case metrics, judge trace refs, assertion counts, and aggregate report totals"
  ],
  "no_built_in_guarantee": {
    "required": true,
    "statement": "Leia core does not provide built-in generic AI evaluation execution; leia-generic-ai-evaluation-harness defines the provider-free package boundary."
  }
}
