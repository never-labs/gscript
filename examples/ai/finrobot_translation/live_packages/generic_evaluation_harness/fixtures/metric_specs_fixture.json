{
  "schema_version": 1,
  "provider_free": true,
  "live_network": false,
  "metrics": [
    {
      "metric_id": "dataset_item_valid",
      "type": "boolean",
      "aggregation": "pass_rate",
      "gate": {"pass_rate_min": 1}
    },
    {
      "metric_id": "judge_passed",
      "type": "boolean",
      "aggregation": "pass_rate",
      "gate": {"pass_rate_min": 1}
    },
    {
      "metric_id": "answer_chars",
      "type": "numeric",
      "aggregation": "mean",
      "gate": {"mean_max": 180}
    },
    {
      "metric_id": "rubric_label",
      "type": "categorical",
      "aggregation": "value_counts",
      "gate": {"allowed_values": ["pass"]}
    },
    {
      "metric_id": "judge_tokens",
      "type": "token_count",
      "aggregation": "sum",
      "gate": {"sum_max": 2000}
    }
  ]
}
