{
  "schema_version": 1,
  "id": "generic-ai-dialect-backend-plan",
  "scope": {
    "provider_free": true,
    "domain_specific": false,
    "read_only": true,
    "depends_on_q_runtime": false,
    "finrobot_specific_syntax_assumption": false
  },
  "backend_shapes": [
    {
      "shape_id": "ai.model.resolve",
      "status": "planned",
      "capabilities": ["model"],
      "contract": "Resolve provider-neutral model aliases into replay-safe execution descriptors.",
      "inputs": ["model_alias", "provider_policy", "replay_mode"],
      "outputs": ["model_descriptor", "capability_flags", "redaction_policy"],
      "example": "examples/ai/general_agent_workflow.leia",
      "test": "tests/llm/llm_ai_dialect_test.go",
      "fixture": "examples/ai/general_agent_workflow.records.json"
    },
    {
      "shape_id": "ai.turn.execute",
      "status": "planned",
      "capabilities": ["turn", "replay"],
      "contract": "Execute or replay a single structured model turn with deterministic usage and error envelopes.",
      "inputs": ["messages", "response_format", "tool_policy", "replay_records"],
      "outputs": ["assistant_message", "usage", "tool_requests", "turn_error"],
      "example": "examples/ai/coding_agent_replay.leia",
      "test": "tests/llm/llm_ai_dialect_contract_test.go",
      "fixture": "examples/ai/coding_agent_replay.records.json"
    },
    {
      "shape_id": "ai.tool.invoke",
      "status": "planned",
      "capabilities": ["tool", "approval", "capability"],
      "contract": "Validate, authorize, invoke, and replay a tool call using a provider-neutral result envelope.",
      "inputs": ["tool_schema", "arguments", "capability_tags", "approval_state"],
      "outputs": ["tool_result", "approval_trace", "artifact_refs", "normalized_error"],
      "example": "examples/ai/coding_agent_replay.leia",
      "test": "tests/llm/llm_tool_contract_test.go",
      "fixture": "examples/ai/finrobot_translation/policy_parity/fixtures/policy_outcome_envelopes.json"
    },
    {
      "shape_id": "ai.agent.run",
      "status": "planned",
      "capabilities": ["agent", "workflow"],
      "contract": "Run declarative agent loops over turns, tools, memory snapshots, and structured outputs.",
      "inputs": ["agent_config", "initial_state", "tool_registry", "max_steps"],
      "outputs": ["final_output", "tool_history", "workflow_state", "loop_trace"],
      "example": "examples/ai/general_analysis_assistant.leia",
      "test": "tests/llm/llm_agent_replay_test.go",
      "fixture": "examples/ai/general_analysis_assistant.records.json"
    },
    {
      "shape_id": "ai.workflow.orchestrate",
      "status": "planned",
      "capabilities": ["workflow", "trace"],
      "contract": "Coordinate multi-agent handoffs, stage retries, cache decisions, and trace emission.",
      "inputs": ["workflow_graph", "stage_inputs", "retry_policy", "cache_policy"],
      "outputs": ["stage_outputs", "handoff_trace", "cache_events", "workflow_result"],
      "example": "examples/ai/general_agent_workflow.leia",
      "test": "tests/llm/llm_ai_native_workflow_integration_test.go",
      "fixture": "examples/ai/finrobot_translation/ai_dialect_index/fixtures/stream_trace_fixture.json"
    },
    {
      "shape_id": "ai.eval.run",
      "status": "planned",
      "capabilities": ["evaluation", "replay"],
      "contract": "Run provider-free evaluation cases with replayed judges, metrics, findings, and golden gates.",
      "inputs": ["dataset_manifest", "case_inputs", "metric_specs", "judge_records"],
      "outputs": ["case_results", "metric_summary", "findings", "gate_status"],
      "example": "examples/ai/finrobot_translation/evaluation_harness/generic_ai_evaluation.source.txt",
      "test": "tests/llm/finrobot_evaluation_harness_parity_test.go",
      "fixture": "examples/ai/finrobot_translation/evaluation_harness/manifest.json"
    },
    {
      "shape_id": "ai.trace.emit",
      "status": "planned",
      "capabilities": ["trace", "approval", "replay"],
      "contract": "Emit normalized trace events for turns, streams, approvals, tools, artifacts, and replay matching.",
      "inputs": ["event_type", "event_payload", "redaction_policy", "correlation_ids"],
      "outputs": ["trace_event", "redacted_payload", "sequence_marker"],
      "example": "examples/ai/record_replay_trace_project.leia",
      "test": "tests/llm/llm_trace_test.go",
      "fixture": "examples/ai/finrobot_translation/ai_dialect_index/fixtures/stream_trace_fixture.json"
    },
    {
      "shape_id": "ai.package.audit",
      "status": "planned",
      "capabilities": ["package-boundary", "capability"],
      "contract": "Audit package manifests, provider-free gates, registered examples, and missing built-in guarantees.",
      "inputs": ["package_manifest", "fixture_index", "example_registry", "capability_policy"],
      "outputs": ["audit_findings", "coverage_status", "missing_boundary_records"],
      "example": "examples/ai/finrobot_translation/package_manifest_audit/README.md",
      "test": "tests/llm/finrobot_package_manifest_audit_test.go",
      "fixture": "examples/ai/finrobot_translation/package_manifest_audit/ledger.json"
    }
  ]
}
