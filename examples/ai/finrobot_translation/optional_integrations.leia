            output_schema: "finrl_strategy_v1"
            skip_reason: "optional dependency finrl is not installed"
        },
        {
            id: "finml"
            display_name: "FinML"
            package_name: "finml"
            import_name: "finml"
            adapter_id: "optional.finml.factor_model"
