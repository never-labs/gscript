// FR-GAP-018 optional integrations gating fixture.
//
// This example does not import or execute any optional package. It records the
// package manifest, capability gate, clean skip envelope, and replay fixture
// hook expected by FinRobot-style optional adapters.

func check(name, ok) {
    if !ok {
        error("check failed: " .. name)
    }
}

optional_integrations_package := {
    name: "finrobot_translation.optional_integrations"
    version: "FR-GAP-018"
    offline_only: true
    live_network: false
    real_dependency_imports: false
    fixture_hook: "recorded_optional_fixture"
    integrations: {
        {
            id: "fingpt"
            display_name: "FinGPT"
            package_name: "fingpt"
            import_name: "fingpt"
            adapter_id: "optional.fingpt.forecast"
            capability: "optional.ai.fingpt.forecast"
            requires: {"optional.ai.fingpt.forecast", "optional.fixture.replay"}
            feature: "financial sentiment and forecast tutorial"
            fixture_key: "fingpt:forecast:ACME:2026-06-11"
            output_schema: "fingpt_forecast_v1"
            skip_reason: "optional dependency fingpt is not installed"
        },
        {
            id: "finrl"
