            capability: "optional.chart.mplfinance.render"
            requires: {"optional.chart.mplfinance.render", "optional.fixture.replay"}
            feature: "candlestick chart rendering"
            fixture_key: "mplfinance:candles:ACME:offline"
            output_schema: "mplfinance_chart_artifact_v1"
            skip_reason: "optional dependency mplfinance is not installed"
        },
        {
            id: "ollama"
            display_name: "Ollama"
            package_name: "ollama"
            import_name: "ollama"
            adapter_id: "optional.ollama.local_llm"
