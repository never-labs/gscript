// Generic provider-free workflow orchestration composition.
//
// Demonstrates that workflow_orchestrator, approval_policy, and
// evaluation_harness compose as generic AI contracts without provider bindings
// or domain-specific syntax.

func check(name, ok) {
    if !ok {
        error("check failed: " .. name)
    }
}

orchestration_contract := {
    id: "generic_workflow_orchestration_contract_v1",
    scope: "generic-ai-workflow-orchestration",
    provider_free: true,
    live_network: false,
    live_model: false,
    domain_specific: false,
    provider: nil,
    capabilities: {
        "workflow.orchestrate",
        "approval.policy",
        "evaluation.harness",
        "replay.fixture",
    },
}

fixture_lookup := llm.tool("fixture_lookup", func(topic) {
    return "fixture-context:" .. topic, nil
}, {
    params: {"topic"}
    requires: {"local.fixture.read"}
    result: {type: "string"}
    replay_key: "generic-workflow:fixture-lookup"
})

publish_result := llm.tool("publish_result", func(id) {
    return "published:" .. id, nil
}, {
    params: {"id"}
    requires: {"publish.web"}
    result: {type: "string"}
    replay_key: "generic-workflow:publish-result"
})

approval_policy := llm.policy()

evaluation_harness := {
    id: "generic_workflow_evaluation_harness_v1",
    provider_free: true,
    live_network: false,
    live_model: false,
    runner: "evaluate",
    gates: {
        {id: "workflow_steps", metric: "step_count", expected: 3},
        {id: "approval_default_deny", metric: "denied_high_risk_calls", expected: 1},
        {id: "provider_absence", metric: "live_model_calls", expected: 0},
    },
}

workflow_orchestrator := llm.workflow({
    llm.step("collect_context", func(ctx) {
        text, err := fixture_lookup.fn(ctx.input)
        if err != nil {
            return nil, err
        }
        return {
            value: {
                topic: ctx.input,
                context: text,
                provider_free: true,
                live_model_calls: 0,
            },
            text: text,
        }, nil
    }, {component: "workflow_orchestrator", dependency: "fixture_lookup"}),

    llm.step("apply_approval_policy", func(ctx) {
        ok, ok_err := llm.check_policy({fixture_lookup}, approval_policy)
        _, denied_err := llm.check_policy({publish_result}, approval_policy)
        pending := {id: "approval-generic-1", tool: "publish_result", args: {id: "artifact-1"}}
        token := loop.snapshot({msg.user("publish artifact-1")}, pending)
        approval := {ok: false, reason: "generic policy denies publish without approval"}
        denied, resume_err := loop.resume(token, approval)
        trace := llm.approval_trace({
            token: token
            pending: pending
            approval: approval
            result: denied
            policy: approval_policy
        })
        return {
            value: {
                local_allowed: ok,
                local_error_nil: ok_err == nil,
                denied_class: denied_err.class,
                resume_error_nil: resume_err == nil,
                trace: trace,
            },
            text: "approval:" .. trace.decision.status,
        }, nil
    }, {component: "approval_policy", dependency: "collect_context"}),

    llm.step("evaluation_harness", func(ctx) {
        policy := ctx.context.apply_approval_policy.value
        return {
            value: {
                harness_id: evaluation_harness.id,
                gate_count: #evaluation_harness.gates,
                step_count: 3,
                provider_free: orchestration_contract.provider_free,
                live_model_calls: ctx.context.collect_context.value.live_model_calls,
                denied_high_risk_calls: 1,
                approval_status: policy.trace.decision.status,
                provider: orchestration_contract.provider,
            },
            text: "evaluation:passed",
        }, nil
    }, {component: "evaluation_harness", dependency: "apply_approval_policy"}),
})

workflow_result, workflow_err := workflow_orchestrator.run("generic onboarding")
workflow_summary := workflow_result.value
approval_summary := workflow_result.context.apply_approval_policy.value
evaluation_summary := workflow_result.context.evaluation_harness.value

check("workflow run", workflow_err == nil && workflow_result.status == "ok")
check("workflow steps", #workflow_result.steps == 3)
check("contract provider-free", orchestration_contract.provider_free == true && orchestration_contract.live_model == false)
check("approval default deny", approval_policy.default == "deny_high_risk")
check("local read allowed", approval_summary.local_allowed == true && approval_summary.local_error_nil == true)
check("publish denied", approval_summary.denied_class == "publish")
check("approval trace", approval_summary.trace.kind == "approval_replay_trace")
check("evaluation harness", evaluation_summary.harness_id == evaluation_harness.id && evaluation_summary.gate_count == 3)
check("no provider", evaluation_summary.provider == nil && evaluation_summary.live_model_calls == 0)
check("generic scope", orchestration_contract.domain_specific == false)

print("generic_workflow_orchestration", orchestration_contract.id)
print("steps", #workflow_result.steps)
print("approval", approval_summary.trace.decision.status)
print("harness", evaluation_summary.harness_id)
print("ok")

evaluate "generic workflow orchestration composition" {
    assert(workflow_err == nil)
    assert(workflow_result.status == "ok")
    assert(#workflow_result.steps == 3)
    assert(workflow_orchestrator.steps[1].opts.component == "workflow_orchestrator")
    assert(workflow_orchestrator.steps[2].opts.component == "approval_policy")
    assert(workflow_orchestrator.steps[3].opts.component == "evaluation_harness")
    assert(orchestration_contract.provider_free == true)
    assert(orchestration_contract.live_network == false)
    assert(orchestration_contract.live_model == false)
    assert(orchestration_contract.domain_specific == false)
    assert(evaluation_summary.provider == nil)
    assert(evaluation_summary.live_model_calls == 0)
    assert(evaluation_summary.denied_high_risk_calls == 1)
    assert(approval_summary.trace.decision.status == "denied")
    assert(evaluation_summary.approval_status == "denied")
}
