// FR-GAP-009/015 deterministic vector, matrix, sensitivity, and optimization
// tolerance fixture for FinRobot valuation translation work.

func near(a, b, eps) {
    return math.abs(a - b) <= eps
}

func check(name, ok) {
    if !ok {
        print("failed", name)
    }
    assert(ok)
}

base_fcf_b := 135.0
net_debt_b := -54.0
shares_b := 15.2
projection_discount := 1.5386239549
pv_explicit_fcf_b := 456.11760768771586

wacc_cases := {0.08, 0.09, 0.10}
growth_cases := {0.015, 0.025, 0.035}
sensitivity_matrix := matrix.dense(#wacc_cases, #growth_cases)

for i := 1; i <= #wacc_cases; i++ {
    for j := 1; j <= #growth_cases; j++ {
        terminal_value := base_fcf_b * (1 + growth_cases[j]) / (wacc_cases[i] - growth_cases[j])
        enterprise_value := pv_explicit_fcf_b + terminal_value / projection_discount
        equity_value := enterprise_value - net_debt_b
        matrix.setf(sensitivity_matrix, i - 1, j - 1, equity_value / shares_b)
    }
}

scenario_rows := {
    {wacc: wacc_cases[1], terminal_growth: growth_cases[1], price: matrix.getf(sensitivity_matrix, 0, 0)},
    {wacc: wacc_cases[1], terminal_growth: growth_cases[2], price: matrix.getf(sensitivity_matrix, 0, 1)},
    {wacc: wacc_cases[1], terminal_growth: growth_cases[3], price: matrix.getf(sensitivity_matrix, 0, 2)},
    {wacc: wacc_cases[2], terminal_growth: growth_cases[1], price: matrix.getf(sensitivity_matrix, 1, 0)},
    {wacc: wacc_cases[2], terminal_growth: growth_cases[2], price: matrix.getf(sensitivity_matrix, 1, 1)},
    {wacc: wacc_cases[2], terminal_growth: growth_cases[3], price: matrix.getf(sensitivity_matrix, 1, 2)},
    {wacc: wacc_cases[3], terminal_growth: growth_cases[1], price: matrix.getf(sensitivity_matrix, 2, 0)},
    {wacc: wacc_cases[3], terminal_growth: growth_cases[2], price: matrix.getf(sensitivity_matrix, 2, 1)},
    {wacc: wacc_cases[3], terminal_growth: growth_cases[3], price: matrix.getf(sensitivity_matrix, 2, 2)},
}

best_case := scenario_rows[1]
worst_case := scenario_rows[1]
for i := 2; i <= #scenario_rows; i++ {
    if scenario_rows[i].price > best_case.price {
        best_case = scenario_rows[i]
    }
    if scenario_rows[i].price < worst_case.price {
        worst_case = scenario_rows[i]
    }
}

expected_returns := {0.032, 0.026, 0.051, 0.018, 0.012}
volatility := {0.18, 0.16, 0.31, 0.21, 0.24}
scores := {0.58, 0.52, 0.64, 0.48, 0.42}
target_caps := {0.30, 0.25, 0.20, 0.15, 0.10}

raw_weights := {}
raw_total := 0.0
for i := 1; i <= #expected_returns; i++ {
    raw_weights[i] = scores[i] * expected_returns[i] / volatility[i]
    raw_total = raw_total + raw_weights[i]
}

optimized_weights := {}
gross_weight := 0.0
portfolio_return := 0.0
max_tolerance_error := 0.0
for i := 1; i <= #raw_weights; i++ {
    normalized := raw_weights[i] / raw_total
    capped := normalized
    if capped > target_caps[i] {
        capped = target_caps[i]
    }
    optimized_weights[i] = capped
    gross_weight = gross_weight + capped
    portfolio_return = portfolio_return + capped * expected_returns[i]
    cap_error := capped - target_caps[i]
    if cap_error < 0 {
        cap_error = 0 - cap_error
    }
    if cap_error > max_tolerance_error && normalized > target_caps[i] {
        max_tolerance_error = cap_error
    }
}

optimization_tolerance := 0.000001
sensitivity_math_summary := string.format(
    "sensitivity_math matrix=%dx%d base=%.2f best=%.2f worst=%.2f gross=%.4f return=%.4f tolerance=%.6f",
    #wacc_cases,
    #growth_cases,
    matrix.getf(sensitivity_matrix, 1, 1),
    best_case.price,
    worst_case.price,
    gross_weight,
    portfolio_return,
    max_tolerance_error
)

check("sensitivity matrix center price", near(matrix.getf(sensitivity_matrix, 1, 1), 124.5869, 0.0001))
check("sensitivity matrix best and worst cases", near(best_case.price, 166.3260, 0.0001) && near(worst_case.price, 102.4898, 0.0001))
check("matrix scenario table shape", #scenario_rows == 9 && scenario_rows[5].wacc == 0.09 && scenario_rows[5].terminal_growth == 0.025)
check("deterministic optimization tolerance", near(optimized_weights[3], 0.20, optimization_tolerance) && near(max_tolerance_error, 0.0, optimization_tolerance))
check("portfolio vector aggregation", near(gross_weight, 0.9034445, 0.0001) && near(portfolio_return, 0.0284770, 0.0001))

print(sensitivity_math_summary)
