// Generic compliance/safety gate example for replayed AI workflows.
// The policy is capability-based and intentionally domain-neutral.

policy := llm.policy()

local_lookup := llm.tool("local_lookup", func(topic) {
    return "fixture:" .. topic, nil
}, {
    params: {"topic"}
    requires: {"local.replay.read"}
    result: {type: "string"}
    error: {kind: "policy"}
    replay_key: "compliance:local-lookup"
})

network_fetch := llm.tool("network_fetch", func(url) {
    return url, nil
}, {
    params: {"url"}
    requires: {"network.http"}
    result: {type: "string"}
    error: {kind: "policy"}
    replay_key: "compliance:network-fetch"
})

submit_action := llm.tool("submit_action", func(id) {
    return id, nil
}, {
    params: {"id"}
    requires: {"trading.submit"}
    result: {type: "string"}
    error: {kind: "policy"}
    replay_key: "compliance:submit-action"
})

publish_report := llm.tool("publish_report", func(id) {
    return id, nil
}, {
    params: {"id"}
    requires: {"publish.web"}
    result: {type: "string"}
    error: {kind: "policy"}
    replay_key: "compliance:publish-report"
})

ok, ok_err := llm.check_policy({local_lookup}, policy)
_, network_err := llm.check_policy({network_fetch}, policy)
_, trading_err := llm.check_policy({submit_action}, policy)
_, publish_err := llm.check_policy({publish_report}, policy)

pending := {id: "call-compliance-1", tool: "submit_action", args: {id: "action-1"}}
token := loop.snapshot({msg.user("review high-risk action")}, pending)
approval := {ok: false, reason: "capability policy requires human review"}
denied, denied_err := loop.resume(token, approval)
approval_trace := llm.approval_trace({
    token: token
    pending: pending
    approval: approval
    result: denied
    policy: policy
})

assert(ok == true)
assert(ok_err == nil)
assert(network_err.class == "network")
assert(trading_err.class == "trading")
assert(publish_err.class == "publish")
assert(approval_trace.kind == "approval_replay_trace")
assert(approval_trace.policy.default == "deny_high_risk")
assert(approval_trace.decision.status == "denied")
assert(approval_trace.result.status == "denied")

print("compliance_policy default=" .. policy.default .. " trace=" .. approval_trace.kind)
