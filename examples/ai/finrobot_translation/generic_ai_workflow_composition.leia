// Provider-free generic AI workflow composition.
//
// This is a thin Leia-native composition over the generic package boundaries:
// model, model-io, document-rag, prompt-role, memory, turn, tool,
// tool-registry, planning, agent, workflow, eval, replay, trace, approval, and
// package-audit. It intentionally declares no
// provider SDK, network call, credential, or domain adapter.

package_boundaries := {
    {role: "model" package_id: "generic-model-registry" capability: "generic.ai.model.registry" entrypoint: "generic.ai.model.registry" provider_free: true live_network: false},
    {role: "model-io" package_id: "generic-model-io-envelope" capability: "generic.ai.model.io.envelope" entrypoint: "ai.model.io.envelope" provider_free: true live_network: false},
    {role: "document-rag" package_id: "generic-document-rag-pipeline" capability: "generic.ai.document.rag" entrypoint: "ai.document.rag_pipeline" provider_free: true live_network: false},
    {role: "prompt-role" package_id: "generic-prompt-role-catalog" capability: "generic.ai.prompt.role.catalog" entrypoint: "ai.prompt.role_catalog" provider_free: true live_network: false},
    {role: "memory" package_id: "generic-memory-store" capability: "generic.ai.memory.store" entrypoint: "ai.memory.store" provider_free: true live_network: false},
    {role: "replay" package_id: "generic-record-replay" capability: "generic.ai.record.capture" entrypoint: "generic.ai.record.replay.fixture" provider_free: true live_network: false},
    {role: "trace" package_id: "generic-trace-events" capability: "generic.ai.trace.events" entrypoint: "ai.trace.emit" provider_free: true live_network: false},
    {role: "approval" package_id: "generic-approval-policy" capability: "generic.ai.approval.policy.evaluate" entrypoint: "generic.ai.approval.policy.evaluate" provider_free: true live_network: false},
    {role: "tool" package_id: "generic-tool-contracts" capability: "ai.tool.invoke" entrypoint: "ai.tool.invoke" provider_free: true live_network: false},
    {role: "tool-registry" package_id: "generic-tool-registry" capability: "generic.tool.registry.declare" entrypoint: "ai.tool.registry" provider_free: true live_network: false},
    {role: "turn" package_id: "generic-turn-runner" capability: "ai.turn.execute" entrypoint: "ai.turn.execute" provider_free: true live_network: false},
    {role: "agent" package_id: "generic-agent-runner" capability: "ai.agent.config.declarative" entrypoint: "ai.agent.run" provider_free: true live_network: false},
    {role: "planning" package_id: "generic-planning-graph" capability: "generic.planning.graph.define" entrypoint: "ai.workflow.plan_graph" provider_free: true live_network: false},
    {role: "package-audit" package_id: "generic-package-boundary-auditor" capability: "generic.ai.package.boundary.audit.manifest" entrypoint: "generic.ai.package.boundary.audit" provider_free: true live_network: false},
    {role: "workflow" package_id: "generic-workflow-orchestrator" capability: "ai.workflow.orchestrate.provider_free" entrypoint: "ai.workflow.orchestrate" provider_free: true live_network: false},
    {role: "eval" package_id: "generic-evaluation-harness" capability: "ai.eval.run.provider_free" entrypoint: "ai.eval.run" provider_free: true live_network: false},
}

composition_edges := {
    {from: "model" to: "model-io" handoff: "resolved model descriptor"},
    {from: "document-rag" to: "memory" handoff: "retrieval evidence and cited context chunks"},
    {from: "memory" to: "turn" handoff: "retrieved context window"},
    {from: "model-io" to: "turn" handoff: "request, stream, response, usage, and redaction envelopes"},
    {from: "prompt-role" to: "agent" handoff: "role profile, prompt template, and output schema"},
    {from: "tool" to: "turn" handoff: "declarative tool schema"},
    {from: "turn" to: "agent" handoff: "turn envelope and tool request"},
    {from: "agent" to: "workflow" handoff: "agent result and loop trace"},
    {from: "workflow" to: "eval" handoff: "workflow result fixture"},
    {from: "replay" to: "turn" handoff: "strict ordered record match"},
    {from: "trace" to: "workflow" handoff: "correlated events"},
    {from: "approval" to: "tool" handoff: "capability decision"},
    {from: "tool-registry" to: "tool" handoff: "validated tool descriptor"},
    {from: "planning" to: "workflow" handoff: "plan graph and dependency evidence"},
    {from: "package-audit" to: "workflow" handoff: "provider-free boundary gate"},
}

workflow_contract := {
    id: "generic-ai-workflow-composition"
    provider_free: true
    live_network: false
    real_dependency_imports: false
    credential_required: false
    composition: package_boundaries
    edges: composition_edges
    native_surfaces: {"model", "model-io", "document-rag", "prompt-role", "memory", "turn", "tool", "tool-registry", "planning", "agent", "workflow", "eval", "replay", "trace", "approval", "package-audit"}
}

func role_present(role) {
    for i := 1; i <= #workflow_contract.composition; i++ {
        if workflow_contract.composition[i].role == role {
            return true
        }
    }
    return false
}

func provider_free_boundaries() {
    for i := 1; i <= #workflow_contract.composition; i++ {
        boundary := workflow_contract.composition[i]
        if boundary.provider_free != true || boundary.live_network != false {
            return false
        }
    }
    return workflow_contract.provider_free == true &&
        workflow_contract.live_network == false &&
        workflow_contract.real_dependency_imports == false &&
        workflow_contract.credential_required == false
}

func connected_native_surfaces() {
    return #workflow_contract.composition == 16 &&
        #workflow_contract.edges == 15 &&
        role_present("model") &&
        role_present("model-io") &&
        role_present("document-rag") &&
        role_present("prompt-role") &&
        role_present("memory") &&
        role_present("turn") &&
        role_present("tool") &&
        role_present("tool-registry") &&
        role_present("planning") &&
        role_present("agent") &&
        role_present("workflow") &&
        role_present("eval") &&
        role_present("replay") &&
        role_present("trace") &&
        role_present("approval") &&
        role_present("package-audit")
}

assert(provider_free_boundaries())
assert(connected_native_surfaces())

package_boundary_count := #workflow_contract.composition
composition_edge_count := #workflow_contract.edges
composition_summary := string.format(
    "%s boundaries=%d edges=%d provider_free=%s",
    workflow_contract.id,
    package_boundary_count,
    composition_edge_count,
    tostring(workflow_contract.provider_free)
)

print(composition_summary)
