// Secret-free FinRobot-style local configuration fixture.
// Set FINROBOT_TRANSLATION_API_KEY in the host environment when running against
// a real provider; the checked-in table only stores the lookup key.

config := llm.config

finrobot_config := config.table({
    provider: "local",
    model: "mock-finrobot-analyst",
    api_key: config.secret("FINROBOT_TRANSLATION_API_KEY", {required: false}),
    retry: {
        max_attempts: 2,
        backoff_ms: 1000,
    },
})

trace_config := config.display(finrobot_config)
resolved_config, config_err := config.resolve(finrobot_config)
safe_config := config.redact(resolved_config)
