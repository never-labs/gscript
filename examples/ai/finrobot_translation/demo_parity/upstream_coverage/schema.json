{
  "schema_version": 1,
  "id": "ai-dialect-upstream-coverage-ledger-schema",
  "required_record_fields": [
    "id",
    "source_path",
    "coverage_status",
    "target_examples",
    "target_packages",
    "excluded_scope",
    "fixture_hashes",
    "next_action"
  ],
  "coverage_status_values": [
    "covered_example",
    "covered_live_package_skeleton",
    "partial_fixture_contract",
    "mapped_optional_gate",
    "excluded_non_ai_surface"
  ],
  "target_path_policy": {
    "translation_root": "examples/ai/finrobot_translation",
    "provider_free_default": true,
    "live_network_default": false,
    "real_dependency_import_default": false
  },
  "hash_policy": {
    "algorithm": "sha256",
    "source_hash": "sha256 over audited upstream source content or source inventory tuple",
    "fixture_hashes": "sha256 over checked-in Leia fixture, manifest, schema, or example files"
  }
}
