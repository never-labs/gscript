// equity_report.leia - Offline replay translation of the FinRobot equity report pipeline.
// Sources mapped:
// - create_equity_report.py
// - generate_financial_analysis.py
// - modules/equity_agents/*
// - modules/text_generator_agents.py
//
// The workflow keeps FinRobot's two-stage shape:
// 1. Load normalized financial, peer, news, risk, catalyst, and market fixtures.
// 2. Run section agents for overview/takeaways, valuation, news/catalysts, and
//    risks/competitors.
// 3. Assemble a final report object from deterministic local data plus replayed
//    section outputs.

model {
    default: "mock-finrobot-equity"
}

run_log := {}

func remember(step, value) {
    run_log[#run_log + 1] = step .. ":" .. value
}

load_equity_inputs := tool {
    name: "load_equity_inputs"
    fn: func(case_id) {
        remember("load_equity_inputs", case_id)
        return {
            case_id: case_id,
            company_name: "Apple Inc.",
            company_ticker: "AAPL",
            report_date: "June 11, 2026",
            market: {
                share_price: "$198.40",
                target_price: "$225.00",
                rating: "Outperform",
                sector: "Technology",
                market_cap: "$2,980.00B",
                fwd_pe: "27.4x",
                pb_ratio: "38.2x"
            },
            financial_metrics: {
                revenue_2023A: "$383.3B",
                revenue_2024A: "$391.0B",
                revenue_growth_2024A: "2.0%",
                ebitda_margin_2024A: "33.1%",
                contribution_margin_2024A: "46.2%",
                sga_margin_2024A: "6.7%",
                eps_2024A: "$6.08"
            },
            peers: {
                tickers: {"MSFT", "GOOG", "AMZN"},
                median_ev_ebitda: "20.6x",
                target_ev_ebitda: "21.5x"
            },
            news: {
                articles: 4,
                dominant_theme: "AI product cycle and services growth",
                sentiment: "constructive"
            },
            catalyst_analysis: {
                top: {"AI device refresh", "services margin expansion", "capital return update"},
                summary: "Near-term catalysts center on product-cycle execution and services monetization."
            },
            risk_inputs: {
                top: {"China demand volatility", "regulatory scrutiny", "hardware replacement-cycle risk"},
                mitigation: "Services mix, installed base loyalty, and balance sheet flexibility."
            }
        }, nil
    }
    params: {"case_id"}
    description: "Load a local FinRobot-style equity report fixture."
}

normalize_financials := tool {
    name: "normalize_financials"
    fn: func(inputs) {
        remember("normalize_financials", inputs.company_ticker)
        return {
            company: inputs.company_name .. " (" .. inputs.company_ticker .. ")",
            context: inputs.company_name .. " (" .. inputs.company_ticker .. ") | " ..
            "Revenue 2024A " .. inputs.financial_metrics.revenue_2024A .. " | " ..
            "Revenue growth " .. inputs.financial_metrics.revenue_growth_2024A .. " | " ..
            "EBITDA margin " .. inputs.financial_metrics.ebitda_margin_2024A .. " | " ..
            "Contribution margin " .. inputs.financial_metrics.contribution_margin_2024A .. " | " ..
            "SG&A margin " .. inputs.financial_metrics.sga_margin_2024A .. " | " ..
            "Peers " .. inputs.peers.tickers[1] .. "," .. inputs.peers.tickers[2] .. "," .. inputs.peers.tickers[3] .. " | " ..
            "News theme " .. inputs.news.dominant_theme .. " | " ..
            "Catalysts " .. inputs.catalyst_analysis.summary .. " | " ..
            "Risks " .. inputs.risk_inputs.top[1] .. "," .. inputs.risk_inputs.top[2] .. "," .. inputs.risk_inputs.top[3],
            actual_years_only: true,
            offline_replay: true
        }, nil
    }
    params: {"inputs"}
    description: "Normalize local fixture data into section-agent context."
}

assemble_report := tool {
    name: "assemble_report"
    fn: func(inputs, financials, overview, valuation, news_catalyst, risk_competitor) {
        remember("assemble_report", inputs.company_ticker)
        return {
            title: "Equity Research Report - " .. inputs.company_name,
            company_ticker: inputs.company_ticker,
            report_date: inputs.report_date,
            market_snapshot: inputs.market,
            tagline: overview.value.tagline,
            company_overview: overview.value.company_overview,
            investment_overview: overview.value.investment_overview,
            major_takeaways: overview.value.major_takeaways,
            valuation_summary: valuation.value.valuation_summary,
            target_price: valuation.value.target_price,
            valuation_methods: valuation.value.methods,
            news_summary: news_catalyst.value.news_summary,
            catalyst_summary: news_catalyst.value.catalyst_summary,
            risk_summary: risk_competitor.value.risk_summary,
            competitor_summary: risk_competitor.value.competitor_summary,
            source_pipeline: {
                "generate_financial_analysis",
                "text_generator_agents",
                "equity_agents",
                "create_equity_report"
            },
            replay_ready: financials.offline_replay && overview.value.replay_ready && valuation.value.replay_ready && news_catalyst.value.replay_ready && risk_competitor.value.replay_ready
        }, nil
    }
    params: {"inputs", "financials", "overview", "valuation", "news_catalyst", "risk_competitor"}
    description: "Assemble the translated equity report object."
}

overview_agent := agent {
    name: "finrobot_overview_sections"
    model: "mock-finrobot-equity"
    instructions: prompt { role: "system", text: "Translate FinRobot tagline, company overview, investment overview, and major takeaways sections into replayable structured output." }
    params: {"context"}
    output: {
        tagline: "three sentence tagline"
        company_overview: "business and financial overview"
        investment_overview: "investment update"
        major_takeaways: {"Revenue Growth", "Gross Profit Margin", "SG&A Expense Margin", "EBITDA Margin Stability"}
        replay_ready: true
    }
    max_steps: 1
}

valuation_agent := agent {
    name: "finrobot_valuation_section"
    model: "mock-finrobot-equity"
    instructions: prompt { role: "system", text: "Translate FinRobot valuation overview and multi-method valuation into replayable structured output." }
    params: {"context"}
    output: {
        valuation_summary: "valuation summary"
        target_price: "$0.00"
        rating: "rating"
        methods: {"ev_ebitda", "dcf", "peer_comparison"}
        replay_ready: true
    }
    max_steps: 1
}

news_catalyst_agent := agent {
    name: "finrobot_news_catalyst_sections"
    model: "mock-finrobot-equity"
    instructions: prompt { role: "system", text: "Translate FinRobot news summary and catalyst analysis into replayable structured output." }
    params: {"context"}
    output: {
        news_summary: "recent news summary"
        catalyst_summary: "catalyst summary"
        material_events: {"event"}
        sentiment: "neutral"
        replay_ready: true
    }
    max_steps: 1
}

risk_competitor_agent := agent {
    name: "finrobot_risk_competitor_sections"
    model: "mock-finrobot-equity"
    instructions: prompt { role: "system", text: "Translate FinRobot risks and competitor analysis sections into replayable structured output." }
    params: {"context"}
    output: {
        risk_summary: "risk summary"
        competitor_summary: "competitor summary"
        core_risks: {"risk"}
        peers: {"peer"}
        replay_ready: true
    }
    max_steps: 1
}

evaluate "finrobot equity report replay" {
    inputs, inputs_err := load_equity_inputs.fn("aapl-offline-fixture")
    assert(inputs_err == nil)
    assert(inputs.company_ticker == "AAPL")

    financials, financials_err := normalize_financials.fn(inputs)
    assert(financials_err == nil)
    assert(financials.actual_years_only == true)
    assert(financials.offline_replay == true)

    overview, overview_err := overview_agent(financials.context)
    valuation, valuation_err := valuation_agent(financials.context)
    news_catalyst, news_catalyst_err := news_catalyst_agent(financials.context)
    risk_competitor, risk_competitor_err := risk_competitor_agent(financials.context)

    assert(overview_err == nil)
    assert(valuation_err == nil)
    assert(news_catalyst_err == nil)
    assert(risk_competitor_err == nil)

    assert(overview.value.major_takeaways[1] == "Revenue Growth")
    assert(overview.value.major_takeaways[4] == "EBITDA Margin Stability")
    assert(valuation.value.methods[1] == "ev_ebitda")
    assert(valuation.value.methods[3] == "peer_comparison")
    assert(news_catalyst.value.sentiment == "constructive")
    assert(risk_competitor.value.peers[2] == "GOOG")

    report, report_err := assemble_report.fn(inputs, financials, overview, valuation, news_catalyst, risk_competitor)
    assert(report_err == nil)
    assert(report.replay_ready == true)
    assert(report.company_ticker == "AAPL")
    assert(report.source_pipeline[1] == "generate_financial_analysis")
    assert(report.source_pipeline[4] == "create_equity_report")

    review, review_err := turn {
        model: "mock-finrobot-report-review"
        messages: {
            llm.system("Review the translated FinRobot equity report workflow for offline replay coverage."),
            llm.user(report.title .. " | sections: overview, valuation, news, catalyst, risk, competitor | replay_ready=" .. tostring(report.replay_ready)),
        }
    }
    assert(review_err == nil)
    assert(review.text == "Equity report translation is replayable: local fixture loading, section agents, enhanced summaries, and deterministic final assembly are covered.")

    print("company", report.company_ticker)
    print("sections", "overview/valuation/news/catalyst/risk/competitor")
    print("target", report.target_price)
    print("log_steps", #run_log)
    print("review", review.text)
    print("ok")
}
