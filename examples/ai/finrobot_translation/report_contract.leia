// report_contract.leia - FR-GAP-012 chart/report artifact contract example.
// This is an offline-verifiable contract fixture, not a PDF/HTML renderer.

func check(name, ok) {
    if !ok {
        error("check failed: " .. name)
    }
}

contract := llm.report_artifact_contract({
    name: "finrobot_equity_report_artifact_contract",
    version: "FR-GAP-012",
})

source_annotations := {
    {
        id: "src_financial_metrics",
        title: "Financial metrics and forecasts fixture",
        kind: "csv",
        locator: "examples/ai/finrobot_translation/fixtures/financial_metrics_and_forecasts.csv",
        as_of: "2026-03-31",
        stale_after: "2026-06-30",
        stale: true,
        license: "fixture",
        retrieved_at: "2026-06-11T00:00:00Z",
        evidence_hash: "sha256:fixture-financial-metrics",
    },
    {
        id: "src_ratios",
        title: "Valuation ratios fixture",
        kind: "csv",
        locator: "examples/ai/finrobot_translation/fixtures/ratios_raw_data.csv",
        as_of: "2026-03-31",
        stale_after: "2026-06-30",
        stale: true,
        license: "fixture",
        retrieved_at: "2026-06-11T00:00:00Z",
        evidence_hash: "sha256:fixture-ratios",
    },
}

report_sections := {
    {
        id: "executive_summary",
        title: "Executive Summary",
        order: 1,
        required: true,
        content: "AI-assisted summary grounded in staged equity report fixtures.",
        chart_refs: {},
        source_refs: {"src_financial_metrics", "src_ratios"},
        ai_disclosure: true,
        disclosure_ref: "ai_disclosure",
    },
    {
        id: "financial_analysis",
        title: "Financial Analysis",
        order: 2,
        required: true,
        content: "Revenue, EBITDA, and EPS analysis backed by local CSV fixtures.",
        chart_refs: {"chart_revenue_ebitda"},
        source_refs: {"src_financial_metrics"},
        ai_disclosure: true,
        disclosure_ref: "ai_disclosure",
    },
    {
        id: "valuation_analysis",
        title: "Valuation Analysis",
        order: 3,
        required: true,
        content: "Multiple and peer comparison narrative backed by local ratio fixtures.",
        chart_refs: {"chart_eps_pe"},
        source_refs: {"src_ratios"},
        ai_disclosure: true,
        disclosure_ref: "ai_disclosure",
    },
}

chart_specs := {
    {
        id: "chart_revenue_ebitda",
        title: "Revenue & EBITDA Trend",
        section_id: "financial_analysis",
        kind: "timeseries_combo",
        renderer: "chart.package.timeseries_combo",
        source_refs: {"src_financial_metrics"},
        x: "fiscal_year",
        series: {"Revenue", "EBITDA"},
        artifact: {
            id: "artifact_chart_revenue_ebitda_png",
            kind: "image/png",
            path: "output/AAPL/report/charts/AAPL_revenue_ebitda.png",
            status: "specified_not_rendered",
        },
    },
    {
        id: "chart_eps_pe",
        title: "EPS x PE Trend Analysis",
        section_id: "valuation_analysis",
        kind: "dual_axis_line",
        renderer: "chart.package.dual_axis_line",
        source_refs: {"src_ratios"},
        x: "fiscal_year",
        series: {"Diluted EPS", "PE Ratio"},
        artifact: {
            id: "artifact_chart_eps_pe_png",
            kind: "image/png",
            path: "output/AAPL/report/charts/AAPL_eps_pe.png",
            status: "specified_not_rendered",
        },
    },
}

stale_data_warning := "Data fixtures are stale because as_of 2026-03-31 is older than the report date 2026-06-11."
ai_disclosure_marker := "AI_DISCLOSURE: This equity report text is AI-assisted, source-backed, and not investment advice."

artifact_manifest := {
    contract: contract.version,
    report_id: "AAPL_2026_06_11_equity_report",
    generated_at: "2026-06-11T00:00:00Z",
    report_sections: {"executive_summary", "financial_analysis", "valuation_analysis"},
    chart_specs: {"chart_revenue_ebitda", "chart_eps_pe"},
    artifacts: {
        {id: "artifact_html_report", kind: "text/html", path: "output/AAPL/report/AAPL_Professional_Equity_Report.html", status: "planned_not_rendered"},
        {id: "artifact_pdf_report", kind: "application/pdf", path: "output/AAPL/report/AAPL_Professional_Equity_Report.pdf", status: "planned_not_rendered"},
        chart_specs[1].artifact,
        chart_specs[2].artifact,
    },
    source_annotations: source_annotations,
    warnings: {"stale_data_warning:" .. stale_data_warning},
    ai_disclosure: ai_disclosure_marker,
}

section_ok, section_msg := llm.validate_output(report_sections[1], contract.schemas.report_section)
chart_ok, chart_msg := llm.validate_output(chart_specs[1], contract.schemas.chart_spec)
source_ok, source_msg := llm.validate_output(source_annotations[1], contract.schemas.source_annotation)
manifest_ok, manifest_msg := llm.validate_output(artifact_manifest, contract.schemas.artifact_manifest)

check("contract version", contract.version == "FR-GAP-012")
check("contract is offline", contract.offline_verifiable == true)
check("renderer not required", contract.renderer_required == false)
check("section schema", section_ok == true)
check("chart schema", chart_ok == true)
check("source schema", source_ok == true)
check("manifest schema", manifest_ok == true)
check("manifest sections", #artifact_manifest.report_sections == 3)
check("manifest charts", #artifact_manifest.chart_specs == 2)
check("source annotations", #artifact_manifest.source_annotations == 2)
check("stale-data warning", #artifact_manifest.warnings == 1 && source_annotations[1].stale == true)
check("AI disclosure marker", artifact_manifest.ai_disclosure == ai_disclosure_marker)
check("HTML artifact planned only", artifact_manifest.artifacts[1].status == "planned_not_rendered")
check("PDF artifact planned only", artifact_manifest.artifacts[2].status == "planned_not_rendered")

print("contract", contract.version)
print("report_sections", #report_sections)
print("chart_specs", #chart_specs)
print("artifact_manifest", artifact_manifest.report_id)
print("source_annotations", #source_annotations)
print("stale_data_warning", artifact_manifest.warnings[1])
print("ai_disclosure", artifact_manifest.ai_disclosure)
