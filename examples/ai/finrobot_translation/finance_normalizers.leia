// FR-GAP-014 finance normalizer package skeleton.
//
// Normalizers are fixture-backed schema contracts, not live vendor clients.
// Each normalized record preserves provider provenance, replay identity, source
// schema, capture time, and stale-data metadata.

finance_normalizer_package := {
    name: "finrobot_translation.finance_normalizers"
    version: "FR-GAP-014"
    offline_only: true
    schemas: {
        market_price_bar_v1: {
            required: {"symbol", "date", "open", "high", "low", "close", "volume", "provider", "replay_key", "captured_at"}
            stale_after_days: 5
        }
        company_profile_v1: {
            required: {"symbol", "name", "exchange", "industry", "currency", "provider", "replay_key", "captured_at"}
            stale_after_days: 30
        }
        fundamental_metric_row_v1: {
            required: {"symbol", "period_end", "revenue_per_share", "gross_margin", "roic", "provider", "replay_key", "captured_at"}
            stale_after_days: 120
        }
        sec_section_v1: {
            required: {"symbol", "cik", "accession", "form", "filed", "section", "text", "provider", "replay_key", "captured_at"}
            stale_after_days: 365
        }
        earnings_segment_v1: {
            required: {"symbol", "fiscal_year", "fiscal_quarter", "speaker", "text", "provider", "replay_key", "captured_at"}
            stale_after_days: 120
        }
        social_sentiment_record_v1: {
            required: {"symbol", "post_id", "title", "score", "created_utc", "provider", "replay_key", "captured_at"}
            stale_after_days: 2
        }
        analyst_recommendation_v1: {
            required: {"symbol", "as_of", "firm", "rating", "provider", "replay_key", "captured_at"}
            stale_after_days: 30
        }
    }
}

normalizer_schema_names := {
    "market_price_bar_v1",
    "company_profile_v1",
    "fundamental_metric_row_v1",
    "sec_section_v1",
    "earnings_segment_v1",
    "social_sentiment_record_v1",
    "analyst_recommendation_v1"
}

normalized_fixture_rows := {
    {
        schema: "market_price_bar_v1"
        symbol: "ACME"
        date: "2026-03-01"
        open: 100.10
        high: 102.00
        low: 99.80
        close: 101.40
        volume: 1200000
        provider: "yahoo"
        replay_key: "yahoo:chart:ACME:1mo"
        captured_at: "2026-06-11T00:00:00Z"
        source_schema: "YahooChartPayload"
    }
    {
        schema: "company_profile_v1"
        symbol: "ACME"
        name: "ACME Corp"
        exchange: "XNAS"
        industry: "Industrial Automation"
        currency: "USD"
        provider: "finnhub"
        replay_key: "finnhub:profile2:ACME"
        captured_at: "2026-06-11T00:00:00Z"
        source_schema: "FinnhubProfilePayload"
    }
    {
        schema: "fundamental_metric_row_v1"
        symbol: "ACME"
        period_end: "2025-12-31"
        revenue_per_share: 42.10
        gross_margin: 0.42
        roic: 0.18
        provider: "fmp"
        replay_key: "fmp:key_metrics:ACME:annual"
        captured_at: "2026-06-11T00:00:00Z"
        source_schema: "FMPKeyMetricsPayload"
    }
    {
        schema: "sec_section_v1"
        symbol: "ACME"
        cik: "0000000000"
        accession: "0000000000-26-000001"
        form: "10-K"
        filed: "2026-02-20"
        section: "item_1a"
        text: "Risk factors: supply concentration."
        provider: "sec"
        replay_key: "sec:companyfacts:ACME:10-K:2025"
        captured_at: "2026-06-11T00:00:00Z"
        source_schema: "SECFilingPayload"
    }
    {
        schema: "earnings_segment_v1"
        symbol: "ACME"
        fiscal_year: "2025"
        fiscal_quarter: "Q4"
        speaker: "CFO"
        text: "Free cash flow conversion remained above ninety percent."
        provider: "earnings"
        replay_key: "earnings:transcript:ACME:2025:Q4"
        captured_at: "2026-06-11T00:00:00Z"
        source_schema: "EarningsTranscriptPayload"
    }
    {
        schema: "social_sentiment_record_v1"
        symbol: "ACME"
        post_id: "r1"
        title: "ACME backlog watch"
        score: 42
        created_utc: 1772200800
        provider: "reddit"
        replay_key: "reddit:search:ACME:sentiment"
        captured_at: "2026-06-11T00:00:00Z"
        source_schema: "RedditSearchPayload"
    }
    {
        schema: "analyst_recommendation_v1"
        symbol: "ACME"
        as_of: "2026-03-01"
        firm: "Replay Research"
        rating: "neutral"
        provider: "fmp"
        replay_key: "fmp:analyst_recommendation:ACME"
        captured_at: "2026-06-11T00:00:00Z"
        source_schema: "FMPAnalystPayload"
    }
}

func normalizer_schema(name) {
    return finance_normalizer_package.schemas[name]
}

func validate_normalized_row(row) {
    schema := normalizer_schema(row.schema)
    if schema == nil {
        return false, {kind: "unknown_schema" schema: row.schema}
    }
    for i := 1; i <= #schema.required; i++ {
        field := schema.required[i]
        if row[field] == nil {
            return false, {kind: "missing_field" schema: row.schema field: field}
        }
    }
    if row.provider == nil || row.replay_key == nil || row.source_schema == nil {
        return false, {kind: "missing_provenance" schema: row.schema}
    }
    return true, nil
}

func validate_all_normalized_rows(rows) {
    for i := 1; i <= #rows; i++ {
        ok, err := validate_normalized_row(rows[i])
        if !ok {
            return false, err
        }
    }
    return true, nil
}

func stale_policy(schema_name) {
    schema := normalizer_schema(schema_name)
    if schema == nil {
        return nil
    }
    return {schema: schema_name stale_after_days: schema.stale_after_days}
}

all_rows_valid, validation_error := validate_all_normalized_rows(normalized_fixture_rows)
assert(all_rows_valid == true)
assert(validation_error == nil)
assert(stale_policy("market_price_bar_v1").stale_after_days == 5)
assert(normalized_fixture_rows[3].provider == "fmp")
assert(normalized_fixture_rows[6].replay_key == "reddit:search:ACME:sentiment")

invalid_row := {
    schema: "fundamental_metric_row_v1"
    symbol: "ACME"
    period_end: "2025-12-31"
    revenue_per_share: 42.10
    gross_margin: 0.42
    provider: "fmp"
    replay_key: "fmp:key_metrics:ACME:annual"
    captured_at: "2026-06-11T00:00:00Z"
    source_schema: "FMPKeyMetricsPayload"
}
invalid_ok, invalid_error := validate_normalized_row(invalid_row)
assert(invalid_ok == false)
assert(invalid_error.kind == "missing_field")
assert(invalid_error.field == "roic")

finance_normalizers_summary := string.format(
"finance_normalizers schemas=%d rows=%d valid=%s stale_market_days=%d invalid_field=%s",
#normalizer_schema_names,
#normalized_fixture_rows,
tostring(all_rows_valid),
stale_policy("market_price_bar_v1").stale_after_days,
invalid_error.field
)

print(finance_normalizers_summary)
