// FinRobot generated-code/notebook tooling replay example.
//
// FR-GAP-017 evidence: capability-gated file read/write/execute/display-image
// operations are represented as deterministic replay envelopes. Command cases
// are approval checked and denied by default. This fixture never starts Python,
// a shell, or a notebook kernel.

generated_code_tooling_fixture := {
    workspace: {
        root: "mock://workspace/finrobot/generated-code"
        live_python: false
        live_notebook: false
        live_shell: false
    }
    files: {
        {
            replay_key: "file:read:strategy-cell"
            operation: "read"
            path: "notebooks/strategy.ipynb"
            capability: "generated-code.read"
            content_type: "application/x-ipynb+json"
            sha256: "fixture-ipynb-strategy"
            bytes: 184
            content: "{\"cells\":[{\"cell_type\":\"code\",\"source\":\"weights = prices.pct_change().mean()\"}]}"
        }
        {
            replay_key: "file:write:signals-py"
            operation: "write"
            path: "generated/signals.py"
            capability: "generated-code.write"
            content_type: "text/x-python"
            sha256: "fixture-generated-signals"
            bytes: 96
            content: "def build_signals(prices):\n    return prices.pct_change().mean().sort_values()"
        }
    }
    executions: {
        {
            replay_key: "execute:python-cell:signals"
            operation: "execute"
            runtime: "python"
            kernel: "python3-fixture"
            capability: "generated-code.execute"
            command: "python-cell"
            source: "signals = build_signals(prices)"
            exit_code: 0
            stdout: "signals: PDD=0.18 BABA=0.11"
            stderr: ""
            duration_ms: 12
            side_effects: {}
            live_python: false
            live_notebook: false
        }
    }
    images: {
        {
            replay_key: "display:image:allocation-chart"
            operation: "display_image"
            path: "artifacts/allocation.png"
            capability: "generated-code.display-image"
            media_type: "image/png"
            width: 640
            height: 360
            sha256: "fixture-allocation-chart-png"
            alt: "Replay allocation chart for generated-code tooling"
            bytes: 4096
        }
    }
    denied_commands: {
        {
            replay_key: "command:deny:shell-rm"
            command: "rm -rf /tmp/finrobot"
            capability: "generated-code.execute"
            reason: "shell command requires explicit generated-code approval"
            live_shell: false
        }
        {
            replay_key: "command:deny:pip-install"
            command: "pip install unknown-package"
            capability: "generated-code.execute"
            reason: "package installation is outside replay fixture"
            live_shell: false
        }
        {
            replay_key: "command:deny:notebook-kernel"
            command: "jupyter nbconvert --execute strategy.ipynb"
            capability: "generated-code.execute"
            reason: "notebook kernel execution is disabled in replay mode"
            live_notebook: false
        }
    }
}

func find_fixture_row(rows, key) {
    for i := 1; i <= #rows; i++ {
        row := rows[i]
        if row.replay_key == key {
            return row
        }
    }
    return nil
}

func replay_file_read(path) {
    row := find_fixture_row(generated_code_tooling_fixture.files, "file:read:strategy-cell")
    if row == nil || row.path != path {
        return nil, {kind: "replay_miss" operation: "read" path: path}
    }
    return {
        kind: "generated_code_tooling.replay_envelope"
        version: "generated_code_tooling.v1"
        replay_key: row.replay_key
        operation: row.operation
        capability: row.capability
        path: row.path
        artifact: {content_type: row.content_type sha256: row.sha256 bytes: row.bytes}
        content: row.content
        runtime: generated_code_tooling_fixture.workspace
    }, nil
}

func replay_file_write(path, content) {
    row := find_fixture_row(generated_code_tooling_fixture.files, "file:write:signals-py")
    if row == nil || row.path != path || row.content != content {
        return nil, {kind: "replay_miss" operation: "write" path: path}
    }
    return {
        kind: "generated_code_tooling.replay_envelope"
        version: "generated_code_tooling.v1"
        replay_key: row.replay_key
        operation: row.operation
        capability: row.capability
        path: row.path
        artifact: {content_type: row.content_type sha256: row.sha256 bytes: row.bytes}
        status: "recorded"
        runtime: generated_code_tooling_fixture.workspace
    }, nil
}

func replay_python_execute(source) {
    row := find_fixture_row(generated_code_tooling_fixture.executions, "execute:python-cell:signals")
    if row == nil || row.source != source {
        return nil, {kind: "replay_miss" operation: "execute" source: source}
    }
    return {
        kind: "generated_code_tooling.replay_envelope"
        version: "generated_code_tooling.v1"
        replay_key: row.replay_key
        operation: row.operation
        capability: row.capability
        runtime: row.runtime
        kernel: row.kernel
        source: row.source
        result: {exit_code: row.exit_code stdout: row.stdout stderr: row.stderr duration_ms: row.duration_ms}
        side_effects: row.side_effects
        live_python: row.live_python
        live_notebook: row.live_notebook
    }, nil
}

func replay_display_image(path) {
    row := find_fixture_row(generated_code_tooling_fixture.images, "display:image:allocation-chart")
    if row == nil || row.path != path {
        return nil, {kind: "replay_miss" operation: "display_image" path: path}
    }
    return {
        kind: "generated_code_tooling.replay_envelope"
        version: "generated_code_tooling.v1"
        replay_key: row.replay_key
        operation: row.operation
        capability: row.capability
        image: {
            path: row.path
            media_type: row.media_type
            width: row.width
            height: row.height
            sha256: row.sha256
            alt: row.alt
            bytes: row.bytes
        }
        runtime: generated_code_tooling_fixture.workspace
    }, nil
}

func denied_command_trace(row, policy) {
    pending := {
        id: row.replay_key
        tool: "generated_code_command"
        args: {command: row.command capability: row.capability}
    }
    approval := {ok: false reason: row.reason}
    result := {
        status: "denied"
        command: row.command
        capability: row.capability
        live_shell: row.live_shell
        live_notebook: row.live_notebook
    }
    return llm.approval_trace({
        token: "replay-token:" .. row.replay_key
        pending: pending
        approval: approval
        result: result
        policy: policy
    })
}

read_generated_file := llm.tool("read_generated_file", replay_file_read, {
    params: {"path"}
    requires: {"generated-code.read"}
})
write_generated_file := llm.tool("write_generated_file", replay_file_write, {
    params: {"path", "content"}
    requires: {"generated-code.write"}
})
execute_generated_python := llm.tool("execute_generated_python", replay_python_execute, {
    params: {"source"}
    requires: {"generated-code.execute"}
})
display_generated_image := llm.tool("display_generated_image", replay_display_image, {
    params: {"path"}
    requires: {"generated-code.display-image"}
})
generated_code_command := llm.tool("generated_code_command", func(command) {
    return nil, {kind: "approval_required" command: command}
}, {
    params: {"command"}
    requires: {"generated-code.execute"}
})

generated_policy := llm.policy({
    allow: {
        "generated-code.read",
        "generated-code.write",
        "generated-code.execute",
        "generated-code.display-image",
    }
})
generated_default_policy := llm.policy()

read_policy_ok, read_policy_err := llm.check_policy({read_generated_file}, generated_policy)
write_policy_ok, write_policy_err := llm.check_policy({write_generated_file}, generated_policy)
execute_policy_ok, execute_policy_err := llm.check_policy({execute_generated_python}, generated_policy)
display_policy_ok, display_policy_err := llm.check_policy({display_generated_image}, generated_policy)
_, default_execute_err := llm.check_policy({generated_code_command}, generated_default_policy)

read_envelope, read_err := replay_file_read("notebooks/strategy.ipynb")
write_envelope, write_err := replay_file_write("generated/signals.py", "def build_signals(prices):\n    return prices.pct_change().mean().sort_values()")
execute_envelope, execute_err := replay_python_execute("signals = build_signals(prices)")
image_envelope, image_err := replay_display_image("artifacts/allocation.png")

denied_command_traces := {}
for i := 1; i <= #generated_code_tooling_fixture.denied_commands; i++ {
    denied_command_traces[i] = denied_command_trace(generated_code_tooling_fixture.denied_commands[i], generated_default_policy)
}

generated_code_tooling_read_capability := read_envelope.capability
generated_code_tooling_write_status := write_envelope.status
generated_code_tooling_execute_runtime := execute_envelope.runtime
generated_code_tooling_execute_stdout := execute_envelope.result.stdout
generated_code_tooling_image_media_type := image_envelope.image.media_type
generated_code_tooling_denied_count := #denied_command_traces
generated_code_tooling_default_denied_class := default_execute_err.class
generated_code_tooling_first_denied_command := denied_command_traces[1].pending.args.command
generated_code_tooling_first_denied_reason := denied_command_traces[1].decision.reason
generated_code_tooling_live_python := execute_envelope.live_python
generated_code_tooling_live_notebook := execute_envelope.live_notebook
generated_code_tooling_policy_ok := read_policy_ok && write_policy_ok && execute_policy_ok && display_policy_ok
generated_code_tooling_policy_errors_nil := read_policy_err == nil && write_policy_err == nil && execute_policy_err == nil && display_policy_err == nil
generated_code_tooling_replay_errors_nil := read_err == nil && write_err == nil && execute_err == nil && image_err == nil

generated_code_tooling_summary := string.format(
    "generated_code_tooling read=%s write=%s exec=%s image=%s denied=%d live_python=%s live_notebook=%s",
    generated_code_tooling_read_capability,
    generated_code_tooling_write_status,
    generated_code_tooling_execute_runtime,
    generated_code_tooling_image_media_type,
    generated_code_tooling_denied_count,
    tostring(generated_code_tooling_live_python),
    tostring(generated_code_tooling_live_notebook)
)

print(generated_code_tooling_summary)
