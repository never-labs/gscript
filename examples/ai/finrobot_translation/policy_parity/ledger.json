  "audit_date": "2026-06-12",
  "scope": "approval_capability_policy",
  "not_finrobot_syntax": true,
  "source": {
    "repo": "FinRobot",
    "source_paths": [
      "finrobot/toolkits.py",
      "finrobot/functional/*",
      "finrobot/data_source/*",
      "FinRobot tutorials and demos"
    ],
    "source_concepts": [
      "external market and document network calls",
      "API keys and credential-gated providers",
      "generated code and notebook execution",
      "local file and report artifact writes",
      "report publication and web product deployment",
      "trading or portfolio action submission",
      "optional live provider adapters",
      "LLM/model provider calls"
    ]
  },
  "target": {
    "repo": "leia",
    "baseline_branch": "origin/codex/ai-dialect-polish",
    "translation_root": "examples/ai/finrobot_translation",
    "ledger_directory": "examples/ai/finrobot_translation/policy_parity",
    "policy_example": "examples/ai/finrobot_translation/compliance_policy.leia",
    "provider_free_default": true,
    "live_network_default": false,
    "real_credentials_default": false,
    "real_dependency_import_default": false,
    "runtime_execution_default": false,
    "file_write_default": false,
    "publication_default": false,
    "trading_default": false,
    "model_call_default": false
  },
  "global_gates": [
    "policy parity must be ledger driven and must not hard-code a single approval case",
    "provider-free tests must not call external network, live model providers, finance vendors, trading APIs, q/runtime, or local code execution",
    "default policy is deny_high_risk for external side effects and live-provider actions",
    "approved cases require explicit opt-in capability and approval evidence while keeping parity fixtures side-effect-free",
    "clean-skip cases must be successful skips with a reason when credentials, provider live flags, or model live flags are absent"
  ],
  "status_values": [
    "denied",
    "approved",
    "clean_skip"
  ],
  "action_values": [
    "deny",
    "approve",
    "clean_skip"
  ],
