// finrobot_translation/core_agents/workflow_handoff.leia
//
// FinRobot workflow translation to Leia AI dialect.
// Source mapping:
// - UserProxyAgent -> explicit user message plus tool-result history
// - GroupChat/GroupChatManager -> deterministic coordinator history and speaker log
// - MultiAssistantWithLeader nested chat -> leader agent with specialist agent-as-tool
// - order_trigger/order_message -> parse [Agent_Name] orders into a specialist task

llm.register_models({
    default: "mock-leader"
    leader: "mock-leader"
    employee: "mock-employee"
})

leader_prompt := "You are the leader of the following group members:\nName: Market_Analyst\nResponsibility:\n - collect local evidence\n\nSummarize status, issue one [Market_Analyst] order at a time, and reply TERMINATE when everything is done."

func order_message(agent_name, full_order) {
    marker := "[" .. agent_name .. "]"
    start_idx := string.find(full_order, marker, 1, true)
    order := full_order
    if start_idx != nil {
        order = string.sub(full_order, start_idx + #marker)
        if string.sub(order, 1, 1) == ":" {
            order = string.sub(order, 2)
        }
    }
    return "Follow leader's order and complete the following task with your group members:\n\n" .. string.trim(order) .. "\n\nFor coding tasks, provide scripts and executor will run them for you. Reply TERMINATE when done."
}

func employee_config(order) {
    return {
        model: "employee"
        messages: {
            llm.system("You are Market_Analyst translated from FinRobot. Use only provided generic tools or local evidence."),
            llm.user(order_message("Market_Analyst", order)),
        }
        output: {
            completed: true
            summary: "short delegated result"
            next_speaker: "User_Proxy"
        }
        budget: {turns: 1, calls: 0, tokens: 512}
    }
}

market_analyst := llm.agent("Market_Analyst", employee_config, nil, {
    params: {"order"}
    output: {
        completed: true
        summary: "short delegated result"
        next_speaker: "User_Proxy"
    }
    description: "Execute one translated leader order and return structured status."
})

func leader_config(task) {
    return {
        model: "leader"
        messages: {
            llm.system(leader_prompt),
            llm.user(task),
        }
        tools: {market_analyst}
        budget: {turns: 3, calls: 1, tokens: 1024}
    }
}

leader := llm.agent("FinRobot_Group_Leader", leader_config, nil, {
    params: {"task"}
    description: "Coordinate translated FinRobot specialists through agent-as-tool handoff."
})

func group_speaker_log() {
    return {
        "User_Proxy -> FinRobot_Group_Leader",
        "FinRobot_Group_Leader -> Market_Analyst",
        "Market_Analyst -> User_Proxy",
        "User_Proxy -> FinRobot_Group_Leader"
    }
}

evaluate "leader workflow delegates through agent as tool" {
    result, err := leader("Prepare a local evidence summary. If delegation is needed, order [Market_Analyst] to collect generic notes.")
    assert(err == nil)
    assert(result.text == "Status: delegated evidence was collected and checked. TERMINATE")

    tool_msg, tool_idx := history.find(result.history, {role: "tool"})
    assert(tool_idx > 0)
    assert(tool_msg.value.completed == true)
    assert(tool_msg.value.summary == "Generic local evidence collected for the translated workflow.")
    assert(tool_msg.value.next_speaker == "User_Proxy")
}

evaluate "group chat speaker policy is represented as explicit history" {
    speakers := group_speaker_log()
    assert(speakers[1] == "User_Proxy -> FinRobot_Group_Leader")
    assert(speakers[2] == "FinRobot_Group_Leader -> Market_Analyst")
    assert(speakers[3] == "Market_Analyst -> User_Proxy")
    assert(speakers[4] == "User_Proxy -> FinRobot_Group_Leader")
}
