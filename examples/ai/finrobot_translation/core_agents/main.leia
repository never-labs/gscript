// finrobot_translation/core_agents/main.leia
//
// FinRobot core agent-library translation to Leia AI dialect.
// Source mapping:
// - FinRobot(agent_config) -> agent { name, instructions, tools, output }
// - profile/responsibilities prompts -> prompt { role: "system", text: ... }
// - register_toolkits(...) -> generic local tool descriptors, not runtime built-ins
// - SingleAssistant.chat(...) -> one replay-backed agent invocation plus review turn

model {
    default: "mock-finrobot-core"
}

agent_library := {
    Market_Analyst: {
        name: "Market_Analyst",
        profile: "Collect local evidence, aggregate it for the client request, and reply TERMINATE when the task is done.",
        tool_names: {"load_profile", "search_local_notes"}
    },
    Expert_Investor: {
        name: "Expert_Investor",
        profile: "Generate a customized analysis report from supplied local evidence and client feedback. Reply TERMINATE when everything is settled.",
        tool_names: {"load_profile", "build_report_outline"}
    },
    Data_Analyst: {
        name: "Data_Analyst",
        profile: "Analyze data with local tools, collaborate in group workflows, and reply TERMINATE when everything is done.",
        tool_names: {}
    }
}

func role_prompt(title, responsibilities) {
    body := "As a " .. title .. ", your responsibilities are as follows:"
    for i := 1; i <= #responsibilities; i++ {
        body = body .. "\n - " .. responsibilities[i]
    }
    return body .. "\n\nReply \"TERMINATE\" in the end when everything is done."
}

tool_events := {}

func remember(kind, value) {
    tool_events[#tool_events + 1] = kind .. ":" .. value
}

load_profile := tool {
    name: "load_profile"
    fn: func(agent_name) {
        remember("load_profile", agent_name)
        cfg := agent_library[agent_name]
        if cfg == nil {
            return nil, "unknown agent profile"
        }
        return cfg.profile, nil
    }
    params: {"agent_name"}
    description: "Load a translated FinRobot library profile from local configuration."
}

search_local_notes := tool {
    name: "search_local_notes"
    fn: func(query) {
        remember("search_local_notes", query)
        return "local notes: map toolkit calls to explicit tools; keep evidence generic and replayable", nil
    }
    params: {"query"}
    description: "Search local non-financial notes used by the translated agent."
}

build_report_outline := tool {
    name: "build_report_outline"
    fn: func(agent_name, sections) {
        remember("build_report_outline", agent_name)
        return {
            agent: agent_name,
            sections: sections,
            source: "local-evidence"
        }, nil
    }
    params: {"agent_name", "sections"}
    description: "Build a generic report outline from structured local evidence."
}

core_mapper := agent {
    name: "finrobot_core_mapper"
    model: "mock-finrobot-core"
    instructions: prompt { role: "system", text: "Translate FinRobot agent_library entries into Leia agents with generic local evidence tools and structured output." }
    tools: {load_profile, search_local_notes, build_report_outline}
    params: {"request"}
    output: {
        mapped_agents: {"Market_Analyst", "Expert_Investor"}
        single_assistant: "agent invocation with a user message"
        tool_calling: "explicit tools array"
        structured_output: true
        termination: "TERMINATE as prompt convention"
    }
    max_steps: 1
}

evaluate "agent library maps to declarative Leia agents" {
    mapped, mapped_err := core_mapper("Map Market_Analyst and Expert_Investor to Leia core agents.")
    assert(mapped_err == nil)
    assert(mapped.value.mapped_agents[1] == "Market_Analyst")
    assert(mapped.value.mapped_agents[2] == "Expert_Investor")
    assert(mapped.value.single_assistant == "agent invocation with a user message")
    assert(mapped.value.tool_calling == "explicit tools array")
    assert(mapped.value.structured_output == true)
    assert(mapped.value.termination == "TERMINATE as prompt convention")

    review, review_err := turn {
        model: "mock-finrobot-review"
        messages: {
            llm.system("Review the FinRobot core agent mapping for replayability and runtime neutrality."),
            llm.user(mapped.text),
        }
    }
    assert(review_err == nil)
    assert(review.text == "Core agent mapping is replayable: library profiles become prompts, toolkit entries become explicit tools, and outputs stay structured.")
}

evaluate "role prompt mirrors FinRobot responsibility preprocessing" {
    prompt_text := role_prompt("Research Lead", {"Coordinate specialists", "Return a structured status"})
    assert(string.find(prompt_text, "As a Research Lead", 1, true) != nil)
    assert(string.find(prompt_text, "Coordinate specialists", 1, true) != nil)
    assert(string.find(prompt_text, "TERMINATE", 1, true) != nil)
}
