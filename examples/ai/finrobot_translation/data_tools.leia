// FinRobot data-source/toolkit layer translated into generic Leia AI tools.
//
// The source FinRobot layer wraps yfinance, Finnhub, SEC API, FMP, Reddit,
// FinNLP, and earnings-call helpers as AutoGen-callable functions. This file
// keeps the shape but removes provider clients: every tool reads deterministic
// replay documents from llm.collection and returns llm.evidence-backed data.

provider_docs := llm.collection({
    llm.doc({
        id: "yfinance:prices:ACME"
        title: "Replay market prices"
        source: "mock/yfinance/history"
        provider: "yfinance"
        dataset: "prices"
        entity: "ACME"
        text: "ACME replay prices cover 2026-01-02 to 2026-01-03 with close values 101.40 and 103.20."
        rows: {
            {date: "2026-01-02" open: 100.10 high: 102.00 low: 99.80 close: 101.40 volume: 1200000}
            {date: "2026-01-03" open: 101.80 high: 103.70 low: 101.20 close: 103.20 volume: 980000}
        }
    })
    llm.doc({
        id: "finnhub:profile:ACME"
        title: "Replay company profile"
        source: "mock/finnhub/company_profile2"
        provider: "finnhub"
        dataset: "profile"
        entity: "ACME"
        text: "ACME Corp is a replay entity in industrial automation, listed on XNAS with headquarters in US."
        profile: {
            name: "ACME Corp"
            industry: "Industrial Automation"
            exchange: "XNAS"
            country: "US"
            currency: "USD"
        }
    })
    llm.doc({
        id: "fmp:metrics:ACME"
        title: "Replay fundamentals"
        source: "mock/fmp/key-metrics"
        provider: "fmp"
        dataset: "metrics"
        entity: "ACME"
        text: "ACME replay fundamentals include revenue, gross margin, free cash flow conversion, and return on invested capital."
        rows: {
            {year: "2025" revenue_m: 8420 gross_margin: 0.42 fcf_conversion: 0.91 roic: 0.18}
            {year: "2024" revenue_m: 7810 gross_margin: 0.40 fcf_conversion: 0.86 roic: 0.16}
        }
    })
    llm.doc({
        id: "sec:10k:ACME:2025"
        title: "Replay 10-K filing"
        source: "mock/sec-api/extractor"
        provider: "sec"
        dataset: "filing"
        entity: "ACME"
        year: "2025"
        text: "ACME 2025 10-K item 1A says supply concentration and integration timing are the primary risks."
        metadata: {
            form_type: "10-K"
            filed_at: "2026-02-20"
            accession: "0000000000-26-000001"
            filing_url: "mock://sec/acme/2025/10-k"
        }
        sections: {
            item_1a: "Risk factors: supply concentration and integration timing."
            item_7: "Management discussion: demand improved while backlog normalization continued."
        }
    })
    llm.doc({
        id: "reddit:social:ACME"
        title: "Replay social posts"
        source: "mock/reddit/search"
        provider: "reddit"
        dataset: "social"
        entity: "ACME"
        text: "Replay Reddit posts mention ACME backlog, automation demand, and margin questions."
        rows: {
            {created_utc: "2026-02-21 14:00:00" id: "r1" title: "ACME backlog watch" score: 42 num_comments: 18}
            {created_utc: "2026-02-22 09:30:00" id: "r2" title: "Automation demand check" score: 17 num_comments: 5}
        }
    })
    llm.doc({
        id: "finnlp:news:ACME"
        title: "Replay news stream"
        source: "mock/finnlp/date-range"
        provider: "finnlp"
        dataset: "news"
        entity: "ACME"
        text: "Replay news stream says ACME expanded service capacity and guided stable backlog conversion."
        rows: {
            {date: "2026-02-20" source_name: "Replay Wire" headline: "ACME expands service capacity" summary: "Capacity increase targets recurring support."}
            {date: "2026-02-21" source_name: "Replay Wire" headline: "Backlog conversion steady" summary: "Management expects stable conversion."}
        }
    })
    llm.doc({
        id: "earnings:transcript:ACME:2025:Q4"
        title: "Replay earnings transcript"
        source: "mock/earnings-call/transcript"
        provider: "earnings_call"
        dataset: "transcript"
        entity: "ACME"
        year: "2025"
        quarter: "Q4"
        text: "Operator introduces the ACME Q4 call. CEO says demand improved. CFO says free cash flow conversion remained above ninety percent."
        segments: {
            {speaker: "Operator" quarter: "Q4" text: "Welcome to the ACME Q4 replay call."}
            {speaker: "CEO" quarter: "Q4" text: "Demand improved in automation and service capacity expanded."}
            {speaker: "CFO" quarter: "Q4" text: "Free cash flow conversion remained above ninety percent."}
        }
    })
})

func matches_doc(doc, provider, dataset, entity) {
    return doc.provider == provider && doc.dataset == dataset && doc.entity == string.upper(entity)
}

func find_doc(provider, dataset, entity) {
    for i := 1; i <= provider_docs.count; i++ {
        doc := provider_docs.docs[i]
        if matches_doc(doc, provider, dataset, entity) {
            return doc
        }
    }
    return nil
}

func project_row(row, fields) {
    if fields == nil || #fields == 0 {
        return row
    }
    out := {}
    for i := 1; i <= #fields; i++ {
        key := fields[i]
        out[key] = row[key]
    }
    return out
}

func project_rows(rows, fields, limit) {
    out := {}
    max := #rows
    if limit != nil && limit > 0 && limit < max {
        max = limit
    }
    for i := 1; i <= max; i++ {
        out[#out + 1] = project_row(rows[i], fields)
    }
    return out
}

func evidence_for(doc, label) {
    return llm.evidence({doc}, {label: label})
}

fetch_table := llm.tool("fetch_table", func(provider, dataset, entity, selected_fields, limit) {
    doc := find_doc(provider, dataset, entity)
    if doc == nil {
        return nil, {message: "replay dataset not found"}
    }
    return {
        provider: provider
        dataset: dataset
        entity: string.upper(entity)
        rows: project_rows(doc.rows, selected_fields, limit)
        evidence: evidence_for(doc, "Data table evidence")
    }, nil
}, {
    description: "Return replay tabular data for a provider/dataset/entity tuple."
    params: {"provider", "dataset", "entity", "selected_fields", "limit"}
    requires: {"local.replay.read"}
    param_docs: {
        provider: "source family such as yfinance, fmp, reddit, or finnlp"
        dataset: "dataset name such as prices, metrics, social, or news"
        entity: "lookup key; ticker-like symbols are normalized but not interpreted"
        selected_fields: "optional list of fields to project"
        limit: "optional maximum row count"
    }
})

fetch_profile := llm.tool("fetch_profile", func(provider, entity) {
    doc := find_doc(provider, "profile", entity)
    if doc == nil {
        return nil, {message: "replay profile not found"}
    }
    return {
        provider: provider
        entity: string.upper(entity)
        profile: doc.profile
        evidence: evidence_for(doc, "Profile evidence")
    }, nil
}, {
    description: "Return replay entity profile data."
    params: {"provider", "entity"}
    requires: {"local.replay.read"}
})

fetch_filing := llm.tool("fetch_filing", func(entity, year, section) {
    doc := find_doc("sec", "filing", entity)
    if doc == nil || doc.year != year {
        return nil, {message: "replay filing not found"}
    }
    key := "item_" .. string.lower(tostring(section))
    return {
        provider: "sec"
        entity: string.upper(entity)
        year: year
        metadata: doc.metadata
        section: section
        text: doc.sections[key]
        evidence: evidence_for(doc, "Filing evidence")
    }, nil
}, {
    description: "Return replay filing metadata and a section excerpt."
    params: {"entity", "year", "section"}
    requires: {"local.replay.read"}
})

fetch_transcript := llm.tool("fetch_transcript", func(entity, year, quarter, speaker) {
    doc := find_doc("earnings_call", "transcript", entity)
    if doc == nil || doc.year != year || doc.quarter != quarter {
        return nil, {message: "replay transcript not found"}
    }
    segments := {}
    for i := 1; i <= #doc.segments; i++ {
        segment := doc.segments[i]
        if speaker == nil || speaker == "" || segment.speaker == speaker {
            segments[#segments + 1] = segment
        }
    }
    return {
        provider: "earnings_call"
        entity: string.upper(entity)
        year: year
        quarter: quarter
        segments: segments
        evidence: evidence_for(doc, "Transcript evidence")
    }, nil
}, {
    description: "Return replay earnings-call transcript segments."
    params: {"entity", "year", "quarter", "speaker"}
    requires: {"local.replay.read"}
})

search_evidence := llm.tool("search_evidence", func(query, limit) {
    ctx := llm.retrieve(provider_docs, query, {limit: limit label: "Retrieved data-source evidence"})
    return {
        query: query
        matches: ctx.matches
        evidence: llm.evidence(ctx.matches, {label: "Search evidence"})
    }, nil
}, {
    description: "Search replay source documents and package matches as evidence."
    params: {"query", "limit"}
    requires: {"local.replay.read"}
})

func register_data_toolkit() {
    return {
        fetch_table
        fetch_profile
        fetch_filing
        fetch_transcript
        search_evidence
    }
}

data_tools := register_data_toolkit()

price_call := {id: "call-price" tool: "fetch_table" args: {
        provider: "yfinance"
        dataset: "prices"
        entity: "acme"
        selected_fields: {"date", "close"}
        limit: 2
    }}
prices, price_err := llm.dispatch(price_call, data_tools)
if price_err != nil {
    print(price_err.message)
    return
}

profile_call := {id: "call-profile" tool: "fetch_profile" args: {provider: "finnhub" entity: "ACME"}}
profile, profile_err := llm.dispatch(profile_call, data_tools)
if profile_err != nil {
    print(profile_err.message)
    return
}

filing_call := {id: "call-filing" tool: "fetch_filing" args: {entity: "ACME" year: "2025" section: "1a"}}
filing, filing_err := llm.dispatch(filing_call, data_tools)
if filing_err != nil {
    print(filing_err.message)
    return
}

transcript_call := {id: "call-transcript" tool: "fetch_transcript" args: {entity: "ACME" year: "2025" quarter: "Q4" speaker: "CFO"}}
transcript, transcript_err := llm.dispatch(transcript_call, data_tools)
if transcript_err != nil {
    print(transcript_err.message)
    return
}

search_call := {id: "call-search" tool: "search_evidence" args: {query: "ACME risk backlog free cash flow", limit: 3}}
search, search_err := llm.dispatch(search_call, data_tools)
if search_err != nil {
    print(search_err.message)
    return
}

assert(provider_docs.count == 7)
assert(#data_tools == 5)
assert(prices.rows[1].date == "2026-01-02")
assert(prices.rows[2].close == 103.20)
assert(profile.profile.industry == "Industrial Automation")
assert(filing.metadata.form_type == "10-K")
assert(string.find(filing.text, "supply concentration", 1, true) != nil)
assert(transcript.segments[1].speaker == "CFO")
assert(#search.matches == 3)
assert(string.find(search.evidence.text, "Search evidence:", 1, true) != nil)

data_tools_summary := string.format(
"finrobot_data_tools tools=%d docs=%d price_rows=%d transcript_segments=%d search_matches=%d",
#data_tools,
provider_docs.count,
#prices.rows,
#transcript.segments,
#search.matches
)

print(data_tools_summary)
