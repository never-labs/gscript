overview_ok, overview_msg := llm.validate_output(section_fixture_outputs.overview, section_output_schemas.overview_section_v1)
financial_ok, financial_msg := llm.validate_output(section_fixture_outputs.financial, section_output_schemas.financial_section_v1)
