// FinRobot investment group translated to Leia + q + AI.
// Mirrors experiments/investment_group.py, analyzer.py, and coding.py helper roles.

model {
    default: "mock-fast"
}

evaluate "FinRobot investment group replay" {

    func check(name, ok) {
        if !ok {
            print("failed", name)
        }
        assert(ok)
        print("ok", name)
    }

    committee_inputs := q.sql(
    "select group_name,sym,score,confidence,weight from ([] group_name:`sentiment`risk`fundamental`sentiment`risk`fundamental; sym:`PDD`PDD`PDD`BABA`BABA`BABA; score:0.62 0.44 0.58 0.40 0.55 0.46; confidence:0.78 0.70 0.74 0.61 0.66 0.62; weight:0.25 0.35 0.40 0.25 0.35 0.40)",
    {}
    )

    committee_inputs = q.sql(committee_inputs, "update weighted_score:score*weight from trades")
    investment_view := q.sql(committee_inputs, "select integrated_score:sum weighted_score, confidence:sum confidence*weight, groups:count i by sym from trades order by integrated_score desc")
    investment_view = q.sql(investment_view, "update target_price:70.0*(1+integrated_score*0.20) from trades where sym=`PDD")
    investment_view = q.sql(investment_view, "update target_price:82.0*(1+integrated_score*0.12) from trades where sym=`BABA")
    investment_view = q.sql(investment_view, "update recommendation:`invest from trades where integrated_score>0.52")
    investment_view = q.sql(investment_view, "update recommendation:`watch from trades where integrated_score<=0.52")

    leader_orders := q.sql(
    "select step,recipient,order_text from ([] step:1 2 3 4; recipient:`Market_Sentiment_Analysts`Risk_Assessment_Analysts`Fundamental_Analysts`CIO; order_text:(\"score recent market sentiment\";\"summarize 20-F risks\";\"calculate core profitability ratios\";\"integrate findings and set target price\"))",
    {}
    )

    func replay_report_prompt(ticker, section) {
        return "ticker=" .. ticker .. "; section=" .. section .. "; saved=mock://" .. ticker .. "/" .. section, nil
    }

    prepare_report_prompt := tool {
        name: "prepare_report_prompt"
        fn: replay_report_prompt
        params: {"ticker", "section"}
        description: "Replay ReportAnalysisUtils prompt preparation without SEC or market data calls."
    }

    func replay_python_cell(cell) {
        return "executed deterministic cell: " .. cell, nil
    }

    exec_python_cell := tool {
        name: "exec_python_cell"
        fn: replay_python_cell
        params: {"cell"}
        description: "Replay CodingUtils/IPython execution without touching a notebook runtime."
    }

    cio := agent {
        name: "chief_investment_officer"
        config: func(request) {
            return {
                model: "mock-fast"
                messages: {
                    llm.system("Coordinate sentiment, risk, and fundamental analyst groups, then make one investment decision."),
                    llm.user(request),
                }
            }, nil
        }
        params: {"request"}
    }

    agent_result, agent_err := cio("Evaluate PDD on the translated investment-group workflow using only local fixture data.")
    prompt_log, prompt_err := replay_report_prompt("PDD", "20-F-risk")
    code_log, code_err := replay_python_cell("target_price = 78.12")

    check("q integrates investment group scores", #investment_view == 2 && investment_view[1].sym == "PDD" && investment_view[1].recommendation == "invest")
    check("q keeps group leader order skeleton", #leader_orders == 4 && leader_orders[1].recipient == "Market_Sentiment_Analysts" && leader_orders[4].recipient == "CIO")
    check("analyzer helper is replayed locally", prompt_err == nil && string.find(prompt_log, "mock://PDD/20-F-risk", 1, true) != nil)
    check("coding helper is replayed locally", code_err == nil && string.find(code_log, "target_price", 1, true) != nil)
    check("CIO agent stays offline and mockable", agent_err == nil && agent_result.text == "Direct llm.turn keeps examples simple.")

    summary := string.format("quant_investment_group top=%s recommendation=%s target=%.2f", investment_view[1].sym, investment_view[1].recommendation, investment_view[1].target_price)
    print(summary)

}
