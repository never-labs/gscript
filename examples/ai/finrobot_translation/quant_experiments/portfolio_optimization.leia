// FinRobot portfolio optimization translated to Leia + q + AI.
// Mirrors experiments/portfolio_optimization.py and BackTraderUtils.back_test.

model {
    default: "mock-fast"
}

evaluate "FinRobot portfolio optimization replay" {

    func check(name, ok) {
        if !ok {
            print("failed", name)
        }
        assert(ok)
        print("ok", name)
    }

    candidates := q.sql(
    "select sym,score,ret,vol,beta,adv,target_cap from ([] sym:`AAPL`MSFT`NVDA`JPM`XOM; score:0.58 0.52 0.64 0.48 0.42; ret:0.032 0.026 0.051 0.018 0.012; vol:0.18 0.16 0.31 0.21 0.24; beta:1.12 1.05 1.46 1.02 0.88; adv:68000000 32000000 54000000 28000000 25000000; target_cap:0.30 0.25 0.20 0.15 0.10)",
    {}
    )

    candidates = q.sql(candidates, "update raw_weight:score*ret*reciprocal vol from trades")
    weight_sum := q.sql(candidates, "select total:sum raw_weight by bucket:`portfolio from trades")[1].total
    candidates = q.sql(candidates, "update weight:raw_weight*" .. tostring(1.0 / weight_sum) .. " from trades")
    candidates = q.sql(candidates, "update capped_weight:weight from trades")
    candidates = q.sql(candidates, "update capped_weight:target_cap from trades where weight>target_cap")
    candidates = q.sql(candidates, "update expected_return:capped_weight*ret from trades")
    candidates = q.sql(candidates, "update risk_contribution:capped_weight*vol*beta from trades")
    candidates = q.sql(candidates, "update liquidity_days:capped_weight*100000000*reciprocal adv from trades")

    optimized := q.sql(candidates, "select sym,ret,vol,beta,target_cap,raw_weight,weight,capped_weight,expected_return,risk_contribution,liquidity_days from trades order by capped_weight desc")
    portfolio_stats := q.sql(optimized, "select gross:sum capped_weight, expected_return:sum expected_return, risk:sum risk_contribution, max_liquidity_days:max liquidity_days by bucket:`portfolio from trades")
    rebalance_orders := q.sql(optimized, "select sym,notional:capped_weight*100000000, expected_return,risk_contribution,liquidity_days from trades where capped_weight>0.12 order by notional desc")

    func replay_backtest(strategy, start_date, end_date) {
        stats := portfolio_stats[1]
        return string.format("Back Test Finished. strategy=%s start=%s end=%s final_value=%.2f expected_return=%.4f risk=%.4f", strategy, start_date, end_date, 100000000 * (1 + stats.expected_return), stats.expected_return, stats.risk), nil
    }

    backtest_strategy := tool {
        name: "backtest_strategy"
        fn: replay_backtest
        params: {"strategy", "start_date", "end_date"}
        description: "Replay a deterministic BackTrader-style result from q portfolio stats."
    }

    optimizer := agent {
        name: "portfolio_optimizer"
        config: func(request) {
            return {
                model: "mock-fast"
                messages: {
                    llm.system("Optimize a quantitative portfolio using local q risk and return tables."),
                    llm.user(request),
                }
            }, nil
        }
        params: {"request"}
    }

    agent_result, agent_err := optimizer("Allocate capital, cap concentration, and backtest the SMA_CrossOver baseline.")
    bt_log, bt_err := replay_backtest("SMA_CrossOver", "2023-01-01", "2023-12-31")

    check("q computes normalized optimization weights", #optimized == 5 && optimized[1].sym == "AAPL" && optimized[3].sym == "NVDA" && optimized[3].capped_weight == 0.20)
    check("q computes portfolio stats", #portfolio_stats == 1 && portfolio_stats[1].gross > 0.86 && portfolio_stats[1].expected_return > 0.027)
    check("q emits rebalance order skeleton", #rebalance_orders == 3 && rebalance_orders[1].sym == "AAPL" && rebalance_orders[3].sym == "NVDA")
    check("BackTrader-style tool is replayable", bt_err == nil && string.find(bt_log, "Back Test Finished", 1, true) != nil)
    check("AI optimizer stays offline and mockable", agent_err == nil && agent_result.text == "Direct llm.turn keeps examples simple.")

    summary := string.format("quant_portfolio names=%d gross=%.4f expected_return=%.4f", #rebalance_orders, portfolio_stats[1].gross, portfolio_stats[1].expected_return)
    print(summary)

}
