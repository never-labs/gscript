// Provider-free parity smoke for FinRobot RAG earnings call and SEC filing
// notebooks.
//
// This fixture-only translation validates the retrieval pipeline shape without
// opening network connections, vector stores, embedding providers, or model
// providers.

rag_earnings_sec_notebook := {
    id: "finrobot-tutorial-notebook-rag-earnings-sec"
    source_notebooks: {
        "tutorials_beginner/agent_rag_earnings_call_sec_filings.ipynb",
        "tutorials_beginner/agent_rag_qa.ipynb",
        "tutorials_beginner/agent_rag_qa_up.ipynb",
    }
    provider_free: true
    live_network: false
    credentials_required: false
    model_required: false
    real_dependency_imports: false
    fixture_key: "tutorial:notebook:rag_earnings_sec:ACME:provider_free:2026-06-12"
    corpus: {
        {id: "earnings_call_q1" kind: "earnings_transcript" chunks: 3 source: "fixture"},
        {id: "sec_10k_risk" kind: "sec_filing" chunks: 2 source: "fixture"},
        {id: "sec_10q_liquidity" kind: "sec_filing" chunks: 2 source: "fixture"},
    }
    queries: {
        {id: "margin_drivers" top_k: 2 expected_sources: 2},
        {id: "risk_factor_delta" top_k: 2 expected_sources: 2},
        {id: "liquidity_runway" top_k: 2 expected_sources: 2},
    }
    gates: {
        embeddings_provider: "fixture_hash_embedding"
        vector_store: "in_memory_fixture"
        reranker: "deterministic_score"
    }
}

func rag_corpus_ok(item) {
    if item == nil {
        return false
    }
    return item.id != nil && item.source == "fixture" && item.chunks > 0
}

func rag_query_ok(query) {
    if query == nil {
        return false
    }
    return query.id != nil && query.top_k > 0 && query.expected_sources > 0
}

rag_chunk_count := 0
for i := 1; i <= #rag_earnings_sec_notebook.corpus; i++ {
    item := rag_earnings_sec_notebook.corpus[i]
    assert(rag_corpus_ok(item))
    rag_chunk_count = rag_chunk_count + item.chunks
}

rag_query_count := 0
for i := 1; i <= #rag_earnings_sec_notebook.queries; i++ {
    query := rag_earnings_sec_notebook.queries[i]
    assert(rag_query_ok(query))
    rag_query_count = rag_query_count + 1
}

assert(rag_earnings_sec_notebook.provider_free == true)
assert(rag_earnings_sec_notebook.live_network == false)
assert(rag_earnings_sec_notebook.credentials_required == false)
assert(rag_earnings_sec_notebook.model_required == false)
assert(rag_earnings_sec_notebook.real_dependency_imports == false)
assert(rag_chunk_count == 7)
assert(rag_query_count == 3)

rag_earnings_sec_notebook_summary := string.format(
"rag_earnings_sec_notebook_parity corpus=%d chunks=%d queries=%d provider_free=%s live_network=%s model_required=%s fixture=%s",
#rag_earnings_sec_notebook.corpus,
rag_chunk_count,
rag_query_count,
tostring(rag_earnings_sec_notebook.provider_free),
tostring(rag_earnings_sec_notebook.live_network),
tostring(rag_earnings_sec_notebook.model_required),
rag_earnings_sec_notebook.fixture_key
)

print(rag_earnings_sec_notebook_summary)
