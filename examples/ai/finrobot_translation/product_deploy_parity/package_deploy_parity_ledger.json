{
  "schema_version": 1,
  "id": "finrobot-package-product-deploy-parity-ledger",
  "gap_id": "FR-GAP-021",
  "provider_free": true,
  "live_network_default": false,
  "clean_skip_default": true,
  "package_deploy_files": {
    "requirements": "../package_deploy_requirements.txt",
    "setup": "../package_deploy_setup.py",
    "dockerfile": "../package_deploy_Dockerfile",
    "run_web_app": "../package_deploy_run_web_app.py",
    "gcloud": "../package_deploy_gcloud.sh",
    "manifest": "../package_deploy_manifest.json"
  },
  "product_workflow_sources": {
    "manifest": "../live_packages/product_workflow/package.manifest.json",
    "deployment_gates": "../live_packages/product_workflow/contracts/deployment_capability_gates.json",
    "product_contract": "../live_packages/product_workflow/contracts/product_workflow_contract.json",
    "db_migration_contract": "../live_packages/product_workflow/contracts/db_migration_contract.json",
    "static_asset_manifest": "../live_packages/product_workflow/templates/static_asset_manifest.json"
  },
  "parity_entries": [
    {
      "id": "dockerfile_fixture_service",
      "deploy_surface": "dockerfile",
      "package_file": "../package_deploy_Dockerfile",
      "product_capabilities": [
        "product.workflow.deploy.container"
      ],
      "required_evidence": [
        "LEIA_FINROBOT_DATA_DIR",
        "PORT=8080",
        "package_deploy_requirements.txt",
        "package_deploy_run_web_app.py"
      ],
      "provider_free": true,
      "live_network": false,
      "clean_skip": false
    },
    {
      "id": "setup_requirements_extras",
      "deploy_surface": "python_package",
      "package_file": "../package_deploy_setup.py",
      "product_capabilities": [
        "product.workflow.deploy.local",
        "product.workflow.deploy.container"
      ],
      "required_evidence": [
        "leia>=0.1.0",
        "gunicorn>=22.0",
        "console_scripts",
        "finrobot-translation-web"
      ],
      "provider_free": true,
      "live_network": false,
      "clean_skip": false
    },
    {
      "id": "requirements_extra_index",
      "deploy_surface": "requirements",
      "package_file": "../package_deploy_requirements.txt",
      "product_capabilities": [
        "product.workflow.deploy.local"
      ],
      "required_evidence": [
        "leia>=0.1.0",
        "[web]",
        "[all]"
      ],
      "provider_free": true,
      "live_network": false,
      "clean_skip": false
    },
    {
      "id": "run_web_app_env_health",
      "deploy_surface": "run_web_app",
      "package_file": "../package_deploy_run_web_app.py",
      "product_capabilities": [
        "product.workflow.deploy.local",
        "product.workflow.web.route"
      ],
      "required_evidence": [
        "def check_environment()",
        "LEIA_FINROBOT_DATA_DIR",
        "evaluation_harness/manifest.json",
        "OPENAI_API_KEY",
        "ThreadingHTTPServer",
        "PORT"
      ],
      "provider_free": true,
      "live_network": false,
      "clean_skip": false
    },
    {
      "id": "gcloud_deploy_gate",
      "deploy_surface": "cloud_deploy_script",
      "package_file": "../package_deploy_gcloud.sh",
      "product_capabilities": [
        "product.workflow.deploy.cloud"
      ],
      "required_evidence": [
        "gcloud run deploy",
        "package_deploy_Dockerfile",
        "LEIA_FINROBOT_DATA_DIR"
      ],
      "provider_free": true,
      "live_network": false,
      "clean_skip": true,
      "skip_reason": "Cloud deploy is metadata-gated by default; executing it requires an external package/operator capability outside provider-free tests."
    }
  ],
  "env_gates": [
    {
      "id": "data_dir_required",
      "env": "LEIA_FINROBOT_DATA_DIR",
      "required": true,
      "default": "./examples/ai/finrobot_translation",
      "package_manifest_check": "data_dir_exists",
      "run_web_app_check": "check_environment",
      "provider_free": true
    },
    {
      "id": "replay_manifest_required",
      "path": "evaluation_harness/manifest.json",
      "required": true,
      "package_manifest_check": "replay_manifest_present",
      "run_web_app_check": "REQUIRED_RELATIVE_FILES",
      "provider_free": true
    },
    {
      "id": "live_provider_keys_optional",
      "env": "OPENAI_API_KEY|FINNHUB_API_KEY|FMP_API_KEY",
      "required": false,
      "redact": true,
      "package_manifest_check": "live_provider_keys_optional",
      "clean_skip_when_absent": true,
      "provider_free": true
    }
  ],
  "server_metadata": {
    "recommended_server": "gunicorn",
    "recommended_dependency": "gunicorn>=22.0",
    "fallback_server": "ThreadingHTTPServer",
    "entrypoint": "package_deploy_run_web_app:main",
    "bind_env": "PORT",
    "default_port": "8080",
    "health_routes": [
      "/",
      "/healthz"
    ],
    "provider_free": true,
    "live_network_default": false
  },
  "static_assets": {
    "source": "../live_packages/product_workflow/templates/static_asset_manifest.json",
    "capability": "product.workflow.web.template_snapshot",
    "required_policy": {
      "external_fetch": false,
      "remote_fonts": false,
      "inline_only": true,
      "hash_algorithm": "sha256"
    },
    "provider_free": true,
    "live_network": false
  },
  "auth_session_gates": {
    "source": "../live_packages/product_workflow/contracts/product_workflow_contract.json#/auth_session",
    "capability": "product.workflow.auth.session",
    "mode": "fixture",
    "required_states": [
      "anonymous",
      "oauth_state_issued",
      "authenticated",
      "expired",
      "revoked"
    ],
    "required_denied_cases": [
      "missing_session",
      "disabled_user",
      "expired_oauth_state",
      "requires_admin"
    ],
    "provider_free": true,
    "live_network": false
  },
  "db_migration_gates": {
    "source": "../live_packages/product_workflow/contracts/db_migration_contract.json",
    "capability": "product.workflow.db.migration.plan",
    "migration_engine": "contract_only",
    "required_tables": [
      "users",
      "sessions",
      "report_requests",
      "reports",
      "artifacts",
      "task_events",
      "audit_events",
      "schema_versions",
      "schema_rollbacks"
    ],
    "rollback_required": true,
    "provider_free": true,
    "live_network": false
  },
  "clean_skips": [
    {
      "id": "missing_live_provider_keys",
      "condition": "OPENAI_API_KEY, FINNHUB_API_KEY, or FMP_API_KEY absent",
      "status": "clean_skip",
      "network_allowed": false
    },
    {
      "id": "cloud_deploy_without_external_capability",
      "condition": "product.workflow.deploy.cloud not granted by an external package",
      "status": "clean_skip",
      "network_allowed": false
    },
    {
      "id": "database_without_live_migration_engine",
      "condition": "db migration engine remains contract_only",
      "status": "clean_skip",
      "network_allowed": false
    }
  ],
  "no_network_default": {
    "package_manifest": true,
    "product_workflow_manifest": true,
    "deployment_capability_gates": true,
    "static_asset_manifest": true,
    "db_migration_contract": true
  }
}
