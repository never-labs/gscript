// reporting.leia - FinRobot reporting/chart/web boundary translation.
// Captures the Leia project shape for report sections -> chart specs ->
// HTML/PDF artifacts -> web-app orchestration without running a PDF engine or
// starting a server.

func check(name, ok) {
    if !ok {
        error("check failed: " .. name)
    }
}

report_request := {
    task_id: "task-demo-aapl",
    ticker: "AAPL",
    company_name: "Apple Inc.",
    years_limit: 5,
    peers: {"MSFT", "GOOGL", "META"},
    generate_text: true,
    generate_pdf: true,
    enable_enhanced_charts: true,
    enable_sensitivity_analysis: true,
    enable_catalyst_analysis: true,
    enable_enhanced_news: true,
}

section_catalog := {
    {id: "executive_summary", title: "Executive Summary", order: 1, required: true},
    {id: "company_overview", title: "Company Overview", order: 2, required: true},
    {id: "financial_analysis", title: "Financial Analysis", order: 3, required: true},
    {id: "valuation_analysis", title: "Valuation Analysis", order: 4, required: true},
    {id: "catalyst_analysis", title: "Catalyst Analysis", order: 5, required: false},
    {id: "risk_factors", title: "Risk Factors", order: 6, required: true},
    {id: "investment_recommendation", title: "Investment Recommendation", order: 7, required: true},
    {id: "appendix", title: "Appendix", order: 8, required: false},
}

func section_content(section) {
    return {
        id: section.id,
        title: section.title,
        order: section.order,
        required: section.required,
        content: section.title .. " content generated from staged equity-analysis inputs.",
        data_sources: {"financial_metrics_and_forecasts.csv", "ratios_raw_data.csv"},
        ai_generated: section.id != "appendix",
        charts: {},
    }
}

func build_sections(catalog) {
    sections := {}
    for i := 1; i <= #catalog; i++ {
        sections[i] = section_content(catalog[i])
    }
    return sections
}

chart_specs := {
    {
        id: "revenue_ebitda",
        title: "Revenue & EBITDA Trend",
        section_id: "financial_analysis",
        renderer: "chart.package.timeseries_combo",
        source_table: "financial_metrics_and_forecasts.csv",
        x: "fiscal_year",
        series: {"Revenue", "EBITDA"},
        output: "AAPL_revenue_ebitda.png",
    },
    {
        id: "eps_pe",
        title: "EPS x PE Trend Analysis",
        section_id: "valuation_analysis",
        renderer: "chart.package.dual_axis_line",
        source_table: "ratios_raw_data.csv",
        x: "fiscal_year",
        series: {"Diluted EPS", "PE Ratio"},
        output: "AAPL_eps_pe.png",
    },
    {
        id: "ev_ebitda_peer",
        title: "EV/EBITDA Peer Comparison",
        section_id: "valuation_analysis",
        renderer: "chart.package.peer_comparison",
        source_table: "peer_ev_ebitda_comparison.csv",
        x: "company",
        series: {"EV/EBITDA"},
        output: "AAPL_ev_ebitda_peer.png",
    },
    {
        id: "share_performance",
        title: "Share Performance vs S&P 500",
        section_id: "investment_recommendation",
        renderer: "chart.package.relative_return",
        source_table: "market_price_history",
        x: "date",
        series: {"AAPL", "^GSPC"},
        output: "AAPL_share_performance.png",
    },
}

func render_chart_spec(spec) {
    return {
        id: spec.id,
        title: spec.title,
        section_id: spec.section_id,
        renderer: spec.renderer,
        input: spec.source_table,
        output: spec.output,
        status: "specified",
    }
}

func attach_charts(sections, specs) {
    for i := 1; i <= #specs; i++ {
        rendered := render_chart_spec(specs[i])
        for j := 1; j <= #sections; j++ {
            if sections[j].id == rendered.section_id {
                sections[j].charts[#sections[j].charts + 1] = rendered
            }
        }
    }
    return sections
}

func validate_sections(sections) {
    missing := {}
    warnings := {}
    for i := 1; i <= #sections; i++ {
        section := sections[i]
        if section.required && section.content == "" {
            missing[#missing + 1] = section.id
        }
        if section.ai_generated && #section.data_sources == 0 {
            warnings[#warnings + 1] = section.id .. ":missing_data_source"
        }
    }
    return {
        valid: #missing == 0,
        missing: missing,
        warnings: warnings,
        section_count: #sections,
    }
}

func html_text(value) {
    return dialect.eval("html_escape", tostring(value))
}

func chart_img(chart) {
    return template {
        text: `<figure data-chart="{{.id}}"><img src="{{.src}}" alt="{{.title}}"><figcaption>{{.title}}</figcaption></figure>`,
        data: {
            id: html_text(chart.id),
            src: html_text(chart.output),
            title: html_text(chart.title),
        },
    }
}

func render_section_html(section) {
    charts_html := ""
    for i := 1; i <= #section.charts; i++ {
        charts_html = charts_html .. chart_img(section.charts[i])
    }
    return template {
        text: `<section id="{{.id}}" data-ai="{{.ai_generated}}"><h2>{{.title}}</h2><p>{{.content}}</p>{{.charts}}</section>`,
        data: {
            id: html_text(section.id),
            ai_generated: html_text(section.ai_generated),
            title: html_text(section.title),
            content: html_text(section.content),
            charts: charts_html,
        },
    }
}

func render_html_report(request, sections) {
    body := ""
    for i := 1; i <= #sections; i++ {
        body = body .. render_section_html(sections[i])
    }
    return template {
        text: `<!doctype html><html><head><title>{{.ticker}} Professional Equity Report</title></head><body><main>{{.body}}</main><footer>AI-assisted; source-backed; not investment advice.</footer></body></html>`,
        data: {
            ticker: html_text(request.ticker),
            body: body,
        },
    }
}

func plan_pdf_export(request, html_artifact) {
    return {
        engine: "document.package.pdf_export",
        input_html: html_artifact.path,
        output_pdf: request.ticker .. "_Professional_Equity_Report.pdf",
        status: "planned_not_rendered",
    }
}

func orchestrate_web_task(request) {
    analysis_dir := "output/" .. request.ticker .. "/analysis"
    report_dir := "output/" .. request.ticker .. "/report"
    sections := attach_charts(build_sections(section_catalog), chart_specs)
    validation := validate_sections(sections)
    html_report := render_html_report(request, sections)
    html_artifact := {
        kind: "html",
        path: report_dir .. "/" .. request.ticker .. "_Professional_Equity_Report.html",
        bytes: #html_report,
    }
    pdf_artifact := plan_pdf_export(request, html_artifact)
    return {
        task_id: request.task_id,
        status: "completed",
        stages: {
            {name: "financial_analysis", output_dir: analysis_dir},
            {name: "create_equity_report", output_dir: report_dir},
            {name: "generate_pdf_report", enabled: request.generate_pdf},
        },
        validation: validation,
        artifacts: {
            html: {html_artifact.path},
            pdf: {pdf_artifact.output_pdf},
            charts: chart_specs,
        },
        logs: {
            "Starting analysis pipeline...",
            "Created report sections and chart specs.",
            "Rendered HTML artifact boundary.",
            "Planned PDF artifact boundary.",
            "Pipeline completed successfully.",
        },
    }
}

sections := attach_charts(build_sections(section_catalog), chart_specs)
validation := validate_sections(sections)
html_report := render_html_report(report_request, sections)
task := orchestrate_web_task(report_request)

check("sections valid", validation.valid == true)
check("section count", validation.section_count == 8)
check("financial chart attached", #sections[3].charts == 1)
check("valuation charts attached", #sections[4].charts == 2)
check("html boundary includes charts", string.find(html_report, "data-chart=\"revenue_ebitda\"", 1, true) != nil)
check("pdf planned not rendered", task.artifacts.pdf[1] == "AAPL_Professional_Equity_Report.pdf")
check("web orchestration stages", #task.stages == 3)
check("web orchestration completed", task.status == "completed")

print("report_sections", validation.section_count)
print("chart_specs", #chart_specs)
print("html_artifact", task.artifacts.html[1])
print("pdf_artifact", task.artifacts.pdf[1])
print("web_task", task.task_id .. ":" .. task.status)
