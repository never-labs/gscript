// FinRobot AgentBuilder provider-free replay example.
//
// This models agent_builder_demo.py without importing AutoGen or calling a
// live model. The builder creates a dynamic roster, saves/loads its config,
// assigns tools by role, and replays a bounded GroupChat trace from fixtures.

agent_builder_replay_fixture := {
    source: "agent_builder_demo.py"
    provider_free: true
    live_network: false
    live_model: false
    credentials_required: false
    real_dependency_imports: false
    replay_key: "finrobot:agent_builder_demo:provider_free:2026-06-12"
    builder_spec: {
        id: "finrobot-agent-builder-demo"
        task: "Build a provider-free equity research team for ACME."
        max_round: 4
        roster_request: {"leader", "fundamental_analyst", "news_analyst", "risk_analyst"}
        roles: {
            {
                id: "leader"
                display_name: "Lead PM"
                role: "leader"
                metadata: {seniority: "lead" responsibility: "orchestrate group chat and final synthesis"}
                tools: {"assign_sections", "save_config"}
            }
            {
                id: "fundamental_analyst"
                display_name: "Fundamental Analyst"
                role: "member"
                metadata: {seniority: "member" responsibility: "financial statement review"}
                tools: {"fetch_fundamentals"}
            }
            {
                id: "news_analyst"
                display_name: "News Analyst"
                role: "member"
                metadata: {seniority: "member" responsibility: "news and catalyst review"}
                tools: {"fetch_news"}
            }
            {
                id: "risk_analyst"
                display_name: "Risk Analyst"
                role: "member"
                metadata: {seniority: "member" responsibility: "risk register review"}
                tools: {"fetch_risks"}
            }
        }
    }
    tool_replay: {
        fetch_fundamentals: {result: "ACME revenue +8%, gross margin 42%, net cash positive." evidence_id: "fundamentals:ACME:fixture"}
        fetch_news: {result: "Catalyst cluster: AI product cycle, services renewal, capital return." evidence_id: "news:ACME:fixture"}
        fetch_risks: {result: "Primary risks: demand volatility, regulation, supplier concentration." evidence_id: "risks:ACME:fixture"}
        assign_sections: {result: "Sections assigned to fundamental, news, and risk members." evidence_id: "builder:assignments:fixture"}
        save_config: {result: "Builder config serialized to local replay JSON." evidence_id: "builder:config:fixture"}
    }
}

func clone_tool_names(names) {
    out := {}
    for i := 1; i <= #names; i++ {
        out[#out + 1] = names[i]
    }
    return out
}

func build_agent_roster(builder_spec) {
    roster := {}
    for i := 1; i <= #builder_spec.roster_request; i++ {
        requested_id := builder_spec.roster_request[i]
        for j := 1; j <= #builder_spec.roles; j++ {
            role := builder_spec.roles[j]
            if role.id == requested_id {
                roster[#roster + 1] = {
                    id: role.id
                    display_name: role.display_name
                    role: role.role
                    metadata: role.metadata
                    tools: clone_tool_names(role.tools)
                    provider_free: true
                    live_model: false
                }
            }
        }
    }
    return roster
}

func save_builder_config(builder_spec, roster) {
    return json.encode({
        builder_id: builder_spec.id
        source: agent_builder_replay_fixture.source
        provider_free: true
        live_network: false
        live_model: false
        credentials_required: false
        real_dependency_imports: false
        groupchat: {max_round: builder_spec.max_round}
        agents: roster
        replay_key: agent_builder_replay_fixture.replay_key
    })
}

func load_builder_config(config_text) {
    loaded, err := json.decode(config_text)
    if err != nil {
        return nil, err
    }
    return loaded, nil
}

func has_tool(agent, tool_name) {
    for i := 1; i <= #agent.tools; i++ {
        if agent.tools[i] == tool_name {
            return true
        }
    }
    return false
}

func count_role(roster, role_name) {
    total := 0
    for i := 1; i <= #roster; i++ {
        if roster[i].role == role_name {
            total = total + 1
        }
    }
    return total
}

func find_tool_replay(tool_name) {
    return agent_builder_replay_fixture.tool_replay[tool_name]
}

assign_sections_tool := llm.tool("assign_sections", func(ticker) {
    return find_tool_replay("assign_sections")
}, {description: "Replay AgentBuilder section assignment." params: {"ticker"} requires: {"local.fixture.read"}})

save_config_tool := llm.tool("save_config", func(config_text) {
    saved := find_tool_replay("save_config")
    return {result: saved.result evidence_id: saved.evidence_id bytes: #config_text}
}, {description: "Replay AgentBuilder config save." params: {"config_text"} requires: {"local.fixture.read"}})

fetch_fundamentals_tool := llm.tool("fetch_fundamentals", func(ticker) {
    return find_tool_replay("fetch_fundamentals")
}, {description: "Replay local fundamentals fixture." params: {"ticker"} requires: {"local.fixture.read"}})

fetch_news_tool := llm.tool("fetch_news", func(ticker) {
    return find_tool_replay("fetch_news")
}, {description: "Replay local news fixture." params: {"ticker"} requires: {"local.fixture.read"}})

fetch_risks_tool := llm.tool("fetch_risks", func(ticker) {
    return find_tool_replay("fetch_risks")
}, {description: "Replay local risk fixture." params: {"ticker"} requires: {"local.fixture.read"}})

agent_builder_tools := {assign_sections_tool, save_config_tool, fetch_fundamentals_tool, fetch_news_tool, fetch_risks_tool}

func primary_tool_for_agent(agent) {
    if agent.role == "leader" {
        return "assign_sections"
    }
    return agent.tools[1]
}

func replay_groupchat(roster, max_round, ticker) {
    trace := {}
    for round := 1; round <= max_round; round++ {
        agent_index := ((round - 1) % #roster) + 1
        agent := roster[agent_index]
        tool_name := primary_tool_for_agent(agent)
        tool_result, err := llm.dispatch({id: "round-" .. tostring(round) tool: tool_name args: {ticker: ticker}}, agent_builder_tools)
        if err != nil {
            return nil, err
        }
        trace[#trace + 1] = {
            round: round
            agent_id: agent.id
            role: agent.role
            tool: tool_name
            evidence_id: tool_result.evidence_id
            result: tool_result.result
            provider_free: true
        }
    }
    return trace, nil
}

agent_builder_roster := build_agent_roster(agent_builder_replay_fixture.builder_spec)
agent_builder_saved_config := save_builder_config(agent_builder_replay_fixture.builder_spec, agent_builder_roster)
agent_builder_loaded_config, agent_builder_load_err := load_builder_config(agent_builder_saved_config)
agent_builder_config_save_event, agent_builder_save_err := llm.dispatch(
{id: "save-builder-config" tool: "save_config" args: {config_text: agent_builder_saved_config}},
agent_builder_tools
)
agent_builder_trace, agent_builder_trace_err := replay_groupchat(
agent_builder_roster,
agent_builder_loaded_config.groupchat.max_round,
"ACME"
)

agent_builder_leader_count := count_role(agent_builder_roster, "leader")
agent_builder_member_count := count_role(agent_builder_roster, "member")

assert(agent_builder_replay_fixture.provider_free == true)
assert(agent_builder_replay_fixture.live_network == false)
assert(agent_builder_replay_fixture.live_model == false)
assert(agent_builder_replay_fixture.credentials_required == false)
assert(agent_builder_replay_fixture.real_dependency_imports == false)
assert(#agent_builder_roster == 4)
assert(agent_builder_leader_count == 1)
assert(agent_builder_member_count == 3)
assert(agent_builder_roster[1].metadata.seniority == "lead")
assert(agent_builder_roster[2].metadata.seniority == "member")
assert(has_tool(agent_builder_roster[1], "save_config"))
assert(has_tool(agent_builder_roster[2], "fetch_fundamentals"))
assert(has_tool(agent_builder_roster[3], "fetch_news"))
assert(has_tool(agent_builder_roster[4], "fetch_risks"))
assert(agent_builder_load_err == nil)
assert(agent_builder_save_err == nil)
assert(agent_builder_trace_err == nil)
assert(agent_builder_loaded_config.builder_id == "finrobot-agent-builder-demo")
assert(agent_builder_loaded_config.groupchat.max_round == 4)
assert(#agent_builder_loaded_config.agents == 4)
assert(agent_builder_config_save_event.bytes > 100)
assert(#agent_builder_trace == agent_builder_loaded_config.groupchat.max_round)
assert(agent_builder_trace[1].role == "leader")
assert(agent_builder_trace[2].tool == "fetch_fundamentals")
assert(agent_builder_trace[3].tool == "fetch_news")
assert(agent_builder_trace[4].tool == "fetch_risks")
assert(agent_builder_trace[4].provider_free == true)

agent_builder_replay_summary := string.format(
"agent_builder_replay roster=%d leaders=%d members=%d max_round=%d trace=%d first_tool=%s saved_bytes=%d provider_free=%s live_network=%s",
#agent_builder_roster,
agent_builder_leader_count,
agent_builder_member_count,
agent_builder_loaded_config.groupchat.max_round,
#agent_builder_trace,
agent_builder_trace[1].tool,
agent_builder_config_save_event.bytes,
tostring(agent_builder_replay_fixture.provider_free),
tostring(agent_builder_replay_fixture.live_network)
)

print(agent_builder_replay_summary)
