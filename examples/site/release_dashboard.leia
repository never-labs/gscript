// release_dashboard.leia - Build a small static release dashboard.
// Demonstrates: html, markdown, mdtable, json, template, and hash.

print("=== Site: release dashboard ===")

release_notes := markdown`# Leia Checkout Release

This fixture models a static release dashboard generated from local data.

## Signals

- tests
- latency
- deploy
`

checks := [
    {Name: "unit", Status: "pass", Owner: "platform", DurationMs: "42"},
    {Name: "integration", Status: "pass", Owner: "qa", DurationMs: "88"},
    {Name: "load", Status: "pass", Owner: "performance", DurationMs: "236"},
]

check_rows := [checks[1], checks[2], checks[3]]
check_rows._headers = ["Name", "Status", "Owner", "DurationMs"]
check_table := dialect.eval("mdtable", check_rows, {mode: "encode"})

gate := {
    service: "checkout-api",
    release: "2026.06",
    ok: true,
    passed: #checks,
    title: release_notes.title,
}

data_json := dialect.eval("json", gate, {mode: "encode"})
fingerprint := string.sub(dialect.eval("hash", data_json .. check_table), 1, 12)
headline := template {
    text: "{{.service}} {{.release}} gate={{.ok}} fingerprint={{.fingerprint}}",
    data: {
        service: gate.service,
        release: gate.release,
        ok: gate.ok,
        fingerprint: fingerprint,
    },
}

page := html {
    tag: "main",
    attrs: {class: "release-dashboard", data_release: gate.release},
    children: [
        {tag: "h1", text: release_notes.title},
        {tag: "p", text: headline},
        {tag: "section", attrs: {class: "checks"}, children: [
            {tag: "h2", text: "Checks"},
            {tag: "pre", text: check_table},
        ]},
        {tag: "script", attrs: {type: "application/json", id: "release-data"}, text: data_json},
    ],
}

func contains(text, needle) {
    return string.find(text, needle, 1, true) != nil
}

print(headline)
print(page)

assert(release_notes.title == "Leia Checkout Release")
assert(release_notes.list_items == 3)
assert(contains(check_table, "| Name | Status | Owner | DurationMs |"))
assert(contains(check_table, "| unit | pass | platform | 42 |"))
assert(contains(data_json, "\"service\":\"checkout-api\""))
assert(contains(headline, "fingerprint=" .. fingerprint))
assert(contains(page, "<main class=\"release-dashboard\" data_release=\"2026.06\">"))
assert(contains(page, "<h1>Leia Checkout Release</h1>"))
assert(contains(page, "<pre>| Name | Status | Owner | DurationMs |"))
assert(contains(page, "&#34;ok&#34;:true"))
assert(fingerprint == string.sub(dialect.eval("hash", data_json .. check_table), 1, 12))

print("release dashboard ok")
