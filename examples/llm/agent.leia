// Minimal LLM stdlib agent sample.
//
// This file demonstrates the table/function-shaped LLM surface:
// model registration, llm.agent_defaults, tool descriptors, reusable agents,
// message tables, turns, and budget wrappers. Running it requires the LLM
// stdlib with a host/provider configuration.

llm.register_models({
    default: "demo"
    demo: {
        provider_model: "mock-demo"
    }
})

// lookup searches local documentation.
lookup := llm.tool("lookup", func(query) {
    return "doc:" .. query, nil
}, {
    params: ["query"]
    requires: ["docs.read"]
    param_docs: {query: "natural-language search query"}
})

llm.agent_defaults({
    model: "demo"
    tools: [lookup]
    budget: {turns: 4, calls: 4, tokens: 2000, time: 30}
})

answer := llm.agent("answer", func(question) {
    return {
        messages: [
            llm.system("Use local documentation when useful."),
            llm.user(question),
        ]
        tools: [lookup]
    }
}, nil, {params: ["question"]})

func review_config(question) {
    return {
        messages: [
            llm.system("Return a short answer."),
            llm.user(question),
        ]
    }
}

review := llm.agent("review", review_config, func(question) {
    cfg := review_config(question)
    result, err := llm.turn(cfg)
    return result, err
}, {params: ["question"]})

llm.with_budget({turns: 2}, func() {
    result, err := answer("What is Leia?")
    if err != nil {
        print(err.message)
        return
    }
    print(result.text)
})
