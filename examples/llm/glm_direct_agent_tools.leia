// Real GLM direct agent-as-tool demo.
//
// This mirrors the local glm_cc wrapper's environment shape without invoking it:
//   endpoint: LEIA_GLM_BASE_URL, default https://open.bigmodel.cn/api/anthropic
//   key:      LEIA_GLM_API_KEY, SENTINEL_GLM_API_KEY, or GLM_API_KEY
//   model:    LEIA_GLM_MODEL or GLM_MODEL, default glm-5.1
//
// Run without committing tokens:
//   LEIA_LLM_INTEGRATION=1 LEIA_GLM_API_KEY=... leia run examples/llm/glm_direct_agent_tools.leia

func env_first(a, b, c, fallback) {
    v := os.getenv(a)
    if v != nil && v != "" {
        return v
    }
    v = os.getenv(b)
    if v != nil && v != "" {
        return v
    }
    v = os.getenv(c)
    if v != nil && v != "" {
        return v
    }
    return fallback
}

llm.register_models({
    default: "glm-smoke",
    ["glm-smoke"]: {
        provider: "glm"
        protocol: "anthropic_compatible"
        base_url: env_first("LEIA_GLM_BASE_URL", "ANTHROPIC_BASE_URL", "", "https://open.bigmodel.cn/api/anthropic")
        api_key: env_first("LEIA_GLM_API_KEY", "SENTINEL_GLM_API_KEY", "GLM_API_KEY", "")
        provider_model: env_first("LEIA_GLM_MODEL", "GLM_MODEL", "ANTHROPIC_MODEL", "glm-5.1")
    }
})

glm_api_key := env_first("LEIA_GLM_API_KEY", "SENTINEL_GLM_API_KEY", "GLM_API_KEY", "")
if os.getenv("LEIA_LLM_INTEGRATION") != "1" {
    print("set LEIA_LLM_INTEGRATION=1 to run this real GLM example")
    return
}
if glm_api_key == nil || glm_api_key == "" {
    print("set LEIA_GLM_API_KEY, SENTINEL_GLM_API_KEY, or GLM_API_KEY to run this GLM example")
    return
}

func extract_memory_config(note) {
    return {
        model: "glm-smoke"
        output: {
            project: "ORCHID"
            owner: "ADA"
            remembered: true
            source: "direct-agent-tool"
        }
    }
}

extract_memory := llm.agent("extract_memory", extract_memory_config, func(note) {
    lower := string.lower(note)
    if string.find(lower, "orchid") == nil || string.find(lower, "ada") == nil {
        return nil, {kind: "validation", message: "memory note missing ORCHID or ADA"}
    }
    return {
        project: "ORCHID"
        owner: "ADA"
        remembered: true
        source: "direct-agent-tool"
    }, nil
}, {
    params: {"note"}
    output: {project: "ORCHID", owner: "ADA", remembered: true, source: "direct-agent-tool"}
})

supervisor := llm.agent("supervisor", func(question) {
    return {
        model: "glm-smoke"
        messages: {
            llm.system("You are testing tool use. You must call extract_memory exactly once before answering. After the tool result, answer in one short sentence that includes DIRECT_AGENT_TOOL_OK."),
            llm.user(question),
        }
        tools: {extract_memory}
        max_steps: 4
        max_tokens: 128
        temperature: 0
    }
}, nil, {params: {"question"}})

result, err := supervisor("Use the extract_memory tool with this note: project codename is ORCHID and owner is ADA. Do not answer from memory; call the tool first.")
if err != nil {
    print(err.message)
    return
}

print("text=" .. result.text)
print("history_len=" .. tostring(#result.history))
print("roles=" .. result.history[1].role .. "/" .. result.history[2].role .. "/" .. result.history[3].role .. "/" .. result.history[4].role)
print("tool=" .. result.history[3].tool_call.tool)
print("project=" .. result.history[4].value.project)
print("owner=" .. result.history[4].value.owner)
print("source=" .. result.history[4].value.source)
