// Manual tool-history handoff demo.
//
// This example is intended for host tests with a mock or replay provider. It
// demonstrates the custom-flow shape behind the built-in agent loop: a turn may
// return tool calls, but the flow must dispatch them and append tool evidence to
// the history before making the next turn.

lookup_doc := llm.tool("lookup_doc", func(topic) {
    return "doc:" .. topic, nil
}, {
    params: ["topic"]
    requires: ["docs.read"]
    param_docs: {topic: "documentation topic"}
})

func manual_research_config(topic) {
    return {
        model: "mock-manual"
        messages: [
            llm.system("Use tool evidence before answering."),
            llm.user("Find docs for " .. topic),
        ]
        tools: [lookup_doc]
        budget: {turns: 2, calls: 1, tokens: 512}
    }
}

manual_research := llm.agent("manual_research", manual_research_config, func(topic) {
    cfg := manual_research_config(topic)
    history := cfg.messages

    first, first_err := llm.turn({
        model: cfg.model
        messages: history
        tools: cfg.tools
    })
    if first_err != nil {
        return nil, first_err
    }

    if first.status != "tool_calls" {
        return first, nil
    }

    call := first.calls[1]
    evidence, dispatch_err := llm.dispatch(call, cfg.tools)
    if dispatch_err != nil {
        append(history, msg.assistant_call(call))
        append(history, msg.tool_error(call.id, dispatch_err.message))
    } else {
        append(history, msg.assistant_call(call))
        append(history, msg.tool_result(call.id, evidence))
    }

    final, final_err := llm.turn({
        model: cfg.model
        messages: history
        tools: cfg.tools
        max_tokens: 128
    })
    return {
        first_status: first.status,
        text: final.text,
        evidence: evidence,
        history_len: #history
    }, final_err
}, {params: ["topic"]})

manual, manual_err := manual_research("agent history")
if manual_err != nil {
    print(manual_err.message)
    return
}
manual_text := manual.text
manual_evidence := manual.evidence
manual_history_len := manual.history_len

print("manual", manual_text)
print("evidence", manual_evidence)
print("history", manual_history_len)
