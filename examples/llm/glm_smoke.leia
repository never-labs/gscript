// Real GLM LLM multi-turn memory smoke demo.
//
// This mirrors the local glm_cc wrapper's configuration without invoking it:
//   endpoint: LEIA_GLM_BASE_URL, default https://open.bigmodel.cn/api/anthropic
//   key:      LEIA_GLM_API_KEY, SENTINEL_GLM_API_KEY, or GLM_API_KEY
//   model:    LEIA_GLM_MODEL or GLM_MODEL, default glm-5.1
//
// Run without committing tokens:
//   LEIA_GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic \
//   LEIA_GLM_API_KEY=... \
//   LEIA_GLM_MODEL=glm-5.1 \
//   LEIA_LLM_INTEGRATION=1 \
//   leia run examples/llm/glm_smoke.leia

func env_first(a, b, c, fallback) {
    v := os.getenv(a)
    if v != nil && v != "" {
        return v
    }
    v = os.getenv(b)
    if v != nil && v != "" {
        return v
    }
    v = os.getenv(c)
    if v != nil && v != "" {
        return v
    }
    return fallback
}

llm.register_models({
    default: "glm-smoke",
    ["glm-smoke"]: {
        provider: "glm"
        protocol: "anthropic_compatible"
        base_url: env_first("LEIA_GLM_BASE_URL", "ANTHROPIC_BASE_URL", "", "https://open.bigmodel.cn/api/anthropic")
        api_key: env_first("LEIA_GLM_API_KEY", "SENTINEL_GLM_API_KEY", "GLM_API_KEY", "")
        provider_model: env_first("LEIA_GLM_MODEL", "GLM_MODEL", "ANTHROPIC_MODEL", "glm-5.1")
    }
})

glm_api_key := env_first("LEIA_GLM_API_KEY", "SENTINEL_GLM_API_KEY", "GLM_API_KEY", "")
if os.getenv("LEIA_LLM_INTEGRATION") != "1" {
    print("set LEIA_LLM_INTEGRATION=1 to run this real GLM smoke example")
    return
}
if glm_api_key == nil || glm_api_key == "" {
    print("set LEIA_GLM_API_KEY, SENTINEL_GLM_API_KEY, or GLM_API_KEY to run this GLM smoke example")
    return
}

history := {
    llm.system("You are a deterministic memory smoke-test assistant. Follow exact reply instructions. Keep answers short."),
    llm.user("Store this memory: project codename is ORCHID and owner is ADA. Reply exactly: MEMORY_STORED"),
}

stored, err := llm.turn({
    messages: history
    max_tokens: 32
    temperature: 0
})
if err != nil {
    print(err.message)
    return
}

history[#history + 1] = msg.assistant(stored.text)
history[#history + 1] = msg.user("Using only the stored memory, reply exactly: project=ORCHID;owner=ADA")

recalled, err := llm.turn({
    messages: history
    max_tokens: 48
    temperature: 0
})
if err != nil {
    print(err.message)
    return
}

history[#history + 1] = msg.assistant(recalled.text)

extractor := llm.agent("extractor", func(summary) {
    return {
        model: "glm-smoke"
        messages: {
            llm.system("Return only compact JSON with exactly these keys: project, owner, remembered, meta. meta must be an object with source. Do not include Markdown."),
            llm.user("Convert this memory recall into JSON. Use project=\"ORCHID\", owner=\"ADA\", remembered=true, meta.source=\"history\" when the recall says project=ORCHID;owner=ADA. Recall: " .. summary),
        }
        output: {
            project: "ORCHID"
            owner: "ADA"
            remembered: true
            meta: {
                source: "history"
            }
        }
        max_tokens: 96
        temperature: 0
    }
}, nil, {
    params: {"summary"}
    output: {project: "ORCHID", owner: "ADA", remembered: true, meta: {source: "history"}}
})

extracted, err := extractor(recalled.text)
if err != nil {
    print(err.message)
    return
}

print("stored=" .. stored.text)
print("recalled=" .. recalled.text)
print("project=" .. extracted.value.project)
print("owner=" .. extracted.value.owner)
print("remembered=" .. tostring(extracted.value.remembered))
print("source=" .. extracted.value.meta.source)
