// Built-in SQLite ledger analytics example.
//leia:cap db.open,db.exec,db.query,db.one

conn := db.memory()

conn.exec(sql`create table accounts (
    id integer primary key,
    code text not null unique,
    name text not null,
    kind text not null
)`)
conn.exec(sql`create table ledger_entries (
    id integer primary key,
    account_id integer not null,
    posted_on text not null,
    project text not null,
    amount_cents integer not null,
    memo text not null,
    cleared bool not null,
    foreign key (account_id) references accounts(id)
)`)

accounts := [
    {id: 1, code: "cash", name: "Operating Cash", kind: "asset"},
    {id: 2, code: "ar", name: "Accounts Receivable", kind: "asset"},
    {id: 3, code: "rev", name: "Product Revenue", kind: "income"},
    {id: 4, code: "ops", name: "Operations Expense", kind: "expense"},
    {id: 5, code: "refund", name: "Customer Refunds", kind: "contra_income"},
]

for i := 1; i <= #accounts; i++ {
    conn.exec(sql {
        query: "insert into accounts (id, code, name, kind) values (:id, :code, :name, :kind)",
        params: accounts[i],
    })
}

entries := [
    {id: 1, account_id: 1, posted_on: "2026-06-01", project: "alpha", amount_cents: 125000, memo: "Acme payment", cleared: true},
    {id: 2, account_id: 3, posted_on: "2026-06-01", project: "alpha", amount_cents: 125000, memo: "Acme invoice", cleared: true},
    {id: 3, account_id: 4, posted_on: "2026-06-02", project: "platform", amount_cents: -18000, memo: "hosting", cleared: true},
    {id: 4, account_id: 5, posted_on: "2026-06-02", project: "beta", amount_cents: -6000, memo: "service credit", cleared: true},
    {id: 5, account_id: 1, posted_on: "2026-06-03", project: "beta", amount_cents: 82000, memo: "Beta payment", cleared: false},
    {id: 6, account_id: 3, posted_on: "2026-06-03", project: "beta", amount_cents: 82000, memo: "Beta invoice", cleared: false},
    {id: 7, account_id: 4, posted_on: "2026-06-04", project: "alpha", amount_cents: -21000, memo: "contractor", cleared: true},
    {id: 8, account_id: 2, posted_on: "2026-06-04", project: "gamma", amount_cents: 44000, memo: "Gamma invoice", cleared: false},
    {id: 9, account_id: 3, posted_on: "2026-06-04", project: "gamma", amount_cents: 44000, memo: "Gamma revenue", cleared: false},
    {id: 10, account_id: 4, posted_on: "2026-06-05", project: "gamma", amount_cents: -9500, memo: "team tools", cleared: true},
]

for i := 1; i <= #entries; i++ {
    conn.exec(sql {
        query: "insert into ledger_entries (id, account_id, posted_on, project, amount_cents, memo, cleared) values (:id, :account_id, :posted_on, :project, :amount_cents, :memo, :cleared)",
        params: entries[i],
    })
}

account_rollup := conn.query(sql`select
    a.code,
    a.name,
    a.kind,
    count(e.id) as entry_count,
    sum(e.amount_cents) as total_cents
from accounts a
join ledger_entries e on e.account_id = a.id
group by a.id, a.code, a.name, a.kind
order by total_cents desc`)

project_report := conn.query(sql`select
    project,
    count(*) as entry_count,
    sum(case when amount_cents > 0 then amount_cents else 0 end) as inflow_cents,
    sum(case when amount_cents < 0 then -amount_cents else 0 end) as outflow_cents,
    sum(amount_cents) as net_cents
from ledger_entries
group by project
order by net_cents desc`)

uncleared := conn.query(sql {
    query: "select id, project, memo, amount_cents from ledger_entries where cleared = :cleared order by id",
    params: {cleared: false},
})

top_account := conn.one(sql {
    query: "select a.code, sum(e.amount_cents) as total_cents from accounts a join ledger_entries e on e.account_id = a.id group by a.id, a.code order by total_cents desc limit 1",
    params: {},
})

duplicate_account, duplicate_account_err := conn.exec(sql {
    query: "insert into accounts (id, code, name, kind) values (:id, :code, :name, :kind)",
    params: {id: 99, code: "cash", name: "Duplicate Cash", kind: "asset"},
})

error_branch := "ok"
if duplicate_account == nil && duplicate_account_err != nil {
    error_branch = "constraint"
}

top_project := project_report[1]
database_summary := string.format(
"ledger accounts=%d entries=%d top_account=%s top_total=%.2f top_project=%s net=%.2f uncleared=%d error=%s",
#account_rollup,
#entries,
top_account.code,
top_account.total_cents / 100,
top_project.project,
top_project.net_cents / 100,
#uncleared,
error_branch
)

print(database_summary)

return {
    connection: conn,
    account_rollup: account_rollup,
    project_report: project_report,
    uncleared: uncleared,
    top_account: top_account,
    duplicate_account_err: duplicate_account_err,
    summary: database_summary,
}
