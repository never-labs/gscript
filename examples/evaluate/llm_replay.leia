func summarize_with_replay() {
    return llm.turn({
        model: "mock-fast",
        messages: [llm.user("Summarize Leia replay checks in five words.")],
    })
}

evaluate "llm turn consumes replay" {
    result, err := summarize_with_replay()
    assert(err == nil)
    assert(result.text == "Deterministic agent checks with replay.")
}
