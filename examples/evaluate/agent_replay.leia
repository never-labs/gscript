agent classify_support(message) {
    model: "mock-fast"
    system: "Classify support message. Return refund, shipping, or other."
    user: message
}

evaluate "agent classifies refund request with replay" {
    result, err := classify_support("Customer asks for a refund after a damaged delivery.")
    assert(err == nil)
    assert(result.text == "refund")
}
