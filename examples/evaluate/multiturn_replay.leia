func run_multiturn_replay() {
    history := {
        llm.system("Plan and then summarize Leia replay work."),
        llm.user("Create a short implementation plan for replay checks."),
    }

    plan, err := llm.turn({
        model: "mock-fast",
        messages: history,
    })
    assert(err == nil)
    assert(plan.text == "1. Write ordinary checks. 2. Replay LLM turns.")

    history[#history + 1] = msg.assistant(plan.text)
    history[#history + 1] = msg.user("Condense the plan into a release note.")

    note, err := llm.turn({
        model: "mock-fast",
        messages: history,
    })
    assert(err == nil)
    assert(note.text == "Leia checks now support deterministic replay.")
}

evaluate "multiturn replay consumes every turn" {
    run_multiturn_replay()
}
