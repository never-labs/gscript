// config_template_manifest.leia - Build a deployment manifest from config dialects.
// Demonstrates: env, ini, csv, template, headers, urlquery, and JSON encoding.

print("=== Dialects: config template manifest ===")

env_cfg := env`APP_NAME=ledger-api
APP_ENV=staging
APP_PORT=8080
`

feature_cfg := ini`region=us-east-1
release=2026.06

[feature]
canary=true
`

owners := dialect.eval("csv", "team,email\nplatform,platform@example.test\nsecurity,security@example.test\n", {headers: true})

query := urlquery {
    service: env_cfg.APP_NAME,
    env: env_cfg.APP_ENV,
    release: feature_cfg.release,
}

request_headers := headers {
    "content-type": "application/json",
    "x-service": env_cfg.APP_NAME,
    "x-release": feature_cfg.release,
}

manifest_text := template {
    text: "service={{.service}}\nenv={{.env}}\nregion={{.region}}\nowner={{.owner}}\n",
    data: {
        service: env_cfg.APP_NAME,
        env: env_cfg.APP_ENV,
        region: feature_cfg.region,
        owner: owners[1].email,
    },
}

manifest := {
    service: env_cfg.APP_NAME,
    env: env_cfg.APP_ENV,
    port: tonumber(env_cfg.APP_PORT),
    region: feature_cfg.region,
    release: feature_cfg.release,
    canary: feature_cfg.feature.canary == "true",
    owner: owners[1].email,
    audit_query: query,
}

encoded := dialect.eval("json", manifest, {mode: "encode"})

print(manifest_text)
print("query:", query)
print("headers:")
print(request_headers)
print(encoded)

assert(env_cfg.APP_NAME == "ledger-api")
assert(feature_cfg.region == "us-east-1")
assert(feature_cfg.feature.canary == "true")
assert(owners[2].team == "security")
assert(query == "env=staging&release=2026.06&service=ledger-api")
assert(request_headers == "Content-Type: application/json\r\nX-Release: 2026.06\r\nX-Service: ledger-api\r\n")
assert(manifest_text == "service=ledger-api\nenv=staging\nregion=us-east-1\nowner=platform@example.test\n")
assert(encoded == "{\"audit_query\":\"env=staging\\u0026release=2026.06\\u0026service=ledger-api\",\"canary\":true,\"env\":\"staging\",\"owner\":\"platform@example.test\",\"port\":8080,\"region\":\"us-east-1\",\"release\":\"2026.06\",\"service\":\"ledger-api\"}")

print("config template manifest ok")
