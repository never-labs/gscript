print("=== Dialects: binary protocol fixture ===")

frame := dialect.eval("binary", {258, "OK"}, {mode: "pack", format: "be:u16 bytes:2"})
frame_hex := dialect.eval("hex", frame)
decoded := dialect.eval("binary", frame, {mode: "unpack", format: "be:u16 bytes:2"})
frame_size := dialect.eval("binary", "", {mode: "size", format: "be:u16 bytes:2"})

little_frame := dialect.eval("binary", {-1234, 16909060, 1.5, "OK"}, {mode: "pack", format: "le:i16 u32 f32 bytes:2"})
little_hex := dialect.eval("hex", little_frame)
little_decoded := dialect.eval("binary", little_frame, {mode: "unpack", format: "le:i16 u32 f32 bytes:2"})
little_size := dialect.eval("binary", "", {mode: "size", format: "le:i16 u32 f32 bytes:2"})

print("frame hex:", frame_hex)
print("decoded:", decoded.values[1], decoded.values[2], "next", decoded.next)
print("little hex:", little_hex)
print("little decoded:", little_decoded.values[1], little_decoded.values[2], little_decoded.values[3], little_decoded.values[4])

assert(frame_hex == "01024f4b")
assert(decoded.values[1] == 258)
assert(decoded.values[2] == "OK")
assert(decoded.next == 5)
assert(frame_size == 4)
assert(little_hex == "2efb040302010000c03f4f4b")
assert(little_decoded.values[1] == -1234)
assert(little_decoded.values[2] == 16909060)
assert(little_decoded.values[3] == 1.5)
assert(little_decoded.values[4] == "OK")
assert(little_decoded.next == 13)
assert(little_size == 12)

print("binary protocol fixture ok")
