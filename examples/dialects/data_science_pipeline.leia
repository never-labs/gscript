// data_science_pipeline.leia - Small numeric data pipeline with existing stdlib.
// Demonstrates: nums dialect input, dense matrix feature view, SoA columns,
// simple scoring, aggregate metrics, and formatted output.

print("=== Dialects: data science pipeline ===")

feature_rows := dialect.eval("nums", `
1.0, 0.8, 3.0
2.0, 1.6, 2.0
3.0, 2.4, 1.0
4.0, 3.2, 0.0
`, {matrix: true})

targets := nums`3.04 3.98 4.92 5.86`
targets_alias := dialect.eval("numbers", "3.04 3.98 4.92 5.86")

func dense_matrix_from_rows(rows) {
    if #rows == 0 {
        return matrix.dense(0, 0)
    }
    width := #rows[1]
    for i := 1; i <= #rows; i++ {
        if #rows[i] != width {
            error("non-rectangular matrix rows")
        }
    }
    m := matrix.dense(#rows, width)
    for i := 1; i <= #rows; i++ {
        row := rows[i]
        for j := 1; j <= #row; j++ {
            matrix.setf(m, i - 1, j - 1, row[j])
        }
    }
    return m
}

func numeric_column(rows, column) {
    out := {}
    for i := 1; i <= #rows; i++ {
        out[i] = rows[i][column]
    }
    return array.f64(out)
}

func number_or(value, fallback) {
    parsed := tonumber(value)
    if parsed == nil {
        return fallback
    }
    return parsed
}

func ids(n) {
    out := {}
    for i := 1; i <= n; i++ {
        out[i] = i
    }
    return array.i64(out)
}

func zeroes(n) {
    out := {}
    for i := 1; i <= n; i++ {
        out[i] = 0.0
    }
    return array.f64(out)
}

features := dense_matrix_from_rows(feature_rows)

samples := soa.zip({
    id: ids(#feature_rows),
    x1: numeric_column(feature_rows, 1),
    x2: numeric_column(feature_rows, 2),
    x3: numeric_column(feature_rows, 3),
    target: array.f64(targets),
    prediction: zeroes(#feature_rows),
    error: zeroes(#feature_rows),
})

weights := {1.1, 0.3, 0.4}
bias := 0.5
for i := 1; i <= soa.len(samples); i++ {
    score := bias
    for j := 1; j <= #weights; j++ {
        score = score + matrix.getf(features, i - 1, j - 1) * weights[j]
    }
    row := samples[i]
    row.prediction = score
    row.error = score - row.target
    samples[i] = row
}

positive_error := soa.mask(samples, "error", ">", 0.0000001)
error_stats := soa.stats(samples, "error")
mean_prediction := soa.mean(samples, "prediction")
positive_count := soa.countWhere(samples, positive_error)
score_energy := soa.dot(samples, "prediction", "prediction")

empty_features := dense_matrix_from_rows({})
empty_samples := soa.zip({id: array.i64({})})
missing_rows := dialect.eval("csv", "id,x1,x2\n1,2.5,\n2,,4.5\n", {headers: true})
imputed_x1 := number_or(missing_rows[2].x1, 0)
imputed_x2 := number_or(missing_rows[1].x2, -1)
jsonl_samples := jsonl`{"id":1,"x":1.5,"y":2.0}
{"id":2,"x":2.5,"y":4.0}
{"id":3,"x":3.5,"y":6.0}
`
jsonl_x_values := {}
jsonl_y_values := {}
for i := 1; i <= #jsonl_samples; i++ {
    jsonl_x_values[i] = jsonl_samples[i].x
    jsonl_y_values[i] = jsonl_samples[i].y
}
jsonl_columns := soa.zip({
    id: ids(#jsonl_samples),
    x: array.f64(jsonl_x_values),
    y: array.f64(jsonl_y_values),
})
jsonl_x_mean := soa.mean(jsonl_columns, "x")
jsonl_xy_dot := soa.dot(jsonl_columns, "x", "y")

bad_matrix, bad_matrix_err := dialect.eval("nums", "1 2\n3\n", {matrix: true})
bad_nums, bad_nums_err := dialect.eval("nums", "1 nope 3")
ok, convert_err := pcall(array.f64, {1, "bad"})
ok_rect, rect_err := pcall(dense_matrix_from_rows, {{1, 2}, {3}})

print(string.format("rows: %d columns: %d", soa.len(samples), #feature_rows[1]))
print(string.format("prediction mean: %.3f", mean_prediction))
print(string.format("error mean/min/max: %.3f %.3f %.3f", error_stats.mean, error_stats.min, error_stats.max))
print(string.format("positive errors: %d", positive_count))
print(string.format("prediction energy: %.3f", score_energy))

assert(soa.len(samples) == 4)
assert(#targets_alias == #targets)
assert(targets_alias[4] == targets[4])
assert(matrix.getf(features, 3, 2) == 0)
assert(soa.column(samples, "prediction")[1] == 3.04)
assert(error_stats.mean < 0.000001 && error_stats.mean > -0.000001)
assert(error_stats.min < 0.000001 && error_stats.min > -0.000001)
assert(error_stats.max < 0.000001 && error_stats.max > -0.000001)
assert(positive_count == 0)
assert(soa.len(empty_samples) == 0)
assert(pcall(matrix.getf, empty_features, 0, 0) == false)
assert(imputed_x1 == 0)
assert(imputed_x2 == -1)
assert(soa.len(jsonl_columns) == 3)
assert(jsonl_x_mean == 2.5)
assert(jsonl_xy_dot == 34)
assert(bad_matrix == nil)
assert(string.find(bad_matrix_err, "matrix row 2", 1, true) != nil)
assert(bad_nums == nil)
assert(string.find(bad_nums_err, "invalid number", 1, true) != nil)
assert(ok == false)
assert(string.find(convert_err, "dense array f64 value must be numeric", 1, true) != nil)
assert(ok_rect == false)
assert(string.find(rect_err, "non-rectangular matrix rows", 1, true) != nil)

print("data science pipeline ok")
