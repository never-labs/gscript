print("=== Dialects: network protocols ===")

client := ipaddr`10.2.3.4`
office := cidr`10.2.0.7/16`
inside := dialect.eval("cidr", office.cidr, {ip: client.ip})
outside := dialect.eval("ipaddr", "10.3.3.4", {cidr: office.cidr})
v6_office := cidr`2001:db8::/32`
v6_inside := dialect.eval("cidr", v6_office.cidr, {ip: "2001:db8::42"})
v6_outside := dialect.eval("cidr", v6_office.cidr, {ip: "2001:db9::1"})
any_v4 := dialect.eval("cidr", "0.0.0.0/0", {ip: "203.0.113.9"})
single_host := dialect.eval("cidr", "192.168.1.7/32", {ip: "192.168.1.7"})
single_host_miss := dialect.eval("cidr", "192.168.1.7/32", {ip: "192.168.1.8"})
any_v6 := dialect.eval("cidr", "::/0", {ip: "2001:db8::1"})
single_v6 := dialect.eval("cidr", "2001:db8::1/128", {ip: "2001:db8::1"})
single_v6_miss := dialect.eval("cidr", "2001:db8::1/128", {ip: "2001:db8::2"})
link_local := ipaddr`fe80::1%eth0`
listener := hostport`[2001:db8::1]:443`
link_listener := hostport`[fe80::1%lo0]:8080`
joined := dialect.eval("hostport", {host: listener.host, port: listener.port}, {mode: "encode"})
decoded := dialect.eval("hostport", "example.com:8443", {mode: "decode"})
join_alias := dialect.eval("hostport", {host: decoded.host, port: decoded.port}, {mode: "join"})
bad_ip, bad_ip_err := dialect.eval("ipaddr", "not-an-ip")
bad_cidr, bad_cidr_err := dialect.eval("cidr", "10.2.0.0")
bad_mode, bad_mode_err := dialect.eval("hostport", "example.com:8443", {mode: "bogus"})
missing_host, missing_host_err := dialect.eval("hostport", {port: "443"}, {mode: "encode"})
missing_port, missing_port_err := dialect.eval("hostport", {host: "example.com"}, {mode: "encode"})

print("client:", client.ip, "v", client.version, "private", client.private)
print("office:", office.masked, "bits", office.bits)
print("contains:", inside.contains, outside.contains)
print("v6 contains:", v6_inside.contains, v6_outside.contains)
print("link local:", link_local.ip, link_local.zone, link_local.link_local_unicast)
print("listener:", listener.host, listener.port, joined, join_alias)

assert(client.version == 4)
assert(client.private)
assert(office.masked == "10.2.0.0/16")
assert(inside.contains)
assert(!outside.contains)
assert(v6_office.version == 6)
assert(v6_inside.contains)
assert(!v6_outside.contains)
assert(any_v4.contains)
assert(single_host.contains)
assert(!single_host_miss.contains)
assert(any_v6.contains)
assert(single_v6.contains)
assert(!single_v6_miss.contains)
assert(link_local.zone == "eth0")
assert(link_local.link_local_unicast)
assert(listener.host == "2001:db8::1")
assert(listener.port == "443")
assert(link_listener.host == "fe80::1%lo0")
assert(link_listener.addr.zone == "lo0")
assert(joined == "[2001:db8::1]:443")
assert(decoded.host == "example.com")
assert(decoded.port == "8443")
assert(join_alias == "example.com:8443")
assert(bad_ip == nil && bad_ip_err != nil)
assert(bad_cidr == nil && bad_cidr_err != nil)
assert(bad_mode == nil && bad_mode_err != nil)
assert(missing_host == nil && missing_host_err != nil)
assert(missing_port == nil && missing_port_err != nil)

print("network protocol dialects ok")
