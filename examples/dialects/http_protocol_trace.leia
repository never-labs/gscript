// http_protocol_trace.leia - Inspect an HTTP exchange without network access.
// Demonstrates: httpmsg, url, cookie, mime, urlquery, html_escape, hash, and JSONL logs.

print("=== Dialects: HTTP protocol trace ===")

request := httpmsg`GET /v1/search?q=leia+dialects&debug=true HTTP/1.1
host: api.example.test:9443
accept: application/json
cache-control: max-age=60
cookie: session=s-123; cohort=beta
x-trace-id: req-42

`
request_again := dialect.eval("httpmsg", "GET /v1/search?q=leia+dialects&debug=true HTTP/1.1\r\nhost: api.example.test:9443\r\naccept: application/json\r\ncache-control: max-age=60\r\ncookie: session=s-123; cohort=beta\r\nx-trace-id: req-42\r\n\r\n", {mode: "parse"})
request_url := url`https://api.example.test:9443/v1/search?q=leia+dialects&debug=true`
request_headers := request.headers
request_cookies := dialect.eval("cookie", request_headers.Cookie)

response_type := mime`application/json; charset=utf-8`
cache_control := kv`max-age=60
stale-while-revalidate=30
`
etag_payload := request_url.path .. "?" .. urlquery {q: request_url.query.q, debug: request_url.query.debug}
etag := dialect.eval("hash", etag_payload, {algo: "sha1"})

safe_query := dialect.eval("html_escape", request_url.query.q)
response_body := "{\"ok\":true,\"query\":\"" .. safe_query .. "\"}"
response_headers := {}
response_headers["content-type"] = response_type.type
response_headers["cache-control"] = "max-age=" .. cache_control["max-age"]
response_headers.etag = "\"" .. string.sub(etag, 1, 12) .. "\""
response_headers["x-trace-id"] = request_headers["X-Trace-Id"]
wire_response := dialect.eval("httpmsg", {
    type: "response",
    status: 200,
    reason: "OK",
    headers: response_headers,
    body: response_body,
}, {mode: "format"})

events := [
    {phase: "request", method: "GET", host: request_url.host, path: request_url.path, trace: request_headers["X-Trace-Id"]},
    {phase: "cache", key: etag_payload, ttl: tonumber(cache_control["max-age"])},
    {phase: "response", status: 200, media: response_type.type, etag: string.sub(etag, 1, 12)},
]
trace := dialect.eval("jsonl", events, {mode: "encode"})

print("request:", request_url.scheme, request_url.host, request_url.path)
print("query:", request_url.query.q, request_url.query.debug)
print("cookie cohort:", request_cookies.cohort)
print("safe query:", safe_query)
print("response:")
print(wire_response)
print(trace)

assert(request.type == "request")
assert(request.method == "GET")
assert(request_again.method == request.method)
assert(request.target == "/v1/search?q=leia+dialects&debug=true")
assert(request_url.scheme == "https")
assert(request_url.port == "9443")
assert(request_url.path == "/v1/search")
assert(request_url.query.q == "leia dialects")
assert(request_headers.Accept == "application/json")
assert(request_cookies.session == "s-123")
assert(request_cookies.cohort == "beta")
assert(response_type.params.charset == "utf-8")
assert(cache_control["max-age"] == "60")
assert(etag_payload == "/v1/search?debug=true&q=leia+dialects")
assert(etag == "edf49fbec074c8d64b496ebd3ec2de45909bcd5a")
assert(wire_response == "HTTP/1.1 200 OK\r\nCache-Control: max-age=60\r\nContent-Type: application/json\r\nEtag: \"edf49fbec074\"\r\nX-Trace-Id: req-42\r\n\r\n{\"ok\":true,\"query\":\"leia dialects\"}")
assert(trace == "{\"host\":\"api.example.test\",\"method\":\"GET\",\"path\":\"/v1/search\",\"phase\":\"request\",\"trace\":\"req-42\"}\n{\"key\":\"/v1/search?debug=true\\u0026q=leia+dialects\",\"phase\":\"cache\",\"ttl\":60}\n{\"etag\":\"edf49fbec074\",\"media\":\"application/json\",\"phase\":\"response\",\"status\":200}\n")

print("http protocol trace ok")
