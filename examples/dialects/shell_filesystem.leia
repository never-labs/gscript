// shell_filesystem.leia - Built-in dialects for local process and filesystem work.
// Demonstrates: $, $!, sh, cmd, shellwords, glob, path
//leia:cap process.exec,process.shell,fs.read

print("=== Dialects: shell, command, filesystem ===")

name := "Leia"

// $ runs a small shell snippet and returns a process result table.
shell_result := $`printf 'hello-%s' '${name}'`
assert(shell_result.ok == true)
assert(shell_result.code == 0)
assert(shell_result.text == "hello-Leia")
print("$ stdout:", shell_result.text)
print("$ ok:", shell_result.ok, "code:", shell_result.code)

// $! is the fail-fast shell shortcut. A non-zero exit would raise instead of
// returning a result table; successful commands still expose the same fields.
shell_fast_result := $!`printf 'fast-%s' '${name}'`
assert(shell_fast_result.ok == true)
assert(shell_fast_result.code == 0)
assert(shell_fast_result.text == "fast-Leia")
print("$! stdout:", shell_fast_result.text)

// sh is the named form of the same shell dialect.
sh_result := sh`printf 'alias-%s' '${name}'`
assert(sh_result.ok == true)
assert(sh_result.code == 0)
assert(sh_result.text == "alias-Leia")
print("sh stdout:", sh_result.text)

// Non-zero exits can be inspected without throwing when fail_fast is false.
failed_shell := dialect.eval("sh", "printf shellerr 1>&2; exit 3", {fail_fast: false})
assert(failed_shell.ok == false)
assert(failed_shell.code == 3)
assert(failed_shell.stderr == "shellerr")
print("sh failed ok:", failed_shell.ok, "code:", failed_shell.code)

// cmd runs a command without shell interpolation.
cmd_result := cmd`printf command-ok`
assert(cmd_result.ok == true)
assert(cmd_result.code == 0)
assert(cmd_result.text == "command-ok")
print("cmd stdout:", cmd_result.text)
print("cmd ok:", cmd_result.ok, "code:", cmd_result.code)

// cmd also accepts structured argv/options when shell quoting would be noisy.
structured_cmd := dialect.eval("cmd", {
    cmd: "sh",
    args: {"-c", "cat; printf :$LEIA_DIALECT_EXAMPLE"},
    stdin: "body",
    env: {LEIA_DIALECT_EXAMPLE: "env"},
})
assert(structured_cmd.ok == true)
assert(structured_cmd.text == "body:env")
print("cmd structured:", structured_cmd.text)

entry := process.entry()
cwd_cmd := dialect.eval("cmd", {
    cmd: "sh",
    args: {"-c", "basename \"$PWD\""},
    cwd: entry.dir,
})
override_cwd_cmd := dialect.eval("cmd", {
    cmd: "sh",
    args: {"-c", "basename \"$PWD\""},
    cwd: "/",
}, {cwd: entry.dir})
assert(cwd_cmd.ok == true)
assert(cwd_cmd.text == "dialects\n")
assert(override_cwd_cmd.ok == true)
assert(override_cwd_cmd.text == "dialects\n")
print("cmd cwd:", string.trim(cwd_cmd.text))

// shellwords parses command-line text into argv and encodes argv tables back to
// shell-safe command lines.
argv := shellwords`printf 'quoted value' a\ b ""`
assert(#argv == 4)
assert(argv[1] == "printf")
assert(argv[2] == "quoted value")
assert(argv[3] == "a b")
assert(argv[4] == "")
encoded_cmd := dialect.eval("shellwords", {"printf", "%s\n", "quoted value", "it's", ""}, {mode: "encode"})
formatted_cmd := dialect.eval("shellwords", {"printf", "%s\n", "quoted value", "it's", ""}, {mode: "format"})
roundtrip_argv := dialect.eval("shellwords", encoded_cmd)
assert(roundtrip_argv[3] == "quoted value")
assert(roundtrip_argv[4] == "it's")
assert(roundtrip_argv[5] == "")
assert(formatted_cmd == encoded_cmd)
print("shellwords encoded:", encoded_cmd)

// glob expands a pattern under the configured filesystem root.
matches := dialect.eval("glob", path.join(entry.dir, "*.leia"))
found_shell_filesystem := false
print("glob matches:", #matches)
for i := 1; i <= #matches; i++ {
    if path.base(matches[i]) == "shell_filesystem.leia" {
        found_shell_filesystem = true
    }
    print("  match[" .. i .. "]:", matches[i])
}
assert(found_shell_filesystem == true)

// path cleans a path string without touching the filesystem.
cleaned := path`examples/dialects/../dialects/./shell_filesystem.leia`
assert(cleaned == "examples/dialects/shell_filesystem.leia")
assert(path.match("examples/dialects/*.leia", cleaned) == true)
print("path cleaned:", cleaned)
print("shell/filesystem dialects ok")
