// workflow_test_report.leia - Replay workflow events into a test-style report.
// Demonstrates: JSONL fixtures, TAP and JUnit report parsing, table assertions, template rendering, hash, and JSON output.

print("=== Dialects: workflow test report ===")

events := jsonl`{"run":"wf-1","step":"ingest","status":"ok","ms":12}
{"run":"wf-1","step":"classify","status":"ok","ms":31}
{"run":"wf-1","step":"notify","status":"skip","ms":0}
{"run":"wf-2","step":"ingest","status":"ok","ms":10}
{"run":"wf-2","step":"classify","status":"fail","ms":28}
`

tests := dialect.eval("csv", "name,run,want_status\nhappy path,wf-1,ok\nfailure path,wf-2,fail\n", {headers: true})

func final_status(run_id) {
    status := "missing"
    elapsed := 0
    steps := 0
    for i := 1; i <= #events; i++ {
        if events[i].run == run_id {
            steps = steps + 1
            elapsed = elapsed + events[i].ms
            if events[i].status == "fail" {
                status = "fail"
            } else if status != "fail" && events[i].status == "ok" {
                status = "ok"
            }
        }
    }
    return {status: status, elapsed: elapsed, steps: steps}
}

func elapsed_duration(ms) {
    return dialect.eval("duration", {milliseconds: ms}, {mode: "encode"})
}

results := {}
passed := 0
for i := 1; i <= #tests; i++ {
    actual := final_status(tests[i].run)
    ok := actual.status == tests[i].want_status
    if ok {
        passed = passed + 1
    }
    results[i] = {
        name: tests[i].name,
        run: tests[i].run,
        want: tests[i].want_status,
        got: actual.status,
        steps: actual.steps,
        elapsed_ms: actual.elapsed,
        elapsed_duration: elapsed_duration(actual.elapsed),
        ok: ok,
    }
}

report := {
    total: #tests,
    passed: passed,
    failed: #tests - passed,
    results: results,
}
tap_report := {
    {kind: "version", version: 13},
    {kind: "plan", first: 1, last: #results},
}
for i := 1; i <= #results; i++ {
    tap_report[#tap_report + 1] = {
        kind: "test",
        ok: results[i].ok,
        number: i,
        name: results[i].name,
        diagnostics: {
            string.format("%s got=%s want=%s elapsed=%s", results[i].run, results[i].got, results[i].want, results[i].elapsed_duration),
        },
    }
}
tap_text := dialect.eval("tap", tap_report, {mode: "encode"})
tap_rows := dialect.eval("tap", tap_text)
junit_summary := junit`<testsuite name="workflow" tests="2" failures="0" errors="0" skipped="0" time="0.081">
  <testcase classname="workflow" name="happy path" time="0.043"/>
  <testcase classname="workflow" name="failure path" time="0.038"/>
</testsuite>`
report_json := dialect.eval("json", report, {mode: "encode"})
fingerprint := dialect.eval("hash", report_json)
summary := template {
    text: "workflow tests: {{.passed}}/{{.total}} passed, fingerprint={{.fingerprint}}",
    data: {passed: passed, total: #tests, fingerprint: string.sub(fingerprint, 1, 12)},
}

print(summary)
print(tap_text)
for i := 1; i <= #results; i++ {
    print(string.format("%s\t%s\t%s\t%s", results[i].run, results[i].got, tostring(results[i].ok), results[i].elapsed_duration))
}
print(report_json)

slow_threshold := duration`35ms`

assert(#events == 5)
assert(#tests == 2)
assert(results[1].ok == true)
assert(results[1].got == "ok")
assert(results[1].steps == 3)
assert(results[1].elapsed_ms == 43)
assert(results[1].elapsed_duration == "43ms")
assert(results[2].ok == true)
assert(results[2].got == "fail")
assert(results[2].steps == 2)
assert(results[2].elapsed_ms == 38)
assert(results[2].elapsed_duration == "38ms")
assert(slow_threshold.milliseconds == 35)
assert(report.total == 2)
assert(report.passed == 2)
assert(report.failed == 0)
assert(tap_rows[2].last == 2)
assert(tap_rows[3].ok == true)
assert(tap_rows[4].diagnostics[1] == "wf-2 got=fail want=fail elapsed=38ms")
assert(tap_text == "TAP version 13\n1..2\nok 1 - happy path\n# wf-1 got=ok want=ok elapsed=43ms\nok 2 - failure path\n# wf-2 got=fail want=fail elapsed=38ms\n")
assert(junit_summary.tests == 2)
assert(junit_summary.passed == 2)
assert(junit_summary.suites[1].name == "workflow")
assert(junit_summary.cases[2].name == "failure path")
assert(string.sub(fingerprint, 1, 12) == "92929e62ccf6")
assert(summary == "workflow tests: 2/2 passed, fingerprint=92929e62ccf6")

print("workflow test report ok")
