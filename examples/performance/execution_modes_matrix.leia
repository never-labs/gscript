// execution_modes_matrix.leia - User-facing execution mode and perf report.
// Demonstrates: local benchmark metadata, LuaJIT threshold policy, report tables

print("case:execution_modes_matrix")

modes := {
    {name: "interpreter", role: "semantic reference", fallback: false},
    {name: "bytecode-vm", role: "default execution engine", fallback: true},
    {name: "arm64-jit", role: "hot-path acceleration", fallback: true},
}

benchmarks := {
    {id: "table/table_array_access", current: 0.07375, luajit: 0.10575},
    {id: "control/sieve", current: 0.019125, luajit: 0.06625},
}

fallback_modes := 0
for _, mode := range modes {
    if mode.fallback {
        fallback_modes = fallback_modes + 1
    }
}
assert(fallback_modes == 2)

worst_ratio := 0.0
for _, bench := range benchmarks {
    ratio := bench.current / bench.luajit
    if ratio > worst_ratio {
        worst_ratio = ratio
    }
    assert(ratio < 0.8)
}

print("modes", #modes)
print("benchmarks", #benchmarks)
print("worst_cur_luajit", worst_ratio)
print("ok")
