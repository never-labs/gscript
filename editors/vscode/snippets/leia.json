{
  "function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:args}) {",
      "    ${0}",
      "}"
    ],
    "description": "Define a Leia function"
  },
  "llm agent": {
    "prefix": "llm.agent",
    "body": [
      "${1:agent_name} := llm.agent(\"${1:agent_name}\", func(${2:input}) {",
      "    return {",
      "        model: \"${3:default}\"",
      "        messages: {",
      "            llm.system(\"${4:Be concise.}\"),",
      "            llm.user(${2:input})",
      "        }",
      "    }, nil",
      "})",
      "",
      "${5:result}, err := ${1:agent_name}(${6:value})"
    ],
    "description": "Define and call an llm.agent"
  },
  "llm tool": {
    "prefix": "llm.tool",
    "body": [
      "// ${1:Describe what this tool does.}",
      "//leia:requires ${2:none}",
      "${3:tool_name} := llm.tool(\"${3:tool_name}\", func(${4:arg}) {",
      "    ${0:return nil, nil}",
      "})"
    ],
    "description": "Define an llm.tool with capability metadata"
  },
  "llm turn": {
    "prefix": "llm.turn",
    "body": [
      "result, err := llm.turn({",
      "    model: \"${1:default}\"",
      "    messages: {",
      "        llm.system(\"${2:Be precise.}\"),",
      "        llm.user(${3:question})",
      "    }",
      "    max_tokens: ${4:256}",
      "})"
    ],
    "description": "Run one LLM provider turn"
  },
  "test": {
    "prefix": "test",
    "body": [
      "//leia:test",
      "func test_${1:name}() {",
      "    ${0:assert(true)}",
      "}"
    ],
    "description": "Create a Leia test function"
  },
  "go routine": {
    "prefix": "go",
    "body": [
      "ch := chan()",
      "go func() {",
      "    defer close(ch)",
      "    ${1:send(ch, value)}",
      "}()",
      "${0:result := recv(ch)}"
    ],
    "description": "Start a concurrent task and communicate through a channel"
  }
}
