// Manifest discovery and validation for repository Leia cases.

SCHEMA_VERSION := 2
BENCHMARK_SCHEMA_VERSION := 3

EXCLUDED_DIRS := {__pycache__: true, lua_ref: true}
BENCHMARK_DOMAINS := [
    "numeric", "recursion", "table", "calls", "string",
    "concurrency", "data", "app", "control", "precision",
]
Q_CASE_TYPES := {conformance: true, perf: true, smoke: true}
Q_FEATURE_STATUSES := {supported: true, rejected: true, planned: true}
Q_COVERAGE_KINDS := ["tests", "examples", "benchmarks"]
Q_LIST_KINDS := Q_COVERAGE_KINDS
Q_GATE_SCOPES := {all: true, core: true, extended: true}
Q_CORE_REQUIRED_FEATURES := {
    adverbs: true, asof: true, join: true, keyed: true, mutation: true,
    qsql: true, ["runtime-kernel"]: true, temporal: true, ["typed-null"]: true,
    window: true,
}
Q_CORE_EXCLUDED_FEATURES := {
    ipc: true, persistence: true, serialization: true, session: true,
    ["session-workspace"]: true, ["storage-path"]: true, workspace: true,
}
Q_EXTENDED_TEST_MARKERS := {
    q_boundaries_and_gap_closures_project: true,
    q_columnar_partitioned_store_project: true,
    q_ipc_codec_boundaries_project: true,
    q_session_workspace_project: true,
    q_workspace_session_project_example: true,
}

entryFile := process.entry().file
entryAbs, entryAbsErr := path.abs(entryFile)
if entryAbsErr != nil {
    print("scripts/manifest.leia: " .. entryAbsErr)
    process.exit(1)
}
ROOT := path.dir(path.dir(entryAbs))

func starts_with(s, prefix) {
    return string.sub(s, 1, #prefix) == prefix
}

func ends_with(s, suffix) {
    if #suffix > #s { return false }
    return string.sub(s, #s - #suffix + 1, #s) == suffix
}

func trim_suffix(s, suffix) {
    if ends_with(s, suffix) {
        return string.sub(s, 1, #s - #suffix)
    }
    return s
}

func contains(haystack, needle) {
    return string.find(haystack, needle, 1, true) != nil
}

func split_path(p) {
    if p == "" { return [] }
    return string.split(p, "/")
}

func join_slash(parts) {
    return table.concat(parts, "/")
}

func sorted_keys(m) {
    keys := []
    for k, _ := range pairs(m) {
        append(keys, k)
    }
    table.sort(keys)
    return keys
}

func sorted_values_from_set(m) {
    values := []
    for k, v := range pairs(m) {
        if v { append(values, k) }
    }
    table.sort(values)
    return values
}

func set_from_list(values) {
    out := {}
    if type(values) != "table" { return out }
    for _, value := range ipairs(values) {
        out[value] = true
    }
    return out
}

func list_has(values, needle) {
    if type(values) != "table" { return false }
    for _, value := range ipairs(values) {
        if value == needle { return true }
    }
    return false
}

func list_equal(a, b) {
    if type(a) != "table" || type(b) != "table" { return false }
    aa := []
    bb := []
    for _, v := range ipairs(a) { append(aa, v) }
    for _, v := range ipairs(b) { append(bb, v) }
    if #aa != #bb { return false }
    for i := 1; i <= #aa; i++ {
        if aa[i] != bb[i] { return false }
    }
    return true
}

func reference_equal(a, b) {
    if a == nil && b == nil { return true }
    if type(a) != "table" || type(b) != "table" { return false }
    return a.kind == b.kind && a.path == b.path
}

func repo_rel(absPath) {
    rel, err := path.rel(ROOT, absPath)
    if err != nil { return absPath }
    return rel
}

func case_id(rootName, absPath) {
    rel, err := path.rel(path.join(ROOT, rootName), absPath)
    if err != nil { return trim_suffix(path.base(absPath), ".leia") }
    return trim_suffix(rel, ".leia")
}

func domain_for(rootName, absPath) {
    rel, err := path.rel(path.join(ROOT, rootName), absPath)
    if err != nil { return "default" }
    parts := split_path(rel)
    if #parts == 1 {
        if rootName == "tests" { return "integration" }
        return "default"
    }
    return parts[1]
}

func tags_for(rootName, domain, luaRef) {
    tags := [domain]
    if rootName == "tests" {
        if domain == "language" {
            append(tags, "conformance")
        } else {
            append(tags, "integration")
        }
    } else {
        append(tags, "benchmark")
    }
    return tags
}

func status_for(rootName) {
    if rootName == "tests" { return "passing" }
    return "active"
}

func rel_with_suffix(absPath, base, suffix) {
    rel, err := path.rel(base, absPath)
    if err != nil { return trim_suffix(path.base(absPath), path.ext(absPath)) .. suffix }
    return trim_suffix(rel, path.ext(rel)) .. suffix
}

func lua_ref_for(rootName, absPath) {
    rel := rel_with_suffix(absPath, path.join(ROOT, rootName), ".lua")
    luaPath := ""
    if rootName == "tests" {
        luaPath = path.join(ROOT, rootName, rel)
    } else {
        luaPath = path.join(ROOT, rootName, "lua_ref", rel)
    }
    if fs.exists(luaPath) { return repo_rel(luaPath) }
    return nil
}

func path_parts_have_excluded(parts) {
    for _, part := range ipairs(parts) {
        if EXCLUDED_DIRS[part] { return true }
    }
    return false
}

func walk_leia(base, out) {
    entries := fs.readdir(base)
    table.sort(entries, func(a, b) { return a.name < b.name })
    for _, entry := range ipairs(entries) {
        p := path.join(base, entry.name)
        if entry.isdir {
            walk_leia(p, out)
        } elseif fs.isfile(p) && ends_with(entry.name, ".leia") {
            append(out, p)
        }
    }
}

func iter_leia_cases(rootName) {
    base := path.join(ROOT, rootName)
    paths := []
    if !fs.exists(base) { return paths }
    all := []
    walk_leia(base, all)
    for _, p := range ipairs(all) {
        rel, err := path.rel(base, p)
        if err != nil { rel = repo_rel(p) }
        parts := split_path(rel)
        if path_parts_have_excluded(parts) {
            // excluded
        } elseif rootName == "benchmarks" && !list_has(BENCHMARK_DOMAINS, parts[1]) {
            // excluded
        } else {
            append(paths, p)
        }
    }
    table.sort(paths)
    return paths
}

func is_q_benchmark_path(absPath) {
    rel := repo_rel(absPath)
    name := path.base(absPath)
    return starts_with(rel, "benchmarks/data/") &&
        (starts_with(name, "q_") || starts_with(name, "qsql_") || starts_with(name, "frame_qsql_"))
}

func is_q_example_path(absPath) {
    rel := split_path(repo_rel(absPath))
    if #rel < 3 || rel[1] != "examples" || rel[2] != "data" { return false }
    name := path.base(absPath)
    if starts_with(name, "q_") || starts_with(name, "qsql_") { return true }
    for i := 3; i <= #rel - 1; i++ {
        part := rel[i]
        if starts_with(part, "q_") || starts_with(part, "qsql_") || starts_with(part, "db_q_") {
            return true
        }
    }
    return false
}

func glob_sorted(pattern) {
    matches, err := fs.glob(pattern)
    if err != nil { return [] }
    table.sort(matches)
    return matches
}

func discover_q_benchmarks() {
    base := path.join(ROOT, "benchmarks", "data")
    out := []
    if !fs.exists(base) { return out }
    for _, p := range ipairs(glob_sorted(path.join(base, "*.leia"))) {
        if is_q_benchmark_path(p) { append(out, p) }
    }
    return out
}

func discover_q_examples() {
    base := path.join(ROOT, "examples", "data")
    out := []
    if !fs.exists(base) { return out }
    all := []
    walk_leia(base, all)
    for _, p := range ipairs(all) {
        if is_q_example_path(p) { append(out, p) }
    }
    table.sort(out)
    return out
}

func discover_q_tests() {
    base := path.join(ROOT, "tests", "language")
    set := {}
    for _, p := range ipairs(glob_sorted(path.join(base, "q_*.leia"))) { set[p] = true }
    for _, p := range ipairs(glob_sorted(path.join(base, "qsql_*.leia"))) { set[p] = true }
    out := sorted_values_from_set(set)
    return out
}

func read_json_file(relPath) {
    text, readErr := fs.readfile(path.join(ROOT, relPath))
    if readErr != nil { return nil, tostring(readErr) }
    data, jsonErr := json.decode(text)
    if jsonErr != nil { return nil, tostring(jsonErr) }
    return data, nil
}

func load_q_sidecar_abs(absPath) {
    errors := []
    if !fs.exists(absPath) {
        return [], [repo_rel(absPath) .. " is missing"]
    }
    text, readErr := fs.readfile(absPath)
    if readErr != nil { return [], [repo_rel(absPath) .. ": " .. tostring(readErr)] }
    data, jsonErr := json.decode(text)
    if jsonErr != nil { return [], [repo_rel(absPath) .. ": invalid JSON: " .. tostring(jsonErr)] }
    cases := data.cases
    if type(cases) != "table" {
        return [], [repo_rel(absPath) .. ": missing cases array"]
    }
    out := []
    for i, c := range ipairs(cases) {
        if type(c) != "table" {
            append(errors, string.format("%s: cases[%d] is not an object", repo_rel(absPath), i - 1))
        } else {
            append(out, c)
        }
    }
    return out, errors
}

func q_feature_matrix_abs(absPath) {
    if !fs.exists(absPath) {
        return [], [repo_rel(absPath) .. " is missing"]
    }
    text, readErr := fs.readfile(absPath)
    if readErr != nil { return [], [repo_rel(absPath) .. ": " .. tostring(readErr)] }
    data, jsonErr := json.decode(text)
    if jsonErr != nil { return [], [repo_rel(absPath) .. ": invalid JSON: " .. tostring(jsonErr)] }
    matrix := data.feature_matrix
    if type(matrix) != "table" {
        return [], [repo_rel(absPath) .. ": missing feature_matrix array"]
    }
    out := []
    errors := []
    for i, feature := range ipairs(matrix) {
        if type(feature) != "table" {
            append(errors, string.format("%s: feature_matrix[%d] is not an object", repo_rel(absPath), i - 1))
        } else {
            append(out, feature)
        }
    }
    return out, errors
}

func discover_cases(rootName) {
    cases := []
    for _, p := range ipairs(iter_leia_cases(rootName)) {
        domain := domain_for(rootName, p)
        luaRef := lua_ref_for(rootName, p)
        case := {
            id: case_id(rootName, p),
            path: repo_rel(p),
            domain: domain,
            kind: "test",
            status: status_for(rootName),
            tags: tags_for(rootName, domain, luaRef),
        }
        if rootName == "benchmarks" { case.kind = "benchmark" }
        if luaRef != nil {
            case.reference = {kind: "lua", path: luaRef}
        }
        append(cases, case)
    }
    return cases
}

func load_manifest(rootName) {
    data, err := read_json_file(path.join(rootName, "manifest.json"))
    return data, err
}

func generated_manifest(rootName) {
    cases := discover_cases(rootName)
    manifest := {
        schema_version: SCHEMA_VERSION,
        case_count: #cases,
        cases: cases,
    }
    if rootName == "benchmarks" {
        manifest.schema_version = BENCHMARK_SCHEMA_VERSION
        manifest.domains = BENCHMARK_DOMAINS
        existingPath := path.join(ROOT, "benchmarks", "manifest.json")
        workloads := []
        if fs.exists(existingPath) {
            text := fs.readfile(existingPath)
            existing := json.decode(text)
            if existing.time_source_hints != nil { manifest.time_source_hints = existing.time_source_hints }
            if existing.scale_profiles != nil { manifest.scale_profiles = existing.scale_profiles }
            if type(existing.workloads) == "table" {
                for _, row := range ipairs(existing.workloads) {
                    if type(row) == "table" && type(row.script) == "string" && fs.exists(path.join(ROOT, row.script)) {
                        append(workloads, row)
                    }
                }
            }
        }
        workloadIDs := {}
        for _, row := range ipairs(workloads) {
            if type(row.id) == "string" { workloadIDs[row.id] = true }
        }
        casesByScript := {}
        for _, c := range ipairs(cases) { casesByScript[c.path] = c }
        for _, c := range ipairs(cases) {
            if !workloadIDs[c.id] {
                append(workloads, {
                    id: c.id,
                    domain: c.domain,
                    name: trim_suffix(path.base(c.path), path.ext(c.path)),
                    script: c.path,
                    comparison_reference: c.reference,
                    params: {},
                    recommended_scale: {hot: {}},
                    time_source_hint: "script_time_line",
                    tags: [c.domain],
                })
                workloadIDs[c.id] = true
            }
        }
        for _, row := range ipairs(workloads) {
            if type(row.script) == "string" {
                c := casesByScript[row.script]
                if c != nil && row.comparison_reference == nil && c.reference != nil {
                    row.comparison_reference = c.reference
                }
            }
        }
        manifest.workloads = workloads
    }
    return manifest
}

func validate_manifest(rootName) {
    errors := []
    manifestPath := path.join(ROOT, rootName, "manifest.json")
    if !fs.exists(manifestPath) {
        return [repo_rel(manifestPath) .. " is missing"]
    }
    manifest, err := load_manifest(rootName)
    if err != nil { return [repo_rel(manifestPath) .. ": " .. err] }
    cases := manifest.cases
    if type(cases) != "table" {
        return [repo_rel(manifestPath) .. ": missing cases array"]
    }

    discoveredByPath := {}
    for _, c := range ipairs(discover_cases(rootName)) { discoveredByPath[c.path] = c }
    manifestByPath := {}
    required := ["id", "path", "domain", "kind", "reference", "status", "tags"]

    for i, c := range ipairs(cases) {
        if type(c) != "table" {
            append(errors, string.format("%s: cases[%d] is not an object", repo_rel(manifestPath), i - 1))
        } else {
            missing := []
            for _, field := range ipairs(required) {
                if c[field] == nil && field != "reference" {
                    append(missing, field)
                }
            }
            if #missing > 0 {
                table.sort(missing)
                append(errors, string.format("%s: cases[%d] missing %s", repo_rel(manifestPath), i - 1, table.concat(missing, ", ")))
            }
            if type(c.path) != "string" {
                append(errors, string.format("%s: cases[%d] has non-string path", repo_rel(manifestPath), i - 1))
            } else {
                if manifestByPath[c.path] != nil {
                    append(errors, repo_rel(manifestPath) .. ": duplicate case path " .. c.path)
                }
                manifestByPath[c.path] = c
                if discoveredByPath[c.path] == nil {
                    append(errors, repo_rel(manifestPath) .. ": listed path does not exist or is excluded: " .. c.path)
                }
            }
        }
    }

    missingPaths := []
    extraPaths := []
    for p, _ := range pairs(discoveredByPath) {
        if manifestByPath[p] == nil { append(missingPaths, p) }
    }
    for p, _ := range pairs(manifestByPath) {
        if discoveredByPath[p] == nil { append(extraPaths, p) }
    }
    table.sort(missingPaths)
    table.sort(extraPaths)
    if #missingPaths > 0 { append(errors, repo_rel(manifestPath) .. ": missing .leia cases: " .. table.concat(missingPaths, ", ")) }
    if #extraPaths > 0 { append(errors, repo_rel(manifestPath) .. ": extra .leia cases: " .. table.concat(extraPaths, ", ")) }
    if manifest.case_count != #cases { append(errors, repo_rel(manifestPath) .. ": case_count does not match cases length") }

    if rootName == "benchmarks" {
        for _, legacy := range ipairs(["benchmarks", "groups", "compatibility"]) {
            if manifest[legacy] != nil {
                append(errors, repo_rel(manifestPath) .. ": legacy top-level key is not allowed: " .. legacy)
            }
        }
        if type(manifest.workloads) != "table" {
            append(errors, repo_rel(manifestPath) .. ": missing workloads array")
        } else {
            workloadIDs := {}
            for i, row := range ipairs(manifest.workloads) {
                if type(row) != "table" {
                    append(errors, string.format("%s: workloads[%d] is not an object", repo_rel(manifestPath), i - 1))
                } else {
                    if type(row.id) != "string" {
                        append(errors, string.format("%s: workloads[%d] has non-string id", repo_rel(manifestPath), i - 1))
                    } elseif workloadIDs[row.id] {
                        append(errors, repo_rel(manifestPath) .. ": duplicate workload id " .. row.id)
                    } else {
                        workloadIDs[row.id] = true
                    }
                    if type(row.script) != "string" {
                        append(errors, string.format("%s: workloads[%d] has non-string script", repo_rel(manifestPath), i - 1))
                    } elseif !fs.exists(path.join(ROOT, row.script)) {
                        append(errors, repo_rel(manifestPath) .. ": workload script does not exist: " .. row.script)
                    }
                }
            }
        }
    }

    for _, expected := range pairs(discoveredByPath) {
        actual := manifestByPath[expected.path]
        if actual != nil {
            for _, field := range ipairs(required) {
                if field == "tags" {
                    if !list_equal(actual.tags, expected.tags) {
                        append(errors, string.format("%s: %s field %s is %s, expected %s", repo_rel(manifestPath), expected.path, field, tostring(actual[field]), tostring(expected[field])))
                    }
                } elseif field != "reference" && actual[field] != expected[field] {
                    append(errors, string.format("%s: %s field %s is %s, expected %s", repo_rel(manifestPath), expected.path, field, tostring(actual[field]), tostring(expected[field])))
                }
            }
            if !reference_equal(actual.reference, expected.reference) {
                append(errors, string.format("%s: %s field reference is %s, expected %s", repo_rel(manifestPath), expected.path, tostring(actual.reference), tostring(expected.reference)))
            }
        }
    }
    return errors
}

func validate_q_sidecar(sidecarRel, expectedPaths) {
    sidecarPath := path.join(ROOT, sidecarRel)
    errors := []
    cases, loadErrors := load_q_sidecar_abs(sidecarPath)
    for _, e := range ipairs(loadErrors) { append(errors, e) }
    expectedRel := {}
    for _, p := range ipairs(expectedPaths) { expectedRel[repo_rel(p)] = true }
    byPath := {}
    ids := {}
    for i, c := range ipairs(cases) {
        idv := c.id
        pathv := c.path
        if type(idv) != "string" || idv == "" {
            append(errors, string.format("%s: cases[%d] has missing or non-string id", sidecarRel, i - 1))
        } elseif ids[idv] {
            append(errors, sidecarRel .. ": duplicate case id " .. idv)
        } else {
            ids[idv] = true
        }
        if type(pathv) != "string" {
            append(errors, string.format("%s: cases[%d] has missing or non-string path", sidecarRel, i - 1))
        } else {
            if byPath[pathv] != nil { append(errors, sidecarRel .. ": duplicate case path " .. pathv) }
            byPath[pathv] = c
            if !fs.exists(path.join(ROOT, pathv)) { append(errors, sidecarRel .. ": listed q case does not exist: " .. pathv) }
            if type(c.types) != "table" || #c.types == 0 {
                append(errors, sidecarRel .. ": " .. pathv .. " has missing or invalid types")
            } else {
                unknown := []
                for _, t := range ipairs(c.types) {
                    if type(t) != "string" || !Q_CASE_TYPES[t] { append(unknown, tostring(t)) }
                }
                table.sort(unknown)
                if #unknown > 0 { append(errors, sidecarRel .. ": " .. pathv .. " has unknown types: " .. table.concat(unknown, ", ")) }
            }
            scope := c.gate_scope
            if scope == nil { scope = "core" }
            if scope != "core" && scope != "extended" {
                append(errors, sidecarRel .. ": " .. pathv .. " has invalid gate_scope " .. tostring(scope))
            }
            if type(c.features) != "table" || #c.features == 0 {
                append(errors, sidecarRel .. ": " .. pathv .. " has missing or invalid features")
            }
        }
    }
    missing := []
    extra := []
    for p, _ := range pairs(expectedRel) { if byPath[p] == nil { append(missing, p) } }
    for p, _ := range pairs(byPath) { if !expectedRel[p] { append(extra, p) } }
    table.sort(missing)
    table.sort(extra)
    if #missing > 0 { append(errors, sidecarRel .. ": missing q cases: " .. table.concat(missing, ", ")) }
    if #extra > 0 { append(errors, sidecarRel .. ": extra q cases: " .. table.concat(extra, ", ")) }
    return errors
}

func q_sidecar_path(kind) {
    if kind == "examples" { return "examples/data/q-cases.json" }
    if kind == "benchmarks" { return "benchmarks/data/q-cases.json" }
    return nil
}

func q_path_gate_scope(kind, p) {
    if kind == "tests" {
        stem := trim_suffix(path.base(p), path.ext(p))
        if Q_EXTENDED_TEST_MARKERS[stem] { return "extended" }
        return "core"
    }
    sidecar := q_sidecar_path(kind)
    if sidecar == nil || !fs.exists(path.join(ROOT, sidecar)) { return "core" }
    cases, _ := load_q_sidecar_abs(path.join(ROOT, sidecar))
    for _, c := range ipairs(cases) {
        if c.path == p {
            if c.gate_scope == "extended" { return "extended" }
            return "core"
        }
    }
    return "core"
}

func valid_q_coverage_paths() {
    out := {tests: {}, examples: {}, benchmarks: {}}
    for _, p := range ipairs(discover_q_tests()) { out.tests[repo_rel(p)] = true }
    for _, p := range ipairs(discover_q_examples()) { out.examples[repo_rel(p)] = true }
    for _, p := range ipairs(discover_q_benchmarks()) { out.benchmarks[repo_rel(p)] = true }
    return out
}

func validate_q_feature_matrix(sidecarRel) {
    sidecarPath := path.join(ROOT, sidecarRel)
    errors := []
    matrix, matrixErrors := q_feature_matrix_abs(sidecarPath)
    for _, e := range ipairs(matrixErrors) { append(errors, e) }
    validPaths := valid_q_coverage_paths()
    knownFeatures := {}
    coveredPaths := {tests: {}, examples: {}, benchmarks: {}}
    rowsByFeature := {}

    for i, feature := range ipairs(matrix) {
        featureID := feature.id
        if type(featureID) != "string" || featureID == "" {
            append(errors, string.format("%s: feature_matrix[%d] has missing or non-string id", sidecarRel, i - 1))
        } else {
            if knownFeatures[featureID] { append(errors, sidecarRel .. ": duplicate q feature id " .. featureID) }
            knownFeatures[featureID] = true
            rowsByFeature[featureID] = feature
            if !Q_FEATURE_STATUSES[feature.status] { append(errors, sidecarRel .. ": " .. featureID .. " has invalid status " .. tostring(feature.status)) }
            scope := feature.gate_scope
            if scope == nil { scope = "core" }
            if scope != "core" && scope != "extended" { append(errors, sidecarRel .. ": " .. featureID .. " has invalid gate_scope " .. tostring(scope)) }
            if scope == "core" && Q_CORE_EXCLUDED_FEATURES[featureID] { append(errors, sidecarRel .. ": " .. featureID .. " must be extended, not core") }
            coverage := feature.coverage
            if type(coverage) != "table" {
                append(errors, sidecarRel .. ": " .. featureID .. " has missing coverage object")
                coverage = {}
            }
            coveredAny := false
            for _, kind := range ipairs(Q_COVERAGE_KINDS) {
                paths := coverage[kind]
                if paths == nil { paths = [] }
                if type(paths) != "table" {
                    append(errors, sidecarRel .. ": " .. featureID .. " coverage." .. kind .. " must be a string array")
                } else {
                    seen := {}
                    for _, cp := range ipairs(paths) {
                        if type(cp) != "string" {
                            append(errors, sidecarRel .. ": " .. featureID .. " coverage." .. kind .. " must be a string array")
                        } else {
                            coveredAny = true
                            coveredPaths[kind][cp] = true
                            if seen[cp] { append(errors, sidecarRel .. ": " .. featureID .. " coverage." .. kind .. " has duplicate paths") }
                            seen[cp] = true
                            if !validPaths[kind][cp] { append(errors, sidecarRel .. ": " .. featureID .. " coverage." .. kind .. " references unknown q case " .. cp) }
                        }
                    }
                }
            }
            tests := coverage.tests
            if tests == nil { tests = [] }
            if (feature.status == "supported" || feature.status == "rejected") && (#tests == 0) {
                append(errors, sidecarRel .. ": " .. featureID .. " status " .. tostring(feature.status) .. " requires at least one q language test")
            }
            if feature.status == "supported" && !coveredAny {
                append(errors, sidecarRel .. ": " .. featureID .. " status supported requires coverage")
            }
            if feature.status == "supported" && scope == "core" {
                ok := false
                for _, tp := range ipairs(tests) {
                    if type(tp) == "string" && q_path_gate_scope("tests", tp) == "core" { ok = true }
                }
                if !ok { append(errors, sidecarRel .. ": " .. featureID .. " core supported feature requires at least one core q language test") }
            }
        }
    }

    for _, featureID := range ipairs(sorted_values_from_set(Q_CORE_REQUIRED_FEATURES)) {
        feature := rowsByFeature[featureID]
        if feature == nil {
            append(errors, sidecarRel .. ": missing required core q feature " .. featureID)
        } else {
            if feature.status != "supported" { append(errors, sidecarRel .. ": required core q feature " .. featureID .. " must be supported") }
            scope := feature.gate_scope
            if scope == nil { scope = "core" }
            if scope != "core" { append(errors, sidecarRel .. ": required core q feature " .. featureID .. " must have core gate_scope") }
        }
    }
    for _, kind := range ipairs(Q_COVERAGE_KINDS) {
        for p, _ := range pairs(validPaths[kind]) {
            if !coveredPaths[kind][p] {
                append(errors, sidecarRel .. ": q " .. kind .. " case is not classified in feature_matrix coverage: " .. p)
            }
        }
    }

    for _, sidecar := range ipairs([sidecarRel, "benchmarks/data/q-cases.json"]) {
        cases, loadErrors := load_q_sidecar_abs(path.join(ROOT, sidecar))
        for _, e := range ipairs(loadErrors) { append(errors, e) }
        kind := "benchmarks"
        if sidecar == "examples/data/q-cases.json" { kind = "examples" }
        for _, c := range ipairs(cases) {
            p := c.path
            if p == nil { p = "<unknown>" }
            features := c.features
            if type(features) == "table" {
                scope := c.gate_scope
                if scope == nil { scope = "core" }
                if scope == "core" {
                    for _, fid := range ipairs(features) {
                        if Q_CORE_EXCLUDED_FEATURES[fid] { append(errors, sidecar .. ": core q case " .. p .. " must not include extended feature " .. fid) }
                    }
                }
                for _, fid := range ipairs(features) {
                    if type(fid) == "string" {
                        row := rowsByFeature[fid]
                        if row == nil {
                            append(errors, sidecar .. ": " .. p .. " references unknown q feature " .. fid)
                        } else {
                            coverage := row.coverage
                            paths := []
                            if type(coverage) == "table" && type(coverage[kind]) == "table" { paths = coverage[kind] }
                            if !list_has(paths, p) { append(errors, sidecarRel .. ": " .. fid .. " coverage." .. kind .. " is missing " .. p) }
                        }
                    }
                }
            }
        }
    }
    table.sort(errors)
    return errors
}

func validate_q_coverage(roots) {
    if roots == nil { roots = {tests: true, benchmarks: true} }
    errors := []
    if roots.tests {
        testsManifest, err := load_manifest("tests")
        if err != nil {
            append(errors, "tests/manifest.json: " .. err)
        } else {
            testsByPath := {}
            for _, c := range ipairs(testsManifest.cases) { testsByPath[c.path] = c }
            for _, p := range ipairs(discover_q_tests()) {
                rel := repo_rel(p)
                c := testsByPath[rel]
                if c == nil {
                    append(errors, "tests/manifest.json: missing q language case " .. rel)
                } elseif c.domain != "language" || !list_has(c.tags, "conformance") {
                    append(errors, "tests/manifest.json: q language case " .. rel .. " is not tagged language conformance")
                }
            }
        }
    }
    if roots.benchmarks {
        bm, err := load_manifest("benchmarks")
        if err != nil {
            append(errors, "benchmarks/manifest.json: " .. err)
        } else {
            cases := {}
            workloads := {}
            for _, c := range ipairs(bm.cases) { cases[c.path] = c }
            for _, row := range ipairs(bm.workloads) { workloads[row.script] = row }
            qbs := discover_q_benchmarks()
            for _, p := range ipairs(qbs) {
                rel := repo_rel(p)
                if cases[rel] == nil { append(errors, "benchmarks/manifest.json: missing q benchmark case " .. rel) }
                if workloads[rel] == nil { append(errors, "benchmarks/manifest.json: missing q benchmark workload " .. rel) }
            }
            for _, e := range ipairs(validate_q_sidecar("benchmarks/data/q-cases.json", qbs)) { append(errors, e) }
        }
    }
    if roots.tests && roots.benchmarks {
        for _, e := range ipairs(validate_q_sidecar("examples/data/q-cases.json", discover_q_examples())) { append(errors, e) }
        for _, e := range ipairs(validate_q_feature_matrix("examples/data/q-cases.json")) { append(errors, e) }
    }
    table.sort(errors)
    return errors
}

func q_paths(kind, scope) {
    paths := []
    if kind == "tests" {
        for _, p := range ipairs(discover_q_tests()) { append(paths, repo_rel(p)) }
    } elseif kind == "examples" {
        for _, p := range ipairs(discover_q_examples()) { append(paths, repo_rel(p)) }
    } elseif kind == "benchmarks" {
        for _, p := range ipairs(discover_q_benchmarks()) { append(paths, repo_rel(p)) }
    } else {
        error("unknown q list kind: " .. kind)
    }
    if scope == "all" { return paths }
    out := []
    for _, p := range ipairs(paths) {
        if q_path_gate_scope(kind, p) == scope { append(out, p) }
    }
    return out
}

func json_quote(s) {
    return json.encode(s)
}

func json_value(v) {
    if v == nil { return "null" }
    if type(v) == "string" || type(v) == "number" || type(v) == "bool" { return json.encode(v) }
    return json.encode(v)
}

func json_array_strings(values) {
    parts := []
    for _, value := range ipairs(values) { append(parts, json_quote(value)) }
    return "[" .. table.concat(parts, ", ") .. "]"
}

func json_ref(ref) {
    if ref == nil { return "null" }
    return "{\"kind\": " .. json_quote(ref.kind) .. ", \"path\": " .. json_quote(ref.path) .. "}"
}

func json_case(c, sortedKeys) {
    if sortedKeys {
        return "{\"domain\": " .. json_quote(c.domain) ..
            ", \"id\": " .. json_quote(c.id) ..
            ", \"kind\": " .. json_quote(c.kind) ..
            ", \"path\": " .. json_quote(c.path) ..
            ", \"reference\": " .. json_ref(c.reference) ..
            ", \"status\": " .. json_quote(c.status) ..
            ", \"tags\": " .. json_array_strings(c.tags) .. "}"
    }
    return "{\n" ..
        "      \"id\": " .. json_quote(c.id) .. ",\n" ..
        "      \"path\": " .. json_quote(c.path) .. ",\n" ..
        "      \"domain\": " .. json_quote(c.domain) .. ",\n" ..
        "      \"kind\": " .. json_quote(c.kind) .. ",\n" ..
        "      \"reference\": " .. json_ref(c.reference) .. ",\n" ..
        "      \"status\": " .. json_quote(c.status) .. ",\n" ..
        "      \"tags\": " .. json_array_strings(c.tags) .. "\n" ..
        "    }"
}

func json_workload(row) {
    return json.encode(row)
}

func manifest_json(m) {
    lines := []
    append(lines, "{")
    append(lines, "  \"schema_version\": " .. tostring(m.schema_version) .. ",")
    append(lines, "  \"case_count\": " .. tostring(m.case_count) .. ",")
    if m.domains != nil { append(lines, "  \"domains\": " .. json_array_strings(m.domains) .. ",") }
    append(lines, "  \"cases\": [")
    for i, c := range ipairs(m.cases) {
        sep := ","
        if i == #m.cases { sep = "" }
        append(lines, json_case(c, false) .. sep)
    }
    append(lines, "  ]")
    if m.time_source_hints != nil { append(lines, "  ,\"time_source_hints\": " .. json.encode(m.time_source_hints)) }
    if m.scale_profiles != nil { append(lines, "  ,\"scale_profiles\": " .. json.encode(m.scale_profiles)) }
    if m.workloads != nil {
        append(lines, "  ,\"workloads\": [")
        for i, row := range ipairs(m.workloads) {
            sep := ","
            if i == #m.workloads { sep = "" }
            append(lines, "    " .. json_workload(row) .. sep)
        }
        append(lines, "  ]")
    }
    append(lines, "}")
    return table.concat(lines, "\n") .. "\n"
}

func write_manifest(rootName) {
    fs.writefile(path.join(ROOT, rootName, "manifest.json"), manifest_json(generated_manifest(rootName)))
}

func parse_args() {
    raw := process.args()
    args := []
    for i := 1; i <= #raw; i++ {
        append(args, raw[i])
    }
    scope := "all"
    cleaned := []
    skipNext := false
    for i := 2; i <= #args; i++ {
        if skipNext {
            skipNext = false
            continue
        }
        a := args[i]
        if a == "--scope" {
            if i + 1 > #args {
                print("--scope requires a value")
                process.exit(2)
            }
            scope = args[i + 1]
            skipNext = true
        } elseif starts_with(a, "--scope=") {
            scope = string.sub(a, #"--scope=" + 1)
        } else {
            append(cleaned, a)
        }
    }
    if !Q_GATE_SCOPES[scope] {
        keys := sorted_values_from_set(Q_GATE_SCOPES)
        print("--scope must be one of: " .. table.concat(keys, ", "))
        process.exit(2)
    }
    return args[1], cleaned, scope
}

func parser_error(msg) {
    print(msg)
    process.exit(2)
}

command, roots, scope := parse_args()
if command == nil || command == "" {
    parser_error("usage: manifest.leia <generate|check|list|list-q> [roots...]")
}

if command == "list-q" {
    kinds := roots
    if #kinds == 0 { kinds = Q_LIST_KINDS }
    for _, kind := range ipairs(kinds) {
        if !list_has(Q_LIST_KINDS, kind) { parser_error("list-q accepts only: tests, examples, benchmarks") }
        for _, p := range ipairs(q_paths(kind, scope)) { print(p) }
    }
    process.exit(0)
}

if command == "generate" {
    if #roots == 0 { roots = ["tests", "benchmarks"] }
    for _, rootName := range ipairs(roots) {
        if rootName != "tests" && rootName != "benchmarks" { parser_error("generate accepts only: tests, benchmarks") }
        write_manifest(rootName)
    }
    process.exit(0)
}

if command == "list" {
    if #roots == 0 { roots = ["tests", "benchmarks"] }
    for _, rootName := range ipairs(roots) {
        if rootName != "tests" && rootName != "benchmarks" { parser_error("list accepts only: tests, benchmarks") }
        for _, c := range ipairs(discover_cases(rootName)) { print(json_case(c, true)) }
    }
    process.exit(0)
}

if command != "check" {
    parser_error("unknown command: " .. command)
}

if #roots == 0 { roots = ["tests", "benchmarks"] }
errors := []
rootSet := {}
for _, rootName := range ipairs(roots) {
    if rootName != "tests" && rootName != "benchmarks" { parser_error("check accepts only: tests, benchmarks") }
    rootSet[rootName] = true
    for _, e := range ipairs(validate_manifest(rootName)) { append(errors, e) }
}
for _, e := range ipairs(validate_q_coverage(rootSet)) { append(errors, e) }
if #errors > 0 {
    table.sort(errors)
    for _, e := range ipairs(errors) { print(e) }
    process.exit(1)
}
process.exit(0)
