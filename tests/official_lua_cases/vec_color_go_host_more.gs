print("case:vec_color_go_host_more")

v := vec.vec2(3, 4)
assert(vec.isVec2(v))
assert(v.x == 3 && v.y == 4)
assert(vec.length2(v) == 5)
assert(vec.lengthSq2(v) == 25)
assert(vec.dot2(vec.vec2(1, 2), vec.vec2(3, 4)) == 11)

n := vec.normalize2(v)
assert(math.abs(n.x - 0.6) < 0.000001)
assert(math.abs(n.y - 0.8) < 0.000001)
z := vec.normalize2(vec.zero2())
assert(z.x == 0 && z.y == 0)
p := vec.perp2(vec.vec2(2, 5))
assert(p.x == -5 && p.y == 2)
l := vec.lerp2(vec.vec2(0, 0), vec.vec2(10, 20), 0.25)
assert(l.x == 2.5 && l.y == 5)
c2 := vec.clamp2(vec.vec2(-2, 8), 0, 5)
assert(c2.x == 0 && c2.y == 5)

a := vec.vec3(1, 0, 0)
b := vec.vec3(0, 1, 0)
cross := vec.cross3(a, b)
assert(vec.isVec3(cross))
assert(cross.x == 0 && cross.y == 0 && cross.z == 1)
assert(vec.dot3(vec.vec3(1, 2, 3), vec.vec3(4, 5, 6)) == 32)
assert(vec.length3(vec.vec3(2, 3, 6)) == 7)

orange := color.rgb(255, 128, 0)
assert(color.isColor(orange))
assert(color.toHex(orange) == "#FF8000")
short := color.fromHex("#0F8")
assert(color.toHex(short) == "#00FF88")
withA := color.rgba(255, 0, 0, 128)
assert(math.abs(withA.a - (128 / 255)) < 0.000001)
alpha := color.alpha(color.RED, 0.25)
assert(alpha.r == 1 && alpha.g == 0 && alpha.b == 0 && alpha.a == 0.25)
inv := color.invert(color.rgb(0, 128, 255))
assert(color.toHex(inv) == "#FF7F00")
mix := color.lerp(color.BLACK, color.WHITE, 0.5)
assert(color.toHex(mix) == "#808080")
bad, err := color.fromHex("xxz")
assert(bad == nil && type(err) == "string")

print("ok")
