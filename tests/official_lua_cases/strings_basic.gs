print("case:strings_basic")

assert("alo" < "alo1")
assert("" < "a")
assert("abc" <= "abc")
assert(!("abd" <= "abc"))

assert(string.sub("123456789", 2, 4) == "234")
assert(string.sub("123456789", 7) == "789")
assert(string.sub("123456789", 7, 6) == "")
assert(string.sub("123456789", 7, 7) == "7")
assert(string.sub("123456789", 0, 0) == "")
assert(string.sub("123456789", -1) == "9")
assert(string.sub("123456789", -4) == "6789")
assert(string.sub("123456789", -6, -4) == "456")

assert(string.find("123456789", "345") == 3)
a, b := string.find("123456789", "345")
assert(string.sub("123456789", a, b) == "345")
assert(string.find("1234567890123456789", "345", 3) == 3)
assert(string.find("1234567890123456789", "345", 4) == 13)
assert(!string.find("1234567890123456789", "346", 4))

assert(string.len("") == 0)
assert(string.len("1234567890") == 10)
assert(#"" == 0)
assert(#"1234567890" == 10)

assert(string.byte("a") == 97)
assert(string.byte("ba", 2) == 97)
assert(string.byte("") == nil)
assert(string.byte("hi", 3) == nil)
assert(string.char() == "")
assert(string.char(65, 66, 67) == "ABC")

assert(string.upper("abc") == "ABC")
assert(string.lower("ABCc") == "abcc")
assert(string.rep("teste", 0) == "")
assert(string.rep("teste", 1, "xuxu") == "teste")
assert(string.rep("teste", 2, "x") == "testexteste")
assert(string.reverse("") == "")
assert(string.reverse("1234") == "4321")

print("ok")
