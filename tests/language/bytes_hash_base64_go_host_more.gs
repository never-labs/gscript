print("case:bytes_hash_base64_go_host_more")

encoded := base64.encode("hello?")
assert(encoded == "aGVsbG8/")
decoded, err := base64.decode(encoded)
assert(decoded == "hello?")
assert(err == nil)
urlEncoded := base64.urlEncode("hello?")
assert(urlEncoded == "aGVsbG8_")
decoded, err = base64.urlDecode(urlEncoded)
assert(decoded == "hello?")
assert(err == nil)
bad, err := base64.decode("not-valid!")
assert(bad == nil)
assert(type(err) == "string")

assert(hash.md5("abc") == "900150983cd24fb0d6963f7d28e17f72")
assert(hash.sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d")
assert(hash.sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
assert(hash.crc32("abc") == 891568578)
assert(hash.hmacSHA256("key", "abc") == "9c196e32dc0175f86f4b1cb89289d6619de6bee699e4c378e68309ed97a1a6ab")

buf := bytes.new()
buf.write("hi")
buf.writeByte(33)
assert(buf.toString() == "hi!")
assert(buf.toHex() == "686921")
assert(buf.len() == 3)
bt := buf.bytes()
assert(#bt == 3)
assert(bt[1] == 104)
assert(buf.readString(1, 2) == "hi")
assert(buf.readByte(3) == 33)
assert(buf.readByte(99) == nil)
buf.reset()
assert(buf.len() == 0)

from := bytes.fromHex("686921")
assert(from.toString() == "hi!")
assert(bytes.toHex("go") == "676f")
assert(bytes.xor("\1\2", "\3\1") == "\2\3")
assert(bytes.compare("a", "b") == -1)
assert(bytes.repeat("ab", 3) == "ababab")
assert(bytes.concat("a", bytes.fromString("b"), "c") == "abc")

badBuf, err := bytes.fromHex("xx")
assert(badBuf == nil)
assert(type(err) == "string")

print("ok")
