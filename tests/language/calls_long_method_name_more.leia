print("case:calls_long_method_name_more")

t := {x: 1}
t._012345678901234567890123456789012345678901234567890123456789 = func(self) {
  return self.x
}
assert(t._012345678901234567890123456789012345678901234567890123456789(t) == 1)

t.x = 42
assert(t._012345678901234567890123456789012345678901234567890123456789(t) == 42)

print("ok")
