print("case:q_temporal_window_analytics_project")

result := dofile("examples/data/q_temporal_window_analytics_project/main.leia")

assert(result.summary != "")
assert(#result.calendar == 4)
assert(#result.trades == 5)
assert(#result.quotes == 7)
assert(#result.enriched == 5)
assert(#result.windowed == 5)
assert(#result.projection_path == 7)
assert(#result.bars == 5)
assert(#result.windowed[1].bid == 2)
assert(result.projection_path[1].sym == "AAPL")
assert(result.projection_path[1].price_delta == 100.0)
assert(data.is_null(result.projection_path[1].price_ratio))
assert(result.projection_path[2].price_delta == 1.0)
assert(result.projection_path[2].price_ratio == 1.01)
assert(result.projection_path[2].bid_fill == 100.2)
assert(result.projection_path[2].price_mavg3 == 100.5)
assert(data.is_null(result.projection_path[1].price_xprev2))
assert(result.projection_path[3].trade_id == 106)
assert(result.projection_path[3].sym == "AAPL")
assert(result.projection_path[3].price_delta == -2.0)
assert(result.projection_path[3].price_ratio > 0.980)
assert(result.projection_path[3].price_ratio < 0.981)
assert(result.projection_path[3].bid_fill == 100.5)
assert(result.projection_path[3].price_mavg3 == 100.0)
assert(result.projection_path[3].price_xprev2 == 100.0)
assert(result.projection_path[4].sym == "MSFT")
assert(result.projection_path[4].price_delta == 250.0)
assert(data.is_null(result.projection_path[4].price_ratio))
assert(data.is_null(result.projection_path[4].price_xprev2))
assert(result.projection_path[6].price_delta == -3.0)
assert(result.projection_path[6].price_mavg3 > 250.33)
assert(result.projection_path[6].price_mavg3 < 250.34)
assert(result.projection_path[6].price_xprev2 == 250.0)
assert(result.projection_path[7].sym == "TSLA")
assert(result.projection_path[7].price_delta == 205.0)
assert(result.projection_path[7].bid_fill == nil)
bucket_edges := q.eval("xbar[10;-21 -20 -19 -10 -1 0 1]")
date_running_min := q.eval("mins 2026.06.07 0Nd 2026.06.06")
timestamp_running_max := q.eval("maxs 2026.06.06D09:30:00 0Np 2026.06.06D09:31:00")
ratios_after_null := q.eval("ratios 2 0N 8 16")
assert(bucket_edges[1] == -30)
assert(bucket_edges[2] == -20)
assert(bucket_edges[7] == 0)
assert(date_running_min[1] == "2026-06-07")
assert(date_running_min[2] == "2026-06-07")
assert(date_running_min[3] == "2026-06-06")
assert(timestamp_running_max[1] == "2026-06-06T09:30:00Z")
assert(timestamp_running_max[2] == "2026-06-06T09:30:00Z")
assert(timestamp_running_max[3] == "2026-06-06T09:31:00Z")
assert(ratios_after_null[2].__data_null == true)
assert(ratios_after_null[3] == 8)
aapl_latest := q.lookup(result.sector_keyed, "AAPL")
aapl_all := q.sql(result.sector_joined, "select trade_id,sym,sector,notional from trades where sym=`AAPL order by trade_id asc")
assert(#aapl_latest == 1)
assert(aapl_latest[1].sym == nil)
assert(#aapl_all == 2)

print("ok")
