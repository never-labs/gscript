print("case:q_data_complex_examples_tdd")

func check(name, ok) {
  assert(ok)
  print("ok", name)
}

func distinct_values(values) {
  seen := {}
  out := {}
  for i := 1; i <= #values; i++ {
    value := values[i]
    key := tostring(value)
    if !seen[key] {
      seen[key] = true
      out[#out + 1] = value
    }
  }
  return out
}

func distinct_column(rows, name) {
  seen := {}
  out := {}
  for i := 1; i <= #rows; i++ {
    value := rows[i][name]
    key := tostring(value)
    if !seen[key] {
      seen[key] = true
      out[#out + 1] = value
    }
  }
  return out
}

prices := q.eval("100 101.5 100.75 102.25 103 99.5")
top_prices := q.eval("3#103 102.25 101.5 100.75")
rich_indexes := q.eval("where 100 101.5 100.75 102.25 103 99.5>100")
unique_symbols := distinct_values(["AAPL", "MSFT", "AAPL", "NVDA", "MSFT", "AAPL"])

check("q vector take", q.count(top_prices) == 3 && top_prices[1] == 103 && top_prices[3] == 101.5)
check("q vector filter indexes", q.count(rich_indexes) == 4 && rich_indexes[1] == 1 && rich_indexes[4] == 4)
check("stable distinct helper", #unique_symbols == 3 && unique_symbols[1] == "AAPL" && unique_symbols[3] == "NVDA")

trades := data.frame({
  sym: data.symbols(["AAPL", "MSFT", "AAPL", "NVDA", "MSFT", "AAPL"]),
  side: data.symbols(["buy", "sell", "buy", "buy", "sell", "sell"]),
  venue: data.strings(["XNAS", "XNYS", "XNAS", "ARCX", "BATS", "XNAS"]),
  price: data.f64([100.0, 101.5, 100.75, 102.25, 103.0, 99.5]),
  size: data.i64([100, 120, 80, 150, 90, 50]),
})

projected := q.sql(trades, "select sym,side,venue,notional:price*size from trades where price>100 order by notional desc,sym asc limit 3")
rollup := q.sql(trades, "select notional:sum price*size, fills:count i by sym from trades where price>100 order by notional desc,sym asc")
buy_rollup := q.sql("select qty:sum size, fills:count i by side from trades where side=`buy order by qty desc", {
  trades: trades,
})
projected_symbols := distinct_column(projected, "sym")

check("qsql filter computed order limit", #projected == 3 && projected[1].sym == "NVDA" && projected[1].notional == 15337.5 && projected[3].sym == "MSFT")
check("qsql group order", #rollup == 3 && rollup[1].sym == "MSFT" && rollup[1].notional == 21450.0 && rollup[2].sym == "NVDA")
check("qsql grouped symbol filter", #buy_rollup == 1 && buy_rollup[1].side == "buy" && buy_rollup[1].qty == 330.0 && buy_rollup[1].fills == 3)
check("distinct over qsql rows", #projected_symbols == 2 && projected_symbols[1] == "NVDA" && projected_symbols[2] == "MSFT")

conn := db.memory()
conn.exec(sql`create table trade_events (
  id integer primary key,
  sym text not null,
  side text not null,
  venue text not null,
  price real not null,
  size integer not null
)`)

for i := 1; i <= trades.len; i++ {
  conn.exec(sql {
    query: "insert into trade_events (id, sym, side, venue, price, size) values (:id, :sym, :side, :venue, :price, :size)",
    params: {
      id: i,
      sym: trades.sym[i],
      side: trades.side[i],
      venue: trades.venue[i],
      price: trades.price[i],
      size: trades.size[i],
    },
  })
}

db_trades := conn.frame(sql`select sym,side,venue,price,size from trade_events order by id`)
db_rollup := q.sql(db_trades, "select notional:sum price*size, fills:count i by sym from trade_events where price>100 order by notional desc,sym asc")

conn.exec(sql`create table q_rollup (rank integer primary key, sym text not null, notional real not null, fills integer not null)`)
for i := 1; i <= #db_rollup; i++ {
  row := db_rollup[i]
  conn.exec(sql {
    query: "insert into q_rollup (rank, sym, notional, fills) values (:rank, :sym, :notional, :fills)",
    params: {rank: i, sym: row.sym, notional: row.notional, fills: row.fills},
  })
}

roundtrip := conn.query(sql`select sym,notional,fills from q_rollup order by rank`)

check("db frame feeds qsql", db_trades.len == 6 && db_trades.schema.kinds.price == "f64" && db_rollup[1].sym == "MSFT")
check("db qsql roundtrip back to sqlite", #roundtrip == 3 && roundtrip[1].sym == "MSFT" && roundtrip[1].fills == 2 && roundtrip[3].notional == 8060.0)

typed_trades := data.frame({
  trade_id: data.i64([1, 2, 3, 4]),
  sym: data.symbols(["AAPL", "AAPL", "MSFT", "TSLA"]),
  venue: data.strings(["XNAS", "XNYS", "XNYS", "XNAS"]),
  trade_date: data.date(["2026-06-01", "2026-06-01", "2026-06-02", "2026-06-02"]),
  event_ts: data.timestamp(["2026-06-01T09:30:00Z", "2026-06-01T09:31:00Z", "2026-06-02T09:30:30Z", "2026-06-02T09:31:00Z"]),
  price: data.f64([100.0, 101.0, 80.0, 200.0]),
  size: data.i64([10, 20, 30, 5]),
})
typed_updated := q.sql(typed_trades, "update price:price+1.0,size:size+1 from trades where sym=`AAPL")
typed_trimmed := q.sql(typed_updated, "delete from trades where sym=`TSLA")
typed_venues := data.frame({
  venue: data.strings(["XNAS", "XNYS"]),
  region: data.symbols(["US", "US"]),
})
typed_quotes := data.frame({
  sym: data.symbols(["AAPL", "AAPL", "MSFT"]),
  event_ts: data.timestamp(["2026-06-01T09:29:30Z", "2026-06-01T09:30:30Z", "2026-06-02T09:30:00Z"]),
  bid: data.f64([99.0, 100.5, 79.5]),
})
typed_enriched := q.sql(
  "select trade_id,sym,venue,trade_date,event_ts,price,size,region from trades left join venues on venue order by trade_id asc",
  {trades: typed_trimmed, venues: typed_venues}
)
typed_asofed := q.sql(
  "select trade_id,sym,trade_date,event_ts,price,size,region,bid from enriched asof join quotes on sym,event_ts order by trade_id asc",
  {enriched: typed_enriched, quotes: typed_quotes}
)
typed_rollup := q.sql(
  typed_asofed,
  "select notional:sum price*size, fills:count i, first_bid:first bid, last_region:last region by sym,trade_date from trades where trade_date within (\"2026-06-01\" \"2026-06-02\") order by sym asc,trade_date asc"
)
typed_empty_delete := q.sql(typed_asofed, "delete from trades where event_ts=\"2026-06-03T00:00:00Z\"")

check("typed mutation join asof rollup", #typed_rollup == 2 && typed_rollup[1].sym == "AAPL" && typed_rollup[1].notional == 3253.0 && typed_rollup[1].first_bid == 99.0 && typed_rollup[2].last_region == "US")
check("typed temporal schema survives q chain", typed_asofed.schema.kinds.event_ts == "timestamp" && typed_rollup[1].trade_date == "2026-06-01" && typed_rollup.schema.kinds.trade_date == "date" && #typed_empty_delete == 3)

edge_trades := data.frame({
  trade_id: data.i64([1, 2]),
  sym: data.symbols(["AAPL", "MSFT"]),
  venue: data.strings(["XNAS", "XASE"]),
  event_ts: data.timestamp(["2026-06-01T09:30:00Z", "2026-06-01T09:31:00Z"]),
  price: data.f64([100.0, 80.0]),
})
edge_updated := q.sql(edge_trades, "update price:price+1.0 from trades where sym=`IBM")
edge_venues := data.frame({
  venue: data.strings(["XNAS"]),
  region: data.symbols(["US"]),
})
edge_quotes := data.frame({
  sym: data.symbols(["AAPL"]),
  event_ts: data.timestamp(["2026-06-01T09:30:30Z"]),
  bid: data.f64([99.0]),
})
edge_enriched := q.sql(
  "select trade_id,sym,venue,event_ts,price,region from trades left join venues on venue order by trade_id asc",
  {trades: edge_updated, venues: edge_venues}
)
edge_asofed := q.sql(
  "select trade_id,sym,event_ts,price,region,bid from enriched asof join quotes on sym,event_ts order by trade_id asc",
  {enriched: edge_enriched, quotes: edge_quotes}
)
edge_rollup := q.sql(edge_asofed, "select fills:count i, first_bid:first bid by region from trades order by region asc")
edge_empty := q.sql(edge_asofed, "delete from trades where price>=0.0")

check("typed unmatched left/asof join keeps nulls", edge_updated[1].price == 100.0 && edge_enriched[1].region == "US" && edge_enriched[2].region == nil && edge_asofed[1].bid == nil && edge_asofed[2].bid == nil)
check("typed null grouped aggregate and empty delete schema", #edge_rollup == 2 && edge_rollup[1].region == nil && edge_rollup[1].fills == 1 && edge_rollup[2].region == "US" && #edge_empty == 0 && edge_empty.schema.kinds.event_ts == "timestamp" && edge_empty.schema.kinds.region == "symbol" && edge_empty.schema.kinds.bid == "f64")

print("ok")
