print("case:q_intraday_tca_order_book_project")

result := dofile("examples/data/q_intraday_tca_order_book_project/main.leia")

assert(result.summary != "")
assert(#result.ticks == 18)
assert(#result.quotes == 7)
assert(#result.orders == 6)
assert(#result.trades == 5)
assert(#result.active_book == 10)
assert(#result.top_book == 7)
assert(q.keys(result.book_keyed)[1] == "sym")
assert(q.keys(result.book_keyed)[2] == "venue")
assert(result.calendar[1].trade_date == "2026-06-07")
assert(result.calendar[2].trade_date == nil)
assert(result.venue_fees.XNAS == 0.0003)
assert(result.route_rank.dark == 3)
assert(result.enum_probe[1][3] == 0)
assert(result.enum_probe[2][3] == "IEX")
assert(result.adverb_path[2][4] == 270)
assert(result.dict_each_counts.dark == 4)
assert(result.trades.column_kinds.condition == nil)
assert(result.trades[1].notional == 10010.0)
assert(result.trades[2].signed_qty == -50.0)
assert(result.enriched[1].bid == 99.9)
assert(result.enriched[2].bid == 100.25)
assert(result.enriched[3].ask == 250.2)
assert(#result.quote_window[2].bid == 2)
assert(#result.quote_window[5].bid == 0)
assert(result.order_lifecycle[1].filled == 100.0)
assert(result.order_lifecycle[5].filled == nil)
assert(result.tca[1].arrival_mid == 100.0)
assert(result.tca[1].slippage_bps > 9.99)
assert(result.tca[1].slippage_bps < 10.01)
assert(#result.venue_left == 5)
assert(result.venue_left[3].mic == nil)
assert(#result.rebate_inner == 5)
assert(result.rebate_inner[2].rebate > 0.00119 && result.rebate_inner[2].rebate < 0.00121)
assert(#result.liquid_ticks == 5)
assert(result.liquid_ticks[1].sym == "NVDA")
assert(#result.high_cost == 2)
assert(result.bars[1].bucket == "2026-06-07T09:30:00Z")
assert(math.floor(result.bars[1].vwap * 100) == 10010)
assert(result.bars[2].net_qty == -50.0)
assert(#result.daily_rollup == 3)
assert(result.daily_rollup[1].sym == "AAPL")
assert(result.daily_rollup[1].shares == 150.0)

print("ok")
