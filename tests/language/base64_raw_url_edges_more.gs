print("case:base64_raw_url_edges_more")

encoded := base64.encode("")
assert(encoded == "")
decoded, err := base64.decode("")
assert(decoded == "")
assert(err == nil)

urlEncoded := base64.urlEncode("")
assert(urlEncoded == "")
decoded, err = base64.urlDecode("")
assert(decoded == "")
assert(err == nil)

binary := string.char(0, 1, 2, 127, 128, 255) .. "A+/="
encoded = base64.encode(binary)
decoded, err = base64.decode(encoded)
assert(decoded == binary)
assert(err == nil)
urlEncoded = base64.urlEncode(binary)
decoded, err = base64.urlDecode(urlEncoded)
assert(decoded == binary)
assert(err == nil)

assert(base64.encode("f") == "Zg==")
assert(base64.encode("fo") == "Zm8=")
decoded, err = base64.decode("Zg==")
assert(decoded == "f")
assert(err == nil)
decoded, err = base64.decode("Zm8=")
assert(decoded == "fo")
assert(err == nil)

assert(base64.urlEncode("f") == "Zg")
assert(base64.urlEncode("fo") == "Zm8")
assert(!string.find(base64.urlEncode("f"), "=", 1, true))
assert(!string.find(base64.urlEncode("fo"), "=", 1, true))
decoded, err = base64.urlDecode("Zg")
assert(decoded == "f")
assert(err == nil)
decoded, err = base64.urlDecode("Zm8")
assert(decoded == "fo")
assert(err == nil)

bad, badErr := base64.urlDecode("Zg==")
assert(bad == nil)
assert(type(badErr) == "string")
assert(#badErr > 0)
bad, badErr = base64.urlDecode("Zm8=")
assert(bad == nil)
assert(type(badErr) == "string")
assert(#badErr > 0)
bad, badErr = base64.urlDecode("not-valid!")
assert(bad == nil)
assert(type(badErr) == "string")
assert(#badErr > 0)

print("ok")
