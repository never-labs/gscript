print("case:nextvar_next_pairs_copy")

func checknext(a) {
  b := {}
  k, v := next(a)
  for k {
    b[k] = v
    k, v = next(a, k)
  }
  for kk, vv := range pairs(b) {
    assert(a[kk] == vv)
  }
  for kk, vv := range pairs(a) {
    assert(b[kk] == vv)
  }
}

func mixed(n) {
  t := []
  for i := 1; i <= n; i++ { t[i] = i }
  t.x = 1
  t.y = 2
  t.z = 3
  return t
}

a := mixed(1)
b := mixed(2)
c := mixed(3)
d := mixed(4)
e := mixed(5)

checknext(a)
checknext(b)
checknext(c)
checknext(d)
checknext(e)

print("ok")
