check("flip table cols and meta", #flipped == 3 && flipped[2].sym == "MSFT" && flipped[3].size == 30 && flipped_cols[1] == "sym" && flipped_meta[1].c == "sym" && flipped_meta[1].t == "symbol")
check("keyed table duplicate lookup and query", keyed_keys[1] == "sym" && keyed_keys[2] == "bucket" && #keyed_hit == 1 && keyed_hit[1].seq == 2 && keyed_hit[1].sym == nil && #keyed_miss == 0 && keyed_miss.column_kinds.px == "f64" && #keyed_select == 3 && keyed_select[1].seq == 1 && keyed_select[3].bucket == "09:31")

adverb_over := q.eval("+/100 105 103 110")
adverb_scan := q.eval("+\\100 105 103 110")
adverb_each := q.eval("1 2 3+'10 20 30")
adverb_prior := q.eval("-':100 105 103 110")
adverb_left := q.eval("10-\\:1 2 3")
adverb_right := q.eval("10 20 30-/:1")
adverb_projection := q.eval("({x+y}[10;])'1 2 3")
adverb_over_seed := q.eval("{x+y}/[10;1 2 3]")
adverb_scan_seed := q.eval("{x+y}\\[10;1 2 3]")
adverb_function_value := q.eval("f:+;f/1 2 3 4")

check("adverbs over scan each prior projection", adverb_over == 418 && adverb_scan[4] == 418 && adverb_each[2] == 22 && adverb_prior[2] == 5 && adverb_prior[3] == -2 && adverb_left[3] == 7 && adverb_right[3] == 29 && adverb_projection[3] == 13 && adverb_over_seed == 16 && adverb_scan_seed[3] == 16 && adverb_function_value == 10)

