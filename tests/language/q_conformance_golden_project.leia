attr_unique_meta := q.eval("meta `u#`AAPL`MSFT`AAPL")
attr_grouped_meta := q.eval("meta `g#`AAPL`MSFT`AAPL")

check("symbols preserve values and grouping", q.count(symbols) == 4 && symbols[1] == "AAPL" && symbols[4] == "NVDA" && symbol_group.AAPL[1] == 0 && symbol_group.AAPL[2] == 2 && symbol_group.MSFT[1] == 1)
check("enum domain codes and equality", enum_cast[3] == "AAPL" && enum_domain[1] == "AAPL" && enum_domain[2] == "MSFT" && q.count(enum_domain) == 2 && enum_codes[1] == 0 && enum_codes[2] == 1 && enum_codes[3] == 0 && enum_same == true && enum_other == false)
check("callable enum monads", callable_enum_domain[1] == "AAPL" && callable_enum_domain[2] == "MSFT" && callable_enum_codes[1] == 0 && callable_enum_codes[3] == 0)
check("enum and attribute metadata", enum_meta.domain == "sym" && enum_meta.type == 11 && enum_meta.count == 3 && attr_sorted[3] == 30 && attr_parted[2] == "AAPL" && attr_unique[2] == "MSFT" && attr_grouped[3] == "AAPL" && attr_meta.attribute == "p" && attr_unique_meta.attribute == "u" && attr_grouped_meta.attribute == "g" && attr_meta.type == 11 && attr_meta.count == 3)

dict := q.eval("`bid`ask`last!(100.0 100.5;101.0 101.5;100.75 101.25)")
