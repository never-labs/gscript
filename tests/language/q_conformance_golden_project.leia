check("window join and xbar rollup", #windowed == 4 && #windowed[1].bid == 1 && windowed[2].bid[1] == 100.5 && #windowed[4].bid == 0 && #windowed_last == 4 && windowed_last[1].bid == 100.0 && windowed_last[2].bid == 100.5 && windowed_last[4].bid == nil && #xbar_rollup == 4 && xbar_rollup[1].sym == "AAPL" && xbar_rollup[1].bucket == "2026-06-06T09:30:00Z" && xbar_rollup[1].qty == 10.0 && xbar_rollup[4].sym == "TSLA")
check("aliased aj wj wj1 golden", #asofed_alias_keys == 4 && asofed_alias_keys[1].bid == 100.0 && asofed_alias_keys[2].bid == 100.5 && asofed_alias_keys[4].bid == nil && #windowed_alias_keys == 4 && #windowed_alias_keys[1].bid == 1 && #windowed_alias_keys[4].bid == 0 && #windowed_last_alias_keys == 4 && windowed_last_alias_keys[1].bid == 100.0 && windowed_last_alias_keys[2].bid == 100.5 && windowed_last_alias_keys[4].bid == nil)
check("complex qsql aggregate order take golden", #complex_rollup == 2 && complex_rollup[1].sym == "AAPL" && complex_rollup[1].notional == 2012.0 && complex_rollup[1].max_px == 100.6 && complex_rollup[2].bucket == "2026-06-06T09:30:00Z" && complex_rollup[2].min_px == 100.1 && complex_rollup[2].avg_spread == 0.20000000000000284)

venues := q.sql(
  "select venue,mic_name from ([] venue:`XNAS`XNYS; mic_name:`Nasdaq`NYSE)",
  {}
)
updated := q.sql(trades, "update notional:price*size, fee:0.001*price*size from trades where size>=5")
deleted := q.sql(updated, "delete from trades where sym=`TSLA")
joined := q.sql(
  "select trade_id,sym,venue,mic_name,notional,fee from trades left join venues on venue order by trade_id asc",
  {trades: deleted, venues: venues}
)
fees := q.sql("select venue,rebate from ([] venue:`XNAS`XNAS`XNYS; rebate:0.001 0.002 0.003)", {})
inner_joined := q.sql(
  "select trade_id,sym,venue,rebate from trades inner join fees on venue order by trade_id asc,rebate asc",
  {trades: deleted, fees: fees}
)
unioned := q.sql(
  "select sym,size,price from left uj right on sym order by sym asc",
  {left: q.sql("select sym,size from ([] sym:`AAPL`MSFT; size:10 20)", {}), right: q.sql("select sym,price from ([] sym:`AAPL`NVDA; price:100.0 300.0)", {})}
)
plussed := q.sql(
  "select sym,size,price from left pj right on sym order by sym asc",
  {left: q.sql("select sym,size from ([] sym:`AAPL`MSFT; size:10 20)", {}), right: q.sql("select sym,size,price from ([] sym:`AAPL`NVDA; size:1 3; price:100.0 300.0)", {})}
)
