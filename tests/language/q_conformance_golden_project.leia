enum_other := q.eval("`sym$`AAPL`MSFT~`venue$`AAPL`MSFT")
enum_meta := q.eval("meta `sym$`AAPL`MSFT`AAPL")
callable_enum_domain := q.eval("domain[`sym$`AAPL`MSFT`AAPL]")
callable_enum_codes := q.eval("codes[`sym$`AAPL`MSFT`AAPL]")
attr_sorted := q.eval("`s#10 20 30")
attr_unique := q.eval("`u#`AAPL`MSFT`AAPL")
attr_parted := q.eval("`p#`AAPL`AAPL`MSFT")
attr_grouped := q.eval("`g#`AAPL`MSFT`AAPL")
