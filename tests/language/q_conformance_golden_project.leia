check("golden qsql exec fixed expected", exec_cols.notional[1] == 1001.0 && exec_cols.notional[2] == 2012.0 && exec_cols.notional[3] == 200.0 && exec_rollup.qty[1] == 30.0 && exec_rollup.qty[2] == 5.0 && exec_rollup.qty[3] == 1.0)

decoded_keyed := q.decode(q.encode(keyed))
decoded_enum := q.decode(q.encode(enum_cast))
decoded_typed := q.decode(q.encode(temporal_nulls))
decoded_attr := q.decode(q.encode(attr_parted))
decoded_attr_unique := q.decode(q.encode(attr_unique))

check("codec keyed enum typed attribute roundtrip", q.keys(decoded_keyed)[1] == "sym" && q.lookup(decoded_keyed, "AAPL", "09:30")[1].seq == 2 && decoded_enum[2] == "MSFT" && decoded_typed[2].d == nil && decoded_typed[1].ts == "2026-06-06T09:30:00.250Z" && decoded_attr[3] == "MSFT" && decoded_attr_unique[2] == "MSFT")

print("ok")
