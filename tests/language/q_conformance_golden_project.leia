print("case:q_conformance_golden_project")

func check(name, ok) {
  assert(ok)
  print("ok", name)
}

func missing(v) {
  return v == nil || data.is_null(v)
}

func expect_vec(name, got, expected) {
  assert(q.count(got) == #expected)
  for i := 1; i <= #expected; i++ {
    if expected[i] == nil {
      assert(missing(got[i]))
    } else {
      assert(got[i] == expected[i])
    }
  }
  print("ok", name)
}

func expect_rows(name, rows, count) {
  assert(#rows == count)
  print("ok", name)
}

typed_nulls := q.eval("0Nh 0Ni 0Nj 0Ne")
typed_infinities := q.eval("0Wh -0Wh 0Wi -0Wi 0Wj -0Wj 0We -0We 0Wf -0Wf")
typed_cast_int := q.eval("`int$1 2 0N")
typed_cast_real := q.eval("`real$1 2 0Nf")
typed_cast_float := q.eval("`float$1 2 0Ni")
typed_cast_symbol := q.eval("`symbol$(\"AAPL\";\"MSFT\")")
typed_cast_string := q.eval("`string$`AAPL`MSFT")
typed_cast_date := q.eval("`date$\"2026-06-06\" \"2026-06-07\"")
short_cast_int := q.eval("i$3")
short_cast_float_null_type := q.eval("type f$0N")
short_cast_real := q.eval("e$1 2 0Nf")
short_cast_typed_amend := q.eval("@[(1 2 0Ni);2;:;i$3]")
temporal_nulls := q.sql(
  "select d,t,ts from ([] d:2026.06.06 0Nd; t:09:30:00.250 0Nt; ts:2026.06.06D09:30:00.250 0Np)",
  {}
)
temporal_keyed := q.key_by(data.frame({
  sym: data.symbols({"AAPL", "MSFT"}),
  bucket: data.timestamp({"2026-06-06T09:30:00Z", "2026-06-06T09:31:00Z"}),
  notional: data.f64({10012.0, 8050.0}),
}), "sym", "bucket")
temporal_keyed_hit := q.lookup(temporal_keyed, {sym: "AAPL", bucket: "2026-06-06T09:30:00Z"})
temporal_keyed_miss := q.lookup(temporal_keyed, {sym: "AAPL", bucket: "2026-06-06T09:31:00Z"})

check("typed numeric null literals", q.count(typed_nulls) == 4 && data.is_null(typed_nulls[1]) && data.is_null(typed_nulls[2]) && data.is_null(typed_nulls[3]) && data.is_null(typed_nulls[4]))
check("typed infinity literals", typed_infinities[1] > 30000 && typed_infinities[2] < -30000 && typed_infinities[3] > 2000000000 && typed_infinities[4] < -2000000000 && typed_infinities[5] > 9000000000000000000 && typed_infinities[6] < -9000000000000000000 && typed_infinities[7] > typed_infinities[5] && typed_infinities[8] < typed_infinities[6] && typed_infinities[9] > typed_infinities[5] && typed_infinities[10] < typed_infinities[6])
check("typed casts preserve scalar and vector semantics", typed_cast_int.kind == "i32" && typed_cast_int[1] == 1 && data.is_null(typed_cast_int[3]) && typed_cast_real.kind == "f32" && typed_cast_real[2] == 2.0 && typed_cast_float.kind == "f64" && typed_cast_float[2] == 2.0 && typed_cast_symbol[2] == "MSFT" && typed_cast_string.kind == "string" && typed_cast_string[1] == "AAPL" && typed_cast_date[1] == "2026-06-06")
check("q short typed casts and typed amend", short_cast_int == 3 && short_cast_float_null_type == -9 && short_cast_real.kind == "f32" && data.is_null(short_cast_real[3]) && short_cast_typed_amend.kind == "i32" && short_cast_typed_amend[3] == 3)
check("temporal typed null formatting", #temporal_nulls == 2 && temporal_nulls[1].d == "2026-06-06" && temporal_nulls[1].t == "09:30:00.250" && temporal_nulls[1].ts == "2026-06-06T09:30:00.250Z" && temporal_nulls[2].d == nil && temporal_nulls[2].t == nil && temporal_nulls[2].ts == nil)
check("temporal keyed lookup coerces timestamp strings", #temporal_keyed_hit == 1 && temporal_keyed_hit[1].notional == 10012.0 && #temporal_keyed_miss == 0 && temporal_keyed_miss.column_kinds.notional == "f64")

expr_add := q.eval("10 20 30+1")
expr_promote := q.eval("1 2 3+1.5 2.5 3.5")
expr_null_scan := q.eval("+\\1 0N 2")
expr_null_deltas := q.eval("deltas 1 0N 3")
expr_where := q.eval("where false true false true")
expr_bin := q.eval("10 20 30 bin 5 10 25 40 0N")
expr_within := q.eval("10 20 30 within 15 30")
expr_cut := q.eval("0 2_10 20 30 40")
expr_rank := q.eval("rank 50 20 30 10 40")
expr_xprev := q.eval("2 xprev 10 20 30 40")
expr_rotate := q.eval("2 rotate 10 20 30 40")
expr_prior := q.eval("prior 100 105 103")
expr_prior_each := q.eval("prior' (10 20 30;100 200)")
expr_prev := q.eval("prev 100 105 103")
expr_next := q.eval("next 100 105 103")
expr_differ := q.eval("differ `AAPL`AAPL`MSFT`MSFT")
expr_msum := q.eval("3 msum 10 20 30 40")
expr_mavg := q.eval("3 mavg 10 20 30 40")
expr_mcount := q.eval("3 mcount 10 0N 30 40")
expr_mmin := q.eval("3 mmin 30 0N 10 20")
expr_mmax := q.eval("3 mmax 30 0N 10 20")
expr_mins := q.eval("mins 30 20 25 10")
expr_maxs := q.eval("maxs 30 20 35 10")
expr_avgs := q.eval("avgs 10 0N 30 50")

expect_vec("golden expression scalar-vector arithmetic", expr_add, {11, 21, 31})
expect_vec("golden expression type promotion", expr_promote, {2.5, 4.5, 6.5})
expect_vec("golden expression null scan", expr_null_scan, {1, 1, 3})
check("golden expression null deltas", expr_null_deltas[1] == 1 && missing(expr_null_deltas[2]) && missing(expr_null_deltas[3]))
expect_vec("golden expression where/bin/within", expr_where, {1, 3})
expect_vec("golden expression bin", expr_bin, {-1, 0, 1, 2, -1})
expect_vec("golden expression within", expr_within, {false, true, true})
check("golden expression cut", q.count(expr_cut) == 2 && expr_cut[1][1] == 10 && expr_cut[1][2] == 20 && expr_cut[2][1] == 30 && expr_cut[2][2] == 40)
expect_vec("golden expression rank", expr_rank, {4, 1, 2, 0, 3})
check("golden expression xprev", missing(expr_xprev[1]) && missing(expr_xprev[2]) && expr_xprev[3] == 10 && expr_xprev[4] == 20)
expect_vec("golden expression rotate", expr_rotate, {30, 40, 10, 20})
check("golden expression prior alias and each", missing(expr_prior[1]) && expr_prior[2] == 100 && expr_prior[3] == 105 && missing(expr_prior_each[1][1]) && expr_prior_each[1][2] == 10 && expr_prior_each[2][2] == 100)
check("golden expression prev next differ", missing(expr_prev[1]) && expr_prev[2] == 100 && expr_prev[3] == 105 && expr_next[1] == 105 && expr_next[2] == 103 && missing(expr_next[3]) && expr_differ[1] == true && expr_differ[2] == false && expr_differ[3] == true && expr_differ[4] == false)
expect_vec("golden expression moving sum", expr_msum, {10, 30, 60, 90})
expect_vec("golden expression moving avg", expr_mavg, {10.0, 15.0, 20.0, 30.0})
expect_vec("golden expression moving count", expr_mcount, {1, 1, 2, 2})
expect_vec("golden expression moving min max", expr_mmin, {30, 30, 10, 10})
expect_vec("golden expression moving max", expr_mmax, {30, 30, 30, 20})
expect_vec("golden expression running mins maxs", expr_mins, {30, 20, 20, 10})
expect_vec("golden expression running maxs", expr_maxs, {30, 30, 35, 35})
expect_vec("golden expression running avgs nulls", expr_avgs, {10.0, 10.0, 20.0, 30.0})

symbols := q.eval("`AAPL`MSFT`AAPL`NVDA")
symbol_group := q.eval("group `AAPL`MSFT`AAPL`NVDA")
enum_cast := q.eval("`sym$`AAPL`MSFT`AAPL")
enum_domain := q.eval("domain `sym$`AAPL`MSFT`AAPL")
enum_codes := q.eval("codes `sym$`AAPL`MSFT`AAPL")
