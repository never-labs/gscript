check("pj and aj keyword joins", #plussed == 2 && plussed[1].size == 11.0 && plussed[1].price == 100.0 && plussed[2].size == 20.0 && plussed[2].price == nil && #aj_keyword == 4 && aj_keyword[1].bid == 100.0 && aj_keyword[4].bid == nil)
