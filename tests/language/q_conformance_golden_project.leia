selected := q.sql("select sym,notional:price*size from trades where price>=100 order by notional desc take 2", {trades: trades})
exec_cols := q.sql("exec trade_id,sym,notional:price*size from trades where price>=100 order by trade_id asc", {trades: trades})
exec_vec := q.sql("exec price from trades where sym=`AAPL order by price asc", {trades: trades})
exec_dict := q.sql("exec sym!price from trades where price>=100 order by sym asc", {trades: trades})
exec_rollup := q.sql("exec qty:sum size, gross:sum price*size by sym from trades order by sym asc", {trades: trades})

check("qsql select computed order take", #selected == 2 && selected[1].sym == "AAPL" && selected[1].notional == 2012.0 && selected[2].notional == 1001.0)
check("qsql exec table vector dict rollup", #q.keys(exec_cols) == 3 && exec_cols.trade_id[1] == 1 && q.count(exec_vec) == 2 && exec_vec[2] == 100.6 && q.keys(exec_dict)[1] == "AAPL" && q.value(exec_dict)[2] == 100.6 && #exec_rollup.sym == 3 && exec_rollup.gross[1] == 3013.0 && exec_rollup.sym[3] == "TSLA")
