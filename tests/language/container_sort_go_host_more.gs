print("case:container_sort_go_host_more")

s := container.setNew(1, 2, 2, 3)
assert(container.setSize(s) == 3)
assert(container.setHas(s, 2))
container.setRemove(s, 2)
assert(!container.setHas(s, 2))
u := container.setUnion(container.setNew(1, 2), container.setNew(2, 3))
assert(container.setSize(u) == 3 && container.setHas(u, 1) && container.setHas(u, 3))
i := container.setIntersect(container.setNew(1, 2, 3), container.setNew(2, 3, 4))
assert(container.setSize(i) == 2 && container.setHas(i, 2) && container.setHas(i, 3))
d := container.setDifference(container.setNew(1, 2, 3), container.setNew(2))
assert(container.setSize(d) == 2 && container.setHas(d, 1) && container.setHas(d, 3))

q := container.queueNew()
assert(container.queueEmpty(q))
container.queuePush(q, "b")
container.queuePushFront(q, "a")
container.queuePush(q, "c")
assert(container.queueSize(q) == 3)
assert(container.queuePeek(q) == "a")
assert(container.queuePop(q) == "a")
assert(container.queuePopBack(q) == "c")
assert(container.queuePop(q) == "b")
assert(container.queuePop(q) == nil)

st := container.stackNew()
container.stackPush(st, "a")
container.stackPush(st, "b")
assert(container.stackPeek(st) == "b")
assert(container.stackPop(st) == "b")
assert(container.stackPop(st) == "a")
assert(container.stackEmpty(st))

h := container.heapNew()
h.push(3)
h.push(1)
h.push(2)
assert(h.size() == 3)
assert(h.peek() == 1)
assert(h.pop() == 1 && h.pop() == 2 && h.pop() == 3 && h.pop() == nil)

arr := {3, 1, 2, 2}
sort.asc(arr)
assert(arr[1] == 1 && arr[4] == 3 && sort.isSorted(arr))
assert(sort.bsearch(arr, 2) == 2)
uniq := sort.unique(arr)
assert(#uniq == 3 && uniq[1] == 1 && uniq[2] == 2 && uniq[3] == 3)
sort.desc(arr)
assert(arr[1] == 3 && arr[4] == 1)
sort.reverse(arr)
assert(arr[1] == 1 && arr[4] == 3)
assert(sort.min(arr) == 1 && sort.max(arr) == 3)
evens, odds := sort.partition({1, 2, 3, 4}, func(v) { return v % 2 == 0 })
assert(#evens == 2 && evens[1] == 2 && evens[2] == 4)
assert(#odds == 2 && odds[1] == 1 && odds[2] == 3)
words := {"aaa", "b", "cc"}
sort.byKey(words, func(s) { return #s })
assert(words[1] == "b" && words[3] == "aaa")

print("ok")
