print("case:big_generated_eval_env_more")

lim := 128 + 7
prog := {"y := {0"}
for i := 1; i <= lim; i++ {
  prog[#prog + 1] = i
}
prog[#prog + 1] = "}"
prog[#prog + 1] = string.format("assert(y[%d] == %d)", lim, lim - 1)
prog[#prog + 1] = string.format("assert(y[%d] == %d)", lim + 1, lim)
prog[#prog + 1] = "X = y"
prog[#prog + 1] = "return #y"

env := {assert: assert, X: false}
result := script.eval(table.concat(prog, ";"), {env: env, sourceName: "generated-big.leia"})
assert(result == lim + 1)
assert(env.X[lim] == lim - 1 && env.X[lim + 1] == lim)

print("ok")
