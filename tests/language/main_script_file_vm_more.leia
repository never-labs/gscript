print("case:main_script_file_vm_more")

base := fs.tempfile(nil, "leia_script_vm_")
assert(type(base) == "string")
fs.remove(base)
assert(fs.mkdirAll(base))
defer fs.removeAll(base)

child := path.join(base, "child.leia")
assert(fs.writefile(child, `shared = shared + 1
newGlobal := shared
return shared`))

shared := 41
assert(script.runFile("child.leia", {scriptDir: base}) == 42)
assert(shared == 42)
assert(newGlobal == 42)

fn := script.loadFile("child.leia", {scriptDir: base})
assert(fn() == 43)
assert(shared == 43)
assert(newGlobal == 43)

assert(script.eval("return shared") == 43)
compiled := script.compile("return shared + 1")
assert(compiled() == 44)

envFile := path.join(base, "env_child.leia")
assert(fs.writefile(envFile, `y = x + 2
return x + 1`))
env := {x: 9, y: 0}
assert(script.runFile("env_child.leia", {scriptDir: base, env: env}) == 10)
assert(env.x == 9)
assert(env.y == 11)
assert(shared == 43)

box := script.sandbox({name: "boxed"})
boxed := script.compile("return name", box)
assert(boxed() == "boxed")

print("ok")
