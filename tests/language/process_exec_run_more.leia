print("case:process_exec_run_more")

sh := process.which("sh")
assert(type(sh) == "string")
assert(process.which("__leia_process_missing_command_987654321__") == nil)

pid1 := process.pid()
pid2 := process.pid()
assert(type(pid1) == "number" && pid1 > 0 && pid1 == pid2)

env := process.env()
assert(type(env) == "table")
assert(env.__LEIA_PROCESS_ENV_SHOULD_NOT_EXIST_987654321__ == nil)

run := process.run({sh, "-c", "cat; printf runerr 1>&2; printf :$LEIA_PROCESS_SENTINEL"}, {
  stdin: "runin",
  env: {LEIA_PROCESS_SENTINEL: "runenv"},
})
assert(type(run) == "table")
assert(run.ok == true)
assert(run.code == 0)
assert(run.stdout == "runin:runenv")
assert(run.stderr == "runerr")

runFail := process.run({sh, "-c", "printf failout; printf failerr 1>&2; exit 4"})
assert(runFail.ok == false)
assert(runFail.code == 4)
assert(runFail.stdout == "failout")
assert(runFail.stderr == "failerr")

runMissing := process.run({"__leia_process_missing_command_987654321__"})
assert(runMissing.ok == false)
assert(runMissing.code == -1)
assert(type(runMissing.stdout) == "string")
assert(type(runMissing.stderr) == "string")

execOut, execErr := process.exec(sh, "-c", "printf execout; printf execerr 1>&2")
assert(execOut == "execout")
assert(execErr == nil)

execFailOut, execFailErr := process.exec(sh, "-c", "exit 5")
assert(execFailOut == nil)
assert(type(execFailErr) == "string")

shell := process.shell("printf shellout; printf shellerr 1>&2; exit 6")
assert(shell.ok == false)
assert(shell.code == 6)
assert(shell.stdout == "shellout")
assert(shell.stderr == "shellerr")

assert(!pcall(process.run))
assert(!pcall(process.run, {}))
assert(!pcall(process.exec))
assert(!pcall(process.shell))
assert(!pcall(process.which))

print("ok")
