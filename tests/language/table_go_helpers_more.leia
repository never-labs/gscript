print("case:table_go_helpers_more")

t := [3, 1, 3]
t.name = "bob"
t.active = true
assert(table.count(t) == 5)
assert(table.contains(t, "bob"))
assert(table.indexOf(t, 1) == 2)
assert(table.indexOf(t, 9) == nil)

copy := table.copy(t)
copy[1] = 99
assert(t[1] == 3 && copy[1] == 99)

merged := table.merge({a: 1}, {b: 2, a: 3})
assert(merged.a == 3 && merged.b == 2)

uniq := table.unique([1, 2, 1, 3, 2])
assert(#uniq == 3 && uniq[1] == 1 && uniq[2] == 2 && uniq[3] == 3)

r := table.reverse([1, 2, 3])
assert(r[1] == 3 && r[2] == 2 && r[3] == 1)

s := table.slice(["a", "b", "c", "d"], 2, 3)
assert(#s == 2 && s[1] == "b" && s[2] == "c")

z := table.zip(["x", "y"], [10, 20, 30])
assert(#z == 2 && z[1][1] == "x" && z[1][2] == 10 && z[2][1] == "y" && z[2][2] == 20)

keys := table.keys({a: 1, b: 2})
table.sort(keys)
assert(#keys == 2 && keys[1] == "a" && keys[2] == "b")

values := table.values({a: "x", b: "y"})
table.sort(values)
assert(#values == 2 && values[1] == "x" && values[2] == "y")

print("ok")
