print("case:q_iot_sensor_telemetry_project")

result := dofile("examples/data/q_iot_sensor_telemetry_project/main.leia")

assert(result.summary != "")
assert(#result.devices == 4)
assert(#result.calibration == 6)
assert(#result.readings_raw == 10)
assert(#result.readings == 9)
assert(#result.calibrated == 9)
assert(#result.enriched == 9)
assert(#result.anomalies == 5)
assert(#result.bucket_rollup == 3)
assert(#result.site_rollup == 2)
assert(result.sensor_weights.vibration == 0.35)
assert(result.daily_energy[5] == 675)
assert(result.reading_gaps[4] == 600)
assert(result.max_gap == 1800)
assert(result.calibrated[2].adjusted == 79.0)
assert(result.enriched[8].low_battery == true)
assert(result.anomalies[1].device == "D2")
assert(result.bucket_rollup[2].anomalies == 3)
assert(result.site_rollup[1].site == "north")
assert(result.site_rollup[2].critical_anomalies == 2)
assert(q.keys(result.device_keyed)[1] == "device")

print("ok")
