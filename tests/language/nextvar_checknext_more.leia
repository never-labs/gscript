print("case:nextvar_checknext_more")

func checknext(a) {
  b := {}
  k, v := next(a)
  for k {
    b[k] = v
    k, v = next(a, k)
  }
  for k, v := range pairs(b) { assert(a[k] == v) }
  for k, v := range pairs(a) { assert(b[k] == v) }
}

func mixed(n) {
  t := []
  for i := 1; i <= n; i++ { t[i] = i }
  t.x = 1
  t.y = 2
  t.z = 3
  return t
}

checknext(mixed(1))
checknext(mixed(2))
checknext(mixed(3))
checknext(mixed(4))
checknext(mixed(5))

print("ok")
