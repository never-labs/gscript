print("case:q_keyed_asof_state_replay_project")

result := dofile("examples/data/q_keyed_asof_state_replay_project/main.leia")

assert(result.summary != "")
assert(#result.events == 8)
assert(#result.fills == 4)
assert(#result.order_state == 8)
assert(#result.marked == 8)
assert(#result.sector_marked == 8)
assert(#result.risk_rollup > 0)
assert(result.active_0930[1].order_id == 1001)
assert(result.venue_fee.IEX == 0.0001)
assert(result.running_risk[5] == 1800)
assert(result.event_gaps[4] == 11)
assert(result.weighted_clip == 140)
assert(result.symbol_weights.AAPL == 0.35)
assert(result.marked[1].quote_mid == 100.1)
assert(result.marked[8].quote_imbalance > 0.03)
assert(result.sector_marked[1].bid_sz == 500)
assert(result.risk_rollup[3].sym == "MSFT")
assert(result.risk_rollup[3].vwap == 250.1)
assert(q.keys(result.keyed_state)[1] == "order_id")
assert(q.keys(result.keyed_state)[2] == "sym")
assert(#result.selected_state == 3)
assert(result.selected_state[1].filled == 45.0)
assert(result.selected_state[2].filled == 45.0)
assert(result.selected_state[3].filled == nil)
assert(#result.decoded_marked == #result.sector_marked)
assert(result.decoded_marked[1].quote_mid == 100.1)
assert(q.keys(result.decoded_keyed_state)[1] == "order_id")
assert(q.keys(result.decoded_keyed_state)[2] == "sym")
assert(#result.decoded_aapl_state == 1)
assert(result.decoded_rollup[3].vwap == 250.1)

print("ok")
