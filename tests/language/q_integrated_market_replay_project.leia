print("case:q_integrated_market_replay_project")

result := dofile("examples/data/q_integrated_market_replay_project/main.leia")

assert(result.summary != "")
assert(#result.quotes == 8)
assert(#result.trades == 7)
assert(#result.marked == 7)
assert(#result.windowed == 7)
assert(#result.sector_marked == 7)
assert(#result.fill_rollup == 7)
assert(#result.lifecycle == 7)
assert(#result.bars == 7)
assert(result.exec_notional_by_sym.NVDA > 10586.3)
assert(result.exec_notional_by_sym.NVDA < 10586.5)
assert(result.exec_trade_dict.sym[1] == "MSFT")
assert(result.exec_desk_rollup.desk[1] == "alpha")
assert(result.exec_alpha_syms[2] == "AAPL")
assert(q.keys(result.keyed_trades)[1] == "sym")
assert(q.keys(result.keyed_bars)[2] == "bucket")
assert(q.keys(result.grouped_trade_book)[1] == "sym")
assert(q.keys(result.grouped_trade_book)[2] == "venue")
assert(#q.value(result.grouped_trade_book) == 6)
assert(#result.grouped_msft_arcx == 1)
assert(tostring(result.grouped_msft_arcx[1].trade_id) == "{i64 [104 108]}")
assert(#result.ungrouped_trade_book == 7)
assert(result.ungrouped_trade_book[4].venue == "ARCX")
assert(q.keys(result.amended_lifecycle)[1] == "desk")
assert(#result.alpha_lifecycle == 3)
assert(result.alpha_lifecycle[1].open_qty == 20.0)
assert(result.qty_stats[2][7] == 182)
assert(math.floor(result.adverb_matrix[1]) == 41054)
assert(result.adverb_matrix[4][7] == 177)
assert(math.floor(result.bars[1].vwap * 100) == 10010)

print("ok")
