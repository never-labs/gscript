print("case:math_go_helpers_more")

assert(math.clamp(5, 1, 10) == 5)
assert(math.clamp(-5, 0, 10) == 0)
assert(math.clamp(15, 0, 10) == 10)
assert(math.clamp(1.25, 0.5, 1.0) == 1.0)
assert(math.clamp("7", 0, 9) == 7.0)

assert(math.lerp(0, 10, 0) == 0)
assert(math.lerp(0, 10, 1) == 10)
assert(math.lerp(0, 10, 0.25) == 2.5)
assert(math.lerp(10, 20, -0.5) == 5)
assert(math.lerp(10, 20, 1.5) == 25)

assert(math.sign(-42) == -1)
assert(math.sign(-0.25) == -1)
assert(math.sign(0) == 0)
assert(math.sign(-0.0) == 0)
assert(math.sign(0.25) == 1)
assert(math.sign(math.huge) == 1)
assert(math.sign(-math.huge) == -1)

assert(math.round(3.5) == 4)
assert(math.round(3.49) == 3)
assert(math.round(-2.5) == -3)
assert(math.round(12.345, 2) == 12.35)
assert(math.round(12.344, 2) == 12.34)
assert(math.round(149, -1) == 150.0)

assert(math.trunc(3.99) == 3)
assert(math.trunc(-3.99) == -3)
assert(math.trunc(7) == 7)
assert(math.trunc(-7) == -7)

assert(math.floorDiv(7, 3) == 2)
assert(math.floorDiv(-7, 3) == -3)
assert(math.floorDiv(7, -3) == -3)
assert(math.floorDiv(-7, -3) == 2)
assert(math.floorDiv(7.5, 2) == 3)
assert(math.floorDiv(-7.5, 2) == -4)
assert(math.floorDiv(5, 2.0) == 2)

assert(math.hypot(3, 4) == 5)
assert(math.hypot(5, 12) == 13)
assert(math.hypot(0, -0.0) == 0)
assert(math.hypot(math.huge, 1) == math.huge)

nan := math.huge - math.huge
assert(math.isnan(nan))
assert(!math.isnan(0))
assert(!math.isnan(math.huge))
assert(math.isinf(math.huge))
assert(math.isinf(-math.huge))
assert(!math.isinf(123))
assert(!math.isinf(nan))

ok, err := pcall(math.clamp, 1, 2)
assert(!ok && type(err) == "string")
ok, err = pcall(math.lerp, 1, 2)
assert(!ok && type(err) == "string")
ok, err = pcall(math.sign)
assert(!ok && type(err) == "string")
ok, err = pcall(math.round)
assert(!ok && type(err) == "string")
ok, err = pcall(math.trunc)
assert(!ok && type(err) == "string")
ok, err = pcall(math.floorDiv, 1)
assert(!ok && type(err) == "string")
ok, err = pcall(math.floorDiv, 1, 0)
assert(!ok && type(err) == "string")
ok, err = pcall(math.floorDiv, 1, 0.0)
assert(!ok && type(err) == "string")
ok, err = pcall(math.hypot, 1)
assert(!ok && type(err) == "string")
ok, err = pcall(math.isnan)
assert(!ok && type(err) == "string")
ok, err = pcall(math.isinf)
assert(!ok && type(err) == "string")

print("ok")
