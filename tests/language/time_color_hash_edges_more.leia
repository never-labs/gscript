print("case:time_color_hash_edges_more")

epoch := time.unix(0)
assert(epoch.year == 1970)
assert(epoch.month == 1)
assert(epoch.day == 1)
assert(epoch.hour == 0)
assert(epoch.min == 0)
assert(epoch.sec == 0)
assert(epoch.weekday == 4)
assert(epoch.yearday == 1)
assert(epoch.tz == "UTC")
assert(time.weekday(epoch) == "Thursday")
assert(time.month(epoch) == "January")
assert(time.format(epoch, "%Y-%m-%dT%H:%M:%S %A %B %Z") == "1970-01-01T00:00:00 Thursday January UTC")

beforeEpoch := time.unix(-1)
assert(beforeEpoch.year == 1969)
assert(beforeEpoch.month == 12)
assert(beforeEpoch.day == 31)
assert(beforeEpoch.hour == 23)
assert(beforeEpoch.min == 59)
assert(beforeEpoch.sec == 59)
assert(time.weekday(beforeEpoch) == "Wednesday")
assert(time.month(beforeEpoch) == "December")
assert(time.format(beforeEpoch, "%Y-%m-%d %H:%M:%S") == "1969-12-31 23:59:59")
assert(time.diff(beforeEpoch, epoch) == 1)

half := time.unix(1, 500000000)
assert(half.sec == 1)
assert(half.nsec == 500000000)
assert(half.unix == 1.5)
assert(time.format(half, "%Y-%m-%d %H:%M:%S") == "1970-01-01 00:00:01")

leap := time.date(2000, 2, 29, 23, 30, 0)
assert(time.weekday(leap) == "Tuesday")
assert(time.month(leap) == "February")
assert(time.format(leap, "%Y-%m-%d %H:%M:%S") == "2000-02-29 23:30:00")
nextDay := time.add(leap, time.HOUR)
assert(nextDay.year == 2000)
assert(nextDay.month == 3)
assert(nextDay.day == 1)
assert(nextDay.hour == 0)
assert(nextDay.min == 30)
assert(time.weekday(nextDay) == "Wednesday")
assert(time.month(nextDay) == "March")
assert(time.diff(leap, nextDay) == 3600)
assert(time.diff(nextDay, leap) == -3600)

yearEdge := time.date(1999, 12, 31, 23, 0, 0)
rolled := time.add(yearEdge, 2 * time.HOUR)
assert(rolled.year == 2000)
assert(rolled.month == 1)
assert(rolled.day == 1)
assert(rolled.hour == 1)
assert(time.weekday(rolled) == "Saturday")
assert(time.month(rolled) == "January")
assert(time.diff(yearEdge, rolled) == 7200)

sum := color.rgb(250, 10, 0) + color.rgb(10, 250, 128)
assert(color.isColor(sum))
assert(color.toHex(sum) == "#FFFF80")
assert(sum.a == 1)

scaled := color.rgb(64, 128, 255) * 0.5
assert(color.toHex(scaled) == "#204080")
assert(scaled.a == 1)
scaledLeft := 0.25 * color.rgb(64, 128, 255)
assert(color.toHex(scaledLeft) == "#102040")
mul := color.rgb(128, 255, 64) * color.rgb(128, 128, 255)
assert(color.toHex(mul) == "#408040")

assert(color.rgb(1, 2, 3) == color.rgb(1, 2, 3))
assert(color.rgb(1, 2, 3) != color.rgb(1, 2, 4))
assert(color.rgba(1, 2, 3, 255) == color.rgba(1, 2, 3, 255))
assert(color.rgba(1, 2, 3, 255) != color.rgba(1, 2, 3, 254))

ok, err := pcall(func() { return color.RED * "bad-scale" })
assert(!ok)
assert(type(err) == "string")
assert(string.find(err, "color.__mul", 1, true) != nil)
ok, err = pcall(func() { return getmetatable(color.RED).__add(color.RED) })
assert(!ok)
assert(type(err) == "string")
assert(string.find(err, "color.__add", 1, true) != nil)

assert(hash.sha512("abc") == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
assert(hash.sha512("") == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
assert(hash.sha512("leia\0lua") == "e1554b85ede15db55c1d44fc9892fd50c183be30cd0fd945b3e2a47c195520a8cc4588688b8480c9cca8de6cbd6a26bac372913b075c41d6c9a2a90a0f87fea7")

ok, err = pcall(hash.sha512)
assert(!ok)
assert(type(err) == "string")
assert(string.find(err, "hash.sha512", 1, true) != nil)
ok, err = pcall(hash.sha512, {shape: "table"})
assert(!ok)
assert(type(err) == "string")
assert(string.find(err, "string expected", 1, true) != nil)
ok, err = pcall(hash.hmacSHA256, "key")
assert(!ok)
assert(type(err) == "string")
assert(string.find(err, "key and message expected", 1, true) != nil)

print("ok")
