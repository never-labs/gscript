print("case:qsql_query_tdd")

func check(name, ok) {
  assert(ok)
  print("ok", name)
}

trades := data.frame({
  sym: data.symbols({"AAPL", "MSFT", "AAPL"}),
  price: data.f64({100.5, 90.0, 101.0}),
  size: data.i64({10, 15, 20}),
})

fills := q.sql("select notional:sum price*size, fills:count i by sym from trades where price>100", {
  trades: trades,
})

check("grouped length", fills.len == 1)
check("group key", fills.sym[1] == "AAPL")
check("computed aggregate", fills.notional[1] == 3025.0)
check("count aggregate", fills.fills[1] == 2)

large := q.sql("exec price,size from trades where sym=`AAPL", {trades: trades})
check("exec projection", large.len == 2 && large.price[1] == 100.5 && large.size[2] == 20)

ordered := q.sql("select sym,price,size from trades where size>=10 order by price desc limit 2", {
  trades: trades,
})
check("order limit", ordered.len == 2 && ordered.price[1] == 101.0 && ordered.sym[2] == "AAPL")

conn := db.memory()
conn.exec(sql`create table trade_events (
  id integer primary key,
  sym text not null,
  venue text not null,
  settled bool,
  trade_date text,
  event_ts text,
  price real not null,
  size integer not null
)`)
conn.exec(sql`insert into trade_events values (1, 'AAPL', 'XNAS', true, '2026-06-01', '2026-06-01T09:30:00Z', 100.5, 10)`)
conn.exec(sql`insert into trade_events values (2, 'MSFT', 'XNYS', false, '2026-06-01', '2026-06-01T09:31:00Z', 90.0, 15)`)
conn.exec(sql`insert into trade_events values (3, 'AAPL', 'XNAS', true, '2026-06-02', '2026-06-02T15:59:00Z', 101.0, 20)`)
conn.exec(sql`insert into trade_events values (4, 'NVDA', 'ARCX', null, '2026-06-02', null, 200.0, 5)`)

db_trades := conn.frame(sql`select sym,venue,coalesce(settled, false) as settled,trade_date,coalesce(event_ts, '') as event_ts,price,size from trade_events order by id`)
db_projected := q.sql(db_trades, "select sym,venue,settled,trade_date,event_ts,price,size from trade_events where price>=100 order by price desc")
db_rollup := q.sql(db_trades, "select notional:sum price*size, fills:count i by sym from trade_events where price>=100 order by notional desc")
db_nulls := conn.query(sql`select sym,settled,event_ts from trade_events where event_ts is null`)

check("db frame shape", db_trades.len == 4 && db_trades.schema.kinds.sym == "string" && db_trades.schema.kinds.settled == "i64" && db_trades.schema.kinds.price == "f64")
check("db qsql where order", db_projected.len == 3 && db_projected.sym[1] == "NVDA" && db_projected.settled[1] == 0 && db_projected.trade_date[1] == "2026-06-02")
check("db qsql group order", db_rollup.len == 2 && db_rollup.sym[1] == "AAPL" && db_rollup.notional[1] == 3025.0 && db_rollup.fills[1] == 2)
check("db qsql null temporal passthrough", #db_nulls == 1 && db_nulls[1].sym == "NVDA" && db_nulls[1].settled == nil && db_nulls[1].event_ts == nil)

print("ok")
